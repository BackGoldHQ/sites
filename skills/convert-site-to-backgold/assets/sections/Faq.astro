---
// Faq: a kicker, a heading, a line of copy, then the questions, each one
// closed until it is opened (the first one open when the section says so),
// and the section's contact link. It also writes the questions as the FAQ
// data search engines read.
//
// A starting point for src/components/sections/Faq.astro on the BackGold
// starter, which has no Faq of its own: restyle it, then add `Faq` to
// src/components/sections/index.ts.
import type { Section } from '@backgold/content'
import { serializeJsonLd } from '@backgold/astro/server'
import Band from './Band.astro'
import Prose from '../Prose.astro'
import { links, rows } from '../../lib/section'
import { text } from '../../lib/format'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
// An answer may be BackGold's restricted rich text: the plain words, for the structured data.
const plain = (value: unknown) => text(value)?.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim() ?? null
const items = rows(section).flatMap((row) => {
  const question = text(row.question)
  const answer = plain(row.answer)
  return question && answer ? [{ question, answer, raw: row.answer }] : []
})
const firstOpen = (section as { options?: Record<string, unknown> }).options?.firstOpen === true
const contact = links(section)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })),
}
---
{items.length > 0 && (
  <Band section={section} class="faq-section">
    {kicker && <p class="kicker">{kicker}</p>}
    {heading && <h2>{heading}</h2>}
    <Prose value={section.copy.body} class="lede" />
    <div class="faq-list">
      {items.map((item, i) => (
        <details open={firstOpen && i === 0}>
          <summary>{item.question}</summary>
          <Prose value={item.raw} />
        </details>
      ))}
    </div>
    {contact.length > 0 && (
      <p class="faq-contact">
        {text(section.copy.contactHeading)} {contact.map((link) => <a href={link.href} rel={link.rel}>{link.label}</a>)}
      </p>
    )}
    <script type="application/ld+json" is:inline set:html={serializeJsonLd([jsonLd])} />
  </Band>
)}

<style is:global>
  /* Global and prefixed: a class passed to Band lands outside a scoped style's reach. */
  .faq-section .faq-list details {
    border-bottom: 1px solid currentColor;
    padding: 0.8rem 0;
  }

  .faq-section .faq-list summary {
    cursor: pointer;
    font-weight: 600;
  }

  .faq-section .faq-contact {
    margin-top: 1.2rem;
  }
</style>
