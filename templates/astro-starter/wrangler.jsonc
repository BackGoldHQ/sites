// The Worker that serves the site. The Deploy to Cloudflare button asks for
// each `vars` value and creates the KV namespace below. Keep the `vars` here
// filled in: every deploy applies them, replacing what the dashboard holds.
// The secrets (BACKGOLD_SECRET_KEY, BACKGOLD_SITE_SECRET_KEY,
// BACKGOLD_WEBHOOK_SECRET; the README's
// Settings table has them all) are added after the first deploy, with
// `npx wrangler secret put <NAME>` or in the dashboard (Worker → Settings →
// Variables and Secrets). A deploy never removes a secret. There is no
// .dev.vars.example on purpose: the Deploy button would demand a value for
// every name in it before the Worker exists.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backgold-starter",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "vars": {
    "BACKGOLD_SITE_KEY": "",
    "SITE_URL": "",
    "BACKGOLD_API_ORIGIN": "https://api.backgold.com"
  },
  // No id: Cloudflare creates the namespace on the first deploy.
  "kv_namespaces": [{ "binding": "BACKGOLD_CACHE" }],
  "observability": {
    "enabled": true
  }
}
