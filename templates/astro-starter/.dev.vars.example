# Secrets. Copy this file to .dev.vars for local development (never commit
# .dev.vars). On Cloudflare, set each with `npx wrangler secret put <NAME>`.
# Every one is optional: the site renders published content without them.

# A secret key (bg_site_sk_…) from BackGold → Developer → Keys. Needed for Preview on your site.
BACKGOLD_SECRET_KEY=

# The webhook endpoint's signing secret (whsec_…) from BackGold → Developer → Webhooks. Needed for the webhook.
BACKGOLD_WEBHOOK_SECRET=

# A URL to POST after each content change, for a statically rebuilt site. Usually left blank.
BACKGOLD_REBUILD_HOOK_URL=
