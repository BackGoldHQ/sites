---
// MovementMap: a kicker, a heading, the figures the organization wrote for
// it, and where the data comes from. BackGold's hosted pages also draw a live
// map from a public dataset; this section shows the figures only. A figure
// BackGold fills in live is left out (see literalStat).
import type { Section } from '@backgold/content'
import Band from './Band.astro'
import { links, rows } from '../../lib/section'
import { literalStat, text } from '../../lib/format'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
const stats = rows(section)
  .map((row) => ({ value: literalStat(row.value), label: text(row.label), note: text(row.note) }))
  .filter((stat) => stat.value !== null)
const [source] = links(section)
---
{(heading || stats.length > 0) && (
  <Band section={section} class="stats">
    {kicker && <p class="kicker">{kicker}</p>}
    {heading && <h2>{heading}</h2>}
    {stats.length > 0 && (
      <ul class="grid grid-3 stat-list" role="list">
        {stats.map((stat) => (
          <li class="stat">
            <p class="stat-value">{stat.value}</p>
            {stat.label && <p class="stat-label">{stat.label}</p>}
            {stat.note && <p class="stat-note">{stat.note}</p>}
          </li>
        ))}
      </ul>
    )}
    {source && <p class="fine">Source: <a href={source.href} rel={source.rel}>{source.label}</a></p>}
  </Band>
)}
