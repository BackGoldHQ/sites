---
// QuoteStrip: a heading and a row of quotes, each with who said it.
import type { Section } from '@backgold/content'
import Band from './Band.astro'
import { rows } from '../../lib/section'
import { text } from '../../lib/format'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const heading = text(section.copy.heading)
const quotes = rows(section)
  .map((row) => ({ quote: text(row.quote), attribution: text(row.attribution) }))
  .filter((q): q is { quote: string; attribution: string | null } => q.quote !== null)
---
{(heading || quotes.length > 0) && (
  <Band section={section} class="quotes">
    {heading && <h2>{heading}</h2>}
    {quotes.length > 0 && (
      <ul class="grid grid-3" role="list">
        {quotes.map((q) => (
          <li>
            <figure class="quote">
              <blockquote><p>{q.quote}</p></blockquote>
              {q.attribution && <figcaption>{q.attribution}</figcaption>}
            </figure>
          </li>
        ))}
      </ul>
    )}
  </Band>
)}
