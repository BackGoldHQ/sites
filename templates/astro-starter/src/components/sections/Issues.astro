---
// Issues: a kicker, a heading, a lead paragraph, then one card per issue and
// the section's links. `variant` is the card style chosen in BackGold, kept
// as `data-variant` on the section for your CSS.
import type { Section } from '@backgold/content'
import Band from './Band.astro'
import Prose from '../Prose.astro'
import { links, rows } from '../../lib/section'
import { text } from '../../lib/format'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const heading = text(section.copy.heading)
const kicker = text(section.copy.kicker)
const issues = rows(section).filter((row) => text(row.title) || text(row.body))
const ctas = links(section)
---
<Band section={section} class="issues">
  {kicker && <p class="kicker">{kicker}</p>}
  {heading && <h2>{heading}</h2>}
  <Prose value={section.copy.lead} class="lede" />
  {issues.length > 0 && (
    <ul class="grid grid-3" role="list">
      {issues.map((issue) => (
        <li class="tile">
          {text(issue.title) && <h3>{text(issue.title)}</h3>}
          <Prose value={issue.body} />
        </li>
      ))}
    </ul>
  )}
  {ctas.length > 0 && (
    <p class="actions">
      {ctas.map((link, i) => <a class:list={['button', i > 0 && 'button-quiet']} href={link.href} rel={link.rel}>{link.label}</a>)}
    </p>
  )}
</Band>
