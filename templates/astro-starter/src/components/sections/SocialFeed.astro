---
// SocialFeed: BackGold's hosted pages load the feed live and the Content API
// does not carry its posts, so today this section renders nothing. Should
// rows arrive, it lists each post's text with a link to it. The site's
// social profiles are in the footer either way.
import type { Section } from '@backgold/content'
import Band from './Band.astro'
import { linkOf, rows } from '../../lib/section'
import { text } from '../../lib/format'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const heading = text(section.copy.heading)
const posts = rows(section)
  .map((row) => ({ body: text(row.text) ?? text(row.title), link: linkOf('View the post', row.url) }))
  .filter((p) => p.body)
---
{posts.length > 0 && (
  <Band section={section} class="feed">
    {heading && <h2>{heading}</h2>}
    <ul class="grid grid-3" role="list">
      {posts.map((p) => (
        <li class="tile">
          <p>{p.body}</p>
          {p.link && <p class="fine"><a href={p.link.href} rel={p.link.rel}>{p.link.label}</a></p>}
        </li>
      ))}
    </ul>
  </Band>
)}
