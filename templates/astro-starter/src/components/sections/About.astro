---
// About: a heading, the story, and a photo. `variant` is the side the photo
// sits on ('left' or 'right'); on a phone it sits above the words.
import type { Section } from '@backgold/content'
import Band from './Band.astro'
import Prose from '../Prose.astro'
import { media } from '../../lib/section'
import { text } from '../../lib/format'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const heading = text(section.copy.heading)
const photo = media(section, 'photoUrl')
---
<Band section={section} class:list={['about', photo && 'about-with-photo', section.variant === 'left' && 'about-photo-left']}>
  {photo && <img class="about-photo" src={photo.url} alt={photo.alt} loading="lazy" decoding="async" />}
  <div class="about-words">
    {heading && <h2>{heading}</h2>}
    <Prose value={section.copy.body} />
  </div>
</Band>
