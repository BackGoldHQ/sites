---
// Blog: the newest posts. The section carries no rows of its own, so it reads
// the newest entries of the blog types (posts, podcasts, videos: every
// built-in type with pages) and links to the full list at /blog.
import type { Entry, Section } from '@backgold/content'
import Band from './Band.astro'
import EntryCard from '../EntryCard.astro'
import { entryCard } from '../../lib/section'
import { text } from '../../lib/format'

interface Props {
  section: Section
  variant?: string
}

const SHOWN = 3

const { section } = Astro.props
const heading = text(section.copy.heading) ?? 'Latest'
const bg = Astro.locals.backgold
let entries: Entry[] = []
if (bg.setup === null) {
  const { types } = await bg.client.types()
  const blogTypes = types.filter((t) => t.built_in && t.routable)
  const lists = await Promise.all(blogTypes.map((t) => bg.client.entries(t.key, { limit: SHOWN })))
  entries = lists
    .flatMap((list) => list?.entries ?? [])
    .sort((a, b) => (b.publish_at ?? '').localeCompare(a.publish_at ?? ''))
    .slice(0, SHOWN)
}
---
<Band section={section} class="entries">
  <h2>{heading}</h2>
  {entries.length > 0 ? (
    <div class="grid grid-3">
      {entries.map((entry) => <EntryCard card={entryCard(entry)} level={3} />)}
    </div>
  ) : (
    <p class="empty">Nothing published yet.</p>
  )}
  {entries.length > 0 && <p class="more"><a href="/blog">All posts</a></p>}
</Band>
