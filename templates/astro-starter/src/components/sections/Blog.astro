---
// Blog: the newest posts. The section carries no rows of its own, so it reads
// the newest entries of the blog types (posts, podcasts, videos: the types
// /types lists together, `index: 'blog'`) and links to their full list at
// the organization's blog base (`/news`, or `/blog` on an organization that
// kept that address). A built-in with an address of its own, the
// newsletter, is not one.
import type { Entry, Section } from '@backgold/content'
import { blogBaseOf, isBlogType } from '@backgold/astro/server'
import Band from './Band.astro'
import EntryCard from '../EntryCard.astro'
import { entryCard } from '../../lib/section'
import { text } from '../../lib/format'

interface Props {
  section: Section
  variant?: string
}

const SHOWN = 3

const { section } = Astro.props
const heading = text(section.copy.heading) ?? 'Latest'
const bg = Astro.locals.backgold
let entries: Entry[] = []
let listPath: string | null = null
if (bg.setup === null) {
  const { types } = await bg.client.types()
  const base = blogBaseOf(types)
  listPath = base === null ? null : `/${encodeURIComponent(base)}`
  const lists = await Promise.all(types.filter(isBlogType).map((t) => bg.client.entries(t.key, { limit: SHOWN })))
  entries = lists
    .flatMap((list) => list?.entries ?? [])
    .sort((a, b) => (b.publish_at ?? '').localeCompare(a.publish_at ?? ''))
    .slice(0, SHOWN)
}
---
<Band section={section} class="entries">
  <h2>{heading}</h2>
  {entries.length > 0 ? (
    <div class="grid grid-3">
      {entries.map((entry) => <EntryCard card={entryCard(entry)} level={3} />)}
    </div>
  ) : (
    <p class="empty">Nothing published yet.</p>
  )}
  {entries.length > 0 && listPath && <p class="more"><a href={listPath}>All posts</a></p>}
</Band>
