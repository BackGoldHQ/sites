---
// ContentPost: one featured post, linked to its page on this site. The blog
// types live under the organization's blog base, so the link is
// /<blog base>/<slug> (`/news/<slug>`, or `/blog/<slug>` on an organization
// that kept that address).
import type { Section } from '@backgold/content'
import { blogBaseOf } from '@backgold/astro/server'
import Band from './Band.astro'
import { rows } from '../../lib/section'
import { formatDay, text } from '../../lib/format'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const heading = text(section.copy.heading)
const [row] = rows(section)
const title = text(row?.title)
const slug = text(row?.slug)
const bg = Astro.locals.backgold
const base = slug && /^[A-Za-z0-9][A-Za-z0-9_-]*$/.test(slug) && bg.setup === null ? blogBaseOf((await bg.client.types()).types) : null
const href = base ? `/${encodeURIComponent(base)}/${slug}` : null
const date = text(row?.date)
const day = formatDay(date)
---
{title && (
  <Band section={section} class="featured">
    {heading && <p class="kicker">{heading}</p>}
    <h2 class="featured-title">{href ? <a href={href}>{title}</a> : title}</h2>
    {day && date && <p class="fine"><time datetime={date}>{day}</time></p>}
  </Band>
)}
