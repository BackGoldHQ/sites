---
// An entry's page: its title, summary, byline and date, the hero image, a
// podcast's or video's media, the body, then the type's own fields. An entry
// kept for people the organization knows also says how to sign in (`door`).
import type { ContentTypeSummary, EntryDetail } from '@backgold/content'
import { relFor, renderMarkdown, safeSrc } from '@backgold/astro/server'
import FieldValue from './FieldValue.astro'
import { formatDay } from '../lib/format'

interface Props {
  entry: EntryDetail
  /** The entry's type from GET /types; without it the custom fields are left out. */
  type: ContentTypeSummary | undefined
  /** On a gated entry: where a signed-out visitor signs in, or who is signed in and where they sign out. */
  door?: { signIn: string } | { name: string; signOut: string } | null
}

const { entry, type, door } = Astro.props
const day = formatDay(entry.publish_at)
const hero = entry.hero ? safeSrc(entry.hero.url) : null
const media = safeSrc(entry.media_url)
// The address the type's entries live under, as /types reports it (the organization's blog base for post, podcast and video).
const base = type?.routable ? type.url_base : null

type EntryAuthor = EntryDetail['authors'][number]
const roles = new Map<string, EntryAuthor[]>()
for (const author of entry.authors) roles.set(author.role, [...(roles.get(author.role) ?? []), author])

const isEmpty = (value: unknown) =>
  value === null || value === undefined || (typeof value === 'string' && value.trim() === '') || (Array.isArray(value) && value.length === 0)
const fields = (type?.fields ?? []).filter((field) => !isEmpty(entry.fields?.[field.key]))
const body = entry.body?.markdown ? renderMarkdown(entry.body.markdown) : ''
---
<article class="entry">
  <header class="entry-header">
    {base && entry.terms.length > 0 && (
      <p class="kicker">
        {entry.terms.map((term, i) => (
          <>{i > 0 && ' · '}<a href={`/${encodeURIComponent(base)}/${encodeURIComponent(term.taxonomy)}/${encodeURIComponent(term.slug)}`}>{term.label}</a></>
        ))}
      </p>
    )}
    <h1>{entry.title}</h1>
    {entry.summary && <p class="lede">{entry.summary}</p>}
    {(roles.size > 0 || day) && (
      <p class="byline">
        {[...roles].map(([role, people], i) => (
          <>
            {i > 0 && ' · '}
            {role}{' '}
            {people.map((person, j) => (
              <>
                {j > 0 && (j === people.length - 1 ? ' and ' : ', ')}
                <a href={`/authors/${encodeURIComponent(person.slug)}`}>{person.display_name}</a>
              </>
            ))}
          </>
        ))}
        {roles.size > 0 && day && ' · '}
        {day && entry.publish_at && <time datetime={entry.publish_at}>{day}</time>}
      </p>
    )}
    {door && 'signIn' in door && <p class="byline"><a href={door.signIn}>Sign in with your email</a> to read this.</p>}
    {door && 'signOut' in door && <p class="byline">Signed in as {door.name}. <a href={door.signOut}>Sign out</a></p>}
  </header>
  {hero && <img class="entry-hero" src={hero} alt="" decoding="async" fetchpriority="high" />}
  {media && entry.type === 'podcast' && <audio class="entry-media" src={media} controls preload="none"></audio>}
  {media && entry.type === 'video' && <video class="entry-media" src={media} controls preload="none" playsinline></video>}
  {media && entry.type !== 'podcast' && entry.type !== 'video' && <p><a href={media} rel={relFor(media)}>Open the media file</a></p>}
  {body && <div class="prose entry-body" set:html={body} />}
  {fields.length > 0 && (
    <dl class="fields">
      {fields.map((field) => (
        <div class="field">
          <dt>{field.label}</dt>
          <dd><FieldValue field={field} value={entry.fields[field.key]} /></dd>
        </div>
      ))}
    </dl>
  )}
</article>
