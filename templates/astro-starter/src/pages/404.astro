---
// Astro's own 404 page, for anything the catch-all page does not answer.
// The catch-all renders the same NotFound content for an unknown address.
import Site from '../layouts/Site.astro'
import NotFound from '../components/NotFound.astro'

Astro.response.status = 404
const bg = Astro.locals.backgold
const siteName = bg.setup === null ? (bg.site.name ?? bg.site.domain) : ''
---
<Site title={`Page not found · ${siteName}`} canonicalPath={Astro.url.pathname} noindex>
  <NotFound />
</Site>
