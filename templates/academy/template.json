            "media": {},
            "links": []
          },
          {
            "id": "Cta-about",
            "type": "Cta",
            "band": "plain",
            "bleed": "full",
            "variant": "banner",
            "copy": {
              "heading": "Start with the first lesson.",
              "body": "Pick a course and press play. Lesson 1 is usually free."
            },
            "media": {},
            "links": [
              {
                "label": "See the courses",
                "target": {
                  "kind": "external",
                  "url": "/courses"
                },
                "url": "/courses"
              }
