---
// Pathways · doors on the academy (the Kindling brief §10.2, "Which one are
// you?"): the head (the kicker and the heading at the left, the line under
// them at the right), then the pathways as a ruled list, one to a row
// between hairlines: its number in the gold, its title in the display face
// with the line about who it is for under it, and its link at the right in
// the ember. A pathway whose address is a course's reads "Start with <the
// course's title>", the title from the Content API; one to the Apply page
// (`/join`) reads "Apply"; any other reads the section's link label, else
// "Start here". A pathway's outcome, programs and quiz statements are not
// drawn here (the quiz layout still offers them). The whole row is one
// link, named by its title; a pathway with no address is a row with no
// link. On a phone the link drops under the line.
import type { Section } from '@backgold/content'
import Band from '@backgold/template-kit/components/sections/Band.astro'
import Prose from '@backgold/template-kit/components/Prose.astro'
import { pathwaysOf } from '@backgold/template-kit/components/sections/Pathways/pathways.ts'
import { JOIN_PATH } from '@backgold/template-kit/lib/academy'
import { text } from '@backgold/template-kit/lib/format'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const bg = Astro.locals.backgold
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
const label = text(section.copy.programsLabel) ?? 'Start here'
const pathways = pathwaysOf(section)
const linksCourse = pathways.some((p) => p.link?.href.startsWith('/'))
const courses = linksCourse && bg.setup === null ? ((await bg.client.courses({ limit: 50 }).catch(() => null))?.courses ?? []) : []
const pathOf = (href: string) => href.replace(/[?#].*$/, '').replace(/\/+$/, '')
const titleAt = new Map(courses.map((c) => [pathOf(c.url), c.title]))
const doors = pathways.map((p) => {
  const at = p.link ? pathOf(p.link.href) : null
  const course = at ? titleAt.get(at) : undefined
  return { ...p, more: at === null ? null : course ? `Start with ${course}` : at === JOIN_PATH ? 'Apply' : label }
})
---
{(doors.length > 0 || heading) && (
  <Band section={section} class="pathways pathways-doors ak-paths-band">
    {(kicker || heading || text(section.copy.body)) && (
      <div class="ak-head">
        <div class="ak-head-title">
          {kicker && <p class="kicker">{kicker}</p>}
          {heading && <h2>{heading}</h2>}
        </div>
        <div class="ak-head-aside"><Prose value={section.copy.body} class="lede" /></div>
      </div>
    )}
    {doors.length > 0 && (
      <ol class="ak-paths" role="list">
        {doors.map((door, i) => (
          <li class:list={['ak-path', door.link && 'ak-path-linked']}>
            <span class="ak-path-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="ak-path-words">
              <h3 class="ak-path-title">{door.link ? <a href={door.link.href} rel={door.link.rel}>{door.title}</a> : door.title}</h3>
              {door.summary && <p class="ak-path-line">{door.summary}</p>}
            </div>
            {door.more && <p class="ak-path-more">{door.more}<span aria-hidden="true">{'\u00a0→'}</span></p>}
          </li>
        ))}
      </ol>
    )}
  </Band>
)}
