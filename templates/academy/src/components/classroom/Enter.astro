---
// The classroom's two entrances (src/styles/classroom.css, its motion block):
// a ring inside an element marked `data-kc-enter` draws its arc in from 0,
// and a numeral marked `data-kc-enter` rises once. The stylesheet plays both
// on the first paint, so what is on screen when the page opens moves then.
// From the visitor's first scroll this script holds back what is still
// below the fold (`data-kc-wait`, the start of each entrance, with no
// animation) and lets each go, once, as the scroll brings its top above the
// window's last twelfth; a jump past one lets it go too, so nothing the
// visitor has scrolled to stays held. Before that first scroll nothing is
// held, so a page read without scrolling (a screenshot of the whole page
// among them) is the finished page. Under prefers-reduced-motion: reduce the
// stylesheet plays nothing and this script holds nothing back. Every
// component that draws a ring or a numeral includes this file; Astro sends
// the script once.
---
<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const arm = () => {
      const held = new Set([...document.querySelectorAll<HTMLElement>('[data-kc-enter]')].filter((el) => el.getBoundingClientRect().top > window.innerHeight))
      for (const el of held) el.setAttribute('data-kc-wait', '')
      let queued = false
      const sweep = () => {
        queued = false
        const line = window.innerHeight * 0.92
        for (const el of held) {
          if (el.getBoundingClientRect().top >= line) continue
          el.removeAttribute('data-kc-wait')
          held.delete(el)
        }
        if (held.size === 0) window.removeEventListener('scroll', onScroll)
      }
      const onScroll = () => {
        if (queued) return
        queued = true
        requestAnimationFrame(sweep)
      }
      window.addEventListener('scroll', onScroll, { passive: true })
      onScroll()
    }
    window.addEventListener('scroll', arm, { once: true, passive: true })
  }
</script>
