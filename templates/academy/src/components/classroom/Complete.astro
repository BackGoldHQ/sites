---
// A lesson's completion for a visitor (board L3), on a raised bar: Mark
// complete, a real form posting to the site's progress path and coming back
// to the lesson, beside "Picks up at 1:12, where you stopped." and "Or watch
// to the end and the Academy marks it for you." (left off a Vimeo lesson,
// whose player says nothing back); once done, Completed and Mark as not
// done. The lesson's script (the kit's Tracker) sends both through fetch
// and shows one form or the other.
import { VISITOR_PROGRESS_PATH } from '@backgold/contract/content-api'
import Icon from '@backgold/template-kit/components/sections/Course/Icon.astro'
import type { LessonView } from '@backgold/template-kit/components/sections/Lesson/lesson.ts'
import { clockOf } from '@backgold/template-kit/lib/academy'

interface Props {
  view: LessonView
}

const { view } = Astro.props
const resume = view.resumeAt !== null ? clockOf(view.resumeAt) : null
const marksAtEnd = view.video?.kind === 'file' || (view.video?.kind === 'embed' && view.video.provider === 'youtube')
---
<div class="ls-complete kc-complete">
  <form method="post" action={VISITOR_PROGRESS_PATH} data-complete="true" hidden={view.completed}>
    <input type="hidden" name="course" value={view.courseSlug} />
    <input type="hidden" name="lesson" value={view.slug} />
    <input type="hidden" name="completed" value="true" />
    <input type="hidden" name="return" value={view.path} />
    <button class="button" type="submit"><Icon name="check" /> Mark complete</button>
    {(resume || marksAtEnd) && (
      <div class="kc-complete-words">
        {resume && <p class="kc-complete-resume">Picks up at {resume}, where you stopped.</p>}
        {marksAtEnd && <p class="fine">Or watch to the end and the Academy marks it for you.</p>}
      </div>
    )}
  </form>
  <form method="post" action={VISITOR_PROGRESS_PATH} data-complete="false" hidden={!view.completed}>
    <input type="hidden" name="course" value={view.courseSlug} />
    <input type="hidden" name="lesson" value={view.slug} />
    <input type="hidden" name="completed" value="false" />
    <input type="hidden" name="return" value={view.path} />
    <p class="kc-completed"><Icon name="check" /> Completed</p>
    <button class="button button-quiet button-small" type="submit">Mark as not done</button>
  </form>
</div>
