---
// About · Books (board K5, for an instructor and what they wrote): the
// person's photo at the left, square, with the ember line along its foot,
// and their words at the right (the kicker, their name as the heading, their
// role in gold, the story and the section's one button). Under them, past a
// hairline, the books two across: each cover (2:3) in an ember rule offset
// down and to the left, its title in the display face and its line beside
// it, the year and "Get the book" when the row has them. Every cover stands
// over one set in type (the title over its subtitle, the part after a colon,
// in italic, and the author, the section's heading, at the foot), which
// shows where there is no cover or the cover does not load (the script
// takes a failed one away): never an empty box. On a phone the photo sits
// over the words and the books run one under the other. With no words and
// no photo the books take the band alone; with nothing, nothing is drawn.
import type { Section } from '@backgold/content'
import Band from '@backgold/template-kit/components/sections/Band.astro'
import Prose from '@backgold/template-kit/components/Prose.astro'
import { buttonOf, credentialsOf } from '@backgold/template-kit/components/sections/About/credentials.ts'
import { prose, text } from '@backgold/template-kit/lib/format'
import { media } from '@backgold/template-kit/lib/section'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
const role = text(section.copy.role)
const button = buttonOf(section)
const photo = media(section, 'photoUrl')
const { books } = credentialsOf(section)
const words = !!(kicker || heading || role || prose(section.copy.body) || button)
const Book = words ? 'h3' : 'h2'
/** "Libertarian Leadership: Planting the Seed" as its title and its subtitle. */
const partsOf = (title: string): [string, string | null] => {
  const at = title.indexOf(': ')
  return at > 0 ? [title.slice(0, at), title.slice(at + 2)] : [title, null]
}
---
{(words || photo || books.length > 0) && (
  <Band section={section} class="about about-books kc-books">
    {(words || photo) && (
      <div class:list={['kc-books-top', photo && words && 'kc-books-top-photo']}>
        {photo && (
          <div class="kc-books-photo">
            <img src={photo.url} alt={photo.alt} loading="lazy" decoding="async" />
          </div>
        )}
        {words && (
          <div class="kc-books-words">
            {kicker && <p class="kicker">{kicker}</p>}
            {heading && <h2 class="kc-books-name">{heading}</h2>}
            {role && <p class="kc-books-role">{role}</p>}
            <Prose value={section.copy.body} class="kc-books-body" />
            {button && (
              <p class="actions">
                <a class="button" href={button.href} rel={button.rel}>{button.label}</a>
              </p>
            )}
          </div>
        )}
      </div>
    )}
    {books.length > 0 && (
      <ul class:list={['kc-shelf', (words || photo) && 'kc-shelf-under']} role="list">
        {books.map((book, i) => {
          const [main, rest] = partsOf(book.title)
          return (
            <li class="kc-book">
              <div class="kc-book-frame">
                <div class:list={['kc-book-cover', 'kc-book-set', i % 2 === 0 ? 'kc-book-set-hearth' : 'kc-book-set-smoke']} aria-hidden="true">
                  <span>
                    <span class="kc-book-set-title">{main}</span>
                    {rest && <span class="kc-book-set-sub">{rest}</span>}
                  </span>
                  {heading && <span class="kc-book-set-author">{heading}</span>}
                </div>
                {book.cover && <img class="kc-book-cover kc-book-photo" src={book.cover} alt="" loading="lazy" decoding="async" />}
              </div>
              <div class="kc-book-words">
                <Book class="kc-book-title">{book.title}</Book>
                {book.detail && <p class="kc-book-detail">{book.detail}</p>}
                {book.year && <p class="kc-book-meta">{book.datetime ? <time datetime={book.datetime}>{book.year}</time> : book.year}</p>}
                {book.link && (
                  <p class="kc-book-get">
                    <a href={book.link.href} rel={book.link.rel}>Get the book<span class="visually-hidden">: {book.title}</span><span aria-hidden="true"> →</span></a>
                  </p>
                )}
              </div>
            </li>
          )
        })}
      </ul>
    )}
  </Band>
)}

<script>
  // A cover that does not load leaves the one set in type under it.
  for (const img of document.querySelectorAll<HTMLImageElement>('.kc-book-photo')) {
    if (img.complete && img.naturalWidth === 0) img.remove()
    else img.addEventListener('error', () => img.remove(), { once: true })
  }
</script>
