---
// MovementTicker, the petition drive's "Neighbors signing on" card: the
// heading as a live label (a dot beside it in the mono face), then the live
// feed BackGold frames when the api sends one (the people signing, giving
// and RSVPing, with its count), else the figures the organization wrote for
// it, each a large mono numeral over its label. A figure BackGold fills in
// live is left out of that list (literalStat), and a ticker with neither a
// frame nor a typed figure draws nothing, as the kit's does. The dot pulses
// only for a visitor who has not asked for reduced motion.
import type { Section } from '@backgold/content'
import Band from '@backgold/template-kit/components/sections/Band.astro'
import ModuleFrame from '@backgold/template-kit/components/sections/modules/ModuleFrame.astro'
import { rows } from '@backgold/template-kit/lib/section'
import { literalStat, text } from '@backgold/template-kit/lib/format'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const heading = text(section.copy.heading)
const framed = !!section.embed
const stats = framed
  ? []
  : rows(section)
      .map((row) => ({ value: literalStat(row.value), label: text(row.label) }))
      .filter((stat) => stat.value !== null)
---
{(framed || stats.length > 0) && (
  <Band section={section} class="ticker drive-ticker">
    {heading && (
      <h2 class="drive-ticker-label">
        <span class="drive-ticker-dot" aria-hidden="true"></span>
        {heading}
      </h2>
    )}
    {framed && (
      <ModuleFrame embed={section.embed} band={section.band} type={section.type} layout="ticker" title={heading || 'Activity'} height="28rem" />
    )}
    {stats.length > 0 && (
      <ul class="drive-ticker-figures" role="list">
        {stats.map((stat) => (
          <li>
            <p class="drive-ticker-value">{stat.value}</p>
            {stat.label && <p class="drive-ticker-name">{stat.label}</p>}
          </li>
        ))}
      </ul>
    )}
  </Band>
)}

<style>
  .drive-ticker-label {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0 0 1.25rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .drive-ticker-dot {
    flex: 0 0 auto;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .drive-ticker-dot {
      animation: drive-ticker-pulse 2.4s ease-in-out infinite;
    }
  }
  @keyframes drive-ticker-pulse {
    50% {
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 8%, transparent);
    }
  }
  .drive-ticker-figures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 1rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .drive-ticker-figures li {
    min-width: 0;
    padding-top: 0.875rem;
    border-top: 1px solid var(--line);
  }
  .drive-ticker-figures p {
    margin: 0;
  }
  .drive-ticker-value {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: clamp(2rem, 1.6rem + 1.4vw, 2.75rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .drive-ticker-name {
    margin-top: 0.375rem !important;
    color: var(--muted);
    font-size: var(--text-sm);
  }
</style>
