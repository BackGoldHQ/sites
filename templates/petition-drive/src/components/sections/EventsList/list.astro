---
// EventsList · List, the petition drive's "Show up in person": the heading,
// then one row per event (the hosted petition-drive page's event rows): its
// date as a block (the month and weekday in the mono face around the day's
// numeral), its type as a chip, the title, the time and the place, its live
// counts ("12 going", filled in by the kit's LiveCounts after the page
// loads; empty without scripts), and at the right its button to the event's
// page on this site, which frames BackGold's RSVP and tickets ("RSVP", "Get
// tickets", or "Details" once registration has closed) with a quiet
// "Details" beside an RSVP. `options.actions` 'link' (or none) makes the
// title the link and draws no button. Under the time and place, a quiet
// "Add to calendar" link to the event's calendar file. With no events listed
// the section places BackGold's own events-list frame when it sends one, else
// says nothing is on the calendar, in the section's own words when it has
// them.
import type { Section } from '@backgold/content'
import { Embed } from '@backgold/astro/components'
import Band from '@backgold/template-kit/components/sections/Band.astro'
import LiveCounts from '@backgold/template-kit/components/sections/EventsList/LiveCounts.astro'
import { actionsOf, eventsOf } from '@backgold/template-kit/components/sections/EventsList/events.ts'
import { text } from '@backgold/template-kit/lib/format'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const heading = text(section.copy.heading)
const kicker = text(section.copy.kicker)
const empty = text(section.copy.eventsEmptyCta) ?? 'No upcoming events right now.'
const buttons = actionsOf(section) === 'buttons'
const events = eventsOf(section)
---
<Band section={section} class="events drive-events">
  {kicker && <p class="kicker">{kicker}</p>}
  {heading && <h2>{heading}</h2>}
  {events.length > 0 && (
    <ul class="drive-event-list" role="list">
      {events.map((event) => (
        <li class="drive-event">
          {event.when && event.startsAt ? (
            <time class="drive-event-date" datetime={event.startsAt}>
              <span class="drive-event-month" aria-hidden="true">{event.when.monthShort}</span>
              <span class="drive-event-day" aria-hidden="true">{event.when.day}</span>
              {event.when.weekday && <span class="drive-event-weekday" aria-hidden="true">{event.when.weekday}</span>}
              <span class="visually-hidden">{event.when.full}</span>
            </time>
          ) : (
            <span class="drive-event-date" aria-hidden="true"></span>
          )}
          <div class="drive-event-words">
            {event.type && <p class="drive-event-type"><span class="chip chip-accent">{event.type}</span></p>}
            <h3>{event.link && !buttons ? <a href={event.link.href} rel={event.link.rel}>{event.title}</a> : event.title}</h3>
            {(event.when?.time || event.place) && <p class="drive-event-meta">{[event.when?.time, event.place].filter(Boolean).join(' · ')}</p>}
            {event.id && <p class="drive-event-live" data-bg-live={event.id}></p>}
            {event.calendar && (
              <p class="drive-event-calendar">
                <a href={event.calendar.href} rel={event.calendar.rel}>{event.calendar.label}<span class="visually-hidden">: {event.title}</span></a>
              </p>
            )}
          </div>
          {buttons && event.action && (
            <p class="drive-event-actions">
              <a class="button button-small" href={event.action.href} rel={event.action.rel}>{event.action.label}<span class="visually-hidden">: {event.title}</span></a>
              {event.action.label !== 'Details' && event.link && (
                <a class="button button-small button-quiet" href={event.link.href} rel={event.link.rel}>Details<span class="visually-hidden">: {event.title}</span></a>
              )}
            </p>
          )}
        </li>
      ))}
    </ul>
  )}
  {events.length > 0 && <LiveCounts />}
  {events.length === 0 && section.embed && <Embed embed={section.embed} title={heading ?? 'Upcoming events'} />}
  {events.length === 0 && !section.embed && <p class="drive-events-empty">{empty}</p>}
</Band>

<style>
  .drive-event-list {
    display: grid;
    gap: 0.75rem;
    list-style: none;
    margin: clamp(1.25rem, 1rem + 1vw, 1.75rem) 0 0;
    padding: 0;
  }
  .drive-event {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: 0.875rem 1.125rem;
    align-items: center;
    padding: 1rem 1.125rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
  }
  .drive-event p {
    margin: 0;
  }
  .drive-event-date {
    display: grid;
    justify-items: center;
    align-self: start;
    padding-right: 1.125rem;
    border-right: 1px solid var(--line);
    line-height: 1;
  }
  .drive-event-month,
  .drive-event-weekday {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .drive-event-month {
    color: var(--accent);
  }
  .drive-event-day {
    margin: 0.25rem 0;
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .drive-event-weekday {
    color: var(--muted);
  }
  .drive-event-type {
    margin-bottom: 0.375rem !important;
  }
  .drive-event-type .chip {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .drive-event h3 {
    margin: 0;
    font-family: var(--font);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0;
  }
  .drive-event h3 a {
    color: inherit;
    text-decoration: none;
  }
  .drive-event h3 a:hover {
    text-decoration: underline;
  }
  .drive-event-meta,
  .drive-event-live:not(:empty),
  .drive-event-calendar {
    margin-top: 0.25rem !important;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .drive-event-calendar a {
    color: var(--muted);
  }
  .drive-event-actions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  @media (min-width: 40rem) {
    .drive-event {
      grid-template-columns: 3.25rem minmax(0, 1fr) auto;
    }
    .drive-event-actions {
      grid-column: auto;
      justify-content: flex-end;
    }
  }
  .drive-events-empty {
    margin: 1rem 0 0;
    padding: 1rem 1.125rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-card);
    color: var(--muted);
  }
</style>
