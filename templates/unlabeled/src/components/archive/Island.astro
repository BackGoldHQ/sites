---
// The archive's one script (board U2, frame 3): it loads /archive/index.json
// (the same documents the server searches, any format of it: a document
// without request facts draws as before), answers each keystroke in the
// search field without a round trip, shows the best few with the query's
// parse (what it was read as, the same answer's other spellings, where it
// matched), and writes the URL as it goes. The field is a combobox over the
// list of options; a status line says how many records match. Enter, or "All results", opens the
// server's results page; with scripts off the form does exactly that.
---
<script>
  import { createSearcher, hrefOf, paramsOf, type SearchDoc } from '../../lib/archive/search'
  import { matchedLine, parseChips, sameAnswerLines } from '../../lib/archive/query'
  import { requestMeta } from '../../lib/archive/record'
  import { kindOf } from '../../lib/archive/kinds'

  const SHOWN = 6
  const form = document.querySelector<HTMLFormElement>('[data-ar-search]')
  const input = form?.querySelector<HTMLInputElement>('[data-ar-input]')
  const live = form?.querySelector<HTMLElement>('[data-ar-live]')
  const status = form?.querySelector<HTMLElement>('[data-ar-status]')

  const text = (tag: string, value: string, className?: string) => {
    const el = document.createElement(tag)
    el.textContent = value
    if (className) el.className = className
    return el
  }

  if (form && input && live) {
    let searcher: ReturnType<typeof createSearcher> | null = null
    let loading: Promise<void> | null = null
    let selected = -1
    const load = () =>
      (loading ??= fetch('/archive/index.json', { headers: { Accept: 'application/json' } })
        .then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
        .then((body: { format?: number; docs: SearchDoc[] }) => {
          // An index written before request facts (format 2) has none: its requests draw as other records.
          searcher = createSearcher(body.docs.map((doc) => ({ ...doc, request: doc.request ?? null })))
        })
        .catch(() => {
          // The form still works without the island.
          loading = null
        }))

    const close = () => {
      live.hidden = true
      live.replaceChildren()
      selected = -1
      input.setAttribute('aria-expanded', 'false')
      input.removeAttribute('aria-activedescendant')
    }

    // What the query matched in the live rows, in her invert (the CSS Custom
    // Highlight API, ::highlight(u-match) in template.css): each plain word
    // of the query, case aside; operators (ch(…), pay:…, $…) and quotes are
    // left out. Without the API the rows are as they were.
    const mark = (root: HTMLElement, q: string) => {
      const registry = (CSS as unknown as { highlights?: Map<string, unknown> }).highlights
      const HighlightOf = (window as unknown as { Highlight?: new (...ranges: Range[]) => unknown }).Highlight
      if (!registry || !HighlightOf) return
      const terms = q
        .replace(/"/g, ' ')
        .split(/\s+/)
        .filter((t) => t.length > 1 && !/[:($]/.test(t))
        .map((t) => t.toLowerCase())
      const ranges: Range[] = []
      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT)
      for (let node = walker.nextNode(); node; node = walker.nextNode()) {
        const lower = (node.textContent ?? '').toLowerCase()
        for (const term of terms) {
          for (let at = lower.indexOf(term); at >= 0; at = lower.indexOf(term, at + term.length)) {
            const range = new Range()
            range.setStart(node, at)
            range.setEnd(node, at + term.length)
            ranges.push(range)
          }
        }
      }
      registry.set('u-match', new HighlightOf(...ranges))
    }

    const render = () => {
      if (!searcher) return
      const q = input.value.trim()
      const params = { ...paramsOf(new URLSearchParams(location.search)), q, page: 1 }
      history.replaceState(null, '', hrefOf(params))
      if (!q) return close()
      const result = searcher.run(params)
      const list = document.createElement('ul')
      list.setAttribute('role', 'listbox')
      list.id = 'ar-live-list'
      result.hits
        .slice()
        .sort((a, b) => b.score - a.score)
        .slice(0, SHOWN)
        .forEach((hit, i) => {
          const li = document.createElement('li')
          li.id = `ar-live-${i}`
          li.setAttribute('role', 'option')
          li.setAttribute('aria-selected', 'false')
          const a = document.createElement('a')
          a.href = hit.doc.url
          a.tabIndex = -1
          const meta = hit.doc.request ? [kindOf(hit.doc.kind).singular, ...requestMeta(hit.doc.request)] : [hit.doc.mark, hit.doc.category, hit.doc.date]
          a.append(text('span', meta.filter(Boolean).join(' · '), 'ar-meta'), document.createElement('br'), text('strong', hit.doc.title))
          if (hit.context) {
            const p = document.createElement('span')
            p.className = 'ar-muted'
            p.append(document.createElement('br'), hit.context.before, text('mark', hit.context.hit), hit.context.after)
            a.append(p)
          }
          li.append(a)
          li.style.setProperty('--n', String(i))
          list.append(li)
        })
      const footer = document.createElement('footer')
      const all = document.createElement('a')
      all.href = hrefOf(params)
      all.textContent = result.total === 0 ? `No records for ‘${q}’ · see what is close →` : `All ${result.total} results →`
      footer.append(text('span', '↑ ↓ move · ↵ open · esc close', 'ar-meta'), all)
      const matched = result.total > 0 ? matchedLine(searcher.matching(params), result.parsed) : null
      const chips = [...parseChips(result.parsed), ...sameAnswerLines(result.parsed), ...(matched ? [matched] : [])]
      const parse = document.createElement('p')
      parse.className = 'ar-chips ar-parse'
      parse.style.padding = '0 0.875rem 0.5rem'
      for (const c of chips) parse.append(text('span', c, 'ar-chip ar-chip-parse'))
      live.replaceChildren(list, ...(chips.length ? [parse] : []), footer)
      mark(list, q)
      live.hidden = false
      selected = -1
      input.setAttribute('aria-expanded', 'true')
      input.removeAttribute('aria-activedescendant')
      if (status) status.textContent = result.total === 0 ? `No records for ${q}` : `${result.total} ${result.total === 1 ? 'record' : 'records'}; up and down arrows move through the first ${Math.min(SHOWN, result.total)}`
    }

    let timer: ReturnType<typeof setTimeout> | undefined
    input.addEventListener('focus', () => void load())
    input.addEventListener('input', () => {
      clearTimeout(timer)
      timer = setTimeout(() => void load().then(render), 60)
    })
    input.addEventListener('keydown', (event) => {
      const options = [...live.querySelectorAll<HTMLElement>('[role="option"]')]
      if (event.key === 'Escape') return close()
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp' && event.key !== 'Enter') return
      if (event.key === 'Enter') {
        if (selected >= 0 && options[selected]) {
          event.preventDefault()
          location.href = options[selected].querySelector('a')!.href
        }
        return
      }
      if (options.length === 0) return
      event.preventDefault()
      selected = (selected + (event.key === 'ArrowDown' ? 1 : -1) + options.length) % options.length
      options.forEach((o, i) => o.setAttribute('aria-selected', String(i === selected)))
      input.setAttribute('aria-activedescendant', options[selected]!.id)
    })
    document.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement | null
      if (event.key !== '/' || target?.closest('input, textarea, select, [contenteditable]')) return
      event.preventDefault()
      input.focus()
    })
    document.addEventListener('click', (event) => {
      if (!form.contains(event.target as Node)) close()
    })
  }
</script>
