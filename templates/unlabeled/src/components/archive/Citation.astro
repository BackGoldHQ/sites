---
// A record's source citation, set as a citation (board U3): monospace,
// boxed, selected whole on a click so it copies, the record's links beside
// it, and the archive's mark as a watermark behind it.
import type { ArchiveLink } from '../../lib/archive/record'

interface Props {
  lines: string[]
  links?: ArchiveLink[]
  heading?: string
}

const { lines, links = [], heading = '// Source citation · as the archive gives it' } = Astro.props
---
{(lines.length > 0 || links.length > 0) && (
  <section class="ar-cite" aria-label="Source citation">
    <span class="ar-watermark" aria-hidden="true">UNLABELED</span>
    <p class="ar-meta">{heading}</p>
    {lines.length > 0 ? <pre>{lines.join('\n')}</pre> : <p class="ar-faint" style="margin-top:0.5rem">The archive gives no citation for this record.</p>}
    <slot />
    {links.length > 0 && (
      <p class="ar-row-links" style="margin-top:0.75rem;position:relative">
        {links.map((l) => <a href={l.href} rel={l.external ? 'noopener' : undefined}>{l.label}{l.external ? ' ↗' : ''}</a>)}
      </p>
    )}
  </section>
)}
