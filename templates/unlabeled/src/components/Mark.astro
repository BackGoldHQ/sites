---
// Her mark, for markup that places it itself, as the archive's pages and
// `.u-chapter` do: `wordmark` is her own file (UNLA·skull·ELED,
// src/assets/wordmark.png, white on a clear ground) as an image; `skull` (the
// skull and horns alone: the chapter mark, the watermark) and `horns` (drawn
// out to a rule: the divider) are traced parts of it, inline SVG in the
// current text colour. The header, the footer and the bands draw the same
// files as CSS masks (src/styles/template.css). Each inline copy gets its own
// mask ids, so a page can hold several. With a `label` it is an image named
// for screen readers; without one it is decoration.
import horns from '../assets/horns.svg?raw'
import skull from '../assets/skull.svg?raw'
import wordmark from '../assets/wordmark.png'

interface Props {
  kind?: 'wordmark' | 'skull' | 'horns'
  label?: string
  class?: string
}

const { kind = 'wordmark', label, class: className } = Astro.props
const classes = `u-mark u-mark-${kind}${className ? ` ${className}` : ''}`
const SOURCES = { skull, horns } as const
let svg: string | null = null
if (kind !== 'wordmark') {
  let copies = (Astro.locals as { unlabeledMarks?: number }).unlabeledMarks ?? 0
  copies += 1
  ;(Astro.locals as { unlabeledMarks?: number }).unlabeledMarks = copies
  const suffix = `-${copies}`
  svg = SOURCES[kind]
    .replace(/<!--[\s\S]*?-->\s*/g, '')
    .replace(/u-cut-(around|head)/g, (id) => `${id}${suffix}`)
    .replace('<svg ', `<svg class="${classes}" ${label ? `role="img" aria-label="${label.replace(/[&<>"]/g, '')}"` : 'aria-hidden="true"'} focusable="false" `)
}
---
{svg ? <Fragment set:html={svg} /> : <img class={classes} src={wordmark.src} width={wordmark.width} height={wordmark.height} alt={label ?? ''} decoding="async" />}
