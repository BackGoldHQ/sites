---
// Her mark, for markup that places it itself, as the archive's door, the
// chapter mark and the 404 do: `wordmark` (UNLA·skull·ELED,
// src/assets/wordmark.png) or `skull` (the skull and horns alone,
// src/assets/skull.png), each cut from her own file, white on a clear ground.
// The header, the footer, the divider and the watermark draw the same files
// as CSS masks (src/styles/template.css). With a `label` it is an image named
// for screen readers; without one it is decoration.
import skull from '../assets/skull.png'
import wordmark from '../assets/wordmark.png'

interface Props {
  kind?: 'wordmark' | 'skull'
  label?: string
  class?: string
}

const { kind = 'wordmark', label, class: className } = Astro.props
const image = kind === 'skull' ? skull : wordmark
---
<img class:list={['u-mark', `u-mark-${kind}`, className]} src={image.src} width={image.width} height={image.height} alt={label ?? ''} decoding="async" />
