---
// A board decision at /decisions/<slug> (board U3, frame 1): beside each
// other, the head (meta line, title huge, the summary as the archive wrote
// it and the entry's full text) over the fact table
// (presenter, seconder, the vote as filed and, only from a "Yeas:" list,
// the tally), and the citation boxed with Share under it; then the
// diagram, the Context band (its meeting with this decision marked, its
// category on a line, its campuses, the same agenda item filed twice under
// another category (same agenda_item, or the same title, at its meeting)
// apart from the other near-same entries at its meeting, the buckets whose
// basis names it) and the neighbours in its category.
import type { EntryLayoutProps } from '@backgold/template-kit/components/entries/props.ts'
import ArchiveFrame from '../archive/ArchiveFrame.astro'
import EntryHead from '../archive/EntryHead.astro'
import Citation from '../archive/Citation.astro'
import Diagram from '../archive/Diagram.astro'
import Timeline from '../archive/Timeline.astro'
import Share from '../archive/Share.astro'
import RunningHead from '../archive/RunningHead.astro'
import '../archive/money.css'
import { archiveFor } from '../../lib/archive/index'
import { bucketsCiting, filedTwice, neighbours, tallyOf } from '../../lib/archive/views'
import { list, str } from '../../lib/archive/record'
import { longDay, plural, shortDay } from '../../lib/archive/format'
import { formatUsd } from '../../lib/archive/query'
import { hrefOf, REST } from '../../lib/archive/search'

type Props = EntryLayoutProps

const { entry, type } = Astro.props
const base = type?.url_base ?? 'decisions'
const { data, doc } = await archiveFor(Astro.locals, 'board_decision', entry, base)
const docs = data?.docs ?? [doc]
const f = doc.fields
const meeting = docs.find((d) => d.kind === 'board_meeting' && d.slug === doc.meeting) ?? null
const atMeeting = docs.filter((d) => d.kind === 'board_decision' && d.meeting === doc.meeting).sort((a, b) => (a.mark ?? '').localeCompare(b.mark ?? ''))
// Nine of its meeting's decisions, this one among them.
const here = atMeeting.findIndex((d) => d.id === doc.id)
const from = Math.max(0, Math.min(here - 4, atMeeting.length - 9))
const meetingWindow = atMeeting.slice(from, from + 9)
const inCategory = docs.filter((d) => d.kind === 'board_decision' && d.category === doc.category)
const { previous, next, index, count } = neighbours(docs, doc)
const agendaItem = str(f.agenda_item)
const titleKey = (title: string) => title.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim()
/** The same agenda item at its meeting, filed under another category: the same agenda_item, or the same title. */
const sameItem = docs.filter((d) => d.kind === 'board_decision' && d.id !== doc.id && d.meeting !== null && d.meeting === doc.meeting && d.category !== doc.category && ((agendaItem !== null && str(d.fields.agenda_item) === agendaItem) || titleKey(d.title) === titleKey(doc.title)))
const twice = filedTwice(doc, docs).filter((d) => !sameItem.includes(d))
const filedUnder = [...new Set([doc.category, ...sameItem.map((d) => d.category)].filter((c): c is string => c !== null))]
const underList = filedUnder.length > 2 ? `${filedUnder.slice(0, -1).map((c) => `under ${c}`).join(', ')} and under ${filedUnder.at(-1)}` : filedUnder.map((c) => `under ${c}`).join(' and ')
const buckets = bucketsCiting(doc, docs)
const tally = tallyOf(doc.voteDetail)
const sources = list(f.source_documents).map((slug) => docs.find((d) => d.kind === 'source_document' && d.slug === slug) ?? { slug, title: slug, url: `/sources/${encodeURIComponent(slug)}` })
const originalTitle = str(f.original_title)
const amounts = list(f.amounts)
const campusCounts = doc.campuses.map((c) => ({ campus: c, count: docs.filter((d) => d.id !== doc.id && d.campuses.includes(c)).length }))
const day = shortDay(doc.date)
---
<ArchiveFrame crumbs={[{ label: type?.plural_label ?? 'Decisions', href: `/${base}` }, ...(doc.category ? [{ label: doc.category, href: hrefOf(REST, { kind: 'board_decision', category: doc.category }) }] : []), { label: doc.mark ?? entry.title }]}>
  <div class="ar-record">
    <div>
      <EntryHead
        label={`Decision ${doc.mark ?? ''}`.trim()}
        path={`/${base}/${doc.slug}`}
        place={index >= 0 && doc.category ? `${doc.category} · ${index + 1} of ${count}` : ''}
        kind={type?.singular_label ?? 'Board decision'}
        meta={[doc.category, day?.toUpperCase(), doc.meeting && `Meeting ${doc.meeting}`, ...doc.campuses]}
        title={entry.title}
        summary={entry.summary}
        markdown={entry.body?.markdown}
      />
      <dl class="ar-facts">
        <div><dt>Presenter</dt><dd>{doc.presenter ?? <span class="ar-faint">Not named in the archive</span>}</dd></div>
        {doc.seconder && <div><dt>Seconder</dt><dd>{doc.seconder}</dd></div>}
        <div>
          <dt>Vote · {doc.vote ?? 'Not specified'}</dt>
          <dd>
            {doc.voteDetail ?? (doc.vote === 'Not specified' || !doc.vote ? <span class="ar-faint">The archive records no vote for this item.</span> : doc.vote)}
            {tally && (
              <>
                <ul class="ar-tally" aria-label="Yeas">{tally.yeas.map((n) => <li>{n}</li>)}</ul>
                <p class="ar-meta" style="margin-top:0.375rem">Nays · {tally.nays} · Abstain · {tally.abstain}</p>
              </>
            )}
          </dd>
        </div>
        <div><dt>Decided on</dt><dd>{longDay(doc.date) ?? '—'}</dd></div>
        {meeting && <div><dt>Meeting</dt><dd><a href={meeting.url}>{[str(meeting.fields.meeting_kind), shortDay(meeting.date), str(meeting.fields.meeting_time)].filter(Boolean).join(' · ')} →</a></dd></div>}
        {str(f.agenda_item) && <div><dt>Agenda item</dt><dd>{str(f.agenda_item)}</dd></div>}
        {doc.campuses.length > 0 && <div><dt>Campus</dt><dd class="ar-chips" style="margin-top:0.25rem">{doc.campuses.map((c) => <a class="ar-chip" href={hrefOf(REST, { category: c })}>{c}</a>)}</dd></div>}
        {amounts.length > 0 && <div><dt>Dollar amounts named</dt><dd>{amounts.join(' · ')}</dd></div>}
        {originalTitle && originalTitle !== entry.title && <div><dt>Title as filed · original_title</dt><dd class="ar-muted">{originalTitle}</dd></div>}
      </dl>
    </div>
    <div>
      <Citation lines={doc.citation} links={doc.links.filter((l) => l.label !== 'Diagram')}>
        {sources.length > 0 && <p class="ar-meta" style="margin-top:0.5rem;position:relative">Source documents · {sources.map((s, i) => <>{i > 0 && ' · '}<a href={s.url}>{s.title}</a></>)}</p>}
      </Citation>
      <Share title={entry.title} path={doc.url} />
    </div>
  </div>

  <Diagram fields={f} field="timeline_diagram" data="timeline_data" title={entry.title} />

  <span class="u-horns ar-horns" aria-hidden="true" />
  <section class="ar-band u-grid" aria-labelledby="ar-context">
    <RunningHead mark="§ Context" title="Its meeting · its category · its campuses · what cites it" folio="R / 02" />
    <h2 id="ar-context" class="visually-hidden">Context</h2>
    <div class="ar-two" style="margin-top:1rem">
      {meeting && (
        <div>
          <p class="ar-label">// Its meeting · <a href={meeting.url}>{meeting.url}</a> · {plural(atMeeting.length, 'decision')}</p>
          <ul class="ar-list-plain">
            {meetingWindow.map((d) => (d.id === doc.id ? <li aria-current="true"><span class="ar-mark">{d.mark ?? 'DEC'}</span> {d.title}</li> : <li><span class="ar-mark">{d.mark ?? 'DEC'}</span> <a href={d.url}>{d.title}</a></li>))}
          </ul>
          {atMeeting.length > meetingWindow.length && <p class="ar-meta ar-hint"><a href={meeting.url}>All {atMeeting.length} from this meeting →</a></p>}
        </div>
      )}
      <div>
        {doc.category && (
          <>
            <p class="ar-label">// {doc.category}, on a line · {plural(inCategory.length, 'decision')} · this one marked</p>
            <Timeline docs={inCategory} current={doc} />
          </>
        )}
        {campusCounts.length > 0 && (
          <>
            <p class="ar-label" style="margin-top:1.25rem">// Campuses · other records naming them</p>
            <ul class="ar-list-plain">{campusCounts.map((c) => <li><a href={hrefOf(REST, { category: c.campus })}>{c.count} · {c.campus}</a></li>)}</ul>
          </>
        )}
        {sameItem.length > 0 && (
          <>
            <p class="ar-label" style="margin-top:1.25rem">// Same agenda item · filed {sameItem.length === 1 ? 'twice' : `${sameItem.length + 1} times`}</p>
            <ul class="ar-list-plain mr-twice">{sameItem.map((d) => <li><span class="ar-mark">{d.mark ?? 'DEC'}</span> <a href={d.url}>{d.title}</a></li>)}</ul>
            {filedUnder.length > 1 && <p class="ar-muted" style="padding:0;margin-top:0.5rem">The archive files this item {underList}. {sameItem.length === 1 ? 'Both entries are' : `All ${sameItem.length + 1} entries are`} kept as filed.</p>}
          </>
        )}
        {(twice.length > 0 || sameItem.length === 0) && (
          <>
            <p class="ar-label" style="margin-top:1.25rem">// Same meeting, filed under another category</p>
            {twice.length > 0 ? (
              <ul class="ar-list-plain">{twice.map((d) => <li><span class="ar-mark">{d.mark ?? 'DEC'}</span> <a href={d.url}>{d.title}</a> <span class="ar-faint">· {d.category}</span></li>)}</ul>
            ) : (
              <p class="ar-faint">None.</p>
            )}
          </>
        )}
        <p class="ar-label" style="margin-top:1.25rem">// Cited by a data bucket</p>
        {buckets.length > 0 ? (
          <ul class="ar-list-plain">{buckets.map((b) => <li><a href={b.url}>{b.title}</a>{b.amounts[0] !== undefined && <span class="ar-faint"> · {formatUsd(b.amounts[0])}</span>}</li>)}</ul>
        ) : (
          <p class="ar-faint">None. No bucket’s basis names this decision.</p>
        )}
      </div>
    </div>
  </section>


  <nav class="ar-nextprev ar-meta" aria-label={`In ${doc.category ?? 'this category'}`}>
    <div>{previous ? <a href={previous.url}>← Previous in {doc.category}<br />{previous.title}</a> : <span class="ar-faint">First in this category</span>}</div>
    <div>{next ? <a href={next.url}>Next in {doc.category} →<br />{next.title}</a> : <span class="ar-faint">Last in this category</span>}</div>
  </nav>
</ArchiveFrame>
