---
// One data bucket at /data/<slug> (board U3, frame 2): the meta line, the
// title, the total huge, the line items as the bucket records them, the
// basis as its citation with the decisions it names, what feeds it and
// where it flows, its own flow when its lines add up to its total, and its
// Sankey diagram.
import type { EntryLayoutProps } from '@backgold/template-kit/components/entries/props.ts'
import Share from '../archive/Share.astro'
import ArchiveFrame from '../archive/ArchiveFrame.astro'
import EntryHead from '../archive/EntryHead.astro'
import Citation from '../archive/Citation.astro'
import Diagram from '../archive/Diagram.astro'
import Flow from '../archive/Flow.astro'
import { archiveFor } from '../../lib/archive/index'
import { basisOf } from '../../lib/archive/views'
import { bucketFlow, bucketOf } from '../../lib/archive/money'
import { str } from '../../lib/archive/record'
import { formatUsd } from '../../lib/archive/query'
import { shortDay } from '../../lib/archive/format'

type Props = EntryLayoutProps

const { entry, type } = Astro.props
const base = type?.url_base ?? 'data'
const { data, doc } = await archiveFor(Astro.locals, 'data_bucket', entry, base)
const docs = data?.docs ?? [doc]
const bucket = bucketOf(doc)
const f = doc.fields
const basis = basisOf(doc, docs)
---
<ArchiveFrame crumbs={[{ label: 'Money', href: '/archive/money' }, { label: bucket.family }, { label: doc.mark ?? entry.title }]}>
  <EntryHead label="Data bucket" path={`/${base}/${doc.slug}`} kind={type?.singular_label ?? 'Data bucket'} meta={[bucket.family, bucket.side, bucket.basis && `Basis ${bucket.basis}`]} title={entry.title} summary={entry.summary} markdown={entry.body?.markdown}>
    {bucket.total !== null ? (
      <p style="margin-top:1.25rem"><span class="ar-meta">Total · total_value</span><br /><span class="u-numeral">{formatUsd(bucket.total)}</span></p>
    ) : (
      str(f.total_label) && <p class="ar-meta" style="margin-top:1rem">{str(f.total_label)}</p>
    )}
  </EntryHead>

  {bucket.lines.length > 0 && (
    <section style="margin-top:1.5rem" aria-label="Line items">
      <p class="ar-label">// Line items · as the bucket records them</p>
      <table class="ar-table">
        <tbody>
          {bucket.lines.map((l) => (
            <tr><td>{l.text}</td><td class="ar-num">{l.value === null ? '—' : formatUsd(l.value)}</td></tr>
          ))}
        </tbody>
      </table>
    </section>
  )}
  {str(f.notes) && <p class="ar-muted" style="margin-top:1rem;white-space:pre-line"><span class="ar-meta">Notes · </span>{str(f.notes)}</p>}

  <Citation lines={bucket.basis ? [`Basis: ${bucket.basis}`] : []} links={doc.links}>
    {basis.length > 0 && <p class="ar-meta" style="margin-top:0.5rem;position:relative">basis_decisions → {basis.map((d, i) => <>{i > 0 && ' · '}<a href={d.url}>{d.mark} · {d.title}{d.date ? ` · ${shortDay(d.date)}` : ''}</a></>)}</p>}
  </Citation>

  {(str(f.fed_by) || str(f.flows_to)) && (
    <dl class="ar-facts">
      {str(f.fed_by) && <div><dt>Fed by</dt><dd>{str(f.fed_by)}</dd></div>}
      {str(f.flows_to) && <div><dt>Flows to</dt><dd>{str(f.flows_to)}</dd></div>}
    </dl>
  )}

  {bucket.balanced && bucket.total !== null && <Flow caption={`The flow, from the bucket’s own lines · in = out: ${formatUsd(bucket.total)}`} hub={entry.title} id={`flow-${doc.slug}`} {...bucketFlow(bucket)} />}
  <Diagram fields={f} field="sankey_diagram" data="sankey_data" title={entry.title} />
  <Share title={entry.title} path={doc.url} />
</ArchiveFrame>
