---
// Hero · Cover, Unlabeled's (board U1, section 1): the headline as a cap
// stack, one sentence a line ("Not Red." / "Not Blue." / "Just Texans."), each
// line on its own black slab so it reads over any photo, at 120px on a wide
// screen (the type scale's mega, 54px on a phone); the line under it, then
// the buttons (the first filled, the rest outlined). The photo fills the band
// behind the words through the halftone screen (`.u-halftone`, two tones,
// drawn at render time). A Hero with a video plays it there instead, under
// the same screen: muted, looping, inline, no controls, hidden from
// assistive technology, its poster (the section's video poster, else its
// photo) drawn under it as the still; with no poster the video's own first
// frame is the still. A visitor who asked for reduced motion gets the still
// (the video's source is not even fetched when there is a poster; without
// one, the script holds the video on its first frame), and with script a
// Pause button sits at the band's lower right (WCAG 2.2.2). Its caption,
// when the section has one, sits at the photo's upper right as a figure
// label ("Fig. 01 // A live candidate forum"). The band opens with its
// running head on black slabs, the site's name at the left and the page as a
// file in the centre, "File 001 — Home": the page's title, numbered by its
// place among the header menu's links read in order, groups' links in place
// (src/lib/file-number.ts); a page the menu does not name gets its title
// alone, and a page with no title (a preview) leaves the centre empty.
// Without a photo or a video the stack sits on the page's ground. The page-opening Hero's
// headline is the page's <h1>, any other's an <h2>. A Hero with no headline
// stacks the site's title (her "Not Red. Not Blue. Just Texans."): as the <h1>
// when it opens the page, else as words under the page's own title, which
// the stylesheet then keeps for screen readers only. A Hero with its sign-up form on carries
// BackGold's form, framed under the buttons, as the kit's does.
import type { ComponentProps } from 'astro/types'
import { Embed } from '@backgold/astro/components'
import Band from '@backgold/template-kit/components/sections/Band.astro'
import type Default from '@backgold/template-kit/components/sections/Hero/index.astro'
import { heroPhoto, links, media } from '@backgold/template-kit/lib/section'
import { text } from '@backgold/template-kit/lib/format'
import RunningHead from '../../RunningHead.astro'
import { pageFile } from '../../../lib/file-number'

type Props = ComponentProps<typeof Default>

const { section, level = 2 } = Astro.props
const kicker = text(section.copy.kicker)
const bg = Astro.locals.backgold
const siteTitle = bg.setup === null ? text(bg.site.seo.title)?.trim() || null : null
const own = text(section.copy.headline)?.trim() || null
const headline = own ?? siteTitle
/** Her own headline is a heading; the site's title standing in for none is the page's <h1> only on the page-opening Hero, else words. */
const Heading = level === 1 ? 'h1' : own ? 'h2' : 'p'
const subheadline = text(section.copy.subheadline)
const caption = text(section.copy.caption)
const video = media(section, 'videoUrl')
const picture = video ? heroPhoto(section, 'videoPosterUrl', 'imageUrl', 'photoUrl') : heroPhoto(section, 'imageUrl', 'photoUrl', 'videoPosterUrl')
const framed = video !== null || picture !== null
const buttons = links(section)
/** One slab per sentence: the stack breaks after a full stop, a question or an exclamation. */
const siteName = bg.setup === null ? (bg.site.name ?? bg.site.domain) : null
const slabs = headline ? headline.split(/(?<=[.!?])\s+/u).filter((line) => line !== '') : []
/** The running head's centre: "File 001 — Home". */
const file = bg.setup === null ? await pageFile(bg.client, Astro.url.pathname) : null
---
<Band section={section} class:list={['u-cover', framed && 'u-cover-photo']}>
  <RunningHead kicker={siteName} title={file} class="u-rh-onphoto" />
  {framed && (
    <div class="u-cover-photo-box u-halftone" aria-hidden={picture?.alt ? undefined : 'true'}>
      {picture && <img src={picture.url} alt={picture.alt} loading={level === 1 ? 'eager' : 'lazy'} fetchpriority={level === 1 ? 'high' : undefined} decoding="async" />}
      {video && (
        <video class="u-cover-video" autoplay muted loop playsinline preload={picture ? 'none' : 'metadata'} poster={picture?.url} aria-hidden="true" tabindex="-1" disablepictureinpicture data-u-cover-video>
          <source src={picture ? video.url : `${video.url}#t=0.1`} media={picture ? '(prefers-reduced-motion: no-preference)' : undefined} />
        </video>
      )}
    </div>
  )}
  {framed && caption && <p class="u-cover-caption">{caption}</p>}
  {video && (
    <>
      <button type="button" class="u-cover-toggle" data-u-cover-toggle hidden>Pause</button>
      <script is:inline>
        ;(function () {
          var toggle = document.currentScript && document.currentScript.previousElementSibling
          var band = toggle && toggle.closest('.bg-section')
          var video = band && band.querySelector('[data-u-cover-video]')
          if (!toggle || !video) return
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)')
          var paused = false
          function run() {
            var go = !paused && !reduce.matches && !document.hidden
            if (go && video.paused && video.currentSrc) video.play().catch(function () {})
            if (!go && !video.paused) video.pause()
            toggle.hidden = reduce.matches || !video.currentSrc
            toggle.textContent = paused ? 'Play' : 'Pause'
            toggle.setAttribute('aria-label', (paused ? 'Play' : 'Pause') + ' the background video')
          }
          toggle.addEventListener('click', function () {
            paused = !paused
            run()
          })
          video.addEventListener('loadedmetadata', run)
          video.addEventListener('play', function () {
            if (paused || reduce.matches) video.pause()
          })
          if (reduce.addEventListener) reduce.addEventListener('change', run)
          document.addEventListener('visibilitychange', run)
          run()
        })()
      </script>
    </>
  )}
  <div class="u-cover-words">
    {kicker && <p class="kicker">{kicker}</p>}
    {slabs.length > 0 && (
      <Heading class="u-cover-stack">
        {slabs.map((line) => (
          <span class="u-cover-slab">{line}</span>
        ))}
      </Heading>
    )}
    {(subheadline || buttons.length > 0) && (
      <div class="u-cover-foot">
        {subheadline && <p class="u-cover-lede">{subheadline}</p>}
        {buttons.length > 0 && (
          <p class="actions u-cover-actions">
            {buttons.map((link, i) => <a class:list={['button', i > 0 && 'button-quiet']} href={link.href} rel={link.rel}>{link.label}</a>)}
          </p>
        )}
      </div>
    )}
    {section.embed && <Embed embed={section.embed} title="Sign up" />}
  </div>
</Band>

<style>
  /* The band: the photo's frame, at least a screen tall less the header on a wide screen. */
  :global(.bg-section.u-cover) {
    isolation: isolate;
    overflow: hidden;
  }
  :global(.bg-section.u-cover-photo) {
    display: flex;
    flex-direction: column;
    min-height: clamp(30rem, 72vh, 46rem);
    background-image: none;
  }
  :global(.bg-section.u-cover-photo) > :global(.bg-section-inner) {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    width: 100%;
  }
  /* The photo fills the band, so the band, not its column, is its box. */
  :global(.bg-section.u-cover) > :global(.bg-section-inner) {
    position: static;
  }
  /* The running head reads over the photo: its words on black slabs. */
  :global(.u-cover .u-rh-onphoto) {
    position: relative;
    z-index: 1;
    width: 100%;
    border-bottom: 0;
  }
  :global(.u-cover-photo .u-rh-onphoto > *) {
    justify-self: start;
    padding: 0.375rem 0.625rem;
    background: var(--page);
  }
  :global(.u-cover-photo .u-rh-onphoto > .u-rh-folio) {
    justify-self: end;
  }
  :global(.u-cover-photo .u-rh-onphoto > .u-rh-centre:empty) {
    background: none;
  }
  .u-cover-photo-box {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  /* The video fills the box over its still, through the same screen. */
  .u-cover-photo-box > img,
  .u-cover-video {
    position: absolute;
    inset: 0;
  }
  :global(.u-halftone) .u-cover-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) blur(1px) brightness(1.1) contrast(1.15);
  }
  @media (prefers-reduced-motion: reduce) {
    .u-cover-photo-box > img + .u-cover-video {
      display: none;
    }
  }
  .u-cover-toggle {
    position: absolute;
    right: max(var(--gutter), 50% - var(--content) / 2);
    bottom: var(--space);
    z-index: 1;
    min-height: 2rem;
    padding: 0 0.75rem;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: var(--page);
    color: var(--ink);
    font-family: var(--font-meta);
    font-size: var(--u-meta-size);
    letter-spacing: var(--u-meta-track);
    text-transform: uppercase;
    cursor: pointer;
  }
  .u-cover-toggle:hover,
  .u-cover-toggle:focus-visible {
    background: var(--ink);
    color: var(--page);
  }
  .u-cover-toggle[hidden] {
    display: none;
  }
  .u-cover-caption {
    position: absolute;
    top: calc(var(--space) + 2.75rem);
    right: max(var(--gutter), 50% - var(--content) / 2);
    z-index: 1;
    margin: 0;
    padding: 0.375rem 0.625rem;
    background: var(--page);
    color: var(--muted);
    font-family: var(--font-meta);
    font-size: var(--u-meta-size);
    letter-spacing: var(--u-meta-track);
    text-transform: uppercase;
  }
  .u-cover-words {
    margin-top: auto;
    padding-top: clamp(4rem, 2rem + 8vw, 10rem);
  }
  .u-cover-stack {
    font-family: var(--font-display);
    font-weight: 500;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin: 0;
    font-size: var(--u-mega);
    line-height: 0.92;
  }
  .u-cover-slab {
    padding: 0.04em 0.12em 0.02em 0;
    background: var(--page);
    box-shadow: -0.12em 0 0 var(--page);
  }
  .u-cover-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-top: clamp(1.25rem, 1rem + 1vw, 2rem);
  }
  .u-cover-lede {
    margin: 0;
    padding: 0.25rem 0.5rem 0.25rem 0;
    background: var(--page);
    box-shadow: -0.5rem 0 0 var(--page);
    font-family: var(--font-display);
    font-size: var(--u-d4);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .u-cover-actions {
    margin: 0;
  }
  .u-cover-actions .button-quiet {
    background: var(--page);
  }
  .u-cover-words > :global(.bg-embed) {
    margin-top: 1.5rem;
    max-width: 40rem;
  }
</style>
