---
// EventsList · Agenda, Unlabeled's (board U8): the kit's agenda, its empty
// months carrying the section's first link as a door (AgendaMonths here,
// "Host Unlabeled"). As the kit's (board A6): the events grouped by month under the month's name
// and its count, each a row with the day, the type, the time, the place and
// its live counts ("142 going", "12 seats left", filled in by LiveCounts
// after the page loads; empty without scripts). A month between two listed
// months that has no event, and the month after the last, are drawn as an
// invitation ("December is open.") with the section's empty-events line,
// never as a blank (AgendaMonths).
//
// On the events page (/events) the type tabs come first (TypeTabs): All,
// then each event type with an upcoming event, from the Content API's GET
// /events. They are addresses, /events/<type>, so they work with scripts off;
// there the rows are that type's upcoming events (src/routes/catch-all.astro
// reads them) and its tab is marked current. Anywhere else, when fewer than
// two types have an upcoming event, or when the types cannot be read, no tabs
// are drawn.
//
// Each event opens its own page on this site: `options.actions` 'buttons' adds
// a button to the row ("Get tickets" when the event sells tickets, "RSVP"
// otherwise, "Details" once registration has closed), 'link' (or none) makes
// the title the link; either way the whole row opens it. Under the months, a
// line names the rows' one zone ("Times are Mountain Time.", their times then
// leaving it off) and offers every event as one calendar file
// (CalendarLine). With no events it draws nothing.
import type { ComponentProps } from 'astro/types'
import type Default from '@backgold/template-kit/components/sections/EventsList/index.astro'
import Band from '@backgold/template-kit/components/sections/Band.astro'
import AgendaMonths from './AgendaMonths.astro'
import LiveCounts from '@backgold/template-kit/components/sections/EventsList/LiveCounts.astro'
import TypeTabs from '@backgold/template-kit/components/sections/EventsList/TypeTabs.astro'
import CalendarLine from '@backgold/template-kit/components/sections/EventsList/CalendarLine.astro'
import { actionsOf, eventsOf, sharedZone } from '@backgold/template-kit/components/sections/EventsList/events.ts'
import { text } from '@backgold/template-kit/lib/format'
import { links } from '@backgold/template-kit/lib/section'
import { tabsFor } from '@backgold/template-kit/lib/events'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const heading = text(section.copy.heading)
const invitation = text(section.copy.eventsEmptyCta)
const buttons = actionsOf(section) === 'buttons'
const host = links(section)[0] ?? null
const events = eventsOf(section)
const bg = Astro.locals.backgold
const zone = sharedZone(events)
const tabs = events.length > 0 && bg.setup === null ? await tabsFor(bg.client, Astro.request, section, Astro.url.pathname) : null
---
{events.length > 0 && (
  <Band section={section} class="events events-agenda">
    {heading && <h2>{heading}</h2>}
    {tabs && <TypeTabs tabs={tabs} />}
    <AgendaMonths events={events} buttons={buttons} invitation={invitation} zoneless={zone !== null} host={host} />
    <CalendarLine zone={zone} />
    <LiveCounts />
  </Band>
)}
