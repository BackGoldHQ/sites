---
// Petition, every layout, Unlabeled's (board U6). The image, map and coverage
// layouts are the kit's (their header, the photo, the live map or the county
// coverage, carries the title, and BackGold's frame draws the rest in her
// look). The default layout, `none`, is hers: the section's kicker and its
// heading set large at the left with the figures the organization typed for
// it as huge numerals under it, and BackGold's sign sheet on a hairline box at
// the right (under it on a phone), where the frame draws the live count, the
// goal and the note under it (her legal note goes in that note). The site
// never draws the live count itself: the Content API sends it only inside
// the frame, and a figure BackGold fills in live is left out here
// (literalStat). When BackGold sends the petition's text (petitionWords), the
// left column draws it under the heading as her mono prose: the
// `// What you're signing` running line, the text, the asks as numbered
// steps (board U6's steps) and the legal note; the frame is then asked to
// collapse its own copy of the text (`text=collapsed`). Without the text the
// column is the heading and the figures and the frame keeps its text. Every layout is anchored at `petition` when the section
// names no anchor, as a hosted BackGold page's Petition is, so "Sign the
// petition ↓" lands on it.
import type { Section } from '@backgold/content'
import Band from '@backgold/template-kit/components/sections/Band.astro'
import ModuleFrame from '@backgold/template-kit/components/sections/modules/ModuleFrame.astro'
import PetitionImage from '@backgold/template-kit/components/sections/Petition/image.astro'
import PetitionMap from '@backgold/template-kit/components/sections/Petition/map.astro'
import PetitionCoverage from '@backgold/template-kit/components/sections/Petition/coverage.astro'
import { rows } from '@backgold/template-kit/lib/section'
import { literalStat, text } from '@backgold/template-kit/lib/format'
import { petitionWords } from '@backgold/template-kit/lib/petition-text'

interface Props {
  section: Section
  variant?: string
}

const { section, variant } = Astro.props
const LAYOUTS = { image: PetitionImage, map: PetitionMap, coverage: PetitionCoverage } as const
const Kit = variant && Object.hasOwn(LAYOUTS, variant) ? LAYOUTS[variant as keyof typeof LAYOUTS] : null
const anchored: Section = { ...section, options: { anchorId: 'petition', ...section.options } }
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
const figures = rows(section)
  .filter((row) => row.group === 'tile')
  .map((row) => ({ value: literalStat(row.value), label: text(row.label), note: text(row.note) }))
  .filter((figure): figure is { value: string; label: string | null; note: string | null } => figure.value !== null)
const words = petitionWords(section)
const params: Record<string, string> = words ? { text: 'collapsed' } : {}
---
{Kit ? (
  <Kit section={anchored} variant={variant} />
) : (
  <Band section={anchored} class="u-petition">
    <div class="u-petition-grid">
      <div class="u-petition-words">
        {kicker && <p class="kicker">{kicker}</p>}
        {heading && <h2 class="u-petition-heading">{heading}</h2>}
        {words && (
          <div class="u-petition-text" data-petition-text>
            <p class="u-meta u-slash u-petition-line">What you’re signing</p>
            <div class="prose u-petition-prose" set:html={words.html} />
            {words.asks.length > 0 && (
              <ol class="u-petition-steps">
                {words.asks.map((ask, i) => (
                  <li>
                    <span class="u-petition-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                    <h3>{ask.title}</h3>
                    {ask.body && <p>{ask.body}</p>}
                  </li>
                ))}
              </ol>
            )}
            {words.legal && <p class="u-meta u-petition-legal">{words.legal}</p>}
          </div>
        )}
        {figures.length > 0 && (
          <dl class="u-petition-figures">
            {figures.map((figure) => (
              <div>
                <dt class="u-meta">{figure.label}</dt>
                <dd class="u-numeral">{figure.value}</dd>
                {figure.note && <dd class="u-petition-note">{figure.note}</dd>}
              </div>
            ))}
          </dl>
        )}
      </div>
      <ModuleFrame embed={section.embed} band={section.band} type={section.type} layout="none" card title={heading ?? 'Sign the petition'} height="40rem" params={params} />
    </div>
  </Band>
)}

<style>
  .u-petition-grid {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  .u-petition-heading {
    margin: 0;
    font-size: var(--u-d1);
    line-height: 0.95;
  }
  .u-petition-figures {
    display: grid;
    gap: 1.5rem;
    margin: 2rem 0 0;
  }
  .u-petition-figures div {
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
  }
  .u-petition-figures dt {
    color: var(--muted);
  }
  .u-petition-figures dd {
    margin: 0;
  }
  .u-petition-figures .u-numeral {
    margin-top: 0.5rem;
  }
  .u-petition-note {
    margin-top: 0.75rem !important;
    max-width: 30em;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .u-petition-text {
    margin-top: 2rem;
  }
  .u-petition-line {
    margin: 0 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line-strong);
    color: var(--muted);
  }
  .u-petition-prose {
    max-width: 36em;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.7;
  }
  .u-petition-prose :global(p) {
    margin: 0 0 1em;
  }
  .u-petition-steps {
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }
  .u-petition-steps li {
    padding: 1rem 0 1.125rem;
    border-bottom: 1px solid var(--line);
  }
  .u-petition-no {
    display: block;
    margin-bottom: 0.625rem;
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .u-petition-steps h3 {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: var(--u-d4);
    font-weight: 500;
    line-height: 1.05;
    text-transform: uppercase;
  }
  .u-petition-steps p {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .u-petition-legal {
    margin: 1.25rem 0 0;
    max-width: 40em;
    color: var(--muted);
    letter-spacing: 0.06em;
    line-height: 1.6;
    text-transform: none;
  }
  @media (min-width: 60rem) {
    .u-petition-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 3rem;
    }
  }
</style>
