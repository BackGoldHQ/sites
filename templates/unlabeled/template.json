                },
                "url": "/#events",
                "style": "outline"
              }
            ],
            "options": {
              "anchorId": "get-involved"
            },
            "data": {
              "source": "issues",
              "items": [
                {
                  "title": "Learn what to look for",
                  "body": "A quick field guide shows you how to spot and identify what we\u2019re mapping \u2014 no expertise needed, just an eye for it.",
                  "icon": "lightbulb"
                },
                {
                  "title": "Document it",
                  "body": "Photograph or note it from the public right-of-way \u2014 sidewalk or street. Never trespass, never touch anything.",
                  "icon": "book"
                },
                {
                  "title": "Add it to the record",
                  "body": "Drop a pin on the open, community-owned map. Our short walkthrough does it with you, step by step.",
                  "icon": "globe"
                },
                {
                  "title": "Watch it count",
                  "body": "It appears on the map above within the hour \u2014 permanent, public, and citable at the next hearing.",
                  "icon": "zap"
                }
              ]
            }
          },
          {
