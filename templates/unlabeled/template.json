        "sections": [
          {
            "id": "Petition-home",
            "type": "Petition",
            "band": "plain",
            "bleed": "full",
            "variant": "map",
            "copy": {
              "heading": "Add your name: put it on the record",
              "addressedTo": "Your city council, its oversight committees, and the agencies that answer to them.",
              "goalNote": "Goal set for the next public hearing.",
              "volunteerPrompt": "I'd also like to help."
            },
            "media": {},
            "links": [],
            "options": {
              "datasetPreset": "alpr",
              "datasetArea": "US-TX",
              "badgeNoun": "ALPRs",
              "uncategorizedLabel": "Unattributed",
              "volunteerAsk": "on",
              "recognition": true,
              "anchorId": "petition"
            },
            "data": {
              "source": "petition",
              "items": [
                {
                  "title": "Publish a full inventory.",
                  "body": "Everything in operation \u2014 what it is, who runs it, and what it costs \u2014 in a public dataset, updated on a regular schedule."
                },
                {
                  "title": "Require a public vote",
                  "body": "before any new deployment, contract, or renewal. No more decisions made by purchase order, out of public view."
                },
                {
                  "title": "Cap how long data is kept",
                  "body": "and end bulk sharing with outside agencies for anything not tied to an active, named investigation."
                },
                {
                  "title": "Publish an independent audit",
                  "body": "every year \u2014 who accessed what, under what authority, and whether it was justified."
                },
                {
                  "group": "tile",
                  "label": "Sites mapped",
                  "value": "auto:total",
                  "note": ""
                },
                {
                  "group": "tile",
                  "label": "Signatures",
                  "value": "auto:signatures",
                  "note": ""
                },
                {
                  "group": "tile",
                  "label": "Public votes taken",
                  "value": "0",
                  "note": "On the decisions that put this network here. That is what we are changing."
                }
              ]
            }
          },
          {
            "id": "Issues-home",
            "type": "Issues",
            "band": "tint",
            "bleed": "full",
            "variant": "steps",
            "copy": {
              "kicker": "Get involved",
              "heading": "Signing takes 30 seconds. Mapping takes four minutes.",
              "lead": "Every dot on that map got there because a neighbor walked past one and tagged it. The inventory they won\u2019t publish, we\u2019re building ourselves \u2014 in the open, where nobody can quietly delete it."
            },
            "media": {},
            "links": [
              {
                "label": "Open the global map",
                "target": {
                  "kind": "external",
                  "url": "https://maps.deflock.org"
                },
                "url": "https://maps.deflock.org",
                "style": "primary"
              },
              {
