---
// Petition · none as this template draws it when BackGold sends the
// petition's text (petitionText): the section's kicker and heading, then
// BackGold's sheet, asked to collapse its own copy of the text
// (`text=collapsed`, the disclosure frame.css styles), then the text in
// Nunito under a "What you're signing" kicker. On a wide screen the head and
// the text stack at the left with the sheet beside them; on a phone the sheet
// comes right under the heading, so the count and the form are above the
// fold, and the text follows it, in the same order for the eye and the
// keyboard. The asks are the page's Issues band's and the legal note is the
// frame's, so neither is drawn here. Without the text it is the kit's
// Petition, unchanged.
import type { Section } from '@backgold/content'
import Band from '@backgold/template-kit/components/sections/Band.astro'
import SectionHead from '@backgold/template-kit/components/sections/SectionHead.astro'
import ModuleFrame from '@backgold/template-kit/components/sections/modules/ModuleFrame.astro'
import KitPetition from '@backgold/template-kit/components/sections/Petition/index.astro'
import { text } from '@backgold/template-kit/lib/format'
import { petitionText } from '@backgold/template-kit/lib/petition-text'

interface Props {
  section: Section
  variant?: string
}

const { section, variant } = Astro.props
const petition = petitionText(section)
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
---
{petition ? (
  <Band section={section} class="headed-module np-petition">
    <div class="np-petition-head">
      <SectionHead kicker={kicker} heading={heading} more={[]} />
    </div>
    <ModuleFrame embed={section.embed} band={section.band} type={section.type} layout="none" card title={heading ?? section.type} height="44rem" params={{ text: 'collapsed' }} class="np-petition-sheet" />
    <div class="np-petition-text" data-petition-text>
      <p class="kicker">What you’re signing</p>
      <div class="prose np-petition-prose" set:html={petition} />
    </div>
  </Band>
) : (
  <KitPetition section={section} variant={variant} />
)}

<style>
  :global(.np-petition > .bg-section-inner) {
    display: grid;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    align-items: start;
  }
  .np-petition-text {
    min-width: 0;
  }
  .np-petition-prose {
    max-width: 38em;
    font-family: var(--font);
  }
  @media (min-width: 48rem) {
    :global(.np-petition > .bg-section-inner) {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      grid-template-areas: 'head sheet' 'text sheet';
      grid-template-rows: auto 1fr;
      column-gap: clamp(2rem, 1rem + 3vw, 3.5rem);
    }
    .np-petition-head {
      grid-area: head;
    }
    :global(.np-petition .np-petition-sheet) {
      grid-area: sheet;
    }
    .np-petition-text {
      grid-area: text;
    }
  }
</style>
