---
// FormBlock · wide as this template draws it (board N4, "Tell us, and we'll
// find you a spot"): the section's kicker, heading and body as an intro
// column at the left, and BackGold's form (ModuleFrame, `wide`, the fields
// two to a row) on a hand-cut card at the right; on a phone the intro comes
// first. The form is BackGold's frame; the card says so when there is no
// form to frame. Without a heading or a body the card takes the full width.
import type { Section } from '@backgold/content'
import Band from '@backgold/template-kit/components/sections/Band.astro'
import ModuleFrame from '@backgold/template-kit/components/sections/modules/ModuleFrame.astro'
import Prose from '@backgold/template-kit/components/Prose.astro'
import { prose, text } from '@backgold/template-kit/lib/format'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
const intro = Boolean(heading || prose(section.copy.body))
// The frame's title is an attribute: the heading without the marked word's asterisks.
const title = heading ? heading.replace(/\*([^*]+)\*/g, '$1') : 'Form'
---
<Band section={section} class:list={['form-module', 'form-module-wide', intro && 'np-form-intro']}>
  {intro && (
    <div class="np-form-words">
      {kicker && <p class="kicker">{kicker}</p>}
      {heading && <h2>{heading}</h2>}
      <Prose value={section.copy.body} class="lede" />
    </div>
  )}
  <ModuleFrame embed={section.embed} band={section.band} type={section.type} layout="wide" card title={title} height="34rem" />
</Band>
