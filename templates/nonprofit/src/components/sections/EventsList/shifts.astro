---
// EventsList · shifts as this template draws it (boards N1 and N4): the
// section head, then a hand-cut row per volunteer shift: its date as a
// torn-off calendar page (the month on the primary, the day hand-lettered,
// the weekday), the title, the time and the place beside the clock and pin
// doodles, the spots, and at the right the row's one button to the shift's
// page on this site (/volunteer/<slug>, the kit's, which frames BackGold's
// sign-up card): "Sign up for this shift" while it is open, "Full · join the waitlist" once only the
// waitlist is, "Full" and "Closed" as the outline sticker. A shift that
// belongs to a public event this section lists says so ("Part of" the
// event, linking to its page).
//
// The shifts are the organization's, from the Content API's GET /shifts (the
// next `max` of them, or the first page), or the ones the page passes as
// `shifts` (the volunteer list, which read them all). An api that does not serve it yet,
// a site still being set up, or one with no open shift draws the section's
// events instead, as events: the kit's button ("RSVP", "Get tickets",
// "Details" once closed) and "Add to calendar".
//
// The counts are live, never only the cached page's: each row's slot carries
// the counts the page was built with (`data-going`, `data-capacity`), and
// after the page loads the shifts' are read again from GET /shifts/live, 50
// at a time (the
// events' from the kit's LiveCounts, GET /events/live), which also moves a
// shift's button to its current state. Where a row has a capacity the script
// words the counts ("6 of 10 filled · 4 spots left", "Full"; for an event "6
// of 10 going · 4 seats left") and draws one dot per spot beside them, filled
// for each one taken and dashed for each one open (up to 24; past that, the
// words alone). The dots are a picture of the words, hidden from screen
// readers. With scripts off a shift keeps its counts as built and its
// button; an event keeps its button.
//
// A list with no `max` (Get involved) is grouped by week, Monday to Sunday in
// each row's own calendar, under a hand-lettered "Week of Nov 2" with the
// week's dates and a squiggle rule (the script says "This week" and "Next
// week" in the visitor's own time); a week with no row is not drawn. A
// capped list (home's next three) is one run of rows. With nothing to list
// the head stands over the section's empty-events line as a dashed
// invitation; with neither rows nor a heading nothing is drawn.
import type { Section, ShiftsListRow } from '@backgold/content'
import Band from '@backgold/template-kit/components/sections/Band.astro'
import SectionHead from '@backgold/template-kit/components/sections/SectionHead.astro'
import LiveCounts from '@backgold/template-kit/components/sections/EventsList/LiveCounts.astro'
import { eventsOf, monthName, whenOf, type When } from '@backgold/template-kit/components/sections/EventsList/events.ts'
import { links, linkOf, type Link } from '@backgold/template-kit/lib/section'
import { text } from '@backgold/template-kit/lib/format'
import { firstLiveScript, liveSource } from '@backgold/template-kit/lib/live'
import { shiftPath } from '@backgold/template-kit/lib/shifts'
import Doodle from '../../Doodle.astro'

interface Props {
  section: Section
  variant?: string
  /** The shifts to list, already read (the volunteer list's); left out, the section reads them. */
  shifts?: ShiftsListRow[]
}

/** One row as this layout draws it, a shift's or an event's. */
interface Row {
  kind: 'shift' | 'event'
  /** The live slot's id: the shift's or the event's. */
  id: string | null
  title: string
  startsAt: string | null
  when: When | null
  /** "6:00 PM to 8:00 PM CDT", or the start's time alone. */
  time: string | null
  place: string | null
  /** An event's type chip; a shift has none. */
  type: string | null
  /** The title's link: an event's page; a shift's page. */
  link: Link | null
  /** The event a shift is part of, on this site. */
  partOf: Link | null
  action: Link | null
  /** The button draws as the outline sticker (closed, full). */
  quiet: boolean
  closed: boolean
  calendar: Link | null
  /** A shift's state, for the live script; null on an event. */
  state: ShiftsListRow['state'] | null
  going: number | null
  capacity: number | null
}

const { section, shifts: given } = Astro.props
const heading = text(section.copy.heading)
const invitation = text(section.copy.eventsEmptyCta)
const max = typeof section.options?.max === 'number' ? section.options.max : null
const capped = max !== null
const bg = Astro.locals.backgold

/** The organization's open shifts, or null when the api does not serve them (an older api, a site being set up, a failed read). */
async function openShifts(): Promise<ShiftsListRow[] | null> {
  if (given) return given
  if (bg.setup !== null) return null
  try {
    return (await bg.client.shifts({ limit: Math.min(Math.max(max ?? 50, 1), 50) })).shifts
  } catch {
    return null
  }
}

/** A shift's button, by its state. */
const SHIFT_ACTION: Record<ShiftsListRow['state'], { label: string; quiet: boolean }> = {
  open: { label: 'Sign up for this shift', quiet: false },
  waitlist: { label: 'Full · join the waitlist', quiet: false },
  full: { label: 'Full', quiet: true },
  closed: { label: 'Closed', quiet: true },
}

const sectionEvents = eventsOf(section)
/** The public event a shift belongs to, named by its title, when this section lists it; null otherwise. */
const partOf = (shift: ShiftsListRow): Link | null => {
  if (shift.subject.kind !== 'event' || !shift.subject.slug) return null
  const path = `/events/${encodeURIComponent(shift.subject.slug)}`
  const event = sectionEvents.find((e) => e.link?.href === path)
  return event ? linkOf(event.title, path) : null
}

const shiftRow = (shift: ShiftsListRow): Row => {
  const when = whenOf(shift.starts_at, shift.timezone)
  const end = whenOf(shift.ends_at, shift.timezone)
  const sameDay = when && end && when.year === end.year && when.monthIndex === end.monthIndex && when.day === end.day
  const page = shiftPath(shift.slug)
  const action = SHIFT_ACTION[shift.state] ?? SHIFT_ACTION.closed
  return {
    kind: 'shift',
    id: shift.id,
    title: shift.title,
    startsAt: shift.starts_at,
    when,
    time: when?.clock && sameDay && end?.time ? `${when.clock} to ${end.time}` : (when?.time ?? null),
    place: shift.location,
    type: null,
    link: linkOf(shift.title, page),
    partOf: partOf(shift),
    action: linkOf(action.label, page),
    quiet: action.quiet,
    closed: shift.state === 'closed',
    calendar: null,
    state: shift.state,
    going: shift.signed_up,
    capacity: shift.capacity,
  }
}

const shifts = await openShifts()
const rows: Row[] =
  shifts && shifts.length > 0
    ? shifts.slice(0, max ?? shifts.length).map(shiftRow)
    : sectionEvents.map((e) => ({
        kind: 'event' as const,
        id: e.id,
        title: e.title,
        startsAt: e.startsAt,
        when: e.when,
        time: e.when?.time ?? null,
        place: e.place,
        type: e.type,
        link: e.link,
        partOf: null,
        action: e.action,
        quiet: e.closed,
        closed: e.closed,
        calendar: e.calendar,
        state: null,
        going: null,
        capacity: null,
      }))
const asShifts = rows.length > 0 && rows[0]!.kind === 'shift'
const shiftsLive = asShifts && firstLiveScript(Astro.request) ? await liveSource(bg.setup === null && bg.firstParty, 'shifts') : null

/** The Monday that starts the row's week, in its own calendar, as a UTC date; null for an undated row. */
const mondayOf = (e: Row): Date | null => {
  if (!e.when) return null
  const day = new Date(Date.UTC(e.when.year, e.when.monthIndex, Number(e.when.day)))
  day.setUTCDate(day.getUTCDate() - ((day.getUTCDay() + 6) % 7))
  return day
}
const short = (d: Date) => `${monthName(d.getUTCMonth()).slice(0, 3)} ${d.getUTCDate()}`
/** "Nov 2 to 8", or "Nov 30 to Dec 6" across a month. */
const span = (monday: Date) => {
  const sunday = new Date(monday)
  sunday.setUTCDate(sunday.getUTCDate() + 6)
  return `${short(monday)} to ${sunday.getUTCMonth() === monday.getUTCMonth() ? sunday.getUTCDate() : short(sunday)}`
}

interface Week {
  key: string
  heading: string | null
  dates: string | null
  rows: Row[]
}
const weeks: Week[] = []
for (const row of rows) {
  const monday = capped ? null : mondayOf(row)
  const key = monday ? monday.toISOString().slice(0, 10) : 'rows'
  const last = weeks[weeks.length - 1]
  if (last && last.key === key) last.rows.push(row)
  else weeks.push({ key, heading: monday ? `Week of ${short(monday)}` : null, dates: monday ? span(monday) : null, rows: [row] })
}
/** A shift's counts in words, as the live script writes them too. */
const words = (row: Row): string => {
  if (row.going === null) return ''
  if (row.capacity !== null && row.capacity > 0) {
    const left = row.capacity - row.going
    return `${row.going} of ${row.capacity} filled · ${left > 0 ? `${left} ${left === 1 ? 'spot' : 'spots'} left` : 'Full'}`
  }
  return `${row.going} signed up`
}
const SHIFT_LABELS = JSON.stringify(Object.fromEntries(Object.entries(SHIFT_ACTION).map(([state, a]) => [state, a.label])))
---

{(heading || rows.length > 0) && (
  <Band section={section} class="events events-shifts np-shifts">
    <SectionHead kicker={text(section.copy.kicker)} heading={heading} more={links(section)} />
    {rows.length > 0 ? (
      <div class="np-weeks" data-np-shifts data-np-shifts-live={shiftsLive?.url} data-np-shifts-key={shiftsLive?.key ?? undefined} data-np-labels={asShifts ? SHIFT_LABELS : undefined}>
        {weeks.map((week) => (
          <div class="np-week">
            {week.heading && (
              <h3 class="np-week-head" data-np-week={week.key}>
                <span class="np-week-name">{week.heading}</span>
                <small>{week.dates}</small>
                <span class="np-rule" aria-hidden="true"></span>
              </h3>
            )}
            <ul class="np-shift-list" role="list">
              {week.rows.map((row) => (
                <li class="np-shift np-card">
                  {row.when && row.startsAt ? (
                    <time class="np-tile" datetime={row.startsAt}>
                      <span class="np-tile-month" aria-hidden="true">{row.when.monthShort}</span>
                      <b aria-hidden="true">{row.when.day}</b>
                      {row.when.weekday && <span class="np-tile-weekday" aria-hidden="true">{row.when.weekday}</span>}
                      <span class="visually-hidden">{row.when.full}</span>
                    </time>
                  ) : (
                    <span class="np-tile" aria-hidden="true"><b>–</b></span>
                  )}
                  <div class="np-shift-body">
                    {row.type && <p class="np-shift-type"><span class="chip"><Doodle name="people" />{row.type}</span></p>}
                    <h3 class="np-shift-title">{row.link ? <a href={row.link.href} rel={row.link.rel}>{row.title}</a> : row.title}</h3>
                    {(row.time || row.place || row.partOf) && (
                      <p class="np-shift-meta">
                        {row.time && <span><Doodle name="clock" />{row.time}</span>}
                        {row.place && <span><Doodle name="pin" />{row.place}</span>}
                        {row.partOf && <span><Doodle name="calendar" />Part of <a href={row.partOf.href}>{row.partOf.label}</a></span>}
                      </p>
                    )}
                    {row.kind === 'shift' ? (
                      <p class="np-spots">
                        <span class="np-dots" aria-hidden="true"></span>
                        <span class="np-live" data-np-shift={row.id} data-np-noun="spot" data-going={row.going ?? undefined} data-capacity={row.capacity ?? undefined}>{words(row)}</span>
                      </p>
                    ) : (
                      (row.id || row.closed) && (
                        <p class="np-spots">
                          {row.id && <span class="np-dots" aria-hidden="true"></span>}
                          {row.id && <span class="np-live" data-bg-live={row.id}></span>}
                          {row.closed && <span class="np-closed"><Doodle name="exclaim" />Registration closed</span>}
                        </p>
                      )
                    )}
                  </div>
                  {(row.action || row.calendar) && (
                    <div class="np-shift-go">
                      {row.action && (
                        <a class:list={['button', row.quiet && 'button-quiet']} href={row.action.href} rel={row.action.rel} data-np-shift-action={row.kind === 'shift' ? row.id : undefined}>
                          <span data-np-label>{row.action.label}</span><span class="visually-hidden">: {row.title}</span>
                        </a>
                      )}
                      {row.calendar && (
                        <a class="np-calendar" href={row.calendar.href} rel={row.calendar.rel}>
                          <Doodle name="calendar" />{row.calendar.label}<span class="visually-hidden">: {row.title}</span>
                        </a>
                      )}
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
        <script is:inline>
          (function (root) {
            if (!root || !window.MutationObserver) return
            var MOST = 24
            var draw = function (slot) {
              var dots = slot.previousElementSibling
              if (!dots || !dots.classList.contains('np-dots')) return
              var going = Number(slot.getAttribute('data-going'))
              var capacity = Number(slot.getAttribute('data-capacity'))
              var shift = slot.getAttribute('data-np-noun') === 'spot'
              dots.textContent = ''
              if (!slot.hasAttribute('data-capacity') || !(capacity > 0) || !(going >= 0)) {
                if (shift && going >= 0) slot.textContent = going + ' signed up'
                return
              }
              var left = capacity - going
              var rest = left > 0 ? left + (shift ? (left === 1 ? ' spot left' : ' spots left') : left === 1 ? ' seat left' : ' seats left') : 'Full'
              slot.textContent = going + ' of ' + capacity + (shift ? ' filled · ' : ' going · ') + rest
              if (capacity > MOST) return
              for (var i = 0; i < capacity; i++) {
                var dot = document.createElement('i')
                if (i >= going) dot.className = 'np-open'
                dots.appendChild(dot)
              }
            }
            // A week's heading says This week or Next week in the visitor's own time (the page is cached, so the server cannot).
            var pad = function (n) {
              return (n < 10 ? '0' : '') + n
            }
            var monday = new Date()
            monday.setDate(monday.getDate() - ((monday.getDay() + 6) % 7))
            var key = function (d) {
              return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate())
            }
            var thisWeek = key(monday)
            monday.setDate(monday.getDate() + 7)
            var nextWeek = key(monday)
            var heads = root.querySelectorAll('[data-np-week]')
            for (var h = 0; h < heads.length; h++) {
              var name = heads[h].querySelector('.np-week-name')
              var wk = heads[h].getAttribute('data-np-week')
              if (wk === thisWeek) name.textContent = 'This week'
              else if (wk === nextWeek) name.textContent = 'Next week'
            }
            var slots = root.querySelectorAll('[data-bg-live], [data-np-shift]')
            var watch = new MutationObserver(function (changes) {
              for (var c = 0; c < changes.length; c++) draw(changes[c].target)
            })
            for (var s = 0; s < slots.length; s++) {
              draw(slots[s])
              watch.observe(slots[s], { attributes: true, attributeFilter: ['data-going', 'data-capacity'] })
            }
            // The shifts' counts and states now (GET /shifts/live), over the ones the cached page was built with.
            var api = root.getAttribute('data-np-shifts-live')
            var labels = JSON.parse(root.getAttribute('data-np-labels') || '{}')
            var ids = []
            var shiftSlots = root.querySelectorAll('[data-np-shift]')
            for (var t = 0; t < shiftSlots.length; t++) ids.push(shiftSlots[t].getAttribute('data-np-shift'))
            if (!api || ids.length === 0 || !window.fetch) return
            var headers = { Accept: 'application/json' }
            var apiKey = root.getAttribute('data-np-shifts-key')
            if (apiKey) headers.Authorization = 'Bearer ' + apiKey
            for (var start = 0; start < ids.length; start += 50) {
              fetch(api + '?ids=' + ids.slice(start, start + 50).map(encodeURIComponent).join(','), { headers: headers })
                .then(function (res) {
                  return res.ok ? res.json() : null
                })
                .then(function (body) {
                  var live = body && Array.isArray(body.shifts) ? body.shifts : []
                  for (var l = 0; l < live.length; l++) {
                    var one = live[l]
                    if (!one || typeof one.id !== 'string' || typeof one.signed_up !== 'number') continue
                    var slot = root.querySelector('[data-np-shift="' + one.id.replace(/"/g, '') + '"]')
                    if (slot) slot.setAttribute('data-going', String(one.signed_up))
                    var button = root.querySelector('[data-np-shift-action="' + one.id.replace(/"/g, '') + '"]')
                    if (button && labels[one.state]) {
                      button.querySelector('[data-np-label]').textContent = labels[one.state]
                      button.classList.toggle('button-quiet', one.state === 'full' || one.state === 'closed')
                    }
                  }
                })
                .catch(function () {})
            }
          })(document.currentScript.closest('[data-np-shifts]'))
        </script>
      </div>
    ) : (
      <p class="np-invite"><Doodle name="calendar" />{invitation ?? 'No shifts are posted right now.'}</p>
    )}
    <LiveCounts />
  </Band>
)}
