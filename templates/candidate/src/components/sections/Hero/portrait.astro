---
// Hero, 'portrait' layout (boards C1 and C9, section 1; proposed, C-1): the
// office line small over the headline (`copy.kicker`, "State Senate ·
// District 9"), the candidate's name as the headline set large in capitals
// at the left, on two lines when it is two words (the first name over the
// last, C1 and C9's "IRIS / DELACORTE"), the line under
// it and the buttons, and the portrait at the
// right, standing on the band's floor (no gap under it) over a stripe in the
// accent. On a phone the portrait follows the words, still on the floor.
// The portrait's alt text is `copy.imageAlt`, and its caption
// (`copy.caption`, C1's "Photo: Iris at the Osgood County fair") a chip at
// its lower left. Without a portrait the words take the full width, with no
// caption. With a background photo beside the portrait (`media.imageUrl`,
// a place: a skyline, a main street), the photo fills the band behind both
// under the Full photo hero's scrim, deepest at the left where the words
// sit, and the words read in the photo band's inks. The page-opening Hero's
// headline is the page's <h1> (`level={1}`); any other Hero's is an <h2>. A
// Hero with its signup form on carries an `embed`: BackGold's own form,
// framed under the buttons in the site's own look (ModuleFrame), so it
// draws no card, heading or platform footer of its own.
import type { ComponentProps } from 'astro/types'
import { safeSrc } from '@backgold/astro/server'
import Band from '@backgold/template-kit/components/sections/Band.astro'
import type Default from '@backgold/template-kit/components/sections/Hero/index.astro'
import ModuleFrame from '@backgold/template-kit/components/sections/modules/ModuleFrame.astro'
import { heroPhoto, links } from '@backgold/template-kit/lib/section'
import { text } from '@backgold/template-kit/lib/format'

type Props = ComponentProps<typeof Default>

const { section, level = 2 } = Astro.props
const Heading = level === 1 ? 'h1' : 'h2'
const office = text(section.copy.kicker)
const headline = text(section.copy.headline)
const subheadline = text(section.copy.subheadline)
const caption = text(section.copy.caption)
// A two-word name breaks between its words; any other headline wraps as it falls.
const words = headline?.trim().split(/\s+/) ?? []
const lines = words.length === 2 ? words : null
const photo = heroPhoto(section, 'photoUrl')
// Without a portrait the section's picture stands in for it, as before.
const portrait = photo ?? heroPhoto(section, 'imageUrl')
// A place behind the portrait: the section's picture when the portrait is its own photo.
const backdrop = photo ? safeSrc(section.media.imageUrl?.url) : null
const buttons = links(section)
---
{(headline || subheadline || portrait) && (
  <Band section={section} class:list={['hero-portrait', backdrop && 'hero-portrait-photo']}>
    {backdrop && (
      <>
        <img class="hp-backdrop" src={backdrop} alt="" loading={level === 1 ? 'eager' : 'lazy'} decoding="async" />
        <div class="hp-scrim" aria-hidden="true"></div>
      </>
    )}
    <div class:list={['hp', portrait && 'hp-with-portrait', backdrop && 'on-photo']}>
      <div class="hp-words">
        {office && <p class="hp-office">{office}</p>}
        {headline && <Heading class="hp-name">{lines ? <><span>{lines[0]}</span> <span>{lines[1]}</span></> : headline}</Heading>}
        {subheadline && <p class="hp-lede">{subheadline}</p>}
        {buttons.length > 0 && (
          <p class="actions">
            {buttons.map((link, i) => <a class:list={['button', i > 0 && 'button-quiet']} href={link.href} rel={link.rel}>{link.label}</a>)}
          </p>
        )}
        {section.embed && <ModuleFrame embed={section.embed} band={section.band} type="SignupCapture" layout="card" title="Sign up" height="24rem" class="hp-signup" />}
      </div>
      {portrait && (
        <div class="hp-frame">
          <img
            class="hp-portrait"
            src={portrait.url}
            alt={portrait.alt}
            loading={level === 1 ? 'eager' : 'lazy'}
            fetchpriority={level === 1 ? 'high' : undefined}
            decoding="async"
          />
          {caption && <p class="photo-caption hp-caption">{caption}</p>}
        </div>
      )}
    </div>
  </Band>
)}

<style>
  /*
    The portrait stands on the floor: the band keeps its top padding and drops
    the bottom one, which the stripe replaces. The stripe and the office line's
    rule are the brand's accent itself in both sets (C1, C9): they are
    decoration, not text, so they keep the accent where the band's accent for
    text falls back to its ink.
  */
  :global(.bg-section.hero-portrait) {
    position: relative;
    overflow: hidden;
    padding-bottom: 0;
  }
  :global(.bg-section.hero-portrait)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0.625rem;
    background: var(--bg-brand-accent, var(--accent));
  }
  .hp {
    display: grid;
    align-items: end;
  }
  .hp-words {
    padding-bottom: calc(var(--space) * 0.75 + 0.625rem);
    min-width: 0;
  }
  .hp-office {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .hp-office::before {
    content: '';
    flex: 0 0 auto;
    width: 1.75rem;
    height: 3px;
    background: var(--bg-brand-accent, var(--accent));
  }
  .hp-name {
    margin: 1rem 0 0;
    /* C9's 58px on a phone, C1's 132px on a wide screen. */
    font-size: clamp(3.625rem, 1.6rem + 7vw, 8.25rem);
    font-weight: 800;
    line-height: 0.86;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    max-width: none;
  }
  .hp-name span {
    display: block;
  }
  .hp-lede {
    max-width: 30em;
    margin: 1.5rem 0 0;
    color: var(--muted);
    font-size: var(--text-lg);
  }
  .hp-words .actions {
    margin-top: 1.875rem;
  }
  .hp-words > :global(.hp-signup) {
    margin-top: 1.5rem;
    max-width: 36rem;
  }
  /* The place behind the words and the portrait, under the Full photo hero's scrim (deepest where the words sit). */
  .hp-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
  .hp-scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--band-photo) 90%, transparent) 0%,
      color-mix(in srgb, var(--band-photo) 78%, transparent) 50%,
      color-mix(in srgb, var(--band-photo) 55%, transparent) 100%
    );
  }
  :global(.bg-section.hero-portrait-photo) .hp {
    position: relative;
    z-index: 1;
  }
  .hp-frame {
    position: relative;
    min-width: 0;
    margin-bottom: 0.625rem;
  }
  .hp-portrait {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3.4;
    object-fit: cover;
    border-radius: 1.25rem 1.25rem 0 0;
  }
  /* C1 sets the portrait's caption a little higher off its foot than a photo's. */
  .hp-caption {
    bottom: 0.875rem;
  }
  @media (min-width: 48rem) {
    .hp-with-portrait {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: clamp(2rem, 4vw, 2.75rem);
      min-height: 36rem;
    }
    .hp-with-portrait .hp-words {
      align-self: center;
      padding-bottom: var(--space);
    }
    .hp-portrait {
      aspect-ratio: 4 / 5;
      border-radius: 1.625rem 1.625rem 0 0;
    }
  }
</style>
