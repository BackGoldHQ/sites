---
// Countdown, 'tiles' layout (board C1, section 2): the heading and the day
// at the left, and at the right the time left as three tiles, days, hours
// and minutes, counted in the visitor's browser. Pages are cached until the
// content changes, so the server writes only the deadline: without script
// the heading and the day read plainly and no tiles are drawn. The tiles
// tick once a minute, or are set once and left when the visitor asks for
// reduced motion. Once the deadline has passed the section hides itself
// (C-8 as drawn), and a page rendered after it draws nothing.
import type { Section } from '@backgold/content'
import Band from '@backgold/template-kit/components/sections/Band.astro'
import { rows } from '@backgold/template-kit/lib/section'
import { formatWhen, text } from '@backgold/template-kit/lib/format'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const heading = text(section.copy.heading)
const deadline = text(rows(section)[0]?.deadline)
const when = formatWhen(deadline)
const end = deadline ? Date.parse(deadline) : NaN
const ahead = Number.isFinite(end) && end > Date.now()
---
{deadline && when && ahead && (
  <Band section={section} class="countdown-tiles">
    <div class="ct" data-countdown-ends={deadline}>
      <div class="ct-words">
        {heading && <h2 class="ct-heading">{heading}</h2>}
        <p class="ct-when"><time datetime={deadline}>{when}</time></p>
      </div>
      <dl class="ct-tiles" hidden>
        <div class="ct-tile"><dt>Days</dt><dd data-unit="days">0</dd></div>
        <div class="ct-tile"><dt>Hours</dt><dd data-unit="hours">0</dd></div>
        <div class="ct-tile"><dt>Minutes</dt><dd data-unit="minutes">0</dd></div>
      </dl>
    </div>
    <script is:inline>
      (function (tiles) {
        var band = tiles.closest('.bg-section')
        var end = Date.parse(tiles.closest('[data-countdown-ends]').getAttribute('data-countdown-ends'))
        if (isNaN(end)) return
        var pad = function (n) { return n < 10 ? '0' + n : String(n) }
        var set = function () {
          var ms = end - Date.now()
          if (ms <= 0) {
            band.hidden = true
            return false
          }
          var minutes = Math.floor(ms / 60000)
          tiles.querySelector('[data-unit="days"]').textContent = pad(Math.floor(minutes / 1440))
          tiles.querySelector('[data-unit="hours"]').textContent = pad(Math.floor((minutes % 1440) / 60))
          tiles.querySelector('[data-unit="minutes"]').textContent = pad(minutes % 60)
          tiles.hidden = false
          return true
        }
        if (!set()) return
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
        var timer = setInterval(function () {
          if (!set()) clearInterval(timer)
        }, 60000)
      })(document.currentScript.previousElementSibling.querySelector('.ct-tiles'))
    </script>
  </Band>
)}

<style>
  .ct {
    display: grid;
    gap: 1.25rem;
    align-items: center;
  }
  .ct-heading {
    margin: 0;
    max-width: 18em;
  }
  .ct-when {
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: var(--text-lg);
  }
  .ct-tiles {
    display: flex;
    gap: 0.5rem;
    margin: 0;
  }
  .ct-tiles[hidden] {
    display: none;
  }
  .ct-tile {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.75rem 0.375rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--surface);
    box-shadow: var(--shadow);
    text-align: center;
  }
  .ct-tile dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 0.95;
    font-variant-numeric: tabular-nums;
  }
  .ct-tile dt {
    order: 2;
    margin-top: 0.375rem;
    color: var(--muted);
    font-size: 0.65625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  @media (min-width: 48rem) {
    .ct {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 2.75rem;
    }
    .ct-tiles {
      gap: 0.75rem;
    }
    .ct-tile {
      flex: 0 0 auto;
      min-width: 7rem;
      padding: 1rem 0.875rem 0.875rem;
    }
    .ct-tile dd {
      font-size: 4.25rem;
    }
    .ct-tile dt {
      font-size: var(--text-xs);
      letter-spacing: 0.16em;
    }
  }
</style>
