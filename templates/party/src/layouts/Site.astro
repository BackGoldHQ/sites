---
// Every page's frame, as template.json's `chrome` and `areas` declare it and
// boards A1 (desktop) and A13 (phone) draw it:
//
//   Top banner       (`top_banner`) first, above the header, full width: a
//                    Call to action · Strip is A1's slim announcement strip,
//                    a TakeoverBanner fills the first screen.
//   the header bar   the brand (the logo, else the template's mark and the
//                    name as a two-line wordmark) at the left; the header
//                    menu, each group a dropdown; the light and dark switch
//                    (ModeToggle, unless the site's appearance is pinned);
//                    the header button at the right. On a phone the menu opens as a sheet under the
//                    bar (its groups open in place, the header button again
//                    full width, the legal line under it) and the button
//                    stays beside Menu in the bar until the sheet opens.
//   the page         <main>; each page renders its own single <h1>.
//   other areas      any area this template does not place (one the
//                    organization added in BackGold), after the page, full
//                    width, in the order BackGold lists the site's areas.
//   Above the footer (`above_footer`) over the footer, full width, inside
//                    #above-the-footer (the newsletter issue's closing call
//                    links there when the area holds a sign-up). An email
//                    sign-up there is drawn in A1's band (SignupBand): its
//                    kicker and heading beside BackGold's form.
//   the footer       the brand, the site's description and social links,
//                    the footer menu as columns (a column per group), the
//                    legal line, and the bottom row: the utility menu and
//                    "Powered by BackGold".
//
// The Sidebar (`sidebar`) is drawn beside the page by the routes, in
// src/pages/[...path].astro and preview.astro. The takeover banner is the
// TakeoverBanner section an area carries (most often Top banner); it draws
// through the sections map like any area item.
//
// The type is the template's own: Fraunces and Public Sans, the faces the
// boards name, from Google Fonts (the boards load them from there too).
//
// `page` is the BackGold page being drawn as `{ id, takes_donations }`, or
// null on a route with no BackGold page (a list, an entry, an author, a
// tag, the 404); the menus apply each link's Shows on rule against it.
// Every route here passes it: left out, every link and the button show.
// `areas` is the response's `areas`; null draws no area.
import type { Areas } from '@backgold/content'
import { Analytics, Area, Disclaimer, MenuButton, Seo } from '@backgold/astro/components'
import { menuOf, relFor, safeHref, type MenuPage } from '@backgold/astro/server'
import Brand from '../components/chrome/Brand.astro'
import FooterColumns from '../components/chrome/FooterColumns.astro'
import MenuList from '../components/chrome/MenuList.astro'
import ModeToggle from '../components/chrome/ModeToggle.astro'
import SignupBand from '../components/chrome/SignupBand.astro'
import { sections } from '../components/sections'
import { appearanceOf, brandCss } from '../lib/brand'
import '../styles/site.css'

interface Props {
  title?: string
  description?: string
  image?: string
  canonicalPath: string
  noindex?: boolean
  jsonLd?: object[]
  page?: MenuPage | null
  areas?: Areas | null
}

/** The areas this layout (and the routes, for the Sidebar) place by name. */
const PLACED_AREAS = ['top_banner', 'sidebar', 'above_footer']

const bg = Astro.locals.backgold
if (bg.setup !== null) throw new Error('The site key is not configured; the setup page renders instead of this layout.')

const { site, legal, client } = bg
const { page, areas = null, ...head } = Astro.props
const [primary, footer, utility] = await Promise.all([client.menu('primary'), client.menu('footer'), client.menu('utility')])
const pathname = Astro.url.pathname
const headerItems = primary?.items ?? []
const headerNodes = menuOf(headerItems, pathname, page)
const footerNodes = menuOf(footer?.items ?? [], pathname, page)
const bottomRow = menuOf(utility?.items ?? [], pathname, page).flatMap((node) => [node, ...node.children]).filter((node) => node.href)
const otherAreas = areas ? Object.keys(areas).filter((key) => !PLACED_AREAS.includes(key)) : []
const name = site.name ?? site.domain
const description = site.seo.description?.trim() || null
/** A1's social circles: the platform's short name in the circle (its first two letters when A1 names none), its full name for screen readers. */
const SHORT: Record<string, string> = { facebook: 'Fb', x: 'X', twitter: 'X', instagram: 'Ig', youtube: 'Yt' }
const social = site.social.flatMap(({ platform, url }) => {
  const href = safeHref(url)
  const label = platform.charAt(0).toUpperCase() + platform.slice(1)
  return href ? [{ label, short: SHORT[platform.toLowerCase()] ?? label.slice(0, 2), href, rel: relFor(href) }] : []
})
/** The area map Above the footer: an email sign-up there takes A1's band. */
const aboveFooter = { ...sections, SignupCapture: SignupBand }
/** Light, dark, or auto (the visitor's system, with the header's switch). */
const appearance = appearanceOf(site.style)
const FONTS = 'https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,800;1,9..144,500&family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap'
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...head} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Never render-blocking: the faces arrive after first paint (display=swap
        holds the fallback stack until then), and without script they load as
        a plain stylesheet. */}
    <link rel="stylesheet" href={FONTS} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={FONTS} /></noscript>
    <style is:inline set:html={brandCss(site.brand, appearance)}></style>
    {appearance === 'auto' && (
      <script is:inline>
        try {
          var mode = localStorage.getItem('gg-mode')
          if (mode === 'dark' || mode === 'light') document.documentElement.setAttribute('data-gg-mode', mode)
        } catch (e) {}
      </script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Area name="top_banner" areas={areas} components={sections} />
    <header class="site-header">
      <div class="site-header-inner">
        <Brand name={name} logoUrl={site.brand.logo_url} />
        {headerNodes.length > 0 && (
          <>
            <nav class="header-bar-menu" aria-label="Header menu">
              <MenuList nodes={headerNodes} mode="bar" />
            </nav>
            <details class="header-sheet">
              <summary><span class="sheet-open">Menu</span><span class="sheet-close">Close</span></summary>
              <div class="header-sheet-panel">
                <nav aria-label="Header menu">
                  <MenuList nodes={headerNodes} mode="sheet" />
                </nav>
                <MenuButton items={headerItems} page={page} class="button header-sheet-button" />
                <div class="header-sheet-legal"><Disclaimer legal={legal} /></div>
              </div>
            </details>
          </>
        )}
        {appearance === 'auto' && <ModeToggle />}
        <MenuButton items={headerItems} page={page} class="button button-small header-button" />
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    {otherAreas.map((key) => <Area name={key} areas={areas} components={sections} class="bg-area-after-page" />)}
    <div id="above-the-footer">
      <Area name="above_footer" areas={areas} components={aboveFooter} />
    </div>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <div class="footer-grid">
          <div class="footer-brand">
            <Brand name={name} logoUrl={site.brand.logo_url} />
            {description && <p class="footer-description">{description}</p>}
            {social.length > 0 && (
              <ul class="social" aria-label="Social media">
                {social.map((s) => <li><a href={s.href} rel={s.rel} aria-label={s.label}>{s.short}</a></li>)}
              </ul>
            )}
          </div>
          <FooterColumns nodes={footerNodes} />
        </div>
        {/*
          The legal line ("Paid for by …") must appear on every page, as text in
          the HTML the server sends. It is required by law, and BackGold checks
          the live home page for it every hour and warns the organization when
          it is missing. Restyle it freely; do not remove it, split it or render
          it with client-side script.
        */}
        <div class="disclaimer">
          <Disclaimer legal={legal} />
        </div>
        <div class="footer-row">
          {bottomRow.length > 0 && (
            <nav aria-label="Bottom row">
              <ul>
                {bottomRow.map((node) => <li><a href={node.href} rel={node.rel} aria-current={node.current ? 'page' : undefined}>{node.label}</a></li>)}
              </ul>
            </nav>
          )}
          <span class="footer-powered">Powered by BackGold</span>
        </div>
      </div>
    </footer>
    <Analytics />
  </body>
</html>
