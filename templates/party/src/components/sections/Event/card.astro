---
// One event · Card: one event on another page, compact, on a raised card: its
// date, place and one RSVP or Get tickets.
import type { Section } from '@backgold/content'
import Headed from '../modules/Headed.astro'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
---
<Headed section={section} layout="card" card height="16rem" narrow />
