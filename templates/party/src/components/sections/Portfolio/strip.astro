---
// Portfolio · Strip: the kicker and heading, the body, then the work in one
// row that scrolls sideways, the featured layout's thumbnails on their own
// at a size to read: each piece its picture at 3:2 (or, with none, its
// title large on a panel of the band's surface), then its title (a link to
// its page, or to its picture when it has no page) and its kind in small
// capitals under it. About three and a half pieces show on a wide screen,
// so the next one is always in view at the edge; a phone shows one and a
// little of the next. The row snaps to a piece's edge, takes the keyboard's
// arrow keys when it has focus, and keeps the browser's own scroll bar. No
// script. Nothing is drawn with no work and no heading.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import Prose from '../../Prose.astro'
import { text } from '../../../lib/format'
import { targetOf, workOf } from './work'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
const work = workOf(section)
---
{(heading || work.length > 0) && (
  <Band section={section} class="portfolio portfolio-strip">
    <SectionHead kicker={kicker} heading={heading} more={[]} />
    <Prose value={section.copy.body} class="lede" />
    {work.length > 0 && (
      <ul class="strip" role="list" tabindex="0" aria-label={heading ?? 'Our work'}>
        {work.map((piece) => {
          const target = targetOf(piece)
          return (
            <li class="strip-card">
              <div class:list={['strip-frame', !piece.pictures[0] && 'strip-frame-words']}>
                {piece.pictures[0] ? (
                  <img class="strip-photo" src={piece.pictures[0]} alt="" loading="lazy" decoding="async" />
                ) : (
                  <p class="strip-frame-title" aria-hidden="true">{piece.title}</p>
                )}
              </div>
              <h3 class="strip-title">{target ? <a href={target.href} rel={target.rel}>{piece.title}</a> : piece.title}</h3>
              {piece.kind && <p class="strip-kind">{piece.kind}</p>}
            </li>
          )
        })}
      </ul>
    )}
  </Band>
)}

<style>
  /* The padding keeps a focused card's ring inside the scroll box. */
  .strip {
    display: flex;
    gap: 1rem;
    margin: 0 -0.375rem;
    padding: 0.375rem 0.375rem 1rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0.375rem;
    overscroll-behavior-x: contain;
  }
  .strip:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
    border-radius: var(--radius);
  }
  .strip-card {
    position: relative;
    flex: 0 0 78%;
    min-width: 0;
    scroll-snap-align: start;
    border-radius: var(--radius-card);
  }
  .strip-card > p,
  .strip-card > h3 {
    margin: 0;
  }
  .strip-frame {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }
  .strip-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .strip-frame-words {
    display: grid;
    place-items: center;
    padding: 1.25rem;
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: inset 0 -3px 0 var(--accent);
  }
  .strip-frame-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.15rem + 0.8vw, 1.875rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-align: center;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .strip-card .strip-title {
    margin-top: 0.75rem;
    font-size: calc(var(--h3) * 0.85);
    font-weight: 700;
    line-height: 1.2;
  }
  .strip-title a {
    color: var(--ink);
    text-decoration: none;
  }
  /* The title's link covers the card. */
  .strip-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
  }
  .strip-card:hover .strip-title a {
    text-decoration: underline;
  }
  .strip-card:focus-within {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
  .strip-title a:focus-visible {
    outline: none;
  }
  .strip-card .strip-kind {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  @media (min-width: 40rem) {
    .strip-card {
      flex-basis: 44%;
    }
  }
  @media (min-width: 56rem) {
    .strip {
      gap: 1.25rem;
    }
    .strip-card {
      flex-basis: calc((100% - 3 * 1.25rem) / 3.4);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .strip {
      scroll-behavior: smooth;
    }
    .strip-photo {
      transition: transform 0.3s ease;
    }
    .strip-card:hover .strip-photo {
      transform: scale(1.03);
    }
  }
</style>
