---
// Scorecard, 'grades' layout (board 04, "Grade cards"): the section head and
// the body, then a card for each person the rows name: the photo (their
// initials when there is none) as the Team board draws it, the name in the
// display face, the office in the muted ink, the grade very large in the
// display face and the score under it ("94/100"). Every grade is drawn in the
// same ink whatever it is; the accent is only the rule along each card's
// top. Four cards across on a wide screen, two on a phone. Rows that name no
// one (the votes) are not drawn here. Nothing is drawn with neither a heading
// nor a person.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import Prose from '../../Prose.astro'
import { text } from '../../../lib/format'
import { initials } from '../TeamGrid/people'
import { gradedOf } from './votes'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
const people = gradedOf(section)
---
{(heading || people.length > 0) && (
  <Band section={section} class="scorecard scorecard-grades">
    <SectionHead kicker={kicker} heading={heading} more={[]} />
    <Prose value={section.copy.body} class="lede" />
    {people.length > 0 && (
      <ul class="grades" role="list">
        {people.map((p) => (
          <li class="grade-card">
            {p.photo ? (
              <img class="grade-photo" src={p.photo} alt="" loading="lazy" decoding="async" />
            ) : (
              <span class="grade-photo grade-initials" aria-hidden="true">{initials(p.name)}</span>
            )}
            <h3 class="grade-name">{p.name}</h3>
            {p.office && <p class="grade-office">{p.office}</p>}
            {p.grade && (
              <p class="grade-letter">
                <span class="visually-hidden">Grade </span>{p.grade}
              </p>
            )}
            {p.score !== null && (
              <p class="grade-score">
                <span class="visually-hidden">Score </span>{p.score}/100
              </p>
            )}
          </li>
        ))}
      </ul>
    )}
  </Band>
)}

<style>
  .grades {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .grade-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    padding: 1.125rem 0.875rem 1rem;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) * 1.5);
    background: var(--surface);
    box-shadow: inset 0 3px 0 var(--accent);
    text-align: center;
  }
  .grade-card > * {
    margin: 0;
  }
  .grade-photo {
    display: block;
    width: 4.5rem;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .grade-initials {
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--ink) 8%, transparent);
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .grade-card .grade-name {
    margin-top: 0.875rem;
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.2;
  }
  .grade-card .grade-office {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.35;
    text-wrap: balance;
  }
  .grade-card .grade-letter {
    margin-top: auto;
    padding-top: 0.875rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 2.4rem + 2.4vw, 4.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .grade-card .grade-score {
    margin-top: 0.375rem;
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 48rem) {
    .grades {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }
    .grade-card {
      padding: 1.5rem 1.25rem 1.375rem;
    }
    .grade-photo {
      width: 5.5rem;
    }
  }
</style>
