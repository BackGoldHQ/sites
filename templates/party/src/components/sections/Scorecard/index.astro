---
// Scorecard, 'table' layout, the default (board 04, "Vote tracker table"):
// the section head (the kicker and the heading), the body, then the votes as
// a table on the band's surface: the bill (linked to its roll call when the
// row has one), the issue, the vote as a chip (YEA, NAY, ABSENT), whether it
// agrees with the party's position (a check and "Agrees" in the accent, a
// cross and "Disagrees" in the muted ink; the word carries the meaning), and
// the day. A column no vote fills is left out. The source note sits small
// under the table.
//
// When the votes span more than one issue, a chip per issue ("All" first,
// then each issue in row order) narrows the table to that issue's votes. The
// chips are drawn hidden and shown by the section's script, so with scripts
// off every vote shows and nothing is offered that cannot work.
//
// On a phone each vote is a block of its own: the bill over its cells, each
// cell labelled with its column's header. Nothing is drawn with neither a
// heading nor a vote.
import type { Section } from '@backgold/content'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import Prose from '../../Prose.astro'
import { text } from '../../../lib/format'
import { votesOf } from './votes'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
const sourceNote = text(section.copy.sourceNote)
const votes = votesOf(section)
const issues = [...new Set(votes.map((v) => v.issue).filter((issue): issue is string => issue !== null))]
const tableId = `${section.id}-votes`.replace(/[^A-Za-z0-9_-]/g, '-')
const columns = {
  issue: votes.some((v) => v.issue),
  vote: votes.some((v) => v.vote),
  position: votes.some((v) => v.position),
  date: votes.some((v) => v.day),
}
---
{(heading || votes.length > 0) && (
  <Band section={section} class="scorecard scorecard-table">
    <SectionHead kicker={kicker} heading={heading} more={[]} />
    <Prose value={section.copy.body} class="lede" />
    {votes.length > 0 && (
      <div class="score" data-scorecard>
        {issues.length > 1 && (
          <div class="score-issues" role="group" aria-label="Filter by issue" data-scorecard-issues hidden>
            <button type="button" aria-pressed="true" aria-controls={tableId} data-scorecard-issue="">All</button>
            {issues.map((issue) => (
              <button type="button" aria-pressed="false" aria-controls={tableId} data-scorecard-issue={issue}>{issue}</button>
            ))}
          </div>
        )}
        <div class="score-frame">
          <table class="score-table" id={tableId}>
            {heading && <caption class="visually-hidden">{heading}</caption>}
            <thead>
              <tr>
                <th scope="col">Bill</th>
                {columns.issue && <th scope="col">Issue</th>}
                {columns.vote && <th scope="col">Vote</th>}
                {columns.position && <th scope="col">Position</th>}
                {columns.date && <th scope="col">Date</th>}
              </tr>
            </thead>
            <tbody>
              {votes.map((v) => (
                <tr class="score-row" data-issue={v.issue ?? ''}>
                  <td class="score-bill">{v.link ? <a href={v.link.href} rel={v.link.rel}>{v.bill}</a> : v.bill}</td>
                  {columns.issue && <td data-label="Issue">{v.issue}</td>}
                  {columns.vote && <td data-label="Vote">{v.vote && <span class:list={['chip', 'score-vote', v.vote === 'Absent' && 'score-vote-absent']}>{v.vote}</span>}</td>}
                  {columns.position && (
                    <td data-label="Position">
                      {v.position === 'agrees' && (
                        <span class="score-position score-agrees">
                          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M3 8.5l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                          Agrees
                        </span>
                      )}
                      {v.position === 'disagrees' && (
                        <span class="score-position score-disagrees">
                          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                          Disagrees
                        </span>
                      )}
                    </td>
                  )}
                  {columns.date && <td data-label="Date" class="score-date">{v.day && <time datetime={v.date}>{v.day}</time>}</td>}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {issues.length > 1 && <p class="visually-hidden" role="status" data-scorecard-showing></p>}
        {issues.length > 1 && (
          <script is:inline>
            (function (root) {
              if (!root) return
              var group = root.querySelector('[data-scorecard-issues]')
              var chips = group.querySelectorAll('[data-scorecard-issue]')
              var votes = root.querySelectorAll('tbody tr')
              var showing = root.querySelector('[data-scorecard-showing]')
              var choose = function (chip) {
                var issue = chip.getAttribute('data-scorecard-issue')
                var shown = 0
                for (var c = 0; c < chips.length; c++) chips[c].setAttribute('aria-pressed', chips[c] === chip ? 'true' : 'false')
                for (var v = 0; v < votes.length; v++) {
                  var match = !issue || votes[v].getAttribute('data-issue') === issue
                  votes[v].hidden = !match
                  if (match) shown++
                }
                showing.textContent = issue ? 'Showing ' + shown + ' of ' + votes.length + ' votes: ' + issue + '.' : 'Showing all ' + votes.length + ' votes.'
              }
              for (var c = 0; c < chips.length; c++) {
                chips[c].addEventListener('click', function (event) {
                  choose(event.currentTarget)
                })
              }
              group.hidden = false
            })(document.currentScript.closest('[data-scorecard]'))
          </script>
        )}
      </div>
    )}
    {votes.length > 0 && sourceNote && <p class="fine score-source">{sourceNote}</p>}
  </Band>
)}

<style>
  .score-issues {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1rem;
  }
  .score-issues[hidden] {
    display: none;
  }
  .score-issues button {
    min-height: 2.75rem;
    padding: 0.375rem 1rem;
    border: 1.5px solid color-mix(in srgb, var(--ink) 25%, transparent);
    border-radius: var(--pill);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }
  .score-issues button:hover {
    border-color: var(--ink);
  }
  .score-issues button[aria-pressed='true'] {
    border-color: var(--button);
    background: var(--button);
    color: var(--button-ink);
  }
  .score-frame {
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    overflow: hidden;
  }
  .score-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .score-table th {
    padding: 0.875rem 1.125rem;
    border-bottom: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--ink) 5%, transparent);
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-align: left;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .score-table td {
    padding: 0.9375rem 1.125rem;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }
  .score-row:last-child td {
    border-bottom: 0;
  }
  .score-row[hidden] {
    display: none;
  }
  .score-bill {
    font-weight: 700;
  }
  .score-bill a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--ink) 35%, transparent);
  }
  .score-bill a:hover {
    text-decoration-color: currentColor;
  }
  /* The vote is a fact, not a verdict: every vote wears the same neutral chip; an absence is drawn as a gap. */
  .score-vote {
    background: color-mix(in srgb, var(--ink) 9%, transparent);
    color: var(--ink);
    text-transform: uppercase;
  }
  .score-vote-absent {
    background: transparent;
    border: 1px dashed color-mix(in srgb, var(--ink) 35%, transparent);
    color: var(--muted);
  }
  .score-position {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .score-position svg {
    flex: 0 0 auto;
  }
  .score-agrees {
    color: var(--accent);
  }
  .score-disagrees {
    color: var(--muted);
  }
  .score-date {
    color: var(--muted);
    white-space: nowrap;
  }
  .score-source {
    margin: 0.875rem 0 0;
  }
  /* A phone: each vote a block, the bill over its cells, each cell under its header's name. */
  @media (max-width: 39.99rem) {
    .score-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .score-table,
    .score-table tbody {
      display: block;
    }
    .score-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem 1rem;
      padding: 1rem 1.125rem;
      border-bottom: 1px solid var(--line);
    }
    .score-row:last-child {
      border-bottom: 0;
    }
    .score-table td {
      display: grid;
      align-content: start;
      justify-items: start;
      gap: 0.25rem;
      padding: 0;
      border: 0;
    }
    .score-table td::before {
      content: attr(data-label);
      color: var(--muted);
      font-size: var(--text-xs);
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .score-table .score-bill {
      grid-column: 1 / -1;
      font-size: var(--text);
    }
    .score-table .score-bill::before {
      content: none;
    }
    .score-table td:empty {
      display: none;
    }
  }
</style>
