---
// Scorecard, 'promise' layout (board 04, "Record vs. promise"): the section
// head and the body, then two panels side by side (the first over the second
// on a phone). The first, on the band's surface, is what they said: its label
// small in capitals, the promise as a large quotation in the display face
// (curly quotes added, any typed around it dropped) and where it was said,
// muted. The second, filled in the band's second button colour, is what they
// did: its label, the headline large, the line under it, and the bills of
// the section's votes as a list of links to their roll calls (a bill with no
// address in plain text). A panel with none of its words is left out and the
// other spans the row. The source note sits small under both. Nothing is
// drawn without a promise or a headline.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import Prose from '../../Prose.astro'
import { text } from '../../../lib/format'
import { votesOf } from './votes'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const copy = section.copy
const kicker = text(copy.kicker)
const heading = text(copy.heading)
const promiseLabel = text(copy.promiseLabel)
const promise = text(copy.promise)?.trim().replace(/^["“”']+|["“”']+$/g, '').trim() || null
const promiseSource = text(copy.promiseSource)
const didLabel = text(copy.didLabel)
const did = text(copy.did)
const didDetail = text(copy.didDetail)
const sourceNote = text(copy.sourceNote)
const bills = votesOf(section)
const said = promise !== null
const done = did !== null || didDetail !== null
---
{(promise || did) && (
  <Band section={section} class="scorecard scorecard-promise">
    <SectionHead kicker={kicker} heading={heading} more={[]} />
    <Prose value={copy.body} class="lede" />
    <div class="record">
      {said && (
        <div class="record-panel record-said">
          {promiseLabel && <h3 class="record-label">{promiseLabel}</h3>}
          <figure class="record-quote">
            <blockquote><p>“{promise}”</p></blockquote>
            {promiseSource && <figcaption>{promiseSource}</figcaption>}
          </figure>
        </div>
      )}
      {done && (
        <div class="record-panel record-did">
          <div>
            {didLabel && <h3 class="record-label">{didLabel}</h3>}
            {did && <p class="record-headline">{did}</p>}
            {didDetail && <p class="record-detail">{didDetail}</p>}
          </div>
          {bills.length > 0 && (
            <p class="record-bills">
              {bills.map((b, i) => (
                <>
                  {i > 0 && ', '}
                  {b.link ? <a href={b.link.href} rel={b.link.rel}>{b.bill}</a> : b.bill}
                </>
              ))}
            </p>
          )}
        </div>
      )}
    </div>
    {sourceNote && <p class="fine record-source">{sourceNote}</p>}
  </Band>
)}

<style>
  .record {
    display: grid;
    gap: 1rem;
  }
  .record-panel {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(1.375rem, 1rem + 1.5vw, 2.25rem);
    border-radius: var(--radius-card);
  }
  .record-panel > * {
    margin: 0;
  }
  .record-said {
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .record-did {
    justify-content: space-between;
    gap: 1.5rem;
    border: 1px solid var(--button-2);
    background: var(--button-2);
    color: var(--button-2-ink);
  }
  .record-panel .record-label {
    margin-bottom: 0.875rem;
    color: var(--muted);
    font-family: var(--font);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .record-did .record-label {
    color: color-mix(in srgb, var(--button-2-ink) 78%, transparent);
  }
  .record-quote blockquote {
    margin: 0;
  }
  .record-quote blockquote p,
  .record-headline {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.15rem + 1.3vw, 2.125rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .record-quote blockquote p {
    text-indent: -0.42em;
  }
  .record-quote figcaption {
    margin-top: 1rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .record-did .record-detail {
    margin: 0.875rem 0 0;
    color: color-mix(in srgb, var(--button-2-ink) 88%, transparent);
  }
  .record-bills {
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--button-2-ink) 25%, transparent);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .record-bills a {
    color: var(--button-2-ink);
    text-decoration-color: color-mix(in srgb, var(--button-2-ink) 55%, transparent);
  }
  .record-bills a:hover {
    text-decoration-color: currentColor;
  }
  .record-did :focus-visible {
    outline-color: var(--button-2-ink);
  }
  .record-source {
    margin: 0.875rem 0 0;
  }
  @media (min-width: 48rem) {
    .record {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
  }
</style>
