---
// Map, 'directory' layout, the default (Map and directory; board
// A11-contact, section 4): the heading and the count of places organized
// ("lit"), a compact strip of one tile per place coloured by its status with
// a key under it, then the directory: a card per place with its status, the
// place's name a link when it has one. Open places have a dashed card. The
// section's links follow as buttons. The strip repeats what the directory
// says, so it is hidden from screen readers. Rows: `region`, `status` 'lit'
// or anything else, an optional `url`. 'map' is its own file beside this one.
import type { Section } from '@backgold/content'
import Band from '../Band.astro'
import { links, linkOf, rows } from '../../../lib/section'
import { text } from '../../../lib/format'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const heading = text(section.copy.heading)
const litLabel = text(section.copy.litLabel) ?? 'Organized'
const darkLabel = text(section.copy.darkLabel) ?? 'Still open'
const regions = rows(section)
  .map((row) => ({ name: text(row.region), lit: row.status === 'lit', link: linkOf(row.region, row.url) }))
  .filter((r): r is { name: string; lit: boolean; link: ReturnType<typeof linkOf> } => r.name !== null)
const litCount = regions.filter((r) => r.lit).length
const actions = links(section)
---
<Band section={section} class="regions">
  {heading && <h2>{heading}</h2>}
  {regions.length > 0 && <p class="lede">{litCount} of {regions.length} {litLabel.toLowerCase()}</p>}
  {regions.length > 0 && (
    <>
      <div class="strip" aria-hidden="true">
        {regions.map((r) => <span class:list={['strip-tile', r.lit && 'strip-tile-lit']}></span>)}
      </div>
      <p class="key" aria-hidden="true">
        <span><i class="key-swatch key-swatch-lit"></i>{litLabel}</span>
        <span><i class="key-swatch"></i>{darkLabel}</span>
      </p>
      <ul class="directory" role="list">
        {regions.map((r) => (
          <li class:list={['place', !r.lit && 'place-open']}>
            <span class="place-name">{r.link ? <a href={r.link.href} rel={r.link.rel}>{r.name}</a> : r.name}</span>
            <span class="place-status">{r.lit ? litLabel : darkLabel}</span>
          </li>
        ))}
      </ul>
    </>
  )}
  {actions.length > 0 && (
    <p class="actions">
      {actions.map((link, i) => <a class:list={['button', i > 0 && 'button-quiet']} href={link.href} rel={link.rel}>{link.label}</a>)}
    </p>
  )}
</Band>

<style>
  .strip {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(1.25rem, 1fr));
    gap: 0.25rem;
    margin-top: 1.5rem;
  }
  .strip-tile {
    aspect-ratio: 1.1;
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--ink) 9%, transparent);
  }
  .strip-tile-lit {
    background: var(--button);
  }
  @media (min-width: 48rem) {
    .strip {
      grid-template-columns: repeat(auto-fill, minmax(2.5rem, 1fr));
      gap: 0.375rem;
    }
    .strip-tile {
      border-radius: 0.5rem;
    }
  }
  .key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .key-swatch {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    margin-right: 0.375rem;
    border-radius: 0.1875rem;
    vertical-align: -0.0625rem;
    background: color-mix(in srgb, var(--ink) 9%, transparent);
    border: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
  }
  .key-swatch-lit {
    background: var(--button);
    border-color: var(--button);
  }
  .directory {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.625rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }
  @media (min-width: 40rem) {
    .directory {
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    }
  }
  .place {
    padding: 0.75rem 0.875rem;
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--page) 60%, transparent);
  }
  .place-open {
    border-style: dashed;
    border-color: color-mix(in srgb, var(--ink) 30%, transparent);
    background: transparent;
  }
  .place-name {
    display: block;
    font-weight: 700;
  }
  .place-status {
    display: block;
    color: var(--muted);
    font-size: var(--text-sm);
  }
</style>
