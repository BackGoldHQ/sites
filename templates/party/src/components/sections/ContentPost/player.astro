---
// ContentPost · Player (board 02, A, "Player + outline sidebar"): the piece's
// media large at the left, as its entry page plays it (lesson.ts): a video
// in its player at 16:9, a podcast's audio in the browser's controls beside
// its cover, the hero alone when the piece has no media. Under it the
// section's heading as a kicker, the title (linking to the piece's page on
// this site) and its date, then `notesLabel` ("Notes") as a small heading
// over the notes, the piece's body. At the right a panel headed by
// `linksHeading` ("In this lesson") numbers the section's links: the
// operator's syllabus, worksheets and further reading. Without links the
// panel is left out and the media and notes take the reading column.
// Nothing here knows who is watching: no progress, no "mark complete", no
// quiz.
//
// On a phone (and up to 56rem) the panel follows the notes. With no piece
// baked the section draws nothing, as the Card layout does.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import { lessonOf } from './lesson'
import { idFor } from '../SampleBallot/ballot'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const lesson = await lessonOf(section, Astro.locals.backgold)
const linksId = idFor(section, 'player-links')
---
{lesson && (
  <Band section={section} class="featured lesson-player">
    <div class:list={['lp', lesson.links.length > 0 && 'lp-with-links']}>
      <div class="lp-main">
        {lesson.media?.kind === 'embed' && (
          <div class="lp-frame">
            <iframe src={lesson.media.src} title={lesson.title} allow="encrypted-media; picture-in-picture; fullscreen" allowfullscreen loading="lazy"></iframe>
          </div>
        )}
        {lesson.media?.kind === 'video' && (
          <div class="lp-frame">
            <video src={lesson.media.src} poster={lesson.media.poster ?? undefined} controls preload="none" playsinline>
              <a href={lesson.media.src}>Watch the video</a>
            </video>
          </div>
        )}
        {lesson.media?.kind === 'audio' && (
          <div class="lp-audio">
            {lesson.media.cover && <img class="lp-cover" src={lesson.media.cover} alt="" width="160" height="160" decoding="async" />}
            <audio src={lesson.media.src} controls preload="none">
              <a href={lesson.media.src}>Download the audio</a>
            </audio>
          </div>
        )}
        {lesson.media?.kind === 'image' && <img class="lp-image" src={lesson.media.src} alt="" decoding="async" />}
        <div class="lp-head">
          {lesson.kicker && <p class="kicker">{lesson.kicker}</p>}
          <h2 class="lp-title featured-title">{lesson.href ? <a href={lesson.href}>{lesson.title}</a> : lesson.title}</h2>
          {lesson.day && lesson.date && <p class="fine"><time datetime={lesson.date}>{lesson.day}</time></p>}
        </div>
        {lesson.notes && (
          <div class="lp-notes">
            <h3 class="lp-label">{lesson.notesLabel}</h3>
            <div class="prose" set:html={lesson.notes} />
          </div>
        )}
      </div>
      {lesson.links.length > 0 && (
        <aside class="lp-side" aria-labelledby={linksId}>
          <h3 class="lp-side-title" id={linksId}>{lesson.linksHeading ?? 'In this lesson'}</h3>
          <ol class="lp-links" role="list">
            {lesson.links.map((link, i) => (
              <li>
                <a href={link.href} rel={link.rel}>
                  <span class="lp-num" aria-hidden="true">{i + 1}</span>
                  <span class="lp-link-label">{link.label}</span>
                </a>
              </li>
            ))}
          </ol>
        </aside>
      )}
    </div>
  </Band>
)}

<style>
  .lp {
    display: grid;
    gap: 1.75rem;
  }
  .lp:not(.lp-with-links) {
    max-width: calc(var(--measure) + 8rem);
  }
  .lp-main {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }
  .lp-main > * {
    margin: 0;
  }
  .lp-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--ink) 12%, transparent);
  }
  .lp-frame iframe,
  .lp-frame video {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .lp-audio {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .lp-cover {
    width: 7.5rem;
    height: 7.5rem;
    border-radius: calc(var(--radius) / 1.5);
    object-fit: cover;
  }
  .lp-audio audio {
    flex: 1 1 16rem;
    min-width: 0;
    width: 100%;
  }
  .lp-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    object-fit: cover;
  }
  .lp-head > * {
    margin: 0;
  }
  .lp-head .kicker {
    margin-bottom: 0.5rem;
  }
  .lp-head .lp-title {
    font-size: calc(var(--h2) * 0.75);
    line-height: 1.12;
  }
  .lp-head .fine {
    margin-top: 0.375rem;
  }
  .lp-notes {
    min-width: 0;
  }
  .lp-label {
    margin: 0 0 0.625rem;
    color: var(--muted);
    font-family: var(--font);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .lp-notes .prose > :global(:first-child) {
    margin-top: 0;
  }
  .lp-notes .prose > :global(:last-child) {
    margin-bottom: 0;
  }
  /* The body's headings, moved under the notes' own (lesson.ts). */
  .lp-notes .prose :global(h4),
  .lp-notes .prose :global(h5) {
    margin: 1.5rem 0 0.5rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.25;
  }
  .lp-notes .prose :global(h5) {
    font-family: var(--font);
    font-size: var(--text);
  }
  .lp-side {
    align-self: start;
    min-width: 0;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
  }
  .lp-side .lp-side-title {
    margin: 0 0 0.75rem;
    font-family: var(--font);
    font-size: var(--text);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.3;
  }
  .lp-links {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lp-links a {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 0.625rem;
    align-items: baseline;
    min-height: 2.75rem;
    padding: 0.625rem 0.75rem;
    border-radius: var(--radius);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
  }
  .lp-links a:hover {
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }
  .lp-links a:hover .lp-link-label {
    text-decoration: underline;
  }
  .lp-num {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }
  .lp-link-label {
    overflow-wrap: anywhere;
  }
  @media (min-width: 56rem) {
    .lp-with-links {
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 20rem);
      gap: 2rem;
      align-items: start;
    }
    .lp-side {
      position: sticky;
      top: 1.5rem;
    }
  }
</style>
