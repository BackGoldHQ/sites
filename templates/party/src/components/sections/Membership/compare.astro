---
// Membership, 'compare' layout (board 05, C, "Benefits comparison"): the
// section head and the body, then a table on the band's surface with the
// program's benefits down the first column (the benefits heading over it)
// and a column per offer the organization's join page sells: the offer's
// name, a "Symbolic price" chip on a tier whose amount carries a meaning, and
// its price with any other cadence under it in the header, then a check in
// every cell. The program's benefits come with every offer, so every cell is
// checked; each says "Included" to a screen reader. On a phone the table
// scrolls sideways inside its own bordered box, the benefits column held at
// the left edge.
//
// With one offer, or no benefits, there is nothing to compare: the offers are
// drawn as a card instead, each name with its price, the benefits checked
// under them. The join button and the note sit under either. Nothing is drawn
// when the program has no offers.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import Prose from '../../Prose.astro'
import Benefits from './Benefits.astro'
import Check from './Check.astro'
import Price from './Price.astro'
import { leadCadenceOf, membershipOf, otherCadences, type Offer } from './offers'
import { text } from '../../../lib/format'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const m = membershipOf(section)
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
const benefitsHeading = text(section.copy.benefitsHeading)
const table = m !== null && m.offers.length > 1 && m.benefits.length > 0
const regionId = `${section.id}-membership-compare`.replace(/[^A-Za-z0-9_-]/g, '-')
const lead = (offer: Offer) => leadCadenceOf(offer.cadences)
---
{m && (
  <Band section={section} class="membership membership-compare">
    <SectionHead kicker={kicker} heading={heading} more={[]} />
    <Prose value={section.copy.body} class="lede" />
    {table ? (
      <div class="ms-frame" role="region" aria-labelledby={regionId} tabindex="0">
        <table class="ms-table" style={`--ms-offers: ${m.offers.length}`}>
          <caption class="visually-hidden" id={regionId}>{heading ?? benefitsHeading ?? 'Membership'}</caption>
          <thead>
            <tr>
              <th scope="col" class="ms-benefit-col">{benefitsHeading ?? <span class="visually-hidden">Benefit</span>}</th>
              {m.offers.map((offer) => {
                const others = otherCadences(offer)
                return (
                  <th scope="col" class="ms-offer-col">
                    <span class="ms-offer-name">{offer.name}</span>
                    {offer.symbolic && <span class="chip ms-symbolic">Symbolic price</span>}
                    <span class="ms-offer-price">
                      <Price cents={lead(offer) ? offer.cents[lead(offer)!]! : null} cadence={lead(offer)} from={offer.model === 'donation'} />
                    </span>
                    {others.length > 0 && (
                      <span class="ms-offer-or">
                        or{' '}
                        {others.map((cadence, i) => (
                          <>
                            {i > 0 && ' or '}
                            <Price cents={offer.cents[cadence]!} cadence={cadence} />
                          </>
                        ))}
                      </span>
                    )}
                  </th>
                )
              })}
            </tr>
          </thead>
          <tbody>
            {m.benefits.map((benefit) => (
              <tr>
                <th scope="row" class="ms-benefit-col">{benefit}</th>
                {m.offers.map(() => (
                  <td>
                    <Check />
                    <span class="visually-hidden">Included</span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="ms-single">
        <ul class="ms-single-offers" role="list">
          {m.offers.map((offer) => {
            const others = otherCadences(offer)
            return (
              <li>
                <span class="ms-single-name">
                  {offer.name}
                  {offer.symbolic && <span class="chip ms-symbolic">Symbolic price</span>}
                </span>
                <span class="ms-single-price">
                  <Price cents={lead(offer) ? offer.cents[lead(offer)!]! : null} cadence={lead(offer)} from={offer.model === 'donation'} />
                  {others.length > 0 && (
                    <span class="ms-offer-or">
                      or{' '}
                      {others.map((cadence, i) => (
                        <>
                          {i > 0 && ' or '}
                          <Price cents={offer.cents[cadence]!} cadence={cadence} />
                        </>
                      ))}
                    </span>
                  )}
                  {offer.model === 'donation' && <span class="ms-offer-or">You choose the amount</span>}
                </span>
              </li>
            )
          })}
        </ul>
        {m.benefits.length > 0 && (
          <div class="ms-single-perks">
            {benefitsHeading && <h3 class="ms-single-label">{benefitsHeading}</h3>}
            <Benefits items={m.benefits} />
          </div>
        )}
      </div>
    )}
    {(m.join || m.note) && (
      <div class="ms-after">
        {m.join && <a class="button" href={m.join.href} rel={m.join.rel}>{m.join.label}</a>}
        {m.note && <p class="fine">{m.note}</p>}
      </div>
    )}
  </Band>
)}

<style>
  /* Positioned, so a cell's visually hidden "Included" stays inside the scroll box instead of widening the page. */
  .ms-frame {
    position: relative;
    overflow-x: auto;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--ink);
    overscroll-behavior-x: contain;
  }
  .ms-table {
    width: 100%;
    min-width: calc(10.5rem + var(--ms-offers) * 8.5rem);
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.9375rem;
  }
  .ms-table th,
  .ms-table td {
    padding: 0.9375rem 1.125rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: middle;
  }
  .ms-table tbody tr:last-child > * {
    border-bottom: 0;
  }
  .ms-table thead th {
    padding-block: 1.125rem 1.25rem;
    border-bottom: 1px solid var(--button-2);
    background: var(--button-2);
    color: var(--button-2-ink);
    vertical-align: bottom;
    --ms-price-size: clamp(1.625rem, 1.4rem + 0.6vw, 2rem);
  }
  .ms-table thead .ms-benefit-col {
    color: color-mix(in srgb, var(--button-2-ink) 78%, transparent);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .ms-benefit-col {
    position: sticky;
    left: 0;
    z-index: 1;
    width: 36%;
    min-width: 10.5rem;
    background: var(--surface);
    font-weight: 500;
  }
  tbody .ms-benefit-col {
    box-shadow: inset -1px 0 0 var(--line);
  }
  .ms-offer-col {
    min-width: 8.5rem;
  }
  .ms-offer-name {
    display: block;
    font-weight: 700;
    line-height: 1.3;
  }
  .ms-symbolic {
    margin-top: 0.375rem;
  }
  .ms-table .ms-symbolic {
    background: color-mix(in srgb, var(--button-2-ink) 16%, transparent);
    color: var(--button-2-ink);
  }
  .ms-offer-price {
    display: block;
    margin-top: 0.5rem;
    line-height: 1.05;
    white-space: nowrap;
  }
  .ms-offer-or {
    display: block;
    margin-top: 0.375rem;
    font-size: var(--text-sm);
    font-weight: 500;
    opacity: 0.85;
    --ms-price-size: 1em;
  }
  .ms-offer-or :global(.ms-price-amount) {
    font-family: var(--font);
    font-weight: 700;
    letter-spacing: 0;
  }
  :global(.lede) + .ms-frame,
  :global(.lede) + .ms-single {
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
  }
  .ms-table td {
    --ms-check: var(--accent);
  }
  .ms-table td :global(.ms-check) {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
  }
  .ms-table thead :focus-visible,
  .ms-frame:focus-visible {
    outline-offset: 2px;
  }
  .ms-single {
    display: grid;
    gap: 1.5rem;
    max-width: 40rem;
    padding: clamp(1.375rem, 1rem + 1.2vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--ink);
    --ms-price-size: clamp(2rem, 1.7rem + 1vw, 2.5rem);
  }
  .ms-single-offers {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ms-single-offers li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }
  .ms-single-offers li + li {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .ms-single-name {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    font-weight: 700;
  }
  .ms-single-name .ms-symbolic {
    margin: 0;
  }
  .ms-single-price {
    text-align: right;
  }
  .ms-single-perks {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .ms-single-label {
    margin: 0 0 0.875rem;
    color: var(--muted);
    font-family: var(--font);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .ms-after {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.5rem;
  }
  .ms-after .fine {
    margin: 0;
  }
  :global(.bg-band-contrast) .ms-frame,
  :global(.bg-band-contrast) .ms-single {
    border-color: var(--line);
  }
</style>
