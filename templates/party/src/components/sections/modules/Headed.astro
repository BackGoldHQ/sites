---
// A BackGold module under its section head: the kicker and heading the
// section carries, then the module's frame (ModuleFrame). Petition, One event,
// Store, Calendar and Contact your legislators draw through this, each with
// its own card and starting height. A module with nothing to frame keeps its
// head and says it is not available (ModuleFrame).
import type { Section } from '@backgold/content'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import ModuleFrame from './ModuleFrame.astro'
import { text } from '../../../lib/format'

interface Props {
  section: Section
  layout: string
  card?: boolean
  height?: string
  /** Draw the heading (false where the module draws its own header, a petition's image, map or coverage). */
  head?: boolean
  /** The width the module keeps on a wide screen; none is the full content width. */
  narrow?: boolean
}

const { section, layout, card = false, height, head = true, narrow = false } = Astro.props
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
---
<Band section={section} class:list={['headed-module', narrow && 'headed-module-narrow']}>
  {(head || !section.embed) && <SectionHead kicker={kicker} heading={heading} more={[]} />}
  <ModuleFrame embed={section.embed} band={section.band} type={section.type} layout={layout} card={card} title={heading ?? section.type} height={height} />
</Band>

<style>
  :global(.headed-module-narrow .section-head),
  :global(.headed-module-narrow .module) {
    max-width: 40rem;
    margin-inline: auto;
  }
</style>
