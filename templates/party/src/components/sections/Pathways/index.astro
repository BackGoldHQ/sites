---
// Pathways · Doors, the default (mock 11, A, "Five doors"): the kicker,
// heading and body centred ("Which path fits you?"), then a card per pathway,
// as many across as there are up to five, each one link to that pathway's
// programs (Doors.astro). With no pathways and no heading it draws nothing.
import type { Section } from '@backgold/content'
import Band from '../Band.astro'
import Doors from './Doors.astro'
import Head from './Head.astro'
import { pathwaysOf } from './pathways'
import { text } from '../../../lib/format'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const heading = text(section.copy.heading)
const pathways = pathwaysOf(section)
---
{(pathways.length > 0 || heading) && (
  <Band section={section} class="pathways pathways-doors">
    <Head kicker={text(section.copy.kicker)} heading={heading} body={section.copy.body} />
    <Doors pathways={pathways} programsLabel={text(section.copy.programsLabel)} />
  </Band>
)}
