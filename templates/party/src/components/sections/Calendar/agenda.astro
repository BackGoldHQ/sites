---
// Calendar · Agenda: the heading, then BackGold's calendar opening on its
// agenda.
import type { Section } from '@backgold/content'
import Headed from '../modules/Headed.astro'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
---
<Headed section={section} layout="agenda" height="46rem" />
