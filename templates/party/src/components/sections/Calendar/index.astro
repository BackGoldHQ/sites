---
// Calendar · Month (board A12, the default): the heading, then BackGold's
// calendar opening on the month.
import type { Section } from '@backgold/content'
import Headed from '../modules/Headed.astro'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
---
<Headed section={section} layout="month" height="46rem" />
