---
// MovementTicker: a heading and the figures the organization wrote for it.
// BackGold's hosted pages also run a live feed of gifts and signatures; a
// figure BackGold fills in live is left out here (see literalStat).
import type { Section } from '@backgold/content'
import Band from '../Band.astro'
import { rows } from '../../../lib/section'
import { literalStat, text } from '../../../lib/format'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const heading = text(section.copy.heading)
const stats = rows(section)
  .map((row) => ({ value: literalStat(row.value), label: text(row.label) }))
  .filter((stat) => stat.value !== null)
---
{stats.length > 0 && (
  <Band section={section} class="ticker">
    {heading && <h2>{heading}</h2>}
    <ul class="grid grid-3 stat-list" role="list">
      {stats.map((stat) => (
        <li class="stat">
          <p class="stat-value">{stat.value}</p>
          {stat.label && <p class="stat-label">{stat.label}</p>}
        </li>
      ))}
    </ul>
  </Band>
)}
