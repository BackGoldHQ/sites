---
// Share kit · Strip (REPORT §2 G18): the kicker and heading, the body, then
// the posts in one row that scrolls sideways, smaller than the cards: each
// its graphic at 16:9 when it has one, the network as a chip, the post's
// words cut to five lines (Copy and Share carry all of them), the row's
// link reading "Open" (a screen reader hears "Open on X"), and Copy and Share. About three and a half posts show
// on a wide screen, so the next is always in view at the edge; a phone
// shows one and a little of the next. The row snaps to a post's edge, takes
// the keyboard's arrow keys when it has focus and keeps the browser's own
// scroll bar. Copy and Share are drawn hidden and shown by the section's
// island; without script each post is its words and its link. No counts.
// The section's own links follow the row as its buttons. Nothing is drawn
// with no post and no heading.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import Prose from '../../Prose.astro'
import Actions from './Actions.astro'
import Buttons from './Buttons.astro'
import { labelsOf, postsOf } from './share'
import { links } from '../../../lib/section'
import { text } from '../../../lib/format'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
const posts = postsOf(section)
const labels = labelsOf(section)
const ctas = links(section)
---
{(heading || posts.length > 0) && (
  <Band section={section} class="sharekit sharekit-strip">
    <div data-share-kit>
      <SectionHead kicker={kicker} heading={heading} more={[]} />
      <Prose value={section.copy.body} class="lede sharekit-lede" />
      {posts.length > 0 && (
        <ul class="share-strip" role="list" tabindex="0" aria-label={heading ?? 'Posts to share'}>
          {posts.map((post) => (
            <li class="share-tile" data-share-item data-share-text={post.text} data-share-name={post.name}>
              {post.image && (
                <div class="share-tile-frame">
                  <img class="share-tile-photo" src={post.image} alt="" loading="lazy" decoding="async" />
                </div>
              )}
              <div class="share-tile-body">
                {post.network && <p class="share-tile-network"><span class="chip">{post.network}</span></p>}
                <p class="share-tile-text">{post.text}</p>
                {post.href && <p class="share-tile-open"><a href={post.href} rel={post.rel}>Open<span class="visually-hidden">{post.openHint}</span><span aria-hidden="true"> →</span></a></p>}
                <Buttons post={post} labels={labels} />
              </div>
            </li>
          ))}
        </ul>
      )}
      {ctas.length > 0 && (
        <p class="actions">
          {ctas.map((link, i) => <a class:list={['button', i > 0 && 'button-quiet']} href={link.href} rel={link.rel}>{link.label}</a>)}
        </p>
      )}
      {posts.length > 0 && <Actions />}
    </div>
  </Band>
)}

<style>
  .sharekit-strip :global(.sharekit-lede) {
    margin: -0.5rem 0 1.75rem;
  }
  /* The padding keeps a focused button's ring inside the scroll box. */
  .share-strip {
    display: flex;
    align-items: stretch;
    gap: 1rem;
    margin: 0 -0.375rem;
    padding: 0.375rem 0.375rem 1rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0.375rem;
    overscroll-behavior-x: contain;
  }
  .share-strip:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
    border-radius: var(--radius);
  }
  .share-tile {
    display: flex;
    flex: 0 0 82%;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    scroll-snap-align: start;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--ink);
  }
  .share-tile-frame {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }
  .share-tile-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .share-tile-body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 0.875rem 1rem 1rem;
  }
  .share-tile-body > p {
    margin: 0;
  }
  /* The network chip sits on the card's surface, so it takes its ground from the ink: the band's own chip ground can match the surface in a dark band. */
  .share-tile-network .chip {
    background: color-mix(in srgb, var(--ink) 8%, transparent);
    color: var(--ink);
    white-space: normal;
  }
  .share-tile-body .share-tile-text {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    line-clamp: 5;
    overflow: hidden;
    font-size: var(--text-sm);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .share-tile-open {
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .share-tile-open a {
    color: var(--link);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.25em;
  }
  .share-tile-body :global(.share-buttons) {
    margin-top: auto;
    padding-top: 0.25rem;
  }
  @media (min-width: 40rem) {
    .share-tile {
      flex-basis: 44%;
    }
  }
  @media (min-width: 56rem) {
    .share-strip {
      gap: 1.25rem;
    }
    .share-tile {
      flex-basis: calc((100% - 3 * 1.25rem) / 3.4);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .share-strip {
      scroll-behavior: smooth;
    }
  }
</style>
