---
// Issues, 'rows' layout (board S22, B, "Alternating rows"): the kicker, the
// heading and the lead, then each issue as a large row: its picture (16:10,
// rounded) on one side, and on the other its two-digit number in the accent,
// its title, its line and its note as a chip ("Week 0"). The picture starts
// at the left and changes sides with each row on a wide screen; on a phone
// every row is the picture over the words. A row without a picture shows its
// number large in the display face on the band's surface in the picture's
// place. The section's links follow as buttons. Nothing is drawn with no
// heading, lead or issue.
import type { ComponentProps } from 'astro/types'
import Band from '../Band.astro'
import Prose from '../../Prose.astro'
import type Default from './index.astro'
import { issuesOf, numeral } from './issues'
import { links } from '../../../lib/section'
import { prose, text } from '../../../lib/format'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const heading = text(section.copy.heading)
const kicker = text(section.copy.kicker)
const issues = issuesOf(section)
const ctas = links(section)
const drawn = heading || kicker || prose(section.copy.lead) || issues.length > 0
---
{drawn && (
  <Band section={section} class="issues">
    {kicker && <p class="kicker">{kicker}</p>}
    {heading && <h2>{heading}</h2>}
    <Prose value={section.copy.lead} class="lede" />
    {issues.length > 0 && (
      <ol class="rows" role="list">
        {issues.map((issue, i) => (
          <li class:list={['row', i % 2 === 1 && 'row-flip']}>
            {issue.picture ? (
              <img class="row-picture" src={issue.picture} alt="" loading="lazy" decoding="async" />
            ) : (
              <div class="row-picture row-blank" aria-hidden="true">{numeral(i)}</div>
            )}
            <div class="row-words">
              <p class="row-number" aria-hidden="true">{numeral(i)}</p>
              {issue.title && <h3>{issue.title}</h3>}
              <Prose value={issue.body} class="row-body" />
              {issue.note && <p class="row-note"><span class="chip">{issue.note}</span></p>}
            </div>
          </li>
        ))}
      </ol>
    )}
    {ctas.length > 0 && (
      <p class="actions">
        {ctas.map((link, i) => <a class:list={['button', i > 0 && 'button-quiet']} href={link.href} rel={link.rel}>{link.label}</a>)}
      </p>
    )}
  </Band>
)}

<style>
  .rows {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3rem);
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .row {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }
  .row-picture {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: calc(var(--radius) * 1.5);
  }
  /* No picture: the row's number, large, on the band's surface. */
  .row-blank {
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--accent);
    font-family: var(--font-display);
    font-size: clamp(4rem, 3rem + 4vw, 6.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .row-words {
    min-width: 0;
  }
  .row-words > * {
    margin: 0;
  }
  .row-words .row-number {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.5rem + 0.8vw, 2.25rem);
    font-weight: 800;
    line-height: 1;
  }
  .row-words h3 {
    margin-top: 0.5rem;
  }
  .row-words :global(.row-body) {
    margin-top: 0.5rem;
    color: var(--muted);
  }
  .row-words :global(.row-body) > :global(:last-child) {
    margin-bottom: 0;
  }
  .row-words .row-note {
    margin-top: 0.875rem;
  }
  /* A chip's ground is the tint band's own colour: on that band it takes the surface, ruled. */
  :global(.bg-band-tint) .row-note .chip {
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  @media (min-width: 48rem) {
    .row {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: clamp(1.75rem, 4vw, 3.5rem);
      align-items: center;
    }
    .row-flip {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    }
    .row-flip .row-picture {
      order: 2;
    }
  }
</style>
