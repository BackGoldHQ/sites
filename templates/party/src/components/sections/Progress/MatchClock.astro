---
// The end of a Progress section's match, for the layouts that draw it. The
// server writes the end as a plain line ("Ends Sunday, October 18, 2026 at
// 11:59 PM"), which is what a visitor without script reads. With `tiles`
// (the default) a few lines of script count the time left down each second
// in the visitor's browser as four tiles, days, hours, minutes and seconds,
// the plain line kept for screen readers; without `tiles` the plain line
// stays and nothing ticks. Pages are cached until content changes, so once
// the end has passed in the visitor's browser the clock reads "The match has
// ended" and every `[data-match-chip]` in the section (the "2× match" words)
// goes. `until` is the end as the section stores it, `ends` as formatWhen
// writes it; the caller draws the clock only for an end that is a date.
interface Props {
  until: string
  ends: string
  tiles?: boolean
}

const { until, ends, tiles = true } = Astro.props
const units = [
  { key: 'days', label: 'days' },
  { key: 'hours', label: 'hrs' },
  { key: 'minutes', label: 'min' },
  { key: 'seconds', label: 'sec' },
]
---
{tiles ? (
  <>
    <div class="match-clock" data-match-until={until}>
      <div class="match-left" aria-live="off" data-match-left hidden>
        <p class="visually-hidden">Ends {ends}</p>
        <ol class="match-tiles" role="list" aria-hidden="true">
          {units.map((unit) => (
            <li class="match-tile">
              <span class="match-number" data-match-unit={unit.key}></span>
              <span class="match-unit">{unit.label}</span>
            </li>
          ))}
        </ol>
      </div>
      <p class="match-ends" data-match-ends>Ends <time datetime={until}>{ends}</time></p>
      <p class="match-over" data-match-over hidden>The match has ended</p>
    </div>
    <script is:inline>
      (function (clock) {
        var end = Date.parse(clock.getAttribute('data-match-until'))
        if (isNaN(end)) return
        var left = clock.querySelector('[data-match-left]')
        var plain = clock.querySelector('[data-match-ends]')
        var over = clock.querySelector('[data-match-over]')
        var card = clock.closest('.bg-section')
        var chip = card && card.querySelector('[data-match-chip]')
        var slots = {}
        clock.querySelectorAll('[data-match-unit]').forEach(function (slot) {
          slots[slot.getAttribute('data-match-unit')] = slot
        })
        function two(n) {
          return n < 10 ? '0' + n : String(n)
        }
        function tick() {
          var ms = end - Date.now()
          if (ms <= 0) {
            left.hidden = true
            plain.hidden = true
            over.hidden = false
            if (chip) chip.hidden = true
            return false
          }
          var s = Math.floor(ms / 1000)
          slots.days.textContent = two(Math.floor(s / 86400))
          slots.hours.textContent = two(Math.floor((s % 86400) / 3600))
          slots.minutes.textContent = two(Math.floor((s % 3600) / 60))
          slots.seconds.textContent = two(s % 60)
          return true
        }
        if (!tick()) return
        plain.hidden = true
        left.hidden = false
        var timer = setInterval(function () {
          if (!tick()) clearInterval(timer)
        }, 1000)
      })(document.currentScript.previousElementSibling)
    </script>
  </>
) : (
  <>
    <div class="match-clock match-clock-plain" data-match-until={until}>
      <p class="match-ends" data-match-ends>Ends <time datetime={until}>{ends}</time></p>
      <p class="match-over" data-match-over hidden>The match has ended</p>
    </div>
    <script is:inline>
      (function (clock) {
        var end = Date.parse(clock.getAttribute('data-match-until'))
        if (isNaN(end)) return
        var plain = clock.querySelector('[data-match-ends]')
        var over = clock.querySelector('[data-match-over]')
        var card = clock.closest('.bg-section')
        function close() {
          plain.hidden = true
          over.hidden = false
          if (card) {
            card.querySelectorAll('[data-match-chip]').forEach(function (chip) {
              chip.hidden = true
            })
          }
        }
        var ms = end - Date.now()
        if (ms <= 0) close()
        else if (ms < 2147483647) setTimeout(close, ms)
      })(document.currentScript.previousElementSibling)
    </script>
  </>
)}

<style>
  .match-clock p {
    margin: 0;
  }
  .match-left[hidden],
  .match-ends[hidden],
  .match-over[hidden] {
    display: none;
  }
  .match-tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .match-tile {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    padding: 0.75rem 0.25rem 0.625rem;
    border-radius: var(--radius);
    background: var(--button-2);
    color: var(--button-2-ink);
  }
  .match-number {
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 1.35rem + 1vw, 2.125rem);
    font-weight: 800;
    font-variant-numeric: lining-nums tabular-nums;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .match-unit {
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.2;
  }
  .match-ends,
  .match-over {
    font-weight: 600;
  }
  .match-over {
    color: var(--muted);
  }
  .match-clock-plain .match-ends,
  .match-clock-plain .match-over {
    font-weight: inherit;
    color: inherit;
  }
</style>
