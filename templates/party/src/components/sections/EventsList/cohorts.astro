---
// EventsList · Cohorts (board 03, B, "Cohort picker"): the section head (the
// kicker, the heading, "Choose a start date" as the operator words it, and
// the "All events" link), then a card per event on the band's surface,
// three across on a wide screen, two on a tablet and one on a phone. Each
// card leads with its start: "Starts" in small capitals over the day large
// in the display face ("Oct 15", and the year under it when the events
// span more than one), all in the event's own time zone. Then the title
// (linking to the event's page on this site), the weekday, time and place,
// the type as a chip, the live counts ("12 going · 9 seats left", filled in
// by LiveCounts after the page loads; empty without scripts), and the
// card's one button to the event's page, which frames BackGold's RSVP and
// tickets: "RSVP", "Get tickets" when the event sells tickets. An event
// that has stopped taking registrations says "Registration closed", its
// start in the muted ink, and its button reads "Details" in the outline.
// Every card has its button, whatever `options.actions` says; `options.max`
// caps the cards. No card is "selected": the choice is made on the event's
// page.
//
// With no events the head stands over the section's empty-events line ("No
// upcoming events right now." when it has none); with neither events nor a
// heading nothing is drawn.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import LiveCounts from './LiveCounts.astro'
import SectionHead from '../SectionHead.astro'
import { eventsOf } from './events'
import { links } from '../../../lib/section'
import { text } from '../../../lib/format'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const heading = text(section.copy.heading)
const invitation = text(section.copy.eventsEmptyCta)
const events = eventsOf(section)
const years = new Set(events.map((e) => e.when?.year).filter((y): y is number => y !== undefined))
const showYear = years.size > 1
---
{(heading || events.length > 0) && (
  <Band section={section} class="events events-cohorts">
    <SectionHead kicker={text(section.copy.kicker)} heading={heading} more={links(section)} />
    {events.length > 0 ? (
      <ul class="co-cards" role="list">
        {events.map((event) => (
          <li class:list={['co-card', event.closed && 'co-card-closed']}>
            {event.when && event.startsAt && (
              <p class="co-start">
                <span class="co-starts" aria-hidden="true">Starts</span>
                <time class="co-day" datetime={event.startsAt}>
                  <span aria-hidden="true">{event.when.monthShort} {event.when.day}</span>
                  <span class="visually-hidden">Starts {event.when.full}</span>
                </time>
                {showYear && <span class="co-year" aria-hidden="true">{event.when.year}</span>}
              </p>
            )}
            <h3 class="co-title">{event.link ? <a href={event.link.href} rel={event.link.rel}>{event.title}</a> : event.title}</h3>
            {(event.when?.time || event.place) && (
              <p class="co-meta">{[event.when?.weekday && event.when.time ? `${event.when.weekday} ${event.when.time}` : event.when?.time, event.place].filter(Boolean).join(' · ')}</p>
            )}
            {(event.type || event.id || event.closed) && (
              <p class="co-facts">
                {event.type && <span class="chip chip-wash">{event.type}</span>}
                {event.id && <span class="co-live" data-bg-live={event.id}></span>}
                {event.closed && <span class="co-closed">Registration closed</span>}
              </p>
            )}
            {event.action && (
              <p class="co-action">
                <a class:list={['button', 'button-small', event.closed ? 'button-quiet' : 'button-2']} href={event.action.href} rel={event.action.rel}>
                  {event.action.label}<span class="visually-hidden">: {event.title}</span>
                </a>
              </p>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <p class="co-empty">{invitation ?? 'No upcoming events right now.'}</p>
    )}
    <LiveCounts />
  </Band>
)}

<style>
  .co-cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .co-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
    padding: 1.375rem 1.375rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
  }
  .co-card > * {
    margin: 0;
  }
  .co-start {
    display: grid;
    justify-items: start;
    margin-bottom: 0.25rem;
    line-height: 1;
  }
  .co-starts {
    margin-bottom: 0.375rem;
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
  }
  .co-day {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.9rem + 1.2vw, 2.75rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.025em;
  }
  .co-year {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .co-card-closed .co-day {
    color: var(--muted);
  }
  .co-card .co-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .co-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .co-title a:hover {
    text-decoration: underline;
  }
  .co-meta {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.45;
  }
  .co-facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.75rem;
    font-size: var(--text-sm);
  }
  .co-live {
    color: var(--ink);
    font-weight: 700;
  }
  .co-live:empty {
    display: none;
  }
  .co-closed {
    color: var(--muted);
    font-weight: 700;
  }
  .co-card > .co-action {
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .co-action .button {
    width: 100%;
  }
  .co-empty {
    margin: 0;
    padding: 1.125rem 1.25rem;
    border: 2px dashed color-mix(in srgb, var(--ink) 22%, transparent);
    border-radius: var(--radius);
    color: var(--muted);
  }
  @media (min-width: 40rem) {
    .co-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
    .co-action .button {
      width: auto;
      min-width: 7.5rem;
    }
  }
  @media (min-width: 60rem) {
    .co-cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
