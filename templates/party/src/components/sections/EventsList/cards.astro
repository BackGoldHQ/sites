---
// EventsList · Cards (board A1, "Upcoming events · Cards"; A12 shows it beside
// List and Agenda): the section head (the kicker, the heading and the "All
// events" link), then a raised card per event with its date line in the
// accent ("TUE · OCT 14"), its type as a chip, the time and the place, its
// live counts ("142 going", "12 seats left", filled in by LiveCounts after
// the page loads; empty without scripts), and whether it still takes
// registrations. Each card opens the event's own page on this site, which
// frames BackGold's RSVP and tickets: `options.actions` 'buttons' puts a button on the
// card in the quieter solid style ("Get tickets" when the event sells
// tickets, "RSVP" otherwise, "Details" once registration has closed), 'link'
// (or none) makes the whole card the link. With no events it draws nothing.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import LiveCounts from './LiveCounts.astro'
import SectionHead from '../SectionHead.astro'
import { actionsOf, eventsOf } from './events'
import { links } from '../../../lib/section'
import { text } from '../../../lib/format'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const buttons = actionsOf(section) === 'buttons'
const events = eventsOf(section)
---
{events.length > 0 && (
  <Band section={section} class="events events-cards">
    <SectionHead kicker={text(section.copy.kicker)} heading={text(section.copy.heading)} more={links(section)} />
    <ul class="ev-cards" role="list">
      {events.map((event) => (
        <li class:list={['ev-card', { 'ev-card-linked': event.link && !buttons }]}>
          {(event.when || event.type) && (
            <p class="ev-top">
              {event.when && event.startsAt && (
                <time class="ev-date" datetime={event.startsAt}>
                  <span aria-hidden="true">{[event.when.weekday, `${event.when.monthShort} ${event.when.day}`].filter(Boolean).join(' · ')}</span>
                  <span class="visually-hidden">{event.when.full}</span>
                </time>
              )}
              {event.type && <span class="chip chip-wash">{event.type}</span>}
            </p>
          )}
          <h3 class="ev-title">{event.link && !buttons ? <a href={event.link.href} rel={event.link.rel}>{event.title}</a> : event.title}</h3>
          {(event.when?.time || event.place) && <p class="ev-meta">{[event.when?.time, event.place].filter(Boolean).join(' · ')}</p>}
          {event.id && <p class="ev-live" data-bg-live={event.id}></p>}
          {event.closed && <p class="ev-closed">Registration closed</p>}
          {event.action && buttons && (
            <p class="ev-action">
              <a class="button" href={event.action.href} rel={event.action.rel}>
                {event.action.label}<span class="visually-hidden">: {event.title}</span>
              </a>
            </p>
          )}
        </li>
      ))}
    </ul>
    <LiveCounts />
  </Band>
)}

<style>
  .ev-cards {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ev-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    min-width: 0;
    padding: 1.375rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .ev-card > * {
    margin: 0;
  }
  .ev-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .ev-date {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .ev-title {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .ev-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .ev-card-linked .ev-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .ev-card-linked:hover .ev-title a {
    text-decoration: underline;
  }
  .ev-card-linked:focus-within {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
  .ev-card-linked .ev-title a:focus-visible {
    outline: none;
  }
  .ev-meta {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .ev-live {
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .ev-live:empty {
    display: none;
  }
  .ev-closed {
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .ev-card .ev-action {
    margin-top: auto;
    padding-top: 0.25rem;
  }
  /* A1's RSVP: the quieter solid button, small. */
  .ev-action .button {
    min-height: 2.375rem;
    padding: 0 1rem;
    border-color: var(--button-2);
    background: var(--button-2);
    color: var(--button-2-ink);
    font-size: var(--text-sm);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ev-card {
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease;
    }
    /* A1's motion note: a card lifts 2px with a deeper shadow on hover. */
    .ev-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow), 0 14px 28px -18px color-mix(in srgb, var(--shadow-ink) 45%, transparent);
    }
  }
</style>
