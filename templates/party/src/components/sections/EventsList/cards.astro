---
// EventsList · Cards (board A1, "Upcoming events · Cards"; A12 shows it beside
// List and Agenda): a card per event with its date line, its type, the time
// and the place, and whether it still takes registrations. Each card opens
// the event's own page in BackGold, where an RSVP or a ticket happens:
// `options.actions` 'buttons' puts an RSVP button on the card, 'link' (or
// none) makes the whole card the link. With no events it draws nothing.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import { actionsOf, eventsOf } from './events'
import { text } from '../../../lib/format'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const heading = text(section.copy.heading)
const buttons = actionsOf(section) === 'buttons'
const events = eventsOf(section)
---
{events.length > 0 && (
  <Band section={section} class="events events-cards">
    {heading && <h2>{heading}</h2>}
    <ul class="ev-cards" role="list">
      {events.map((event) => (
        <li class:list={['ev-card', { 'ev-card-linked': event.link && !buttons }]}>
          {(event.when || event.type) && (
            <p class="ev-top">
              {event.when && event.startsAt && (
                <time class="ev-date" datetime={event.startsAt}>
                  <span aria-hidden="true">{[event.when.weekday, `${event.when.monthShort} ${event.when.day}`].filter(Boolean).join(' · ')}</span>
                  <span class="visually-hidden">{event.when.full}</span>
                </time>
              )}
              {event.type && <span class="ev-chip">{event.type}</span>}
            </p>
          )}
          <h3 class="ev-title">{event.link && !buttons ? <a href={event.link.href} rel={event.link.rel}>{event.title}</a> : event.title}</h3>
          {(event.when?.time || event.place) && <p class="ev-meta">{[event.when?.time, event.place].filter(Boolean).join(' · ')}</p>}
          {event.closed && <p class="ev-closed">Registration closed</p>}
          {event.link && buttons && (
            <p class="ev-action">
              <a class="button" href={event.link.href} rel={event.link.rel}>
                {event.closed ? 'Details' : 'RSVP'}<span class="visually-hidden">: {event.title}</span>
              </a>
            </p>
          )}
        </li>
      ))}
    </ul>
  </Band>
)}

<style>
  .ev-cards {
    display: grid;
    gap: clamp(1rem, 2vw, 1.25rem);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .ev-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    min-width: 0;
    padding: 1.375rem;
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    border-radius: calc(var(--radius) * 1.5);
    background: color-mix(in srgb, var(--page) 70%, transparent);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04);
  }
  :global(.bg-band-contrast) .ev-card {
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }
  .ev-card > * {
    margin: 0;
  }
  .ev-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .ev-date {
    color: var(--link);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .ev-chip {
    display: inline-block;
    padding: 0.125rem 0.625rem;
    border-radius: var(--pill);
    background: color-mix(in srgb, var(--link) 12%, transparent);
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .ev-title {
    font-size: var(--h3);
    line-height: 1.2;
  }
  .ev-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .ev-card-linked .ev-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .ev-card-linked:hover .ev-title a {
    text-decoration: underline;
  }
  .ev-card-linked:focus-within {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
  .ev-card-linked .ev-title a:focus-visible {
    outline: none;
  }
  .ev-meta {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .ev-closed {
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .ev-card .ev-action {
    margin-top: auto;
    padding-top: 0.25rem;
  }
  .ev-action .button {
    padding: 0.5rem 1.125rem;
    font-size: var(--text-sm);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ev-card {
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease;
    }
    .ev-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgb(0 0 0 / 0.1);
    }
  }
</style>
