---
// The agenda's rows (board A6), as the Agenda layout draws them and the
// Calendar draws its month on a phone: the events grouped by month under the
// month's name and its count, each a row with the day, the type, the time,
// the place and an empty live-counts slot (LiveCounts fills it). A month
// between two listed months that has no event is drawn as an invitation
// ("December is open.") with the section's empty-events line, never as a
// blank. `buttons` puts the event's button on each row; otherwise the title
// is the link. With no events it draws nothing.
import { monthName, type EventRow } from './events'

interface Props {
  events: EventRow[]
  buttons: boolean
  /** The section's empty-events line, for an empty month's invitation. */
  invitation: string | null
}

const { events, buttons, invitation } = Astro.props

interface Month {
  label: string
  /** The month's own name for its invitation, null for the undated group. */
  name: string | null
  events: EventRow[]
}

// Rows arrive soonest first. A month is year * 12 + month; every month from
// the first listed to the last gets a group, so an empty one in between shows.
// An event with no readable date goes last, under "Date to come".
const dated = events.filter((e) => e.when)
const undated = events.filter((e) => !e.when)
const keyOf = (e: EventRow) => e.when!.year * 12 + e.when!.monthIndex
const keys = dated.map(keyOf)
const first = keys.length > 0 ? Math.min(...keys) : 0
const last = keys.length > 0 ? Math.max(...keys) : -1
const years = new Set(dated.map((e) => e.when!.year))
const months: Month[] = []
for (let key = first; key <= last; key++) {
  const name = monthName(key % 12)
  months.push({ label: years.size > 1 ? `${name} ${Math.floor(key / 12)}` : name, name, events: dated.filter((e) => keyOf(e) === key) })
}
if (undated.length > 0) months.push({ label: 'Date to come', name: null, events: undated })
const count = (n: number) => (n === 1 ? '1 event' : `${n} events`)
---
{months.length > 0 && (
  <div class="agenda">
    {months.map((month) => (
      <div class="agenda-month">
        <h3 class="agenda-heading">
          {month.label} <span class="agenda-count">{month.events.length > 0 ? count(month.events.length) : 'nothing yet'}</span>
        </h3>
        {month.events.length > 0 ? (
          <ul class="agenda-list" role="list">
            {month.events.map((event) => (
              <li class="agenda-row">
                {event.when && event.startsAt ? (
                  <time class="agenda-day" datetime={event.startsAt}>
                    <b aria-hidden="true">{event.when.day}</b>
                    {event.when.weekday && <small aria-hidden="true">{event.when.weekday}</small>}
                    <span class="visually-hidden">{event.when.full}</span>
                  </time>
                ) : (
                  <span class="agenda-day" aria-hidden="true"><b>–</b></span>
                )}
                <div class="agenda-body">
                  {event.type && <p class="agenda-chip">{event.type}</p>}
                  <h4 class="agenda-title">{event.link && !buttons ? <a href={event.link.href} rel={event.link.rel}>{event.title}</a> : event.title}</h4>
                  {(event.when?.time || event.place || event.closed || event.id) && (
                    <p class="agenda-meta">
                      {[event.when?.time, event.place].filter(Boolean).map((part) => <span>{part}</span>)}
                      {event.id && <span class="agenda-live" data-bg-live={event.id}></span>}
                      {event.closed && <span class="agenda-closed">Registration closed</span>}
                    </p>
                  )}
                </div>
                {event.action && buttons && (
                  <p class="agenda-action">
                    <a class="button" href={event.action.href} rel={event.action.rel}>
                      {event.action.label}<span class="visually-hidden">: {event.title}</span>
                    </a>
                  </p>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="agenda-open">
            <strong>{month.name} is open.</strong>
            {invitation && <span> {invitation}</span>}
          </p>
        )}
      </div>
    ))}
  </div>
)}

<style>
  .agenda {
    margin-top: 1.5rem;
  }
  .agenda-month + .agenda-month {
    margin-top: 2.25rem;
  }
  .agenda-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin: 0 0 0.875rem;
    font-size: calc(var(--h3) * 1.15);
    font-weight: 800;
  }
  .agenda-count {
    color: var(--muted);
    font-family: var(--font);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0;
  }
  .agenda-list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .agenda-row {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 0.875rem;
    align-items: center;
    padding: 0.875rem;
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--page) 70%, transparent);
  }
  :global(.bg-band-contrast) .agenda-row {
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }
  .agenda-day {
    display: block;
    padding-right: 0.75rem;
    border-right: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    text-align: center;
  }
  .agenda-day b {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.4rem + 1vw, 2.25rem);
    font-weight: 800;
    line-height: 1;
  }
  .agenda-day small {
    display: block;
    margin-top: 0.25rem;
    color: var(--link);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .agenda-body > * {
    margin: 0;
  }
  .agenda-body .agenda-chip {
    display: inline-block;
    margin-bottom: 0.375rem;
    padding: 0.125rem 0.625rem;
    border-radius: var(--pill);
    background: color-mix(in srgb, var(--link) 12%, transparent);
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .agenda-body .agenda-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .agenda-title a {
    color: var(--ink);
  }
  .agenda-body .agenda-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.125rem 0.75rem;
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .agenda-live {
    color: var(--ink);
    font-weight: 700;
  }
  .agenda-live:empty {
    display: none;
  }
  .agenda-closed {
    font-weight: 700;
  }
  .agenda-action {
    grid-column: 1 / -1;
    margin: 0;
  }
  .agenda-action .button {
    padding: 0.5rem 1.125rem;
    font-size: var(--text-sm);
  }
  .agenda-open {
    margin: 0;
    padding: 1.125rem 1.25rem;
    border: 2px dashed color-mix(in srgb, var(--ink) 22%, transparent);
    border-radius: var(--radius);
    color: var(--muted);
  }
  .agenda-open strong {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }
  @media (min-width: 40rem) {
    .agenda-row {
      grid-template-columns: 5.25rem minmax(0, 1fr) auto;
      gap: 1.25rem;
      padding: 1rem 1.25rem;
    }
    .agenda-action {
      grid-column: auto;
    }
  }
</style>
