---
// EventsList · Week (board 06, C, "Week calendar slots", without its
// picking: an event is signed up for on its own page): the section head (the
// kicker, the heading and the "All events" link), then the coming seven days
// as columns on the band's surface, each headed by its weekday over its day
// number (the month under the first day and any 1st), with the day's events
// under it as links to their pages on this site, which frame BackGold's RSVP
// and tickets: each its type and time over its title, and its live counts
// (filled in by LiveCounts after the page loads; empty without scripts). A
// day with no event keeps its column and says nothing.
//
// The page is cached, so the server cannot know which seven days are coming:
// it draws a column for each day the rows fall on (the event's own day, in
// its own time zone), in day order, and the section's script picks today in
// the visitor's own time, keeps the seven days from it (adding an empty
// column for each day with no event, dropping the rest), and rings today.
// When none of the seven has an event, the head stands over "Nothing this
// week." With scripts off the server's columns show: every upcoming day with
// an event, which is honest. An event with no readable date is left out: it
// has no day to sit in.
//
// On a phone the week is a list of days, each day's head at the left of its
// events. With neither a heading nor an event nothing is drawn.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import LiveCounts from './LiveCounts.astro'
import SectionHead from '../SectionHead.astro'
import { eventsOf, monthName, type EventRow } from './events'
import { links } from '../../../lib/section'
import { text } from '../../../lib/format'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const heading = text(section.copy.heading)
const events = eventsOf(section)
const pad = (n: number) => String(n).padStart(2, '0')

interface Day {
  /** "2026-10-17", the event's own calendar day. */
  key: string
  year: number
  monthIndex: number
  day: number
  events: EventRow[]
}

// Rows arrive soonest first; a day gathers the rows that fall on it.
const days: Day[] = []
for (const event of events) {
  if (!event.when) continue
  const { year, monthIndex } = event.when
  const day = Number(event.when.day)
  const key = `${year}-${pad(monthIndex + 1)}-${pad(day)}`
  const found = days.find((d) => d.key === key)
  if (found) found.events.push(event)
  else days.push({ key, year, monthIndex, day, events: [event] })
}
days.sort((a, b) => (a.key < b.key ? -1 : a.key > b.key ? 1 : 0))

const WEEKDAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']
const weekdayOf = (d: Day) => WEEKDAYS[new Date(Date.UTC(d.year, d.monthIndex, d.day)).getUTCDay()]!
// The month under the first column's day and under any day in a new month.
const showsMonth = (i: number) => i === 0 || days[i]!.monthIndex !== days[i - 1]!.monthIndex || days[i]!.year !== days[i - 1]!.year
const count = (n: number) => (n === 1 ? '1 event' : `${n} events`)
---
{(heading || days.length > 0) && (
  <Band section={section} class="events events-week">
    <SectionHead kicker={text(section.copy.kicker)} heading={heading} more={links(section)} />
    <div class="week" data-week>
      {days.length > 0 && (
        <ol class="wk-days" role="list">
          {days.map((day, i) => (
            <li class="wk-day" data-day={day.key}>
              <h3 class="wk-head">
                <time datetime={day.key}>
                  <span class="wk-weekday" aria-hidden="true">{weekdayOf(day).slice(0, 3)}</span>
                  <span class="wk-date" aria-hidden="true">
                    <b>{day.day}</b>
                    <span class="wk-month" hidden={!showsMonth(i)}>{monthName(day.monthIndex).slice(0, 3)}</span>
                  </span>
                  <span class="visually-hidden" data-week-label>{`${weekdayOf(day)}, ${monthName(day.monthIndex)} ${day.day}, ${count(day.events.length)}`}</span>
                </time>
              </h3>
              <ul class="wk-events" role="list">
                {day.events.map((event) => (
                  <li>
                    {event.link ? (
                      <a class="wk-event" href={event.link.href} rel={event.link.rel}>
                        {(event.type || event.when?.time) && <span class="wk-kind">{[event.type, event.when?.time].filter(Boolean).join(' · ')}</span>}
                        <span class="wk-title">{event.title}</span>
                        {event.id && <span class="wk-live" data-bg-live={event.id}></span>}
                        {event.closed && <span class="wk-closed">Registration closed</span>}
                      </a>
                    ) : (
                      <span class="wk-event">
                        {(event.type || event.when?.time) && <span class="wk-kind">{[event.type, event.when?.time].filter(Boolean).join(' · ')}</span>}
                        <span class="wk-title">{event.title}</span>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      )}
      <p class="wk-empty" data-week-empty hidden={days.length > 0}>Nothing this week.</p>
      {days.length > 0 && (
        <template data-week-blank>
          <li class="wk-day">
            <h3 class="wk-head">
              <time>
                <span class="wk-weekday" aria-hidden="true"></span>
                <span class="wk-date" aria-hidden="true"><b></b><span class="wk-month"></span></span>
                <span class="visually-hidden" data-week-label></span>
              </time>
            </h3>
          </li>
        </template>
      )}
      {days.length > 0 && (
        <script is:inline>
          (function (root) {
            if (!root) return
            var list = root.querySelector('.wk-days')
            var empty = root.querySelector('[data-week-empty]')
            var blank = root.querySelector('template[data-week-blank]')
            var WEEKDAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']
            var MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
            var pad = function (n) {
              return (n < 10 ? '0' : '') + n
            }
            var byDay = {}
            var columns = list.querySelectorAll('[data-day]')
            for (var c = 0; c < columns.length; c++) byDay[columns[c].getAttribute('data-day')] = columns[c]
            // The seven days from today, in the visitor's own time.
            var now = new Date()
            var week = []
            var events = 0
            for (var d = 0; d < 7; d++) {
              var date = new Date(now.getFullYear(), now.getMonth(), now.getDate() + d)
              var key = date.getFullYear() + '-' + pad(date.getMonth() + 1) + '-' + pad(date.getDate())
              var column = byDay[key]
              var n = column ? column.querySelectorAll('.wk-events > li').length : 0
              if (!column) {
                column = blank.content.firstElementChild.cloneNode(true)
                column.setAttribute('data-day', key)
                column.querySelector('time').setAttribute('datetime', key)
                column.querySelector('.wk-weekday').textContent = WEEKDAYS[date.getDay()].slice(0, 3)
                column.querySelector('b').textContent = String(date.getDate())
                column.querySelector('.wk-month').textContent = MONTHS[date.getMonth()].slice(0, 3)
              }
              var label = WEEKDAYS[date.getDay()] + ', ' + MONTHS[date.getMonth()] + ' ' + date.getDate() + (d === 0 ? ', today' : '') + ', ' + (n === 0 ? 'no events' : n === 1 ? '1 event' : n + ' events')
              column.querySelector('[data-week-label]').textContent = label
              column.querySelector('.wk-month').hidden = !(d === 0 || date.getDate() === 1)
              if (d === 0) {
                column.classList.add('wk-today')
                column.setAttribute('aria-current', 'date')
              }
              events += n
              week.push(column)
            }
            for (var k in byDay) if (week.indexOf(byDay[k]) < 0) byDay[k].remove()
            for (var w = 0; w < week.length; w++) list.appendChild(week[w])
            list.hidden = events === 0
            empty.hidden = events > 0
          })(document.currentScript.closest('[data-week]'))
        </script>
      )}
    </div>
    <LiveCounts />
  </Band>
)}

<style>
  /* A phone: a list of days, each day's head at the left of its events. */
  .wk-days {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    overflow: hidden;
  }
  .wk-days[hidden] {
    display: none;
  }
  .wk-day {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 0.875rem;
    align-items: start;
    min-width: 0;
    padding: 0.875rem 1rem;
    border-top: 1px solid var(--line);
  }
  .wk-day:first-child {
    border-top: 0;
  }
  .wk-head {
    margin: 0;
    font: inherit;
    letter-spacing: 0;
  }
  .wk-head time {
    display: grid;
    justify-items: center;
    line-height: 1;
  }
  .wk-weekday {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .wk-date {
    display: grid;
    justify-items: center;
    margin-top: 0.3125rem;
  }
  .wk-date b {
    display: inline-grid;
    place-items: center;
    min-width: 2.375rem;
    height: 2.375rem;
    padding: 0 0.25rem;
    border-radius: var(--pill);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .wk-month {
    margin-top: 0.125rem;
    color: var(--accent);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .wk-month[hidden] {
    display: none;
  }
  /* Today: its day ringed, its weekday in the ink. */
  .wk-today .wk-date b {
    box-shadow: inset 0 0 0 2px var(--button);
  }
  .wk-today .wk-weekday {
    color: var(--ink);
  }
  .wk-events {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .wk-event {
    display: grid;
    gap: 0.1875rem;
    min-width: 0;
    padding: 0.625rem 0.75rem 0.6875rem;
    border: 1.5px solid color-mix(in srgb, var(--ink) 22%, transparent);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    line-height: 1.3;
    text-decoration: none;
  }
  a.wk-event:hover {
    border-color: var(--ink);
  }
  a.wk-event:hover .wk-title {
    text-decoration: underline;
  }
  .wk-kind {
    color: var(--link);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .wk-title {
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .wk-live,
  .wk-closed {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .wk-live:empty {
    display: none;
  }
  .wk-empty {
    margin: 0;
    padding: 1.125rem 1.25rem;
    border: 2px dashed color-mix(in srgb, var(--ink) 22%, transparent);
    border-radius: var(--radius);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
  }
  .wk-empty[hidden] {
    display: none;
  }
  /*
    Wider: seven columns, each day's head over its events. Without scripts the
    server's days run on in rows of seven.
  */
  @media (min-width: 48rem) {
    .wk-days {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }
    .wk-day {
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      gap: 0.75rem;
      min-height: 12rem;
      padding: 0.875rem 0.5rem 1rem;
      border-top: 0;
      border-left: 1px solid var(--line);
    }
    .wk-day:nth-child(7n + 1) {
      border-left: 0;
    }
    .wk-day:nth-child(n + 8) {
      border-top: 1px solid var(--line);
    }
    .wk-head {
      padding-bottom: 0.625rem;
      border-bottom: 1px solid var(--line);
    }
    /* A month line kept in every head, so the seven heads end on one line. */
    .wk-month[hidden] {
      display: block;
      visibility: hidden;
    }
    .wk-event {
      padding: 0.5rem 0.5625rem 0.5625rem;
    }
    .wk-title {
      font-size: 0.8125rem;
    }
    .wk-kind {
      font-size: 0.625rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    a.wk-event {
      transition: border-color 0.15s ease;
    }
  }
</style>
