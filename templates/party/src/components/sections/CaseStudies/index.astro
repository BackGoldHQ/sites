---
// CaseStudies, 'featured' layout, the default. A stub for the design pass: the
// kicker and heading, the body, each row's text fields (a list's items too) on one line, and the
// section's links as buttons, so the section renders with its words before
// it has a design. Replace this file's contents to give the layout its design.
import type { Section } from '@backgold/content'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import Prose from '../../Prose.astro'
import { links, rows } from '../../../lib/section'
import { text } from '../../../lib/format'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
const lines = rows(section)
  .map((row) =>
    Object.values(row)
      .flatMap((value) => (Array.isArray(value) ? value : [value]))
      .map(text)
      .filter((value): value is string => value !== null)
      .join(' · '),
  )
  .filter(Boolean)
const ctas = links(section)
---
<Band section={section} class="casestudies-stub">
  <SectionHead kicker={kicker} heading={heading} more={[]} />
  <Prose value={section.copy.body} />
  {lines.length > 0 && (
    <ul role="list">
      {lines.map((line) => <li>{line}</li>)}
    </ul>
  )}
  {ctas.length > 0 && (
    <p class="actions">
      {ctas.map((link, i) => <a class:list={['button', i > 0 && 'button-quiet']} href={link.href} rel={link.rel}>{link.label}</a>)}
    </p>
  )}
</Band>
