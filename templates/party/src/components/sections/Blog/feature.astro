---
// Blog · Lead story (board A1, "Blog · Lead story"; A12 shows it beside Cards
// and List): the newest post large, with its cover, category, summary and
// byline, and the next ones as a short list beside it, each with its
// category, date and a small cover. Four posts, or the section's `maxItems`;
// "All news" goes to the full list at /blog. With nothing published it draws
// nothing.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import { text } from '../../../lib/format'
import { latestEntries, shownOf, storyOf } from './latest'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const heading = text(section.copy.heading) ?? 'Latest'
const stories = (await latestEntries(Astro.locals.backgold, shownOf(section, 4))).map(storyOf)
const [lead, ...rest] = stories
---
{lead && (
  <Band section={section} class="entries blog-feature">
    <div class="lead-head">
      <h2>{heading}</h2>
      <a class="lead-more" href="/blog">All news</a>
    </div>
    <div class:list={['lead', { 'lead-alone': rest.length === 0 }]}>
      <article class="lead-story">
        {lead.image && <img class="lead-cover" src={lead.image} alt="" loading="lazy" decoding="async" />}
        {lead.category && <p class="lead-chip">{lead.category}</p>}
        <h3 class="lead-title">{lead.href ? <a href={lead.href}>{lead.title}</a> : lead.title}</h3>
        {lead.summary && <p class="lead-summary">{lead.summary}</p>}
        {(lead.byline || lead.day) && (
          <p class="lead-byline">
            {lead.byline}
            {lead.byline && lead.day && ' · '}
            {lead.day && lead.date && <time datetime={lead.date}>{lead.day}</time>}
          </p>
        )}
      </article>
      {rest.length > 0 && (
        <ul class="lead-rest" role="list">
          {rest.map((story) => (
            <li class:list={['lead-item', { 'lead-item-pictured': story.image }]}>
              <div>
                {story.category && <p class="lead-chip">{story.category}</p>}
                <h3 class="lead-item-title">{story.href ? <a href={story.href}>{story.title}</a> : story.title}</h3>
                {story.day && story.date && <p class="lead-byline"><time datetime={story.date}>{story.day}</time></p>}
              </div>
              {story.image && <img class="lead-thumb" src={story.image} alt="" loading="lazy" decoding="async" />}
            </li>
          ))}
        </ul>
      )}
    </div>
  </Band>
)}

<style>
  .lead-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1.75rem;
  }
  .lead-head h2 {
    margin: 0;
  }
  .lead-more {
    font-weight: 700;
  }
  .lead {
    display: grid;
    gap: 2rem;
  }
  .lead-story > *,
  .lead-item p,
  .lead-item h3 {
    margin: 0;
  }
  .lead-story .lead-cover {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: calc(var(--radius) * 1.5);
    margin-bottom: 1.125rem;
  }
  .lead-chip {
    display: inline-block;
    padding: 0.125rem 0.625rem;
    border-radius: var(--pill);
    background: color-mix(in srgb, var(--link) 12%, transparent);
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .lead-story .lead-title {
    margin: 0.75rem 0 0.625rem;
    font-size: clamp(1.625rem, 1.3rem + 1.2vw, 2.125rem);
    font-weight: 800;
    line-height: 1.1;
  }
  .lead-title a,
  .lead-item-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .lead-title a:hover,
  .lead-item-title a:hover {
    text-decoration: underline;
  }
  .lead-story .lead-summary {
    color: var(--muted);
    font-size: var(--text-lg);
    max-width: var(--measure);
  }
  .lead-byline {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .lead-story .lead-byline {
    margin-top: 0.875rem;
  }
  .lead-rest {
    display: grid;
    align-content: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lead-item {
    display: grid;
    gap: 1rem;
    padding: 1.125rem 0;
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
  }
  .lead-item-pictured {
    grid-template-columns: minmax(0, 1fr) 5.5rem;
  }
  .lead-item:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .lead-item .lead-item-title {
    margin-top: 0.375rem;
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.25;
  }
  .lead-item .lead-byline {
    margin-top: 0.25rem;
  }
  .lead-thumb {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
  }
  @media (min-width: 52rem) {
    .lead {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 2.25rem;
    }
    .lead-alone {
      grid-template-columns: minmax(0, 1fr);
      max-width: 48rem;
    }
    .lead-item-pictured {
      grid-template-columns: minmax(0, 1fr) 7rem;
    }
  }
</style>
