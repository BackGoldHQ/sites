---
// The Faq accordion (board 07, A and B's right column): one native
// <details> per question, each a card on the band's surface, the question
// in bold beside a chevron that points down, and turns up while the answer
// is open (in a turn, unless the visitor asks for reduced motion), the
// answer under it through Prose. The browser opens and closes them, with the
// keyboard too, so it works with scripts off. `firstOpen` starts the first
// answer open.
import Prose from '../../Prose.astro'
import type { Question } from './faq'

interface Props {
  questions: Question[]
  firstOpen?: boolean
}

const { questions, firstOpen = false } = Astro.props
---
<div class="faq-questions">
  {questions.map((q, i) => (
    <details class="faq-question" open={firstOpen && i === 0}>
      <summary>{q.question}</summary>
      <Prose value={q.answer} class="faq-answer" />
    </details>
  ))}
</div>

<style>
  .faq-questions {
    display: grid;
    gap: 0.625rem;
  }
  .faq-question {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .faq-question[open] {
    border-color: var(--line-strong);
  }
  .faq-question summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.25rem;
    padding: 0.875rem 1.125rem;
    border-radius: var(--radius);
    color: var(--ink);
    font-weight: 700;
    line-height: 1.35;
    list-style: none;
  }
  .faq-question summary::-webkit-details-marker {
    display: none;
  }
  .faq-question summary:hover {
    color: var(--link);
  }
  /* The chevron: right-angled borders, pointing down while closed and up once open. */
  .faq-question summary::after {
    content: '';
    flex: 0 0 auto;
    width: 0.5rem;
    height: 0.5rem;
    margin: -0.25rem 0.25rem 0 0;
    border-right: 2px solid var(--link);
    border-bottom: 2px solid var(--link);
    transform: rotate(45deg);
  }
  .faq-question[open] summary::after {
    margin-top: 0.25rem;
    transform: rotate(225deg);
  }
  .faq-question :global(.faq-answer) {
    padding: 0 1.125rem 1.125rem;
    color: var(--muted);
  }
  .faq-question :global(.faq-answer > :last-child) {
    margin-bottom: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .faq-question summary::after {
      transition:
        transform 0.2s ease,
        margin 0.2s ease;
    }
    .faq-question[open] :global(.faq-answer) {
      animation: faq-answer-in 0.2s ease-out;
    }
  }
  @keyframes faq-answer-in {
    from {
      opacity: 0;
      transform: translateY(-0.375rem);
    }
  }
</style>
