---
// Stories · Timeline (board 10, C): the kicker, heading and line of copy,
// then the stories in the list in row order down a rail in the accent, in
// one reading column: a dot in the ink beside each story, the last story's
// dot in the accent to mark where things stand now. Each story has its
// label in small capitals (the year, as a <time> when it is one), its title
// in the display face, linked when the row has an address, and its body
// under it. On a phone the rail keeps to the left edge of the column. With
// no story and no heading it draws nothing.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import Prose from '../../Prose.astro'
import { storiesOf, yearOf } from './stories'
import { text } from '../../../lib/format'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
const stories = storiesOf(section)
---
{(heading || stories.length > 0) && (
  <Band section={section} class="stories stories-timeline">
    <div class="timeline-column">
      <SectionHead kicker={kicker} heading={heading} more={[]} />
      <Prose value={section.copy.body} class="lede" />
      {stories.length > 0 && (
        <ol class="timeline" role="list">
          {stories.map((story) => {
            const year = yearOf(story.label)
            return (
              <li class="timeline-step">
                <span class="timeline-dot" aria-hidden="true"></span>
                {story.label && <p class="timeline-label">{year ? <time datetime={year}>{story.label}</time> : story.label}</p>}
                <h3 class="timeline-title">{story.link ? <a href={story.link.href} rel={story.link.rel}>{story.title}</a> : story.title}</h3>
                {story.body && <p class="timeline-body">{story.body}</p>}
              </li>
            )
          })}
        </ol>
      )}
    </div>
  </Band>
)}

<style>
  .timeline-column {
    max-width: calc(var(--measure) + 4rem);
    margin-inline: auto;
  }
  .timeline-column > :global(.lede) {
    margin: -0.5rem 0 1.75rem;
  }
  .timeline {
    --rail: 3px;
    --dot: 1.125rem;
    /* The dot's centre sits on the label's line (its line box is 1.125rem tall). */
    --dot-y: 0.5625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .timeline-step {
    position: relative;
    padding: 0 0 clamp(1.5rem, 1.25rem + 1vw, 2rem) calc(var(--dot) + 1.125rem);
  }
  .timeline-step:last-child {
    padding-bottom: 0;
  }
  /* The rail: each step but the last draws it from its own dot's centre to the next one's. */
  .timeline-step:not(:last-child)::before {
    content: '';
    position: absolute;
    top: var(--dot-y);
    bottom: calc(-1 * var(--dot-y));
    left: calc(var(--dot) / 2 - var(--rail) / 2);
    width: var(--rail);
    background: var(--accent);
  }
  .timeline-dot {
    position: absolute;
    z-index: 1;
    top: calc(var(--dot-y) - var(--dot) / 2);
    left: 0;
    width: var(--dot);
    height: var(--dot);
    border: 3px solid var(--bg-band-background);
    border-radius: 50%;
    background: var(--ink);
    box-shadow: 0 0 0 1px var(--accent);
  }
  .timeline-step:last-child .timeline-dot {
    background: var(--accent);
  }
  .timeline-step > * {
    margin: 0;
  }
  .timeline-label {
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .timeline-step .timeline-title {
    margin-top: 0.25rem;
    font-size: var(--h3);
    font-weight: 700;
    line-height: 1.2;
  }
  .timeline-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .timeline-title a:hover {
    text-decoration: underline;
  }
  .timeline-step .timeline-body {
    margin-top: 0.375rem;
    color: var(--muted);
    max-width: var(--measure);
  }
  @media (min-width: 40rem) {
    .timeline {
      --dot: 1.375rem;
    }
    .timeline-step {
      padding-left: calc(var(--dot) + 1.75rem);
    }
  }
</style>
