---
// PlatformPlanks · Long read (board A2, "Platform planks · Long read"; A12
// shows it beside Numbered): the whole platform as one read. A jump list of
// the platform's sections ("01 · Your money") sits beside the text on a wide
// screen (sticky, with a reading bar that fills as the text scrolls by, where
// the browser can do that in CSS alone) and above it on a phone. Each section
// has its number, title and ethos; each plank is a card with its headline,
// its plain-language line, the full text behind "Read the full plank", and a
// "Share" link to its own anchor, a plain link that works with scripts off.
// The anchors are anchors.ts's, shared with the columns layout. With no
// sections it draws nothing.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import Prose from '../../Prose.astro'
import { text } from '../../../lib/format'
import { partsWithAnchors } from './anchors'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const heading = text(section.copy.heading)
const parts = partsWithAnchors(section)
---
{parts.length > 0 && (
  <Band section={section} class="platform platform-longread">
    {heading && <h2>{heading}</h2>}
    <div class="longread">
      <nav class="longread-jump" aria-label={heading ? `${heading}: sections` : 'Platform sections'}>
        <div class="longread-bar" aria-hidden="true"><span></span></div>
        <ol role="list">
          {parts.map((part) => (
            <li>
              <a href={`#${part.id}`}>{[part.num, part.title ?? (part.num ? null : 'Untitled')].filter(Boolean).join(' · ')}</a>
            </li>
          ))}
        </ol>
      </nav>
      <div class="longread-body">
        {parts.map((part) => (
          <article class="longread-part" id={part.id}>
            {(part.num || part.title) && (
              <h3 class="longread-title">
                {part.num && <span class="longread-num">{part.num}</span>}
                {part.title && <span>{part.title}</span>}
              </h3>
            )}
            {part.ethos && <p class="longread-ethos">{part.ethos}</p>}
            {part.planks.length > 0 && (
              <ul class="longread-planks" role="list">
                {part.planks.map((plank) => (
                  <li class="longread-plank" id={plank.id}>
                    <a class="longread-share" href={`#${plank.id}`}>
                      Share<span class="visually-hidden">: a link to “{plank.headline}”</span>
                    </a>
                    <h4 class="longread-headline">{plank.headline}</h4>
                    {plank.plain && <p class="longread-plain">{plank.plain}</p>}
                    {text(plank.full) && (
                      <details>
                        <summary>Read the full plank</summary>
                        <Prose value={plank.full} />
                      </details>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>
  </Band>
)}

<style>
  .longread {
    margin-top: 1.5rem;
    timeline-scope: --longread;
  }
  .longread-jump {
    margin-bottom: 2rem;
  }
  .longread-jump ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .longread-jump a {
    display: inline-block;
    padding: 0.375rem 0.875rem;
    border: 1.5px solid color-mix(in srgb, var(--ink) 22%, transparent);
    border-radius: var(--pill);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }
  .longread-jump a:hover {
    border-color: var(--ink);
  }
  .longread-bar {
    display: none;
  }
  .longread-body {
    view-timeline: --longread block;
  }
  .longread-part {
    padding: 1.625rem 0;
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    scroll-margin-top: 1rem;
  }
  .longread-part:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .longread-part > * {
    margin: 0;
  }
  .longread-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    font-size: calc(var(--h3) * 1.15);
    font-weight: 800;
  }
  .longread-num {
    color: var(--link);
    font-size: clamp(2rem, 1.6rem + 1.4vw, 2.5rem);
    line-height: 1;
  }
  .longread-part .longread-ethos {
    margin: 0.5rem 0 0.875rem;
    color: var(--muted);
    font-size: var(--text-lg);
    max-width: var(--measure);
  }
  .longread-planks {
    display: grid;
    gap: 0.625rem;
    padding: 0;
    list-style: none;
    max-width: calc(var(--measure) + 4rem);
  }
  .longread-plank {
    padding: 0.875rem 1rem;
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--page) 70%, transparent);
    scroll-margin-top: 1rem;
  }
  :global(.bg-band-contrast) .longread-plank {
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }
  .longread-plank:target {
    border-color: var(--link);
    box-shadow: 0 0 0 2px var(--link);
  }
  .longread-share {
    float: right;
    margin: 0 0 0.25rem 0.75rem;
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .longread-headline {
    margin: 0 0 0.125rem;
    font-family: var(--font);
    font-size: var(--text);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.35;
  }
  .longread-plain {
    margin: 0;
  }
  .longread-plank details {
    margin-top: 0.375rem;
  }
  .longread-plank summary {
    font-size: var(--text-sm);
  }
  .longread-plank :global(.prose) {
    margin-top: 0.75rem;
  }
  @media (min-width: 56rem) {
    .longread {
      display: grid;
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 3rem;
      align-items: start;
    }
    .longread-jump {
      position: sticky;
      top: 1.5rem;
      margin: 0;
    }
    .longread-jump ol {
      display: grid;
      gap: 0.125rem;
      border-left: 2px solid color-mix(in srgb, var(--ink) 14%, transparent);
    }
    .longread-jump a {
      display: block;
      margin-left: -2px;
      padding: 0.4375rem 0.875rem;
      border: 0;
      border-left: 2px solid transparent;
      border-radius: 0;
      color: var(--muted);
    }
    .longread-jump a:hover {
      border-left-color: var(--link);
      color: var(--ink);
    }
  }
  /* The reading bar fills as the text scrolls by: CSS only, where the browser has scroll-driven animations. */
  @supports (animation-timeline: view()) {
    @media (min-width: 56rem) and (prefers-reduced-motion: no-preference) {
      .longread-bar {
        display: block;
        height: 4px;
        margin-bottom: 0.875rem;
        border-radius: 4px;
        background: color-mix(in srgb, var(--ink) 14%, transparent);
        overflow: hidden;
      }
      .longread-bar span {
        display: block;
        height: 100%;
        background: var(--link);
        transform-origin: left center;
        animation: longread-fill linear both;
        animation-timeline: --longread;
        animation-range: contain 0% contain 100%;
      }
    }
  }
  @keyframes longread-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
