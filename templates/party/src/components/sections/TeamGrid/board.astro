---
// TeamGrid · Board (board A3, "Team & open roles · Board"; A12 shows it beside
// Grid): the party's board as seats, each with the photo (the holder's
// initials when there is none), its role over the holder's name, and a line
// under it. Four seats across on a wide screen, two on a phone. With no rows
// it draws nothing.
//
// When the rows are the party's seats (people.ts), each body is a group under
// its name with its seat count, in BackGold's order (the officers' body
// first, Staff last); a term every seat in the body shares is written beside
// the count ("term ends April 2027"), otherwise on each seat. A held seat's
// line is "since 2023", then the holder's bio. A vacant seat is drawn as an
// invitation, not a blank: "This seat is open" with the section's open-roles
// line (else "Any member in good standing can stand for it at convention.")
// and "Ask about running" to its open role's page (else the section's
// "interested?" link). Open roles that arrive without a seat follow, under
// "Open roles".
//
// When the rows are the older groups, officers come first (the leadership
// rows: role over the name, the short bio under it), then the at-large
// members (the staff rows, with their department), then each open role as an
// open seat in the same group.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import { text } from '../../../lib/format'
import { bodiesOf, initials, sharedTerm, teamOf } from './people'

type Props = ComponentProps<typeof Default>

const OPEN_LINE = 'Any member in good standing can stand for it at convention.'

const { section } = Astro.props
const heading = text(section.copy.heading)
const intro = text(section.copy.teamOpenRolesIntro)
const team = teamOf(section)
const { interest } = team
const bodies = bodiesOf(section)
const bySeat = bodies.length > 0
// By seat, the open roles that came without a seat; by group, every row.
const { leaders, staff } = bySeat ? { leaders: [], staff: [] } : team
const open = bySeat ? team.openRoles : team.open
const seats = staff.length + open.length
const count = (n: number) => (n === 1 ? '1 seat' : `${n} seats`)
const ask = (link: { href: string; rel: 'noopener' | undefined } | null) => (link ? { ...link, label: 'Ask about running' } : interest)
---
{(bySeat || leaders.length > 0 || seats > 0) && (
  <Band section={section} class="team team-board">
    {heading && <h2>{heading}</h2>}
    {bodies.map((body) => {
      const term = sharedTerm(body)
      return (
        <div class="seat-group">
          <h3 class="seat-group-name">
            {body.name} <span class="seat-group-count">{[count(body.seats.length), term && `term ends ${term}`].filter(Boolean).join(' · ')}</span>
          </h3>
          <ul class="seats" role="list">
            {body.seats.map((s) => {
              if (!s.name) {
                const button = ask(s.link)
                return (
                  <li class="seat seat-open">
                    <span class="seat-photo seat-empty" aria-hidden="true">?</span>
                    <p class="seat-role">{[s.seat, 'open seat'].filter(Boolean).join(' · ')}</p>
                    <h4 class="seat-name">This seat is open</h4>
                    <p class="seat-line">{intro ?? OPEN_LINE}</p>
                    {!term && s.termEnds && <p class="seat-line">term ends {s.termEnds}</p>}
                    {button && (
                      <p class="seat-ask">
                        <a class="button" href={button.href} rel={button.rel}>
                          {button.label}<span class="visually-hidden">: {s.seat ?? body.name}</span>
                        </a>
                      </p>
                    )}
                  </li>
                )
              }
              const line = [s.since && `since ${s.since}`, !term && s.termEnds && `term ends ${s.termEnds}`].filter(Boolean).join(' · ')
              return (
                <li class="seat">
                  {s.photo ? (
                    <img class="seat-photo" src={s.photo} alt="" loading="lazy" decoding="async" />
                  ) : (
                    <span class="seat-photo seat-initials" aria-hidden="true">{initials(s.name)}</span>
                  )}
                  {s.seat && <p class="seat-role">{s.seat}</p>}
                  <h4 class="seat-name">{s.link ? <a href={s.link.href} rel={s.link.rel}>{s.name}</a> : s.name}</h4>
                  {line && <p class="seat-line">{line}</p>}
                  {s.bio && <p class="seat-line">{s.bio}</p>}
                </li>
              )
            })}
          </ul>
        </div>
      )
    })}
    {leaders.length > 0 && (
      <div class="seat-group">
        <h3 class="seat-group-name">Officers</h3>
        <ul class="seats" role="list">
          {leaders.map((p) => (
            <li class="seat">
              {p.photo ? (
                <img class="seat-photo" src={p.photo} alt="" loading="lazy" decoding="async" />
              ) : (
                <span class="seat-photo seat-initials" aria-hidden="true">{initials(p.name)}</span>
              )}
              {p.role && <p class="seat-role">{p.role}</p>}
              <h4 class="seat-name">{p.link ? <a href={p.link.href} rel={p.link.rel}>{p.name}</a> : p.name}</h4>
              {p.bio && <p class="seat-line">{p.bio}</p>}
            </li>
          ))}
        </ul>
      </div>
    )}
    {seats > 0 && (
      <div class="seat-group">
        <h3 class="seat-group-name">
          {bySeat ? 'Open roles' : 'At-large members'} <span class="seat-group-count">{count(seats)}</span>
        </h3>
        <ul class="seats" role="list">
          {staff.map((p) => (
            <li class="seat">
              {p.photo ? (
                <img class="seat-photo" src={p.photo} alt="" loading="lazy" decoding="async" />
              ) : (
                <span class="seat-photo seat-initials" aria-hidden="true">{initials(p.name)}</span>
              )}
              {p.role && <p class="seat-role">{p.role}</p>}
              <h4 class="seat-name">{p.link ? <a href={p.link.href} rel={p.link.rel}>{p.name}</a> : p.name}</h4>
              {p.dept && <p class="seat-line">{p.dept}</p>}
            </li>
          ))}
          {open.map((p) => {
            const button = ask(p.link)
            return (
              <li class="seat seat-open">
                <span class="seat-photo seat-empty" aria-hidden="true">?</span>
                <p class="seat-role">{[p.role, p.dept].filter(Boolean).join(' · ')} · open seat</p>
                <h4 class="seat-name">This seat is open</h4>
                {(p.blurb ?? intro) && <p class="seat-line">{p.blurb ?? intro}</p>}
                {button && (
                  <p class="seat-ask">
                    <a class="button" href={button.href} rel={button.rel}>
                      {button.label}<span class="visually-hidden">: {p.role}</span>
                    </a>
                  </p>
                )}
              </li>
            )
          })}
        </ul>
      </div>
    )}
  </Band>
)}


<style>
  .seat-group + .seat-group {
    margin-top: 2.25rem;
  }
  .seat-group-name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin: 0 0 1rem;
    font-size: calc(var(--h3) * 1.05);
    font-weight: 800;
  }
  .seat-group-count {
    color: var(--muted);
    font-family: var(--font);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0;
  }
  .seats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .seat {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0.875rem;
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    border-radius: calc(var(--radius) * 1.5);
    background: color-mix(in srgb, var(--page) 70%, transparent);
  }
  :global(.bg-band-contrast) .seat {
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }
  .seat > * {
    margin: 0;
  }
  .seat-photo {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .seat-initials,
  .seat-empty {
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--ink) 8%, transparent);
    color: var(--muted);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .seat .seat-role {
    margin-top: 0.875rem;
    color: var(--link);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .seat .seat-name {
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.2;
  }
  .seat-name a {
    color: var(--ink);
  }
  .seat .seat-line {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .seat-open {
    border: 2px dashed color-mix(in srgb, var(--ink) 25%, transparent);
    background: transparent;
  }
  :global(.bg-band-contrast) .seat-open {
    background: transparent;
  }
  .seat .seat-ask {
    margin-top: auto;
    padding-top: 0.75rem;
  }
  .seat-ask .button {
    padding: 0.5rem 1rem;
    font-size: var(--text-sm);
    line-height: 1.2;
    text-align: center;
  }
  @media (min-width: 48rem) {
    .seats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }
    .seat {
      padding: 1.125rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .seat:not(.seat-open) {
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease;
    }
    .seat:not(.seat-open):hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgb(0 0 0 / 0.1);
    }
  }
</style>
