---
// Cta, 'photo' layout (With photo; board A1-home, section 7): the photo
// fills one half of the band edge to edge, with its caption at its lower
// left when the section carries one (`copy.caption`), and the eyebrow, the
// heading, the line of copy and the buttons (the first the main call, the
// rest outlines) sit in the other; on a phone the photo is a strip above the
// words. Without a photo it is the words alone on the band. A donate link goes to the organization's own
// donate page in BackGold, exactly as given: never rebuild it on this site.
import type { ComponentProps } from 'astro/types'
import Band from '../Band.astro'
import Prose from '../../Prose.astro'
import type Default from './index.astro'
import { links, media } from '../../../lib/section'
import { text } from '../../../lib/format'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const eyebrow = text(section.copy.eyebrow)
const heading = text(section.copy.heading)
const caption = text(section.copy.caption)
const photo = media(section, 'photoUrl', 'imageUrl')
const buttons = links(section)
---
<Band section={section} class:list={['cta', photo && 'cta-photo']}>
  <div class="cta-photo-grid">
    {photo && (
      <div class="cta-photo-frame">
        <img class="cta-photo-image" src={photo.url} alt={photo.alt} loading="lazy" decoding="async" />
        {caption && <p class="cta-photo-caption">{caption}</p>}
      </div>
    )}
    <div class="cta-photo-words">
      {eyebrow && <p class="kicker cta-photo-kicker">{eyebrow}</p>}
      {heading && <h2>{heading}</h2>}
      <Prose value={section.copy.body} class="lede" />
      {buttons.length > 0 && (
        <p class="actions">
          {buttons.map((link, i) => <a class:list={['button', i > 0 && 'button-quiet']} href={link.href} rel={link.rel}>{link.label}</a>)}
        </p>
      )}
    </div>
  </div>
</Band>

<style>
  /* With a photo the band has no padding of its own: the photo meets its edges, the words keep theirs. */
  :global(.bg-section.cta-photo) {
    --bg-section-padding: 0;
    overflow: hidden;
  }
  :global(.bg-section.cta-photo) > :global(.bg-section-inner) {
    max-width: none;
  }
  .cta-photo-grid {
    display: grid;
  }
  .cta-photo-frame {
    position: relative;
  }
  .cta-photo-image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 12.5rem;
    max-height: 22rem;
    object-fit: cover;
  }
  .cta-photo-caption {
    position: absolute;
    left: 0.75rem;
    bottom: 0.625rem;
    max-width: calc(100% - 1.5rem);
    margin: 0;
    padding: 0.1875rem 0.5rem;
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--band-photo) 70%, transparent);
    color: var(--band-photo-ink);
    font-size: 0.6875rem;
    line-height: 1.4;
  }
  :global(.cta-photo) .cta-photo-words {
    padding: 1.75rem var(--gutter) 2rem;
  }
  /* A1 sets the eyebrow over the photo call in the band's muted ink. */
  .cta-photo-kicker {
    color: var(--muted);
  }
  .cta-photo-words h2 {
    font-size: clamp(2rem, 1.35rem + 2.1vw, 2.75rem);
    line-height: 1.04;
    margin-bottom: 1rem;
  }
  .cta-photo-words :global(.lede) {
    font-size: 1.0625rem;
  }
  .cta-photo-words > :last-child {
    margin-bottom: 0;
  }
  @media (min-width: 48rem) {
    :global(.cta-photo) .cta-photo-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cta-photo-image {
      min-height: 21.25rem;
      max-height: none;
    }
    :global(.cta-photo) .cta-photo-words {
      align-self: center;
      max-width: 36rem;
      padding: clamp(2.5rem, 4vw, 3rem) clamp(1.75rem, 3.5vw, 2.75rem);
    }
  }
</style>
