---
// Services, 'list' layout (board S04, B, "Service list + starting at"): the
// section head and the body, then a row per service in the operator's order,
// each on the band's surface: the name and the summary at the left; at the
// right the copy's starting label small in capitals ("Starting at") over the
// price as the operator typed it, the term muted under it; then the row's
// button. The prices and the buttons line up down the list. The template
// draws no icons, so a row's `icon` is not drawn.
//
// Every button is outlined but the featured service's, which is solid, so
// the section has one solid button at most; the copy's featured label sits
// beside that service's name as a chip only when the operator wrote one. On a
// phone a row's words come first, the price and the button under them. The
// note sits small under the list. Nothing is drawn with neither a heading
// nor a service.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import Prose from '../../Prose.astro'
import Button from './Button.astro'
import { servicesOf } from './services'
import { text } from '../../../lib/format'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
const s = servicesOf(section)
const many = s.items.length > 1
---
{(heading || s.items.length > 0) && (
  <Band section={section} class="services services-list">
    <SectionHead kicker={kicker} heading={heading} more={[]} />
    <Prose value={section.copy.body} class="lede" />
    {s.items.length > 0 && (
      <ul class="sv-rows" role="list">
        {s.items.map((service) => (
          <li class:list={['sv-row', service.featured && 'sv-row-featured']}>
            <div class="sv-row-words">
              <div class="sv-row-head">
                <h3 class="sv-row-name">{service.name}</h3>
                {service.featured && s.featuredLabel && <span class="chip">{s.featuredLabel}</span>}
              </div>
              {service.summary && <p class="sv-row-summary">{service.summary}</p>}
            </div>
            <div class="sv-row-price">
              {service.price && (
                <>
                  {s.startingLabel && <p class="sv-row-from">{s.startingLabel}</p>}
                  <p class="sv-row-amount">{service.price}</p>
                </>
              )}
              {service.term && <p class="sv-row-term">{service.term}</p>}
            </div>
            {service.link && (
              <div class="sv-row-action">
                <Button service={service} solid={service.featured} many={many} />
              </div>
            )}
          </li>
        ))}
      </ul>
    )}
    {s.note && <p class="fine sv-rows-note">{s.note}</p>}
  </Band>
)}

<style>
  .sv-rows {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  :global(.lede) + .sv-rows {
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
  }
  .sv-row {
    display: grid;
    gap: 1rem 1.5rem;
    min-width: 0;
    padding: clamp(1.125rem, 0.9rem + 0.8vw, 1.5rem) clamp(1.125rem, 0.8rem + 1.2vw, 1.75rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--ink);
  }
  :global(.bg-band-contrast) .sv-row {
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }
  .sv-row-featured {
    border-color: var(--line-strong);
    box-shadow: var(--shadow);
  }
  .sv-row-words {
    min-width: 0;
  }
  .sv-row-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.75rem;
  }
  /* The featured label's chip, outlined so it reads on a surface as dark as the tint (a dark scheme). */
  .sv-row-head .chip {
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .sv-row-name {
    margin: 0;
    font-family: var(--font);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.35;
  }
  .sv-row-summary {
    margin: 0.25rem 0 0;
    max-width: var(--measure);
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .sv-row-price {
    min-width: 0;
  }
  .sv-row-price p {
    margin: 0;
  }
  .sv-row-from {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .sv-row-amount {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.2rem + 0.5vw, 1.625rem);
    font-variant-numeric: lining-nums;
    font-weight: 800;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }
  .sv-row-term {
    margin-top: 0.125rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .sv-rows-note {
    margin: 1.25rem 0 0;
  }
  /* On a phone the price and the button share a line under the words, the button at the right. */
  @media (max-width: 47.99rem) {
    .sv-row {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
    .sv-row-words {
      grid-column: 1 / -1;
    }
  }
  /* Wider, the rows share their columns, so the prices and the buttons line up down the list. */
  @media (min-width: 48rem) {
    .sv-rows {
      grid-template-columns: minmax(0, 1fr) minmax(9rem, max-content) max-content;
    }
    .sv-row {
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
      align-items: center;
      column-gap: clamp(1.5rem, 3vw, 2.5rem);
    }
    .sv-row-action :global(.button) {
      width: 100%;
    }
  }
</style>
