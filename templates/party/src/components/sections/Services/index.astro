---
// Services, 'packages' layout, the default (board S04, A, "Three packages"):
// the section head and the body, then a card per service in the operator's
// order, three across (two on a tablet, one under another on a phone): the
// service's name small in capitals, its price large in the display face as
// the operator typed it ("$4,500/mo", "15% of spend"), the term muted under
// it, the summary, what it includes as a checked list, and its one button.
// A section with one service draws one card, centred.
//
// The featured service's card is filled in the band's second button colour
// and carries the solid button; the copy's featured label ("Where most
// campaigns start") sits on it as a chip only when the operator wrote one, so
// the fill alone claims nothing. The other cards' buttons are outlined; with
// no featured service every button is, and a single card's is solid. The
// note sits small under the cards. Nothing is drawn with neither a heading
// nor a service.
import type { Section } from '@backgold/content'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import Prose from '../../Prose.astro'
import Button from './Button.astro'
import Includes from './Includes.astro'
import { servicesOf } from './services'
import { text } from '../../../lib/format'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
const s = servicesOf(section)
const many = s.items.length > 1
---
{(heading || s.items.length > 0) && (
  <Band section={section} class="services services-packages">
    <SectionHead kicker={kicker} heading={heading} more={[]} />
    <Prose value={section.copy.body} class="lede" />
    {s.items.length > 0 && (
      <ul class="sv-packages" role="list" data-count={Math.min(s.items.length, 3)}>
        {s.items.map((service) => (
          <li class:list={['sv-package', service.featured && 'sv-package-featured']}>
            <div class="sv-package-body">
              <div class="sv-package-head">
                <h3 class="sv-package-name">{service.name}</h3>
                {service.featured && s.featuredLabel && <span class="chip sv-featured">{s.featuredLabel}</span>}
              </div>
              {service.price && <p class="sv-package-price">{service.price}</p>}
              {service.term && <p class="sv-package-term">{service.term}</p>}
              {service.summary && <p class="sv-package-summary">{service.summary}</p>}
              <Includes items={service.includes} class="sv-package-includes" />
            </div>
            <Button service={service} solid={service.featured || !many} many={many} class="sv-package-button" />
          </li>
        ))}
      </ul>
    )}
    {s.note && <p class="fine sv-packages-note">{s.note}</p>}
  </Band>
)}

<style>
  .sv-packages {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  :global(.lede) + .sv-packages {
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
  }
  .sv-package {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(1.375rem, 1rem + 1vw, 1.875rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--ink);
  }
  :global(.bg-band-contrast) .sv-package {
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }
  .sv-package-featured,
  :global(.bg-band-contrast) .sv-package-featured {
    border-color: var(--button-2);
    background: var(--button-2);
    color: var(--button-2-ink);
    box-shadow: var(--shadow);
    --sv-check: var(--button-2-ink);
  }
  .sv-package-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    min-height: 1.75rem;
  }
  .sv-package-name {
    margin: 0;
    color: var(--muted);
    font-family: var(--font);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .sv-package-featured .sv-package-name {
    color: color-mix(in srgb, var(--button-2-ink) 78%, transparent);
  }
  .sv-package-featured .sv-featured {
    background: color-mix(in srgb, var(--button-2-ink) 16%, transparent);
    color: var(--button-2-ink);
  }
  .sv-package-price {
    margin: 0.875rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.6rem + 1.2vw, 2.75rem);
    font-variant-numeric: lining-nums;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .sv-package-term {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .sv-package-summary {
    margin: 0.875rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .sv-package-featured .sv-package-term {
    color: color-mix(in srgb, var(--button-2-ink) 82%, transparent);
  }
  .sv-package :global(.sv-package-includes) {
    margin: 1.375rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.9375rem;
  }
  .sv-package-featured :global(.sv-package-includes) {
    border-top-color: color-mix(in srgb, var(--button-2-ink) 22%, transparent);
  }
  .sv-package-body {
    flex: 1 0 auto;
  }
  .sv-package :global(.sv-package-button) {
    display: flex;
    width: 100%;
    margin-top: 1.5rem;
  }
  .sv-package-featured :focus-visible {
    outline-color: var(--button-2-ink);
  }
  .sv-packages-note {
    margin: 1.25rem 0 0;
    text-align: center;
  }
  [data-count='1'] {
    max-width: 26rem;
    margin-inline: auto;
  }
  @media (min-width: 40rem) {
    .sv-packages {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    [data-count='1'] {
      grid-template-columns: minmax(0, 1fr);
    }
    [data-count='2'] {
      max-width: 48rem;
      margin-inline: auto;
    }
  }
  @media (min-width: 56rem) {
    .sv-packages[data-count='3'] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
