---
// SampleBallot · Cards (mock 03, "Address-filtered cards"): the kicker over
// the heading, the body, then a card per race, three across on a wide
// screen and one on a phone. Each card has the candidate's headshot (their
// initials where there is none, as the candidate roster draws them), the
// office in small capitals, the name, which links to their page when the
// row has one, the place and the party, the line about them, and the
// endorsed chip on an endorsed race. The ballot measures come after under
// `measuresHeading`, one compact row each: the title (linked to its
// analysis when there is one), the position at the right, the line on it.
//
// No address is looked up here. When the races name more than one place,
// a chip per place ("All" first, then each place in the order the races
// name it) narrows the cards to that place's races, with "Showing N of M."
// for a screen reader. The chips are drawn hidden and shown by the
// section's script, so with scripts off every card shows and nothing is
// offered that cannot work. The measures always show. With no races, no
// measures and no heading it draws nothing.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import Prose from '../../Prose.astro'
import Position from './Position.astro'
import { text } from '../../../lib/format'
import { initials } from '../CandidateRoster/candidates'
import { ballotOf, idFor } from './ballot'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
const endorsedLabel = text(section.copy.endorsedLabel) ?? 'Endorsed'
const measuresHeading = text(section.copy.measuresHeading) ?? 'Ballot measures'
const { races, measures } = ballotOf(section)
const regions = [...new Set(races.map((race) => race.region).filter((region): region is string => region !== null))]
const filter = regions.length > 1
const cardsId = idFor(section, 'races')
---
{(races.length > 0 || measures.length > 0 || heading) && (
  <Band section={section} class="sample-ballot sample-ballot-cards">
    <SectionHead kicker={kicker} heading={heading} more={[]} />
    <Prose value={section.copy.body} class="lede" />
    {races.length > 0 && (
      <div class="ballot-races" data-ballot-races>
        {filter && (
          <div class="ballot-regions" role="group" aria-label="Places" data-ballot-regions hidden>
            <button type="button" aria-pressed="true" aria-controls={cardsId} data-region="">All</button>
            {regions.map((region) => (
              <button type="button" aria-pressed="false" aria-controls={cardsId} data-region={region}>{region}</button>
            ))}
          </div>
        )}
        <ul class="ballot-cards" id={cardsId} role="list">
          {races.map((race) => (
            <li class="ballot-card" data-region={race.region ?? ''}>
              <div class="ballot-card-top">
                {race.photo ? (
                  <img class="ballot-card-photo" src={race.photo} alt="" loading="lazy" decoding="async" />
                ) : (
                  <span class="ballot-card-photo ballot-card-initials" aria-hidden="true">{initials(race.name)}</span>
                )}
                <div class="ballot-card-who">
                  {race.office && <p class="ballot-card-office">{race.office}</p>}
                  <h3 class="ballot-card-name">
                    {race.link ? <a href={race.link.href} rel={race.link.rel}>{race.name}</a> : race.name}
                  </h3>
                  {(race.region || race.party) && <p class="ballot-card-meta">{[race.region, race.party].filter(Boolean).join(' · ')}</p>}
                </div>
              </div>
              {race.summary && <p class="ballot-card-summary">{race.summary}</p>}
              {race.endorsed && <p class="ballot-card-chip"><span class="chip chip-accent">{endorsedLabel}</span></p>}
            </li>
          ))}
        </ul>
        {filter && <p class="ballot-showing" role="status" data-ballot-showing></p>}
        {filter && (
          <script is:inline>
            ;(function (root) {
              if (!root) return
              var chips = root.querySelectorAll('[data-ballot-regions] [data-region]')
              var cards = root.querySelectorAll('.ballot-cards > [data-region]')
              var showing = root.querySelector('[data-ballot-showing]')
              var choose = function (region) {
                var shown = 0
                for (var c = 0; c < chips.length; c++) chips[c].setAttribute('aria-pressed', chips[c].getAttribute('data-region') === region ? 'true' : 'false')
                for (var i = 0; i < cards.length; i++) {
                  var match = !region || cards[i].getAttribute('data-region') === region
                  cards[i].hidden = !match
                  if (match) shown++
                }
                showing.textContent = shown === cards.length ? '' : 'Showing ' + shown + ' of ' + cards.length + '.'
              }
              for (var c = 0; c < chips.length; c++) {
                chips[c].addEventListener('click', function (event) {
                  choose(event.currentTarget.getAttribute('data-region'))
                })
              }
              root.querySelector('[data-ballot-regions]').hidden = false
            })(document.currentScript.closest('[data-ballot-races]'))
          </script>
        )}
      </div>
    )}
    {measures.length > 0 && (
      <div class="ballot-measures">
        <h3 class="ballot-measures-heading">{measuresHeading}</h3>
        <ul class="ballot-measure-list" role="list">
          {measures.map((measure) => (
            <li class="ballot-measure">
              <p class="ballot-measure-title">
                {measure.link ? <a href={measure.link.href} rel={measure.link.rel}>{measure.title}</a> : measure.title}
              </p>
              {measure.position && <Position position={measure.position} />}
              {measure.summary && <p class="ballot-measure-summary">{measure.summary}</p>}
            </li>
          ))}
        </ul>
      </div>
    )}
  </Band>
)}

<style>
  .ballot-regions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .ballot-regions[hidden],
  .ballot-card[hidden] {
    display: none;
  }
  .ballot-regions button {
    min-height: 2.75rem;
    padding: 0.375rem 0.875rem;
    border: 1.5px solid color-mix(in srgb, var(--ink) 25%, transparent);
    border-radius: var(--pill);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }
  .ballot-regions button:hover {
    border-color: var(--ink);
  }
  .ballot-regions button[aria-pressed='true'] {
    border-color: var(--button);
    background: var(--button);
    color: var(--button-ink);
  }
  .ballot-cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ballot-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .ballot-card > * {
    margin: 0;
  }
  .ballot-card:focus-within {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
  .ballot-card-top {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
  }
  .ballot-card-photo {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: calc(var(--radius) * 0.8);
  }
  .ballot-card-initials {
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--ink) 8%, transparent);
    color: var(--muted);
    font-family: var(--font-display);
    font-size: var(--h3);
    font-weight: 700;
  }
  .ballot-card-who > * {
    margin: 0;
  }
  .ballot-card-office {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .ballot-card-name {
    margin-top: 0.25rem;
    font-size: var(--h3);
  }
  .ballot-card-name a {
    color: var(--ink);
    text-decoration: none;
  }
  /* The name's link covers the card. */
  .ballot-card-name a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  .ballot-card-name a:focus-visible {
    outline: none;
  }
  .ballot-card:hover .ballot-card-name a {
    text-decoration: underline;
  }
  .ballot-card-meta {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .ballot-card-summary {
    color: var(--muted);
  }
  .ballot-card > .ballot-card-chip {
    margin-top: auto;
  }
  .ballot-showing {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .ballot-showing:empty {
    display: none;
  }
  .ballot-measures {
    margin-top: clamp(2rem, 1.5rem + 1.5vw, 2.75rem);
  }
  .ballot-measures-heading {
    margin: 0 0 0.75rem;
    font-size: var(--h3);
  }
  .ballot-measure-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--ink);
  }
  .ballot-measure {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.25rem 1rem;
    align-items: center;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--line);
  }
  .ballot-measure-title {
    margin: 0;
    font-weight: 700;
    line-height: 1.35;
  }
  .ballot-measure-title a {
    color: var(--ink);
  }
  .ballot-measure-summary {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  @media (min-width: 40rem) {
    .ballot-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 56rem) {
    .ballot-cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
