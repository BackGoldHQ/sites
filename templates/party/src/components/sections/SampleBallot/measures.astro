---
// SampleBallot · Measures (mock 03, "Measures guide"): where the
// organization stands on each ballot measure. The kicker over the heading,
// the body, then a card per measure, two across (one on a phone): its title
// with the position at the right (YES in the band's accent, NO and No
// position as outlines, never a party's red or blue), the line on it, and
// "Read our analysis" when the row links to one. The races, when there are
// any, follow as a compact list, each office in small capitals over the
// name and party, with the endorsed chip on an endorsed race and the name
// linked to the candidate's page when the row has one; the measures then
// sit under `measuresHeading` so the two read apart. With no races, no
// measures and no heading it draws nothing.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import Prose from '../../Prose.astro'
import Position from './Position.astro'
import { text } from '../../../lib/format'
import { ballotOf, nameWithParty } from './ballot'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
const endorsedLabel = text(section.copy.endorsedLabel) ?? 'Endorsed'
const measuresHeading = text(section.copy.measuresHeading) ?? 'Ballot measures'
const { races, measures } = ballotOf(section)
// Under `measuresHeading` (drawn when races follow) each title is a level lower.
const both = races.length > 0 && measures.length > 0
const Title = both ? 'h4' : 'h3'
---
{(races.length > 0 || measures.length > 0 || heading) && (
  <Band section={section} class="sample-ballot sample-ballot-measures">
    <SectionHead kicker={kicker} heading={heading} more={[]} />
    <Prose value={section.copy.body} class="lede" />
    {both && <h3 class="measures-heading">{measuresHeading}</h3>}
    {measures.length > 0 && (
      <ul class="measure-cards" role="list">
        {measures.map((measure) => (
          <li class="measure-card">
            <div class="measure-head">
              <Title class="measure-title">{measure.title}</Title>
              {measure.position && <Position position={measure.position} />}
            </div>
            {measure.summary && <p class="measure-summary">{measure.summary}</p>}
            {measure.link && (
              <p class="measure-more">
                <a href={measure.link.href} rel={measure.link.rel}>
                  Read our analysis<span class="visually-hidden">: {measure.title}</span>
                  <span aria-hidden="true"> →</span>
                </a>
              </p>
            )}
          </li>
        ))}
      </ul>
    )}
    {races.length > 0 && (
      <ul class="measure-races" role="list">
        {races.map((race) => (
          <li class="measure-race">
            {race.office && <p class="measure-race-office">{race.office}</p>}
            <p class="measure-race-name">
              {race.link ? <a href={race.link.href} rel={race.link.rel}>{nameWithParty(race)}</a> : nameWithParty(race)}
            </p>
            {race.endorsed && <span class="chip chip-accent">{endorsedLabel}</span>}
          </li>
        ))}
      </ul>
    )}
  </Band>
)}

<style>
  .measures-heading {
    margin: 0 0 1rem;
    font-size: var(--h3);
  }
  .measure-cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .measure-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.25rem, 1rem + 0.75vw, 1.625rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .measure-card > * {
    margin: 0;
  }
  .measure-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .measure-title {
    min-width: 0;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.25;
  }
  .measure-head :global(.position) {
    flex: none;
    margin-top: 0.125rem;
  }
  .measure-summary {
    color: var(--muted);
  }
  .measure-more {
    margin-top: auto;
    padding-top: 0.25rem;
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .measure-more a {
    color: var(--link);
  }
  .measure-races {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 0 clamp(1rem, 2vw, 1.75rem);
    margin: clamp(2rem, 1.5rem + 1.5vw, 2.75rem) 0 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--ink);
  }
  .measure-race {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--line);
  }
  .measure-race > p {
    flex-basis: 100%;
    margin: 0;
  }
  .measure-race-office {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .measure-race-name {
    font-weight: 700;
    line-height: 1.3;
  }
  .measure-race-name a {
    color: var(--ink);
  }
  @media (min-width: 40rem) {
    .measure-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
