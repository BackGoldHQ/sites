---
// CandidateRoster: the candidates the organization backs, each with the
// office, the place, the issues, and links to their site and their donate
// page in BackGold (follow it as given; never take a donation here). An
// endorsed candidate carries an "Endorsed" chip beside the status badge (alone
// when there is no status).
import type { Section } from '@backgold/content'
import Band from '../Band.astro'
import { text } from '../../../lib/format'
import { candidatesOf } from './candidates'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const heading = text(section.copy.heading)
const candidates = candidatesOf(section).map((c) => ({ ...c, office: [c.office, c.region].filter(Boolean).join(' · ') }))
---
<Band section={section} class="roster">
  {heading && <h2>{heading}</h2>}
  {candidates.length > 0 ? (
    <ul class="grid grid-3" role="list">
      {candidates.map((c) => (
        <li class="tile">
          {(c.status || c.endorsed) && (
            <p class="roster-tags">
              {c.status && <span class="badge">{c.status}</span>}
              {c.endorsed && <span class="chip chip-accent">Endorsed</span>}
            </p>
          )}
          <h3>{c.name}</h3>
          {c.office && <p class="muted">{c.office}</p>}
          {c.issues.length > 0 && <p class="fine">{c.issues.join(' · ')}</p>}
          {(c.site || c.donate) && (
            <p class="tile-links">
              {c.site && <a href={c.site.href} rel={c.site.rel}>{c.site.label}<span class="visually-hidden">: {c.name}</span></a>}
              {c.donate && <a href={c.donate.href} rel={c.donate.rel}>{c.donate.label}<span class="visually-hidden"> to {c.name}</span></a>}
            </p>
          )}
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty">No candidates listed yet.</p>
  )}
</Band>

<style>
  .roster-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
</style>
