---
// CandidateRoster · Compact (board A1, "Candidate roster · Compact"; A12 shows
// it beside Cards and Ballot): a tight grid of the candidates, each with the
// headshot (their initials when there is none), the name, the office and the
// place. The name links to the candidate's own site when the record has one.
// Four across on a wide screen, two on a phone. With no candidates it draws
// nothing.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import { text } from '../../../lib/format'
import { candidatesOf, initials } from './candidates'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const heading = text(section.copy.heading)
const candidates = candidatesOf(section)
---
{candidates.length > 0 && (
  <Band section={section} class="roster roster-compact">
    {heading && <h2>{heading}</h2>}
    <ul class="compact" role="list">
      {candidates.map((c) => (
        <li class="compact-item">
          {c.photo ? (
            <img class="compact-photo" src={c.photo} alt="" loading="lazy" decoding="async" />
          ) : (
            <span class="compact-photo compact-initials" aria-hidden="true">{initials(c.name)}</span>
          )}
          <h3 class="compact-name">{c.site ? <a href={c.site.href} rel={c.site.rel}>{c.name}</a> : c.name}</h3>
          {c.office && <p class="compact-office">{c.office}</p>}
          {c.region && <p class="compact-region">{c.region}</p>}
        </li>
      ))}
    </ul>
  </Band>
)}

<style>
  .compact {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 0.875rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .compact-item > * {
    margin: 0;
  }
  .compact-photo {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .compact-initials {
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--ink) 8%, transparent);
    color: var(--muted);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .compact-item .compact-name {
    margin-top: 0.75rem;
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.2;
  }
  .compact-name a {
    color: var(--ink);
  }
  .compact-item .compact-office {
    margin-top: 0.125rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .compact-item .compact-region {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.125rem 0.625rem;
    border-radius: var(--pill);
    background: color-mix(in srgb, var(--link) 12%, transparent);
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  @media (min-width: 48rem) {
    .compact {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.125rem;
    }
  }
</style>
