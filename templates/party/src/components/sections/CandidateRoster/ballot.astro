---
// CandidateRoster · Ballot (board A3, "Candidate roster · Ballot"; A12 shows it
// beside Cards and Compact): the candidates grouped by office in ballot order
// (statewide, then the legislature, judicial and local offices, then any
// other), each office under a rule with its level, each candidate with the
// headshot (initials when there is none), the place and status, and the
// buttons to their donate page in BackGold and their own site. The board's
// filter tabs become a row of links to each office once there are more than
// ten candidates in more than one office, so they work with scripts off; its
// search box is not drawn (the template has no search page for candidates).
// With no candidates it draws nothing.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import { text } from '../../../lib/format'
import { candidatesOf, initials, LEVEL_LABELS, type Candidate } from './candidates'

type Props = ComponentProps<typeof Default>

const BALLOT_ORDER = ['statewide', 'legislative', 'judicial', 'local']
const JUMP_AFTER = 10

const { section } = Astro.props
const heading = text(section.copy.heading)
const candidates = candidatesOf(section)

interface Office {
  id: string
  name: string
  level: string | null
  candidates: Candidate[]
}

// Offices in the order their first candidate arrives, then sorted by level;
// within an office, by place ("District 4" before "District 12").
const offices: Office[] = []
for (const c of candidates) {
  const name = c.office ?? 'Also on the ballot'
  let office = offices.find((o) => o.name === name)
  if (!office) {
    office = { id: `${section.id}-office-${offices.length + 1}`.replace(/[^A-Za-z0-9_-]/g, '-'), name, level: c.level, candidates: [] }
    offices.push(office)
  }
  office.candidates.push(c)
}
const rank = (level: string | null) => {
  const i = level ? BALLOT_ORDER.indexOf(level) : -1
  return i < 0 ? BALLOT_ORDER.length : i
}
offices.sort((a, b) => rank(a.level) - rank(b.level))
for (const office of offices) office.candidates.sort((a, b) => (a.region ?? '').localeCompare(b.region ?? '', 'en', { numeric: true }))
const jump = candidates.length > JUMP_AFTER && offices.length > 1
---
{candidates.length > 0 && (
  <Band section={section} class="roster roster-ballot">
    {heading && <h2>{heading}</h2>}
    {jump && (
      <nav class="ballot-jump" aria-label="Offices">
        <ul role="list">
          {offices.map((office) => (
            <li>
              <a href={`#${office.id}`}>
                {office.name} <span class="ballot-jump-count">{office.candidates.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <div class="ballot">
      {offices.map((office) => (
        <div class="ballot-office" id={office.id}>
          <h3 class="ballot-office-name">
            {office.name}
            {office.level && LEVEL_LABELS[office.level] && <small>{LEVEL_LABELS[office.level]}</small>}
          </h3>
          <ul class="ballot-cands" role="list">
            {office.candidates.map((c) => (
              <li class="ballot-cand">
                {c.photo ? (
                  <img class="ballot-photo" src={c.photo} alt="" loading="lazy" decoding="async" />
                ) : (
                  <span class="ballot-photo ballot-initials" aria-hidden="true">{initials(c.name)}</span>
                )}
                <div class="ballot-who">
                  <h4 class="ballot-name">{c.name}</h4>
                  {(c.region || c.status) && <p class="ballot-place">{[c.region, c.status].filter(Boolean).join(' · ')}</p>}
                </div>
                {(c.donate || c.site) && (
                  <p class="ballot-acts">
                    {c.donate && (
                      <a class="button" href={c.donate.href} rel={c.donate.rel}>
                        {c.donate.label}<span class="visually-hidden"> to {c.name}</span>
                      </a>
                    )}
                    {c.site && (
                      <a class="button button-quiet" href={c.site.href} rel={c.site.rel}>
                        {c.site.label}<span class="visually-hidden">: {c.name}</span>
                      </a>
                    )}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Band>
)}

<style>
  .ballot-jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .ballot-jump a {
    display: inline-block;
    padding: 0.375rem 0.875rem;
    border: 1.5px solid color-mix(in srgb, var(--ink) 25%, transparent);
    border-radius: var(--pill);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }
  .ballot-jump a:hover {
    border-color: var(--ink);
  }
  .ballot-jump-count {
    color: var(--muted);
  }
  .ballot {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .ballot-office {
    display: grid;
    gap: 0.875rem;
    padding-top: 0.875rem;
    border-top: 2px solid var(--ink);
    scroll-margin-top: 1rem;
  }
  .ballot-office-name {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.2;
  }
  .ballot-office-name small {
    display: block;
    margin-top: 0.125rem;
    color: var(--muted);
    font-family: var(--font);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0;
  }
  .ballot-cands {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18.75rem), 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ballot-cand {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: 0.75rem 0.875rem;
    align-items: center;
    padding: 0.75rem 0.875rem;
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--page) 70%, transparent);
  }
  :global(.bg-band-contrast) .ballot-cand {
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }
  .ballot-photo {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: calc(var(--radius) * 0.8);
  }
  .ballot-initials {
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--ink) 8%, transparent);
    color: var(--muted);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
  }
  .ballot-who > * {
    margin: 0;
  }
  .ballot-name {
    font-family: var(--font);
    font-size: var(--text);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.3;
  }
  .ballot-place {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .ballot-acts {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
  }
  .ballot-acts .button {
    padding: 0.4375rem 1rem;
    font-size: var(--text-sm);
  }
  @media (min-width: 40rem) {
    .ballot-cand {
      grid-template-columns: 4rem minmax(0, 1fr);
    }
    .ballot-acts {
      grid-column: 2;
    }
  }
  @media (min-width: 56rem) {
    .ballot-office {
      grid-template-columns: 13.75rem minmax(0, 1fr);
      gap: 1.375rem;
    }
  }
</style>
