---
// Collection · Library (board 01, A, "Pathway-filtered grid"): the heading
// with the "See all" link to the type's index at the right, then a card per
// entry on the band's surface, three across on a wide screen, two on a
// tablet and one on a phone. Each card opens with the entry's picture at
// 16:9 and its first term laid over the corner as a small tag; an entry with
// no picture opens with a soft panel naming its term (or the type, when it
// has no term) in the display face instead. Then the title, the link to the
// entry's page (the whole card is the link), and the summary in the muted
// ink. Nothing here knows who is reading: no progress, no "complete".
//
// When the entries' first terms would narrow the cards (two or more terms,
// or one term that some entries lack), a chip per term ("All" first, then
// each term in the order it first appears) shows only that term's entries,
// with "Showing N of M." for a screen reader. The chips are drawn hidden and
// shown by the section's script, so with scripts off every card shows and
// nothing is offered that cannot work. With no entries the heading stands
// over "Nothing here yet.", as the Cards layout says it; with neither,
// nothing is drawn.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import { idFor } from '../SampleBallot/ballot'
import { entriesOf, pluralOf, seeAllOf, termsOf } from './entries'
import { text } from '../../../lib/format'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const heading = text(section.copy.heading)
const entries = entriesOf(section)
const terms = termsOf(entries)
const plural = pluralOf(section)
const filter = terms.length > 1 || (terms.length === 1 && entries.some((e) => e.term === null))
const cardsId = idFor(section, 'library')
const Title = heading ? 'h3' : 'h2'
---
{(heading || entries.length > 0) && (
  <Band section={section} class="entries entries-library">
    <SectionHead kicker={null} heading={heading} more={seeAllOf(section, entries)} />
    {entries.length > 0 ? (
      <div class="lib" data-library>
        {filter && (
          <div class="lib-terms" role="group" aria-label="Filter by topic" data-library-terms hidden>
            <button type="button" aria-pressed="true" aria-controls={cardsId} data-term="">All</button>
            {terms.map((term) => (
              <button type="button" aria-pressed="false" aria-controls={cardsId} data-term={term}>{term}</button>
            ))}
          </div>
        )}
        <ul class="lib-cards" id={cardsId} role="list">
          {entries.map((entry) => {
            const label = entry.term ?? plural
            return (
              <li class:list={['lib-card', entry.href && 'lib-card-linked']} data-term={entry.term ?? ''}>
                {entry.image ? (
                  <div class="lib-frame">
                    <img class="lib-photo" src={entry.image} alt="" loading="lazy" decoding="async" />
                    {entry.term && <p class="lib-tag">{entry.term}</p>}
                  </div>
                ) : label && (
                  <div class="lib-frame lib-frame-label">
                    <p class="lib-big-label">{label}</p>
                  </div>
                )}
                <div class="lib-body">
                  <Title class="lib-title">{entry.href ? <a href={entry.href}>{entry.title}</a> : entry.title}</Title>
                  {entry.summary && <p class="lib-summary">{entry.summary}</p>}
                </div>
              </li>
            )
          })}
        </ul>
        {filter && <p class="visually-hidden" role="status" data-library-showing></p>}
        {filter && (
          <script is:inline>
            ;(function (root) {
              if (!root) return
              var group = root.querySelector('[data-library-terms]')
              var chips = group.querySelectorAll('[data-term]')
              var cards = root.querySelectorAll('.lib-cards > [data-term]')
              var showing = root.querySelector('[data-library-showing]')
              var choose = function (chip) {
                var term = chip.getAttribute('data-term')
                var shown = 0
                for (var c = 0; c < chips.length; c++) chips[c].setAttribute('aria-pressed', chips[c] === chip ? 'true' : 'false')
                for (var i = 0; i < cards.length; i++) {
                  var match = !term || cards[i].getAttribute('data-term') === term
                  cards[i].hidden = !match
                  if (match) shown++
                }
                showing.textContent = shown === cards.length ? 'Showing all ' + cards.length + '.' : 'Showing ' + shown + ' of ' + cards.length + '.'
              }
              for (var c = 0; c < chips.length; c++) {
                chips[c].addEventListener('click', function (event) {
                  choose(event.currentTarget)
                })
              }
              group.hidden = false
            })(document.currentScript.closest('[data-library]'))
          </script>
        )}
      </div>
    ) : (
      <p class="empty">Nothing here yet.</p>
    )}
  </Band>
)}

<style>
  .lib-terms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .lib-terms[hidden],
  .lib-card[hidden] {
    display: none;
  }
  .lib-terms button {
    min-height: 2.75rem;
    padding: 0.375rem 1rem;
    border: 1.5px solid color-mix(in srgb, var(--ink) 25%, transparent);
    border-radius: var(--pill);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }
  .lib-terms button:hover {
    border-color: var(--ink);
  }
  .lib-terms button[aria-pressed='true'] {
    border-color: var(--button);
    background: var(--button);
    color: var(--button-ink);
  }
  .lib-cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lib-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
  }
  .lib-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .lib-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lib-tag {
    position: absolute;
    left: 0.875rem;
    bottom: 0.875rem;
    max-width: calc(100% - 1.75rem);
    margin: 0;
    padding: 0.25rem 0.625rem;
    border-radius: var(--pill);
    background: var(--surface);
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .lib-frame-label {
    display: grid;
    place-items: center;
    padding: 1.25rem;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    box-shadow: inset 0 -3px 0 var(--accent);
  }
  .lib-big-label {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.375rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-align: center;
    overflow-wrap: anywhere;
  }
  .lib-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.125rem 1.25rem 1.375rem;
  }
  .lib-body > * {
    margin: 0;
  }
  .lib-body .lib-title {
    font-size: calc(var(--h3) * 0.85);
    font-weight: 700;
    line-height: 1.2;
  }
  .lib-title a {
    color: var(--ink);
    text-decoration: none;
  }
  /* The title's link covers the card. */
  .lib-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .lib-title a:focus-visible {
    outline: none;
  }
  .lib-card-linked:hover .lib-title a {
    text-decoration: underline;
  }
  .lib-card-linked:focus-within {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
  .lib-summary {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  @media (min-width: 40rem) {
    .lib-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
  @media (min-width: 60rem) {
    .lib-cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .lib-photo {
      transition: transform 0.3s ease;
    }
    .lib-card-linked:hover .lib-photo {
      transform: scale(1.02);
    }
    .lib-terms button {
      transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease;
    }
  }
</style>
