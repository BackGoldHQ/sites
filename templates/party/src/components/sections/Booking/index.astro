---
// Booking, 'cards' layout, the default (board S05, B, "Meeting-type cards"):
// the section head and the body, then a card per meeting type the
// organization's booking module offers, in its order, three across (two on a
// tablet, one under another on a phone), each on the band's surface under a
// thin rule in the accent: the type's name, its description, a line with its
// length and where it happens ("30 min · Video call"), then at the foot its
// price in the display face ("$250", "Free"; nothing when the type names no
// price) beside the pick button ("Pick a time", the section's pick label) to
// the type's booking page in BackGold, where the time is picked and the
// booking made. The first card's button is solid and the rest are outlined, so
// the section has one dominant action. A single type draws one card, centred.
//
// Nothing is drawn when the organization offers no meeting types, heading or
// not: the words would promise a booking that does not exist.
import type { Section } from '@backgold/content'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import Prose from '../../Prose.astro'
import { meetingTypesOf } from './types'
import { text } from '../../../lib/format'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const types = meetingTypesOf(section)
---
{types.length > 0 && (
  <Band section={section} class="booking booking-cards">
    <SectionHead kicker={text(section.copy.kicker)} heading={text(section.copy.heading)} more={[]} />
    <Prose value={section.copy.body} class="lede" />
    <ul class="bk-cards" role="list" data-count={Math.min(types.length, 3)}>
      {types.map((type, i) => (
        <li class="bk-card">
          <div class="bk-card-body">
            <h3 class="bk-name">{type.name}</h3>
            {type.description && <p class="bk-description">{type.description}</p>}
            {type.meta && <p class="bk-meta">{type.meta}</p>}
          </div>
          <div class="bk-foot">
            {type.price && <p class="bk-price">{type.price}</p>}
            <a class:list={['button', 'bk-pick', i > 0 && 'button-quiet']} href={type.book.href} rel={type.book.rel}>
              {type.book.label}<span class="visually-hidden">: {type.name}</span><span class="bk-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </li>
      ))}
    </ul>
  </Band>
)}

<style>
  .bk-cards {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  :global(.lede) + .bk-cards {
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
  }
  .bk-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(1.25rem, 1rem + 0.8vw, 1.625rem);
    border: 1px solid var(--line);
    border-top: 0.25rem solid var(--accent);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--ink);
  }
  .bk-card-body {
    flex: 1 0 auto;
  }
  .bk-name {
    margin: 0;
    font-size: clamp(1.1875rem, 1.1rem + 0.3vw, 1.375rem);
  }
  .bk-description {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .bk-meta {
    margin: 0.875rem 0 0;
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .bk-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-top: 1.375rem;
  }
  .bk-price {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 800;
    font-variant-numeric: lining-nums tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .bk-pick {
    flex: 0 0 auto;
  }
  .bk-arrow {
    margin-left: -0.125rem;
  }
  [data-count='1'] {
    max-width: 26rem;
    margin-inline: auto;
  }
  @media (min-width: 40rem) {
    .bk-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    [data-count='1'] {
      grid-template-columns: minmax(0, 1fr);
    }
    [data-count='2'] {
      max-width: 48rem;
      margin-inline: auto;
    }
  }
  @media (min-width: 56rem) {
    .bk-cards[data-count='3'] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
