---
// MediaKit · Press page (board 15, C): the kicker and the name (`heading`),
// then the press mentions (the rows of kind `mention`) at the left, each a
// row on the band's surface: the outlet in muted small capitals at the
// left, the title (a link to the piece when the row has an address) with
// "detail · March 14, 2026" under it at the right; on a phone the outlet
// sits over the title. At the right (under the mentions on a phone) the
// contact card in the contrast band's colours (on a section already on the
// contrast band, a tint of its ink): the contact heading ("Media
// inquiries"), the contact line, where an email address is a mailto: link
// and a web address a link, and the press kit link (`kitLabel` → `kitHref`)
// as the section's one button. A card with none of its words is left out
// and the mentions take the full width. Downloads, talks and appearances
// are the other layouts'. With no name and no mention it draws nothing.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import { contactParts, mediaKitOf } from './kit'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const found = mediaKitOf(section)
const { mentions, kit } = found
const card = found.contactHeading || found.contactLine || kit
const parts = found.contactLine ? contactParts(found.contactLine) : []
const level = found.heading ? 'h3' : 'h2'
const Title = level
---
{(found.heading || mentions.length > 0) && (
  <Band section={section} class="mediakit mediakit-press">
    <SectionHead kicker={found.kicker} heading={found.heading} more={[]} />
    {(mentions.length > 0 || card) && (
      <div class:list={['press', mentions.length > 0 && card && 'press-split']}>
        {mentions.length > 0 && (
          <ul class="press-list" role="list">
            {mentions.map((mention) => (
              <li class="press-item">
                {mention.outlet && <p class="press-outlet">{mention.outlet}</p>}
                <div class="press-words">
                  <Title class="press-title">{mention.link ? <a href={mention.link.href} rel={mention.link.rel}>{mention.title}</a> : mention.title}</Title>
                  {(mention.detail || mention.dayLabel) && (
                    <p class="press-meta">
                      {mention.detail}
                      {mention.detail && mention.dayLabel && ' · '}
                      {mention.dayLabel && <time datetime={mention.day}>{mention.dayLabel}</time>}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        )}
        {card && (
          <div class="press-contact bg-band-contrast">
            {found.contactHeading && <Title class="press-contact-heading">{found.contactHeading}</Title>}
            {parts.length > 0 && (
              <p class="press-contact-line">
                {parts.map((part) => (part.href ? <a href={part.href}>{part.text}</a> : part.text))}
              </p>
            )}
            {kit && (
              <p class="press-contact-action">
                <a class="button" href={kit.href} rel={kit.rel}>
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                    <path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {kit.label}
                </a>
              </p>
            )}
          </div>
        )}
      </div>
    )}
  </Band>
)}

<style>
  .press {
    display: grid;
    gap: 1.25rem;
  }
  .press-list {
    display: grid;
    gap: 0.625rem;
    align-content: start;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .press-item {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 1.125rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .press-item > * {
    margin: 0;
  }
  .press-outlet {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1.45;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .press-words {
    min-width: 0;
  }
  .press-words > * {
    margin: 0;
  }
  .press-words .press-title {
    font-family: var(--font);
    font-size: var(--text);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.35;
    text-wrap: pretty;
  }
  .press-title a {
    color: var(--ink);
  }
  .press-words .press-meta {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .press-contact {
    align-self: start;
    min-width: 0;
    padding: clamp(1.375rem, 1rem + 1.5vw, 2rem);
    border-radius: var(--radius-card);
    background: var(--bg-band-background);
    color: var(--bg-band-color);
  }
  :global(.bg-band-contrast) .press-contact {
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }
  .press-contact > * {
    margin: 0;
  }
  .press-contact .press-contact-heading {
    font-size: var(--h3);
  }
  .press-contact .press-contact-line {
    margin-top: 0.5rem;
    overflow-wrap: anywhere;
  }
  .press-contact .press-contact-action {
    margin-top: 1.25rem;
  }
  .press-contact > :first-child {
    margin-top: 0;
  }
  .press-contact-action .button {
    max-width: 100%;
  }
  /* With no mention, the card alone keeps a card's width. */
  .press-contact:only-child {
    max-width: 36rem;
  }
  @media (min-width: 40rem) {
    .press-item {
      grid-template-columns: 9.5rem minmax(0, 1fr);
      gap: 1rem;
      align-items: baseline;
      padding: 1.125rem 1.25rem;
    }
    .press-words {
      grid-column: 2;
    }
  }
  @media (min-width: 56rem) {
    .press-split {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: clamp(1.5rem, 3vw, 2.25rem);
      align-items: start;
    }
  }
</style>
