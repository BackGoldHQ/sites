---
// MediaKit · Speaker one-sheet (board 15, B): a filled panel in the contrast
// band's colours (on a section already on the contrast band, a tint of its
// ink). At the left the kicker ("Book Jordan to speak"), the name
// (`heading`) in the display face, the line under it (`role`), the facts
// line small, and the booking link (`bookLabel` → `bookHref`) as the
// section's one button. At the right (under the words on a phone) the talks
// heading over the talks (the rows of kind `talk`), each its title with the
// detail ("45 min keynote") muted beside or under it, between thin rules.
// Under the panel the past appearances (the rows of kind `appearance`) as a
// row of outlined tiles, each the outlet's name (the title when there is no
// outlet) in small capitals, a link when the row has an address. Downloads
// and mentions are the other layouts'. With no name, no talk and no
// appearance it draws nothing.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import { mediaKitOf } from './kit'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const found = mediaKitOf(section)
const { talks, appearances, book } = found
const words = found.kicker || found.heading || found.role || found.facts || book
const level = found.heading ? 'h3' : 'h2'
const Talks = level
---
{(found.heading || talks.length > 0 || appearances.length > 0) && (
  <Band section={section} class="mediakit mediakit-speaker">
    {(words || talks.length > 0) && (
      <div class:list={['speaker-panel', 'bg-band-contrast', words && talks.length > 0 && 'speaker-split']}>
        {words && (
          <div class="speaker-words">
            {found.kicker && <p class="kicker">{found.kicker}</p>}
            {found.heading && <h2 class="speaker-name">{found.heading}</h2>}
            {found.role && <p class="speaker-role">{found.role}</p>}
            {found.facts && <p class="speaker-facts">{found.facts}</p>}
            {book && (
              <p class="speaker-action">
                <a class="button" href={book.href} rel={book.rel}>{book.label}</a>
              </p>
            )}
          </div>
        )}
        {talks.length > 0 && (
          <div class="speaker-talks">
            {found.talksHeading && <Talks class="speaker-talks-heading">{found.talksHeading}</Talks>}
            <ul class="speaker-talk-list" role="list">
              {talks.map((talk) => (
                <li class="speaker-talk">
                  <span class="speaker-talk-title">{talk.link ? <a href={talk.link.href} rel={talk.link.rel}>{talk.title}</a> : talk.title}</span>
                  {talk.detail && <span class="speaker-talk-detail">{talk.detail}</span>}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
    {appearances.length > 0 && (
      <ul class="speaker-appearances" role="list" aria-label="Past appearances">
        {appearances.map((appearance) => {
          const name = appearance.outlet ?? appearance.title
          return (
            <li>
              {appearance.link ? (
                <a class="speaker-tile speaker-tile-linked" href={appearance.link.href} rel={appearance.link.rel}>{name}</a>
              ) : (
                <span class="speaker-tile">{name}</span>
              )}
            </li>
          )
        })}
      </ul>
    )}
  </Band>
)}

<style>
  .speaker-panel {
    display: grid;
    gap: 1.75rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--radius-card);
    background: var(--bg-band-background);
    color: var(--bg-band-color);
  }
  :global(.bg-band-contrast) .speaker-panel {
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }
  .speaker-words {
    min-width: 0;
  }
  .speaker-words > * {
    margin: 0;
  }
  .speaker-words .speaker-name {
    font-size: clamp(2rem, 1.4rem + 2vw, 2.875rem);
    font-weight: 800;
    line-height: 1.05;
  }
  .speaker-words .speaker-role {
    margin-top: 0.625rem;
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.35;
  }
  .speaker-words .speaker-facts {
    margin-top: 0.625rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .speaker-words .speaker-action {
    margin-top: 1.5rem;
  }
  .speaker-talks {
    min-width: 0;
  }
  .speaker-talks .speaker-talks-heading {
    margin: 0 0 0.25rem;
    font-family: var(--font);
    font-size: var(--text);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.4;
  }
  .speaker-talk-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .speaker-talk {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.125rem 1rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--line);
  }
  .speaker-talk-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.3;
  }
  .speaker-talk-title a {
    color: var(--ink);
  }
  .speaker-talk-detail {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .speaker-appearances {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.5rem), 1fr));
    gap: 0.625rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .speaker-appearances:first-child {
    margin-top: 0;
  }
  .speaker-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-height: 3.5rem;
    padding: 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-align: center;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .speaker-tile-linked {
    text-decoration: none;
  }
  .speaker-tile-linked:hover {
    border-color: var(--ink);
    color: var(--ink);
    text-decoration: underline;
  }
  @media (min-width: 48rem) {
    .speaker-split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2rem, 4vw, 3.5rem);
      align-items: start;
    }
    .speaker-appearances {
      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
      gap: 0.875rem;
      margin-top: 1.25rem;
    }
  }
</style>
