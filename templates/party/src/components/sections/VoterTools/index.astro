---
// VoterTools, 'register' layout, the default (mock 02, A, without its lookup
// form: BackGold has no registration check of its own, so the check is the
// official one the organization links to). Two cards side by side, stacked
// on a phone. The first asks: the kicker, the heading and the body, then the
// registration link as the main call and the polling-place link as an
// outline beside it (the polling link is the main call when there is no
// registration link). The second, raised on the band's card colour, is the
// visitor's plan: the election-day line in the display face, the early
// voting line under it, the ID note as a chip, then the key dates under
// `datesHeading`, each with its label, its day and its note; DaysLeft writes
// each date's state ("12 days left", "Today", "Closed") and lifts the
// nearest open one with an accent rule. Each card draws only what it has,
// and a card with nothing is left out. Nothing is drawn when the section
// has neither a heading, a link nor a date.
import type { Section } from '@backgold/content'
import Band from '../Band.astro'
import Prose from '../../Prose.astro'
import DaysLeft from './DaysLeft.astro'
import { voterTools } from './voter-tools'
import { prose } from '../../../lib/format'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const vt = voterTools(section)
const buttons = [vt.register, vt.polling].filter((link) => link !== null)
const asks = !!(vt.kicker || vt.heading || prose(section.copy.body) || buttons.length > 0)
const plan = !!(vt.electionDay || vt.earlyVoting || vt.idNote || vt.dates.length > 0)
const shown = !!(vt.heading || buttons.length > 0 || vt.dates.length > 0)
---
{shown && (
  <Band section={section} class="voter-tools vt-register">
    <div class:list={['vt-cards', asks && plan && 'vt-cards-two']}>
      {asks && (
        <div class="vt-card vt-ask">
          {vt.kicker && <p class="kicker">{vt.kicker}</p>}
          {vt.heading && <h2>{vt.heading}</h2>}
          <Prose value={section.copy.body} class="vt-body" />
          {buttons.length > 0 && (
            <p class="actions vt-actions">
              {buttons.map((link, i) => <a class:list={['button', i > 0 && 'button-quiet']} href={link.href} rel={link.rel}>{link.label}</a>)}
            </p>
          )}
        </div>
      )}
      {plan && (
        <div class="vt-card vt-plan">
          {vt.electionDay && <p class="vt-lead">{vt.electionDay}</p>}
          {vt.earlyVoting && <p class="vt-early">{vt.earlyVoting}</p>}
          {vt.idNote && <p class="vt-id"><span class="chip">{vt.idNote}</span></p>}
          {vt.dates.length > 0 && (
            <div class="vt-deadlines">
              {vt.datesHeading && <h3 class="vt-label">{vt.datesHeading}</h3>}
              <ul class="vt-deadline-list" role="list">
                {vt.dates.map((date) => (
                  <li class="vt-deadline" data-vt-date={date.day ?? undefined}>
                    <span class="vt-deadline-label">{date.label}</span>
                    {date.day && date.short && (
                      <time class="vt-deadline-day" datetime={date.day}>
                        <span aria-hidden="true">{date.short}</span>
                        <span class="visually-hidden">{date.full}</span>
                      </time>
                    )}
                    <span class="vt-deadline-meta">
                      {date.day && <span class="vt-state" data-vt-state></span>}
                      {date.note && <span class="vt-note">{date.note}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )}
    </div>
    {vt.dates.some((date) => date.day) && <DaysLeft />}
  </Band>
)}

<style>
  .vt-cards {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .vt-card {
    min-width: 0;
    padding: clamp(1.375rem, 1rem + 1.5vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
  }
  .vt-card > :last-child {
    margin-bottom: 0;
  }
  .vt-ask h2 {
    max-width: 18ch;
  }
  .vt-ask :global(.vt-body) {
    color: var(--muted);
    font-size: var(--text-lg);
  }
  .vt-ask :global(.vt-body) > :last-child {
    margin-bottom: 0;
  }
  .vt-actions {
    margin-top: 1.75rem;
  }
  .vt-plan {
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .vt-lead {
    margin: 0 0 0.625rem;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }
  .vt-early {
    margin: 0 0 1rem;
    color: var(--muted);
  }
  .vt-id {
    margin: 0 0 1.25rem;
  }
  .vt-deadlines {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .vt-plan > .vt-deadlines:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .vt-label {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-family: var(--font);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .vt-deadline-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* A date's row: the label and its state over the note at the left, the day in the display face at the right. */
  .vt-deadline {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.125rem 1rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--line);
  }
  .vt-deadline:first-child {
    border-top: 0;
  }
  .vt-deadline-label {
    font-weight: 700;
  }
  .vt-deadline-day {
    grid-row: 1 / span 2;
    grid-column: 2;
    align-self: center;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
  }
  .vt-deadline-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    font-size: var(--text-sm);
  }
  .vt-deadline-meta:empty {
    display: none;
  }
  .vt-state {
    font-weight: 700;
  }
  .vt-state:empty {
    display: none;
  }
  .vt-note {
    color: var(--muted);
  }
  /* The nearest open date (DaysLeft): an accent rule at its left, its state and day in the accent. */
  .vt-deadline.vt-next {
    margin-inline: calc(-1 * clamp(1.375rem, 1rem + 1.5vw, 2.25rem));
    padding-inline: calc(clamp(1.375rem, 1rem + 1.5vw, 2.25rem) - 4px) clamp(1.375rem, 1rem + 1.5vw, 2.25rem);
    border-left: 4px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }
  .vt-next .vt-state,
  .vt-next .vt-deadline-day {
    color: var(--accent);
  }
  .vt-next .vt-deadline-day {
    font-size: 1.75rem;
  }
  .vt-closed .vt-deadline-label,
  .vt-closed .vt-deadline-day,
  .vt-closed .vt-state {
    color: var(--muted);
  }
  .vt-closed .vt-deadline-day {
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }
  @media (min-width: 48rem) {
    .vt-cards-two {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: start;
    }
  }
</style>
