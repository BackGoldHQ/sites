---
// Petition · Map: BackGold's sheet under its own map header, which carries the
// title, so no heading here.
import type { Section } from '@backgold/content'
import Headed from '../modules/Headed.astro'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
---
<Headed section={section} layout="map" height="64rem" head={false} />
