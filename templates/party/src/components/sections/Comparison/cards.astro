---
// Comparison, 'cards' layout (board 08, "Head-to-head cards"): the section
// head and the body, then two panels side by side (ours over theirs on a
// phone). Ours, filled in the band's second button colour, is headed with
// our label and lists each of our positions after a check mark; theirs, on
// the band's surface, is headed with the first opponent's label and lists
// their positions after a cross. Each line carries its issue small above it,
// and on a wide screen the two panels share their rows, so an issue's two
// lines sit level. Only us and the first opponent are drawn here: the second
// opponent belongs to the table and the spectrum. An issue neither side
// fills is not drawn; one only a side fills keeps its line in the other
// panel, the issue over a dash ("No position listed" to a screen reader),
// so the lines still pair. A panel with no label or no position is left out
// and the other spans the row. Nothing is drawn with neither a heading nor
// an issue.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import Prose from '../../Prose.astro'
import { text } from '../../../lib/format'
import Unlisted from './Unlisted.astro'
import { linesOf, sidesOf } from './sides'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
const all = linesOf(section)
const panels = sidesOf(section).filter((side) => side.key !== 'them2' && all.some((line) => line.says[side.key]))
const lines = all.filter((line) => panels.some((side) => line.says[side.key]))
---
{(heading || lines.length > 0) && (
  <Band section={section} class="comparison comparison-cards">
    <SectionHead kicker={kicker} heading={heading} more={[]} />
    <Prose value={section.copy.body} class="lede" />
    {lines.length > 0 && (
      <div class="duel" style={`--duel-rows: ${lines.length}`}>
        {panels.map((side) => (
          <div class:list={['duel-panel', side.key === 'us' ? 'duel-ours' : 'duel-theirs']}>
            <h3 class="duel-label">{side.label}</h3>
            <ul class="duel-lines" role="list">
              {lines.map((line) => {
                const says = line.says[side.key]
                return says ? (
                  <li class="duel-line">
                    <span class="duel-issue">{line.issue}</span>
                    <span class="duel-says">
                      {side.key === 'us' ? (
                        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M3 8.5l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      ) : (
                        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                      )}
                      <span>{says}</span>
                    </span>
                  </li>
                ) : (
                  <li class="duel-line">
                    <span class="duel-issue">{line.issue}</span>
                    <span class="duel-says duel-none"><Unlisted /></span>
                  </li>
                )
              })}
            </ul>
          </div>
        ))}
      </div>
    )}
  </Band>
)}

<style>
  .duel {
    display: grid;
    gap: 1rem;
  }
  .duel-panel {
    min-width: 0;
    padding: clamp(1.375rem, 1rem + 1.5vw, 2.25rem);
    border-radius: var(--radius-card);
  }
  .duel-ours {
    border: 1px solid var(--button-2);
    background: var(--button-2);
    color: var(--button-2-ink);
  }
  .duel-theirs {
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .duel-panel .duel-label {
    margin: 0 0 1rem;
    font-size: var(--h3);
  }
  .duel-lines {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .duel-line {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding: 0.875rem 0;
    border-top: 1px solid var(--line);
  }
  .duel-ours .duel-line {
    border-top-color: color-mix(in srgb, var(--button-2-ink) 22%, transparent);
  }
  .duel-none {
    color: var(--muted);
  }
  .duel-ours .duel-none {
    color: color-mix(in srgb, var(--button-2-ink) 70%, transparent);
  }
  .duel-line:last-child {
    padding-bottom: 0;
  }
  .duel-issue {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .duel-ours .duel-issue {
    color: color-mix(in srgb, var(--button-2-ink) 78%, transparent);
  }
  .duel-says {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.35;
  }
  .duel-says svg {
    flex: 0 0 auto;
    width: 1.125rem;
    height: 1.125rem;
    margin-top: 0.125rem;
  }
  .duel-theirs .duel-says {
    font-weight: 500;
  }
  .duel-theirs .duel-says svg {
    color: var(--muted);
  }
  /* A wide screen: the panels side by side, every line on a row both panels share. */
  @media (min-width: 48rem) {
    .duel {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      grid-template-rows: auto repeat(var(--duel-rows), auto);
      column-gap: 1.25rem;
      row-gap: 0;
    }
    .duel-panel {
      display: grid;
      grid-row: 1 / -1;
      grid-template-rows: subgrid;
    }
    .duel-lines {
      display: grid;
      grid-row: 2 / -1;
      grid-template-rows: subgrid;
    }
  }
</style>
