---
// QuoteStrip, 'wall' layout (board 10, C, without its rating panel: a star
// average is a claim the rows do not hold): the heading, then every quote as
// a short card on the band's surface, laid in columns that pack like a
// masonry wall: three on a wide screen, two from 40rem, one on a phone; two
// at most for four quotes or fewer, and a lone quote is one card, not a band
// across the page. The cards run down each column in row order. Each sets
// the quote, curly quotes added (hanging into the margin) unless the
// operator typed their own, then "— attribution, role" in the muted ink,
// either part left out when the row has none. Nothing is drawn with no
// heading and no quote.
import type { ComponentProps } from 'astro/types'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import type Default from './index.astro'
import { quotesOf } from './quotes'
import { text } from '../../../lib/format'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const heading = text(section.copy.heading)
const quotes = quotesOf(section)
// Columns balance by height, so four short cards in three columns leave the
// third empty: three columns from five quotes, two up to four, one for one.
const cols = quotes.length >= 5 ? 3 : Math.min(quotes.length, 2)
---
{(heading || quotes.length > 0) && (
  <Band section={section} class="quotes quotes-wall">
    <SectionHead kicker={null} heading={heading} more={[]} />
    {quotes.length > 0 && (
      <ul class="qw" role="list" data-cols={cols}>
        {quotes.map((q) => {
          const by = [q.attribution, q.role].filter(Boolean).join(', ')
          return (
            <li class="qw-card">
              <figure>
                <blockquote>
                  <p class:list={['qw-quote', q.quoted && 'qw-quoted']}>{q.quote}</p>
                </blockquote>
                {by && <figcaption class="qw-by">— {by}</figcaption>}
              </figure>
            </li>
          )
        })}
      </ul>
    )}
  </Band>
)}

<style>
  .qw {
    columns: 1;
    column-gap: 1rem;
    margin: 0 0 -1rem;
    padding: 0;
    list-style: none;
  }
  /* One quote is one card, not a band across the page. */
  .qw[data-cols='1'] {
    max-width: 36rem;
  }
  .qw-card {
    display: inline-block;
    width: 100%;
    margin: 0 0 1rem;
    break-inside: avoid;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .qw-card figure {
    margin: 0;
    padding: 1.125rem 1.25rem 1.25rem;
  }
  .qw-card blockquote {
    margin: 0;
  }
  .qw-quote {
    margin: 0;
    line-height: 1.5;
    text-indent: -0.36em;
  }
  .qw-quote:not(.qw-quoted)::before {
    content: open-quote;
  }
  .qw-quote:not(.qw-quoted)::after {
    content: close-quote;
  }
  .qw-by {
    margin-top: 0.625rem;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.4;
  }
  @media (min-width: 40rem) {
    .qw {
      column-gap: 1.25rem;
      margin-bottom: -1.25rem;
    }
    .qw:not([data-cols='1']) {
      columns: 2;
    }
    .qw-card {
      margin-bottom: 1.25rem;
    }
  }
  @media (min-width: 60rem) {
    .qw[data-cols='3'] {
      columns: 3;
    }
  }
</style>
