---
// Store · Featured: the heading, then BackGold's store with its first product
// large.
import type { Section } from '@backgold/content'
import Headed from '../modules/Headed.astro'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
---
<Headed section={section} layout="featured" height="52rem" />
