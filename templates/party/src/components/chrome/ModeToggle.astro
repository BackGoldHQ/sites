---
// The header's light and dark switch, for a site whose appearance is auto
// (src/lib/brand.ts). The page follows the visitor's system until they press
// it; then it shows the other set and keeps the choice in this browser
// (`gg-mode`, as `data-gg-mode` on <html>). src/layouts/Site.astro applies a
// kept choice in the <head>, before the page paints, so a dark page never
// flashes light. BackGold's module frames on the page follow along: a chosen
// mode is sent to each (`backgold:mode`) when it loads and on every press.
// Without scripts the button stays hidden and the system decides.
---
<button class="mode-toggle" type="button" data-mode-toggle aria-pressed="false" hidden>
  <span class="visually-hidden">Dark mode</span>
  <svg class="mode-icon mode-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
  <svg class="mode-icon mode-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
</button>

<script is:inline>
  ;(function () {
    var button = document.querySelector('[data-mode-toggle]')
    if (!button) return
    var root = document.documentElement
    var system = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null
    function current() {
      var chosen = root.getAttribute('data-gg-mode')
      if (chosen === 'dark' || chosen === 'light') return chosen
      return system && system.matches ? 'dark' : 'light'
    }
    function show() {
      button.setAttribute('aria-pressed', current() === 'dark' ? 'true' : 'false')
    }
    function tell(frame) {
      var chosen = root.getAttribute('data-gg-mode')
      if (chosen !== 'dark' && chosen !== 'light') return
      var origin
      try {
        origin = new URL(frame.src).origin
      } catch (e) {
        return
      }
      if (frame.contentWindow) frame.contentWindow.postMessage({ type: 'backgold:mode', mode: chosen }, origin)
    }
    // The frames are further down the page than this script: catch each one's
    // load as it happens (load does not bubble, so in the capture phase).
    document.addEventListener(
      'load',
      function (e) {
        var t = e.target
        if (t && t.tagName === 'IFRAME' && t.hasAttribute('data-bg-embed')) tell(t)
      },
      true,
    )
    button.hidden = false
    show()
    if (system && system.addEventListener) system.addEventListener('change', show)
    button.addEventListener('click', function () {
      var next = current() === 'dark' ? 'light' : 'dark'
      root.setAttribute('data-gg-mode', next)
      try {
        localStorage.setItem('gg-mode', next)
      } catch (e) {}
      show()
      var frames = document.querySelectorAll('iframe[data-bg-embed]')
      for (var j = 0; j < frames.length; j++) tell(frames[j])
    })
  })()
</script>

<style>
  .mode-toggle {
    flex-shrink: 0;
    display: inline-grid;
    place-items: center;
    width: 2.375rem;
    height: 2.375rem;
    padding: 0;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--pill);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .mode-toggle[hidden] {
    display: none;
  }
  .mode-toggle:hover {
    border-color: var(--ink);
  }
  .mode-toggle:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 2px;
  }
  .mode-icon {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* The icon names what a press switches to: the moon while light, the sun while dark. */
  .mode-icon-sun,
  .mode-toggle[aria-pressed='true'] .mode-icon-moon {
    display: none;
  }
  .mode-toggle[aria-pressed='true'] .mode-icon-sun {
    display: block;
  }
</style>
