---
// The giving footer's email sign-up (template.json `chrome.footer:
// "giving"`): the Above-the-footer items Site.astro moved into the footer
// (each one made only of email sign-ups), drawn by <Area> exactly as the
// area draws them above the footer, so each is A1's band (SignupBand) and
// keeps its from and until. It sits between the footer menu's columns and the
// legal line, as a rounded panel, and carries #above-the-footer (the
// newsletter issue's "Sign up below" lands on it). Site.astro draws it only
// when there is such an item.
import type { Areas } from '@backgold/content'
import type { AstroComponentFactory } from 'astro/runtime/server/index.js'
import { Area } from '@backgold/astro/components'

interface Props {
  areas: Areas | null
  components: Record<string, AstroComponentFactory>
}

const { areas, components } = Astro.props
---
<div id="above-the-footer" class="footer-signup">
  <Area name="above_footer" areas={areas} components={components} />
</div>

<style>
  /* The space sits on each area item, so an item still waiting for its window (hidden) leaves no gap. */
  .footer-signup :global(.bg-area) {
    margin-top: clamp(2rem, 1.5rem + 1.5vw, 2.75rem);
  }
  .footer-signup :global(.bg-section) {
    border-radius: var(--radius);
  }
</style>
