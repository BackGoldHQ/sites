---
// An email sign-up placed Above the footer (board A1, "Area · Above the
// footer · Email signup · Band"): the frame around BackGold's own sign-up
// form. The kicker and the heading at the left; at the right the form itself,
// which arrives as the section's `embed` (its fields, button, consent line
// and "Sign-up by BackGold" are BackGold's, never rebuilt here). With no
// embed the heading takes the band alone. Site.astro passes this component
// for SignupCapture in the Above the footer area only; anywhere else the
// section renders through @backgold/astro's DefaultSection.
import type { Section } from '@backgold/content'
import { Embed } from '@backgold/astro/components'
import Band from '../sections/Band.astro'
import { text } from '../../lib/format'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
---
{(heading || section.embed) && (
  <Band section={section} class:list={['signup-band', section.embed && 'signup-band-form']}>
    <div class="signup-band-grid">
      <div class="signup-band-words">
        {kicker && <p class="kicker">{kicker}</p>}
        {heading && <h2>{heading}</h2>}
      </div>
      {section.embed && (
        <div class="signup-band-slot">
          <Embed embed={section.embed} title={heading ?? 'Sign up'} />
        </div>
      )}
    </div>
  </Band>
)}

<style>
  /* A1's .sec.tight: 48px of band above and below (32px on a phone). */
  :global(.bg-section.signup-band) {
    --bg-section-padding: clamp(2rem, 1.4rem + 1.6vw, 3rem) var(--gutter);
  }
  .signup-band-grid {
    display: grid;
    gap: 1.625rem;
    align-items: center;
  }
  .signup-band-words h2 {
    max-width: 16em;
    margin: 0;
    font-size: clamp(1.75rem, 1.4rem + 1vw, 2.125rem);
    line-height: 1.08;
  }
  .signup-band-slot :global(.bg-embed) {
    border-radius: var(--radius);
  }
  @media (min-width: 48rem) {
    :global(.signup-band-form) .signup-band-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 2.5rem;
    }
  }
</style>
