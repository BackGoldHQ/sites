---
// An email sign-up placed Above the footer (board A1, "Area · Above the
// footer · Email signup · Band"): whatever layout it was stored with, it is
// drawn in the Band layout there, the kicker and heading beside BackGold's
// form. Site.astro passes this component for SignupCapture in the Above the
// footer area only; anywhere else the section draws its own layout.
import type { ComponentProps } from 'astro/types'
import SignupCapture from '../sections/SignupCapture/index.astro'

type Props = ComponentProps<typeof SignupCapture>
---
<SignupCapture {...Astro.props} variant="band" />
