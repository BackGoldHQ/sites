---
// The post list layout, `list` (board A4): News, and the list of every type
// the organization adds. One entry per row: its picture, the line over its
// title (its term in the list's filter, or its type for an episode or a
// video in News), the title, the summary, and who wrote it and when.
import { safeHref, safeSrc } from '@backgold/astro/server'
import ListFrame from '../ListFrame.astro'
import type { ListLayoutProps } from '../props'
import { rowTerm, singularOf, writers } from '../../../lib/entries'
import { formatDay } from '../../../lib/format'

type Props = ListLayoutProps

const props = Astro.props
const bg = Astro.locals.backgold
const types = props.type === 'blog' && bg.setup === null ? (await bg.client.types()).types : []
const rows = props.entries.map((entry) => {
  const term = rowTerm(entry, props.filter?.taxonomy)
  const kind = entry.type !== 'post' ? singularOf(types, entry.type) : null
  return {
    entry,
    href: entry.url ? safeHref(entry.url) : null,
    image: entry.hero ? safeSrc(entry.hero.url) : null,
    line: [kind, term?.label].filter(Boolean).join(' · ') || null,
    by: writers(entry.authors).map((a) => a.display_name).join(', ') || null,
    day: formatDay(entry.publish_at),
  }
})
---
<ListFrame {...props} noun={props.type === 'blog' ? 'posts' : props.type.plural_label.toLowerCase()} class="list-posts">
  <ol class="post-rows" role="list">
    {rows.map((row) => (
      <li class="post-row">
        <article>
          {row.image && <img class="post-row-image" src={row.image} alt="" loading="lazy" decoding="async" />}
          <div class="post-row-body">
            {row.line && <p class="kicker">{row.line}</p>}
            <h2 class="post-row-title">{row.href ? <a href={row.href}>{row.entry.title}</a> : row.entry.title}</h2>
            {row.entry.summary && <p class="post-row-summary">{row.entry.summary}</p>}
            {(row.by || row.day) && (
              <p class="post-row-byline">
                {row.by}
                {row.by && row.day && ' · '}
                {row.day && row.entry.publish_at && <time datetime={row.entry.publish_at}>{row.day}</time>}
              </p>
            )}
          </div>
        </article>
      </li>
    ))}
  </ol>
</ListFrame>
