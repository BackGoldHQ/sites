---
// Around every list layout: the list's name as the page's one <h1> (on a
// term's list, the term, under the list's name), the filter (All, then each
// term a listed entry carries, the current one marked), the rows the layout
// draws in the slot (a sentence instead when there is nothing to show), and
// the pager under them: "Older" on to the next page when there is one, and
// "Newest" back to the first from any later page. The filter's term lists
// page the same way at their own addresses. There is no search: the Content
// API has none.
import type { ListLayoutProps } from './props'
import { listName, listPath, termPath } from '../../lib/entries'
import '../../styles/entries.css'

interface Props extends ListLayoutProps {
  /** The plural the empty sentence and the pager's label use: "posts", "episodes", "videos", "issues". */
  noun: string
  class?: string
}

const { type, entries, pager, filter, term, noun, class: className } = Astro.props
const base = listPath(type)
const name = listName(type)
const current = term ? `${term.taxonomy.key}/${term.term.slug}` : null
---
<div class:list={['listing', className]}>
  <header class="page-header list-header">
    {term && <p class="kicker"><a href={base ?? '/'}>{name}</a> · {term.taxonomy.label}</p>}
    <h1>{term ? term.term.label : name}</h1>
  </header>
  {base && filter && filter.terms.length > 0 && (
    <nav class="list-filter" aria-label={`Narrow the ${name.toLowerCase()}`}>
      <ul>
        <li><a href={base} aria-current={current === null ? 'page' : undefined}>All</a></li>
        {filter.terms.map((t) => {
          const key = `${filter.taxonomy}/${t.slug}`
          return <li><a href={termPath(base, filter.taxonomy, t.slug)} aria-current={current === key ? 'page' : undefined}>{t.label}</a></li>
        })}
      </ul>
    </nav>
  )}
  {entries.length > 0 ? <slot /> : <p class="empty">{term ? `Nothing is published under ${term.term.label} yet.` : `No ${noun} are published yet.`}</p>}
  {(pager.newest || pager.older) && (
    <nav class="pager" aria-label={`Pages of ${noun}`}>
      {pager.newest && <a href={pager.newest}>Newest</a>}
      {pager.older && <a href={pager.older} rel="next">Older</a>}
    </nav>
  )}
</div>
