        "slug": "about",
        "title": "About",
        "sections": [
          {
            "id": "Hero-about", "type": "Hero", "band": "plain", "bleed": "full", "variant": "split",
            "copy": {
              "headline": "A party for people who would rather be left alone.",
              "subheadline": "We run candidates in every corner of the state on one idea: you are the best judge of how to live your life.",
              "ctaText": "Join the party"
            },
            "media": {},
            "links": [{ "label": "Join the party", "target": { "kind": "surface", "path": "/join" }, "url": "/join" }]
          },
          {
            "id": "About-about", "type": "About", "band": "tint", "bleed": "full", "variant": "letter",
            "copy": {
              "heading": "We are not here to manage you.",
              "body": "Every two years someone promises to fix this state from the top down. We think it works better from the bottom up: families, neighbors, and county chapters that meet in libraries and grange halls and argue about the right things.\n\nWe are a small party with a long memory. We post every check we write. Our members pick our candidates and write our platform, and we keep showing up in every county, whether or not the cameras do."
            },
            "media": {},
            "links": []
          },
          {
            "id": "StatCards-about", "type": "StatCards", "band": "plain", "bleed": "full", "variant": "row",
            "copy": { "heading": "" },
            "media": {},
            "links": [],
            "data": {
              "source": "stats",
              "items": [
                { "label": "the year the party was founded", "value": "Your figure", "note": "", "accent": true },
                { "label": "counties with a chapter that meets every month", "value": "Your figure", "note": "", "accent": false },
                { "label": "the year we started posting every check online", "value": "Your figure", "note": "", "accent": false }
              ]
            }
          },
          {
            "id": "PlatformPlanks-about", "type": "PlatformPlanks", "band": "plain", "bleed": "full", "variant": "longread",
            "copy": { "heading": "What we stand for" },
            "media": {},
            "links": [],
            "options": { "anchorId": "platform" },
            "data": {
              "source": "platform",
              "items": [
                {
                  "title": "Your money",
                  "ethos": "What you earn is yours first. Government should have to make its case every year.",
                  "planks": [
                    { "headline": "No new income tax bracket", "plain": "The top state rate stays where it is, and a new bracket needs a vote of the people." },
                    { "headline": "A levy needs a ballot", "plain": "No new levy without a vote in a general election, not a quiet special one." }
                  ]
                },
                {
                  "title": "Open government",
                  "ethos": "If the state spends it, you can see it, within a week, without filing a request.",
                  "planks": [
                    { "headline": "Every check online", "plain": "A searchable ledger of every payment the state makes, updated weekly." },
                    { "headline": "Meetings on the record", "plain": "Every public body streams and archives its meetings." }
                  ]
                },
                {
                  "title": "Education",
                  "ethos": "Funding follows the student to any school that will teach them.",
                  "planks": [{ "headline": "Education savings accounts", "plain": "For every family, not a lottery for a few." }]
                }
              ]
            }
          },
