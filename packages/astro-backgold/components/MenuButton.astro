---
// The menu's header button: the one link marked `header_button`, drawn on
// the pages its Shows on rule names (every page without `page`). Renders
// nothing when the button does not show or its address is unsafe; nothing
// takes its place. A Donate button carries `data-bg-donate`.
import type { MenuItem } from '@backgold/content'
import { headerButtonOf, type MenuPage } from '../dist/render.js'

interface Props {
  items: MenuItem[]
  page?: MenuPage | null
  class?: string
}

const { items, page, class: className } = Astro.props
const button = headerButtonOf(items, Astro.url.pathname, page)
---
{button && (
  <a
    class:list={['bg-menu-button', className]}
    href={button.href}
    rel={button.rel}
    data-bg-button
    data-bg-donate={button.kind === 'donate' ? '' : undefined}
  >{button.label}</a>
)}
