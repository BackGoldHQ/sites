{
  "name": "@backgold/astro",
  "version": "0.3.1",
  "description": "Astro on Cloudflare Workers for a BackGold headless site: edge cache keyed by content version, webhook, preview, redirects, SEO routes and components",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./components": {
      "types": "./components/index.d.ts",
      "import": "./components/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    }
  },
  "files": [
    "dist",
    "components",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@backgold/content": "workspace:^",
    "marked": "^18.0.14",
    "parse5": "^8.0.1",
    "posthog-js": "^1.435.8"
  },
  "peerDependencies": {
    "astro": "^7"
  },
  "devDependencies": {
    "@givegold/shared": "workspace:*",
    "@types/node": "^24",
    "astro": "^7.3.5",
    "fast-xml-parser": "^5.11.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "~4.1.1"
  },
  "engines": {
    "node": ">= 22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/polyneural/backgold.git",
    "directory": "packages/astro-backgold"
  },
  "keywords": [
    "backgold",
    "headless",
    "cms",
    "astro",
    "astro-integration",
    "withastro",
    "cloudflare-workers"
  ]
}
