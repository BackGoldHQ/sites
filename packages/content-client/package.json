{
  "name": "@backgold/content",
  "version": "0.4.0",
  "description": "Typed, cache-aware client for the BackGold headless Content API (/api/content/v1)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fs": {
      "types": "./dist/fs.d.ts",
      "import": "./dist/fs.js"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "import": "./dist/codegen.js"
    }
  },
  "bin": {
    "backgold-content": "bin/backgold-content.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\"",
    "prepublishOnly": "pnpm lint && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@backgold/contract": "workspace:*",
    "@types/node": "^24",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">= 20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BackGoldHQ/sites.git",
    "directory": "packages/content-client"
  },
  "keywords": [
    "backgold",
    "headless",
    "cms",
    "content-api"
  ]
}
