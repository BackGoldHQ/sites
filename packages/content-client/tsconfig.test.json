{
  // The test build — the only one that compiles *.test.ts (same split as
  // packages/shared: tsconfig.json excludes tests so they never reach dist;
  // `exclude` is replaced, not merged, by a child config). Output goes to the
  // gitignored dist-test/ and runs under node:test.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-test",
    "declaration": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-test"]
}
