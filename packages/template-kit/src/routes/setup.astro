---
// Shown for every page until the site is connected to BackGold (the
// middleware sends each request here while BACKGOLD_SITE_KEY is missing or
// malformed; once it is set, this address is a 404). There is no BackGold
// data yet, so this page uses none: no layout, no menus, no brand.
import { brandCss } from '../lib/brand'
import '../styles/site.css'

const HELP: Record<string, { what: string; where: string }> = {
  BACKGOLD_SITE_KEY: {
    what: 'The site’s publishable key. It starts with bg_site_pk_.',
    where: 'In BackGold, open Sites, choose this site, then Developer. The key is under Keys, with a copy button.',
  },
  BACKGOLD_API_ORIGIN: {
    what: 'Where BackGold’s Content API lives. It must be a web address starting with https://.',
    where: 'Use https://api.backgold.com unless BackGold has told you otherwise.',
  },
}

const missing = Astro.locals.backgold.setup?.missing ?? []
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Connect this site to BackGold</title>
    <style is:inline set:html={brandCss(null)}></style>
  </head>
  <body>
    <main id="main" class="setup">
      <h1>Almost there: connect this site to BackGold</h1>
      <p class="lede">The site is deployed, but it does not know which BackGold site to show yet.</p>
      {missing.length > 0 && (
        <>
          <h2>{missing.length === 1 ? 'One setting needs a value' : 'These settings need a value'}</h2>
          <ul class="setup-list" role="list">
            {missing.map((name) => (
              <li>
                <p><code>{name}</code></p>
                <p>{HELP[name]?.what ?? 'A setting the site needs.'}</p>
                {HELP[name] && <p class="muted">{HELP[name].where}</p>}
              </li>
            ))}
          </ul>
        </>
      )}
      <h2>Where to set it</h2>
      <p>
        In the Cloudflare dashboard, open Workers &amp; Pages, choose this Worker, then Settings, then Variables and
        Secrets. Running locally, put it in <code>wrangler.jsonc</code> under <code>vars</code>.
      </p>
      <p class="muted">This page goes away by itself once the setting is saved.</p>
    </main>
  </body>
</html>
