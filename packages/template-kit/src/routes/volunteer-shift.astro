---
// `/volunteer/<slug>`: one open shift's page, the row of GET /shifts with
// that slug (lib/shifts.ts), drawn by the template's `volunteer:detail`
// (volunteerLayoutFor; the kit's components/volunteer/detail when it
// registers none) under the site's header and footer, with the areas of a
// page that holds events (GET /areas?holds=event); the Sidebar's items draw
// under the shift, full width, as under an event. A shift that belongs to a
// public event names it ("Part of"), by the event's title from GET
// /events/<slug>; an event the site cannot read leaves the line out. A slug
// the feed does not list (an ended shift, an unknown one, or an api with no
// feed) is the 404: the template's `notFound`, else the kit's NotFound.
// Deeper addresses (`/volunteer/<slug>/…`) are not this route's.
// The kit's integration serves it, for the template its `template` option
// names (`virtual:backgold-template`).
import { Area } from '@backgold/astro/components'
import { areaEntriesOf } from '@backgold/astro/server'
import Site from '../layouts/Site.astro'
import NotFound from '../components/NotFound.astro'
import { volunteerLayoutFor } from '../components/entries'
import { eventPage } from '../lib/events'
import { linkOf, type Link } from '../lib/section'
import { openShifts, shiftPath, volunteerAreas } from '../lib/shifts'
import template from 'virtual:backgold-template'

Astro.locals.template = template
const bg = Astro.locals.backgold
if (bg.setup !== null) return new Response(null, { status: 503 })

const { client, site } = bg
const siteName = site.name ?? site.domain
const slug = Astro.params.slug ?? ''
const [shifts, areas] = await Promise.all([openShifts(client), volunteerAreas(client)])
const shift = shifts?.find((s) => s.slug === slug) ?? null
if (!shift) Astro.response.status = 404

/** The public event the shift belongs to, by its title; null for a standalone shift or an event the site cannot read. */
async function partOfOf(): Promise<Link | null> {
  if (!shift || shift.subject.kind !== 'event' || !shift.subject.slug) return null
  const path = `/events/${encodeURIComponent(shift.subject.slug)}`
  try {
    const found = await eventPage(client, path)
    return found ? linkOf(found.event.title, path) : null
  } catch {
    return null
  }
}
const partOf = await partOfOf()
const DetailLayout = volunteerLayoutFor(template, 'detail')
const NotFoundLayout = template.notFound ?? NotFound
const more = shift !== null && areaEntriesOf(areas, 'sidebar').length > 0
---
{shift ? (
  <Site template={template} title={`${shift.title} · ${siteName}`} description={`A volunteer shift with ${siteName}.`} canonicalPath={shiftPath(shift.slug)} page={null} areas={areas}>
    <DetailLayout shift={shift} partOf={partOf} siteName={siteName} />
    {more && <Area name="sidebar" areas={areas} components={template.sections} class="event-more" />}
  </Site>
) : (
  <Site template={template} title={`Page not found · ${siteName}`} canonicalPath={Astro.url.pathname} noindex page={null}>
    <NotFoundLayout />
  </Site>
)}
