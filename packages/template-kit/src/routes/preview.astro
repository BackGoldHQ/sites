---
// BackGold's "Preview on your site" link: /preview?bg_preview=<token>&path=<path>.
// On BackGold's own deploys (the BACKGOLD_API binding) the draft is read
// first-party through the binding as the site, with no key: the composer's
// frame needs nothing set up. A copy deployed with the Deploy button reads it
// with BACKGOLD_SECRET_KEY (it never reaches the page), and without one
// answers 503. Either way it is rendered with the same layout, menus, areas
// and components as the published site, under a "Draft · not published"
// bar, and each section carries the marker the BackGold editor scrolls to.
// Never cached, never indexed. A bad or expired link answers 400. The kit's
// integration serves this page at /preview, for the template its `template`
// option names (`virtual:backgold-template`).
import { PREVIEW_HEADERS, areaEntriesOf, loadPreview, type MenuPage } from '@backgold/astro/server'
import { Area, PreviewBar } from '@backgold/astro/components'
import Site from '../layouts/Site.astro'
import { entryLayoutFor } from '../components/entries'
import PageSections from '../components/PageSections.astro'
import template from 'virtual:backgold-template'

const { sections } = template

const result = await loadPreview(Astro.request)
if (!result.ok) return result.response
for (const [name, value] of Object.entries(PREVIEW_HEADERS)) Astro.response.headers.set(name, value)

const bg = Astro.locals.backgold
if (bg.setup !== null) return new Response(null, { status: 503, headers: PREVIEW_HEADERS })
// The site as it is right now, read beside the draft: the header and footer
// just saved in BackGold draw in this frame at once, and the menus read
// under the current version, rather than as the Worker's cache last knew
// them (it checks the version once a minute).
bg.site = result.site.site
bg.legal = result.site.legal
bg.version = result.site.version
await bg.client.setVersion(result.site.version)
const draft = result.preview
const siteName = bg.site.name ?? bg.site.domain
const type = 'entry' in draft ? (await bg.client.types()).types.find((t) => t.key === draft.entry.type) : undefined
const title = 'page' in draft ? (draft.page.title ?? siteName) : draft.entry.title
const menuPage: MenuPage | null = 'page' in draft ? { id: draft.page.id, takes_donations: draft.page.takes_donations } : null
const areas = draft.areas ?? null
const sidebar = areaEntriesOf(areas, 'sidebar').length > 0
const EntryLayout = 'entry' in draft ? entryLayoutFor(template, draft.entry.type) : null
---
<Site template={template} title={`Preview: ${title}`} canonicalPath={result.path} noindex page={menuPage} areas={areas}>
  <PreviewBar />
  <div class:list={['layout', sidebar && 'layout-split']}>
    <div class="layout-main">
      {'page' in draft && <PageSections template={template} page={draft} siteName={siteName} />}
      {EntryLayout && 'entry' in draft && <EntryLayout entry={draft.entry} type={type} areas={areas} />}
    </div>
    {sidebar && <div class="layout-rail"><Area name="sidebar" areas={areas} components={sections} class="rail" /></div>}
  </div>
</Site>
