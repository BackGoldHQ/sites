---
// Every address on the site. resolveRoute reads what the path is from
// BackGold (a page, a type's list, an entry, an author, a term, a feed), so
// a content type the organization adds gets its pages with no change here.
// Redirects were already answered by the middleware.
//
// An entry is drawn by its type's entry layout and a list (a type's list, or
// a term's) by its type's list layout, as the template's template.json
// `entryLayouts` names them (src/components/entries); a type it does not name, and the
// news list (the blog types' shared list at the organization's blog base,
// `/news` for one made since the address became its own, `/blog` for one that
// kept it), use the post layouts. A list shows
// one page of up to 50 entries: `?cursor=` asks for a later one, and the
// layout draws "Older" on to the next page and "Newest" back to the first
// (the api names no previous page, so there is no "Newer").
//
// The news list opens with its intro when a published page sits at its
// address (resolveRoute's `intro`; the starter's `news` page, board A4): that
// page's sections, its Hero's headline the one <h1>, above the list. Such a
// page is the list's opening, never a page of its own.
//
// The news list and its terms' lists carry a search box that sends `?q=` to
// the news list. There a search of 2 to 80 characters lists the matching
// posts (the Content API's `?q=`, at most 20 a type) in place of the list,
// with no pager; anything else under `q` shows the list. A response to a
// request with `q` is never stored: the edge cache keys a list by its cursor
// alone, so a stored search would answer the bare list's address. Neither is
// a response with a calendar's `?month=`, nor a page with a calendar section
// at all: the month it shows and its today move with the clock.
//
// A page that draws a Donate frame (a section or an area item of type Donate)
// names the donate query names its frame copies (READS_QUERY_HEADER,
// lib/donate-frame.ts), so the edge cache never answers `?amount=25` with
// the bare page's copy, and a request that carries one is never stored. A
// page that draws a form frame names `pick`, the choice the form opens on,
// the same way.
//
// `/events/<type>` is the events page with its Agenda and Calendar sections
// narrowed to that type (the Agenda's rows read from the Content API's `GET
// /events?type=`, src/lib/events.ts; the Calendar reads its month by type
// itself), when the path is not already a page or an entry; a type with no upcoming event, or
// one that does not exist, is a 404. Any other `/events/<slug>` that is not
// a page or an entry is that event's own page (the template's `eventPage`,
// else src/components/EventPage.astro), read from `GET /events/<slug>`; a slug the api has no event for is a 404. A
// type's tab wins over an event slugged like the type while the type has an
// upcoming event. `/events.ics` is every upcoming event as one calendar file
// and `/events/<slug>.ics` one event's (src/lib/events.ts).
//
// A lesson, `/<courses base>/<course>/<lesson>`, is the video read through
// its course (resolveRoute's `lesson`): drawn by the template's `course:lesson`
// entry layout (lessonLayoutFor; the kit's Lesson player when the template
// registers none), given the lesson as `entry` and the api's whole answer
// (the course, the lessons either side) as `lesson`. The course's list and its own page are the
// course type's list and entry layouts. Every read here is made for the
// signed-in visitor when there is one (`locals.backgold.visitorReads`), so
// their locks open; their pages are never cached (the middleware).
//
// A page passes itself to the layout as `{ id, takes_donations }`, so the
// menus apply each link's Shows on rule; every other route passes null. A
// page, an entry, a list, a term and an event pass their areas to the layout
// (Top banner and Above the footer). A page, an entry, a list and a term
// draw their Sidebar beside the main column when it has an item (under it on
// a phone); with none they are one column. A page that opens with a Hero
// puts the Hero over both columns, so the Sidebar starts under it, beside
// what follows (board C5). An event has no column beside it: its Sidebar
// items draw under the event, full width (board C6's "More chances").
import type { Areas } from '@backgold/content'
import { Area } from '@backgold/astro/components'
import { READS_QUERY_HEADER, areaEntriesOf, atomFeed, jsonLdFor, pagerOf, relFor, resolveRoute, safeHref, safeSrc, type MenuPage, type Resolved } from '@backgold/astro/server'
import Site from '../layouts/Site.astro'
import EntryCard from '../components/EntryCard.astro'
import EventPage from '../components/EventPage.astro'
import NotFound from '../components/NotFound.astro'
import PageSections from '../components/PageSections.astro'
import { entryLayoutFor, lessonLayoutFor, listLayoutFor, volunteerLayoutFor } from '../components/entries'
import type { ListLayoutProps } from '../components/entries/props'
import { basePath, filterOf, listName, searchNews, searchQuery } from '../lib/entries'
import { EVENTS_CALENDAR_PATH, MONTH_PARAM, calendarSlugOf, drawsCalendar, eventCalendar, eventPage, eventsCalendar, typedEventsPage } from '../lib/events'
import { entryCard, leadsWithHero } from '../lib/section'
import { DONATE_READS_QUERY, FORM_READS_QUERY, carriesDonateQuery, carriesPickQuery, drawsDonateFrame, drawsFormFrame } from '../lib/donate-frame'
import { VOLUNTEER_PATH, openShifts, volunteerAreas } from '../lib/shifts'
import { markReading } from '../lib/reading'
import { COURSE_TYPE_KEY, lessonSignInTitle } from '../lib/academy'
import template from 'virtual:backgold-template'

const { sections } = template
// Every component this request draws reads the template here (ModuleFrame's frame options, LeadingHero's sections), areas and event pages included.
Astro.locals.template = template
/** One event's page and the 404's content: the template's own when it draws them, else the kit's. */
const EventLayout = template.eventPage ?? EventPage
const NotFoundLayout = template.notFound ?? NotFound

const bg = Astro.locals.backgold
if (bg.setup !== null) return new Response(null, { status: 503 })

const { client, site, siteUrl, visitorReads } = bg
const siteName = site.name ?? site.domain
const pathname = Astro.url.pathname
// `/events.ics` is every upcoming event as one calendar file (the events
// list's "Add every event to your calendar").
if (pathname === EVENTS_CALENDAR_PATH) {
  const file = await eventsCalendar(client, siteUrl, `${siteName} events`)
  if (!file) return new Response('Not found', { status: 404 })
  return new Response(file, {
    headers: { 'Content-Type': 'text/calendar; charset=utf-8', 'Content-Disposition': 'attachment; filename="events.ics"' },
  })
}
// `/events/<slug>.ics` is the event's calendar file (its page's Add to calendar).
const calendarSlug = calendarSlugOf(pathname)
if (calendarSlug !== null) {
  const found = await eventPage(client, `/events/${encodeURIComponent(calendarSlug)}`)
  const file = found ? eventCalendar(found.event, new URL(`/events/${encodeURIComponent(found.event.slug)}`, siteUrl).toString(), new URL(siteUrl).host) : null
  if (!file) return new Response('Not found', { status: 404 })
  return new Response(file, {
    headers: { 'Content-Type': 'text/calendar; charset=utf-8', 'Content-Disposition': `attachment; filename="${found!.event.slug}.ics"` },
  })
}
// The URL, not just the path: a list's `?cursor=` asks for a later page.
let resolved: Resolved = await resolveRoute(client, Astro.url, visitorReads)
const typed = resolved.kind === 'not_found' ? await typedEventsPage(client, Astro.request, pathname) : null
if (typed) resolved = { kind: 'page', page: typed.page }
const event = resolved.kind === 'not_found' ? await eventPage(client, pathname) : null
// `/volunteer` with no page of the site's own at that address is the kit's
// open-shifts list (lib/shifts.ts); a published Volunteer page there, the
// candidate starter's among them, is the page.
const volunteerList = resolved.kind === 'not_found' && !event && pathname === VOLUNTEER_PATH
const shifts = volunteerList ? await openShifts(client) : null
const rawQuery = Astro.url.searchParams.get('q')
const calendar = Astro.url.searchParams.has(MONTH_PARAM) || (resolved.kind === 'page' && resolved.page.sections.some(drawsCalendar))
if (rawQuery !== null || calendar) Astro.response.headers.set('Cache-Control', 'no-store')

if (resolved.kind === 'feed') {
  return new Response(await atomFeed(client, siteUrl, resolved.type), {
    headers: { 'Content-Type': 'application/atom+xml; charset=utf-8' },
  })
}
if (resolved.kind === 'not_found' && !event && !volunteerList) Astro.response.status = 404

let head: { title?: string; description?: string; image?: string; canonicalPath: string; noindex?: boolean; jsonLd?: object[] }
switch (resolved.kind) {
  case 'page': {
    const { page, sections } = resolved.page
    const firstImage = sections.flatMap((s) => Object.values(s.media ?? {})).map((m) => safeSrc(m.url)).find((u) => u !== null)
    const title = page.meta.title ?? page.title ?? undefined
    head = {
      title: typed && title ? `${typed.type.label} · ${title}` : title,
      description: page.meta.description ?? undefined,
      image: safeSrc(page.meta.image_url) ?? firstImage ?? undefined,
      canonicalPath: typed ? pathname : page.url,
      jsonLd: jsonLdFor({ site, siteUrl, kind: 'page', page }),
    }
    break
  }
  case 'index':
    head = {
      title: `${listName(resolved.type, resolved.base, resolved.intro)} · ${siteName}`,
      canonicalPath: pathname,
      jsonLd: jsonLdFor({ site, siteUrl, kind: 'index', type: resolved.type, base: resolved.base, intro: resolved.intro }),
    }
    break
  case 'entry': {
    const { entry, type } = resolved
    head = {
      title: entry.title,
      description: entry.summary ?? undefined,
      image: entry.hero ? (safeSrc(entry.hero.url) ?? undefined) : undefined,
      canonicalPath: entry.url ?? pathname,
      jsonLd: jsonLdFor({ site, siteUrl, kind: 'entry', type, entry }),
    }
    break
  }
  case 'lesson': {
    const { lesson, course } = resolved.lesson
    head = {
      title: `${lesson.title} · ${course.title}`,
      description: lesson.summary ?? undefined,
      image: lesson.hero ? (safeSrc(lesson.hero.url) ?? undefined) : undefined,
      canonicalPath: pathname,
    }
    break
  }
  case 'author':
    head = {
      title: `${resolved.author.display_name} · ${siteName}`,
      description: resolved.author.bio ?? undefined,
      canonicalPath: pathname,
      jsonLd: jsonLdFor({ site, siteUrl, kind: 'author', author: resolved.author }),
    }
    break
  case 'term':
    head = {
      title: `${resolved.term.label} · ${siteName}`,
      canonicalPath: pathname,
      jsonLd: jsonLdFor({ site, siteUrl, kind: 'term', type: resolved.type, base: resolved.base, taxonomy: resolved.taxonomy, term: resolved.term }),
    }
    break
  default:
    head = event
      ? { title: `${event.event.title} · ${siteName}`, image: safeSrc(event.event.image_url) ?? undefined, canonicalPath: pathname }
      : volunteerList
        ? { title: `Volunteer · ${siteName}`, description: `Open volunteer shifts with ${siteName}.`, canonicalPath: VOLUNTEER_PATH }
        : { title: `Page not found · ${siteName}`, canonicalPath: pathname, noindex: true }
}
const menuPage: MenuPage | null =
  resolved.kind === 'page' ? { id: resolved.page.page.id, takes_donations: resolved.page.page.takes_donations } : null
const areas: Areas | null =
  resolved.kind === 'page'
    ? resolved.page.areas
    : resolved.kind === 'entry' || resolved.kind === 'index' || resolved.kind === 'term' || resolved.kind === 'lesson'
      ? resolved.areas
      : volunteerList
        ? await volunteerAreas(client)
        : event?.areas ?? null
{
  const pageSections = resolved.kind === 'page' ? resolved.page.sections : []
  const reads = [
    ...(drawsDonateFrame(pageSections, areas) ? [DONATE_READS_QUERY] : []),
    ...(drawsFormFrame(pageSections, areas) ? [FORM_READS_QUERY] : []),
  ]
  if (reads.length > 0) {
    Astro.response.headers.set(READS_QUERY_HEADER, reads.join(','))
    const carries =
      (drawsDonateFrame(pageSections, areas) && carriesDonateQuery(Astro.url.searchParams)) ||
      (drawsFormFrame(pageSections, areas) && carriesPickQuery(Astro.url.searchParams))
    if (carries) Astro.response.headers.set('Cache-Control', 'no-store')
  }
}
// The sections in an entry's areas leave out the entry being read (lib/reading.ts).
if (resolved.kind === 'entry') markReading(Astro.locals, resolved.entry.id)
if (resolved.kind === 'lesson') markReading(Astro.locals, resolved.lesson.lesson.id)
const sidebar = resolved.kind !== 'author' && resolved.kind !== 'not_found' && areaEntriesOf(areas, 'sidebar').length > 0
const heroOverSplit = sidebar && resolved.kind === 'page' && leadsWithHero(resolved.page.sections)
const eventMore = event !== null && areaEntriesOf(event.areas, 'sidebar').length > 0

// A list, or a term's list: its layout and what it is given. The filter comes
// from the type's whole first page, so every term with an entry on it stays
// offered while one is chosen, on every later page and beside a search.
let list: { Layout: ReturnType<typeof listLayoutFor>; props: ListLayoutProps } | null = null
if (resolved.kind === 'index' || resolved.kind === 'term') {
  const key = resolved.type === 'blog' ? 'post' : resolved.type.key
  const base = basePath(resolved.base)
  const whole = resolved.kind === 'index' && resolved.cursor === null ? resolved : await resolveRoute(client, base, visitorReads)
  const news = resolved.type === 'blog'
  const q = news && resolved.kind === 'index' ? searchQuery(rawQuery) : null
  list = {
    Layout: listLayoutFor(template, key),
    props: {
      template,
      type: resolved.type,
      base: resolved.base,
      entries: q === null ? resolved.entries : await searchNews(client, q),
      pager: q === null ? pagerOf(resolved, pathname) : { newest: null, older: null },
      filter: whole?.kind === 'index' ? filterOf(whole.entries) : null,
      term: resolved.kind === 'term' ? { taxonomy: resolved.taxonomy, term: resolved.term } : null,
      search: news ? { action: base, q } : null,
      intro: resolved.kind === 'index' ? resolved.intro : null,
      areas,
    },
  }
}
const ListLayout = list?.Layout ?? null
const EntryLayout = resolved.kind === 'entry' ? entryLayoutFor(template, resolved.entry.type) : null
const LessonLayout = resolved.kind === 'lesson' ? lessonLayoutFor(template) : null
const VolunteerListLayout = volunteerList ? volunteerLayoutFor(template, 'list') : null
/** What the header's Sign in names to the portal's door: a lesson, or a course's title on the course's page. */
const signInTitle =
  resolved.kind === 'lesson'
    ? lessonSignInTitle(resolved.lesson)
    : resolved.kind === 'entry' && resolved.type.key === COURSE_TYPE_KEY
      ? resolved.entry.title
      : null
const avatar = resolved.kind === 'author' ? safeSrc(resolved.author.avatar_url) : null
const authorLink = resolved.kind === 'author' ? safeHref(resolved.author.link_url) : null
---
<Site {...head} template={template} page={menuPage} areas={areas} signInTitle={signInTitle}>
  {resolved.kind === 'author' && (
    <div class="listing">
      <header class="page-header author">
        {avatar && <img class="author-avatar" src={avatar} alt="" />}
        <h1>{resolved.author.display_name}</h1>
        {resolved.author.bio && <p class="lede">{resolved.author.bio}</p>}
        {authorLink && <p><a href={authorLink} rel={relFor(authorLink)}>More about {resolved.author.display_name}</a></p>}
      </header>
      {resolved.entries.length > 0 && (
        <div class="grid grid-3">{resolved.entries.map((entry) => <EntryCard card={entryCard(entry)} />)}</div>
      )}
    </div>
  )}

  {resolved.kind === 'not_found' && !volunteerList && (event ? <EventLayout event={event.event} /> : <NotFoundLayout />)}
  {VolunteerListLayout && (
    <div class:list={['layout', sidebar && 'layout-split']}>
      <div class="layout-main"><VolunteerListLayout shifts={shifts ?? []} siteName={siteName} /></div>
      {sidebar && <div class="layout-rail"><Area name="sidebar" areas={areas} components={sections} class="rail" /></div>}
    </div>
  )}
  {eventMore && event && <Area name="sidebar" areas={event.areas} components={sections} class="event-more" />}

  {heroOverSplit && resolved.kind === 'page' && <PageSections template={template} page={resolved.page} siteName={siteName} only="lead" />}
  {resolved.kind !== 'author' && resolved.kind !== 'not_found' && (
    <div class:list={['layout', sidebar && 'layout-split']}>
      <div class="layout-main">
        {resolved.kind === 'page' && <PageSections template={template} page={resolved.page} siteName={siteName} only={heroOverSplit ? 'rest' : undefined} />}
        {resolved.kind === 'entry' && EntryLayout && <EntryLayout entry={resolved.entry} type={resolved.type} areas={areas} />}
        {resolved.kind === 'lesson' && LessonLayout && <LessonLayout entry={resolved.lesson.lesson} type={undefined} areas={areas} lesson={resolved.lesson} />}
        {ListLayout && list && <ListLayout {...list.props} />}
      </div>
      {sidebar && <div class="layout-rail"><Area name="sidebar" areas={areas} components={sections} class="rail" /></div>}
    </div>
  )}
</Site>
