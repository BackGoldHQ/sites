---
// `/volunteer`: the organization's open volunteer shifts (GET /shifts, every
// page of it up to 200, lib/shifts.ts), drawn by the template's
// `volunteer:list` (volunteerLayoutFor; the kit's components/volunteer/list
// when it registers none) under the site's header and footer, with the areas
// of a page that holds events (GET /areas?holds=event): the Top banner and
// Above the footer, and the Sidebar beside the list when it has an item
// (under it on a phone), as on any page. An api that serves no shift feed
// draws the layout's empty state. The page is cached by content version
// like every page; the counts are read again after load.
// The kit's integration serves it, for the template its `template` option
// names (`virtual:backgold-template`).
import { Area } from '@backgold/astro/components'
import { areaEntriesOf } from '@backgold/astro/server'
import Site from '../layouts/Site.astro'
import { volunteerLayoutFor } from '../components/entries'
import { VOLUNTEER_PATH, openShifts, volunteerAreas } from '../lib/shifts'
import template from 'virtual:backgold-template'

Astro.locals.template = template
const bg = Astro.locals.backgold
if (bg.setup !== null) return new Response(null, { status: 503 })

const { client, site } = bg
const siteName = site.name ?? site.domain
const [shifts, areas] = await Promise.all([openShifts(client), volunteerAreas(client)])
const ListLayout = volunteerLayoutFor(template, 'list')
const sidebar = areaEntriesOf(areas, 'sidebar').length > 0
---
<Site template={template} title={`Volunteer · ${siteName}`} description={`Open volunteer shifts with ${siteName}.`} canonicalPath={VOLUNTEER_PATH} page={null} areas={areas}>
  <div class:list={['layout', sidebar && 'layout-split']}>
    <div class="layout-main">
      <ListLayout shifts={shifts ?? []} siteName={siteName} />
    </div>
    {sidebar && <div class="layout-rail"><Area name="sidebar" areas={areas} components={template.sections} class="rail" /></div>}
  </div>
</Site>
