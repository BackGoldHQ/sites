---
// The top of an entry's page, shared by every entry layout (board C11): the
// breadcrumb (its list as a link, then its category, the entry itself named
// for screen readers as the current page), the entry's terms as chips over
// the title, each a link to the term's list (categories first, on the wash,
// then tags), or the layout's own words in their place, the title as the
// page's one <h1>, the summary, and the byline: the lead writer's picture or
// initials, the writers' names (the role said only for editors, photographers
// and the rest), the date and the reading time when the layout passes one.
import type { ContentTypeSummary, EntryDetail } from '@backgold/content'
import { safeSrc } from '@backgold/astro/server'
import { formatDay } from '../../lib/format'
import { bylineGroups, initials, listOf, termPath } from '../../lib/entries'

interface Props {
  entry: EntryDetail
  type: ContentTypeSummary | undefined
  /** Words over the title instead of the entry's terms ("Episode", an issue's line). */
  kicker?: string | null
  minutes?: number | null
  /** The list's name in the breadcrumb in place of the one its address gives: a template's own words for it. */
  listLabel?: string | null
}

const { entry, type, kicker = null, minutes = null, listLabel = null } = Astro.props
const listed = listOf(type)
const list = listed && listLabel ? { ...listed, name: listLabel } : listed
const base = list?.path ?? null
const day = formatDay(entry.publish_at)
const groups = bylineGroups(entry.authors)
const lead = entry.authors[0]
const avatar = lead ? safeSrc(lead.avatar_url) : null
const crumbTerm = entry.terms.find((t) => t.taxonomy === 'category') ?? null
const chips = [...entry.terms].sort((a, b) => Number(b.taxonomy === 'category') - Number(a.taxonomy === 'category'))
---
<header class="entry-header">
  {list && (
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={list.path}>{list.name}</a>
      {crumbTerm && <><span class="crumbs-sep" aria-hidden="true">›</span><span>{crumbTerm.label}</span></>}
      <span class="visually-hidden" aria-current="page">{entry.title}</span>
    </nav>
  )}
  {kicker ? (
    <p class="kicker">{kicker}</p>
  ) : (
    base && chips.length > 0 && (
      <ul class="entry-terms" role="list">
        {chips.map((term) => <li><a class:list={['chip', term.taxonomy === 'category' && 'chip-wash']} href={termPath(base, term.taxonomy, term.slug)}>{term.label}</a></li>)}
      </ul>
    )
  )}
  <h1>{entry.title}</h1>
  {entry.summary && <p class="lede">{entry.summary}</p>}
  {(groups.length > 0 || day) && (
    <div class="byline">
      {lead && (avatar ? <img class="byline-avatar" src={avatar} alt="" width="30" height="30" /> : <span class="byline-avatar" aria-hidden="true">{initials(lead.display_name)}</span>)}
      <p>
        {groups.map(({ role, people }, i) => (
          <>
            {i > 0 && ' · '}
            {role !== 'Written by' && <>{role}{' '}</>}
            {people.map((person, j) => (
              <>
                {j > 0 && (j === people.length - 1 ? ' and ' : ', ')}
                <a href={person.href}>{person.display_name}</a>
              </>
            ))}
          </>
        ))}
        {groups.length > 0 && day && ' · '}
        {day && entry.publish_at && <time datetime={entry.publish_at}>{day}</time>}
        {minutes !== null && <> · {minutes} min read</>}
      </p>
    </div>
  )}
</header>
