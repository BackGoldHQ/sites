---
// The video list layout, `grid`: the videos as a grid of pictures, each with
// a play mark, its title and its date; the whole card opens the video's page
// (cards.astro).
import ListFrame from '../ListFrame.astro'
import type { ListLayoutProps } from '../props'
import VideoCards from './cards.astro'

type Props = ListLayoutProps

const props = Astro.props
---
<ListFrame {...props} noun="videos" class="list-videos">
  <VideoCards entries={props.entries} level={2} />
</ListFrame>
