---
// Around every list layout: the list's name as the page's one <h1> (on a
// term's list, the term, under the list's name; on the whole news list, the
// list's intro when it has one: the page at the list's address, its sections
// drawn as a page draws them, so its leading Hero's headline is the <h1>),
// the filter (All, then each term a listed entry carries, the current one
// marked), on the news list the search box (board A4, "Search news": a form
// that sends `?q=` to the news list), the rows the layout draws in the slot
// (a sentence instead when there is nothing to show), and the pager under
// them: "Older" on to the next page when there is one, and "Newest" back to
// the first from any later page. The filter's term lists page the same way at
// their own addresses. A search's results say how many matched ("2 results
// for ‘levy’"), or that nothing did, and have no pager; All stays unmarked,
// since they are not the whole list.
import PageSections from '../PageSections.astro'
import type { ListLayoutProps } from './props'
import { basePath, listName, termPath } from '../../lib/entries'
import '../../styles/entries.css'

interface Props extends ListLayoutProps {
  /** The plural the empty sentence and the pager's label use: "posts", "episodes", "videos", "issues". */
  noun: string
  class?: string
}

const { template, type, base: address, entries, pager, filter, term, search, intro = null, noun, class: className } = Astro.props
const base = basePath(address)
const name = listName(type, address, intro)
const current = term ? `${term.taxonomy.key}/${term.term.slug}` : null
const q = search?.q ?? null
const results = (n: number) => (n === 1 ? '1 result' : `${n} results`)
---
<div class:list={['listing', className]}>
  {intro && !term ? (
    <div class="list-intro"><PageSections template={template} page={intro} siteName={name} /></div>
  ) : (
    <header class="page-header list-header">
      {term && <p class="kicker"><a href={base}>{name}</a> · {term.taxonomy.label}</p>}
      <h1>{term ? term.term.label : name}</h1>
    </header>
  )}
  {filter && filter.terms.length > 0 && (
    <nav class="list-filter" aria-label={`Narrow the ${name.toLowerCase()}`}>
      <ul>
        <li><a href={base} aria-current={current === null && q === null ? 'page' : undefined}>All</a></li>
        {filter.terms.map((t) => {
          const key = `${filter.taxonomy}/${t.slug}`
          return <li><a href={termPath(base, filter.taxonomy, t.slug)} aria-current={current === key ? 'page' : undefined}>{t.label}</a></li>
        })}
      </ul>
    </nav>
  )}
  {search && (
    <form class="list-search" role="search" method="get" action={search.action}>
      <label class="visually-hidden" for="list-search-q">Search news</label>
      <input id="list-search-q" type="search" name="q" value={q ?? undefined} placeholder="Search news" minlength="2" maxlength="80" required />
      <button class="list-search-go" type="submit">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
        <span class="visually-hidden">Search news</span>
      </button>
    </form>
  )}
  {q !== null && entries.length > 0 && <p class="list-results" role="status">{results(entries.length)} for ‘{q}’</p>}
  {entries.length > 0 ? (
    <slot />
  ) : (
    <p class="empty" role={q !== null ? 'status' : undefined}>
      {q !== null ? `Nothing matches ‘${q}’.` : term ? `Nothing is published under ${term.term.label} yet.` : `No ${noun} are published yet.`}
    </p>
  )}
  {(pager.newest || pager.older) && (
    <nav class="pager" aria-label={`Pages of ${noun}`}>
      {pager.newest && <a href={pager.newest}>Newest</a>}
      {pager.older && <a href={pager.older} rel="next">Older</a>}
    </nav>
  )}
</div>
