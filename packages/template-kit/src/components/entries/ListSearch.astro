---
// The news list's search box ("Search news"): a GET form that sends `?q=` to
// the news list, its field first and its button after it, the magnifier drawn
// at the pill's start. ListFrame places it where the template asks
// (TemplateConfig `newsSearch`).
import type { ListSearch } from './props'

interface Props {
  search: ListSearch
}

const { search } = Astro.props
---
<form class="list-search" role="search" method="get" action={search.action}>
  <label class="visually-hidden" for="list-search-q">Search news</label>
  <input id="list-search-q" type="search" name="q" value={search.q ?? undefined} placeholder="Search news" minlength="2" maxlength="80" required />
  <button class="list-search-go" type="submit">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
    <span class="visually-hidden">Search news</span>
  </button>
</form>
