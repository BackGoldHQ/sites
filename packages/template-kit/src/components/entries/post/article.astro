---
// The post entry layout, `article` (board A5), and the layout of every entry
// of a type the organization adds: the header (breadcrumb, terms, title,
// summary, byline with the reading time), the cover, the body in one reading
// column, the type's own fields, Share, and who wrote it. The entry's fields
// come in a fixed order; the operator writes the post, never arranges it.
import { relFor, renderMarkdown, safeSrc } from '@backgold/astro/server'
import AuthorBox from '../AuthorBox.astro'
import EntryFields from '../EntryFields.astro'
import EntryHeader from '../EntryHeader.astro'
import Share from '../Share.astro'
import type { EntryLayoutProps } from '../props'
import { readingMinutes } from '../../../lib/entries'
import '../../../styles/entries.css'

type Props = EntryLayoutProps

const { entry, type } = Astro.props
const hero = entry.hero ? safeSrc(entry.hero.url) : null
const media = safeSrc(entry.media_url)
const body = entry.body?.markdown ? renderMarkdown(entry.body.markdown) : ''
---
<article class="entry entry-article">
  <EntryHeader entry={entry} type={type} minutes={readingMinutes(entry.body?.markdown)} />
  {hero && <img class="entry-cover" src={hero} alt="" decoding="async" fetchpriority="high" />}
  {media && <p class="entry-media-link"><a href={media} rel={relFor(media)}>Open the media file</a></p>}
  {body && <div class="prose entry-body" set:html={body} />}
  <EntryFields entry={entry} type={type} />
  {entry.url && <Share title={entry.title} path={entry.url} />}
  <AuthorBox authors={entry.authors} />
</article>
