---
// The footer menu's columns (src/lib/footer.ts footerColumnsOf): a column per
// group under its label, the loose links in one unlabelled column first.
// Draws nothing when the menu shows no link on this page.
import type { FooterColumn } from '../../lib/footer'

interface Props {
  columns: FooterColumn[]
}

const { columns } = Astro.props
---
{columns.length > 0 && (
  <nav class="footer-columns" aria-label="Footer menu">
    {columns.map((column) => (
      <div class="footer-column">
        {column.label && <h2 class="footer-heading">{column.label}</h2>}
        <ul>
          {column.links.map((node) => (
            <li>
              {node.href ? (
                <a href={node.href} rel={node.rel} aria-current={node.current ? 'page' : undefined}>{node.label}</a>
              ) : (
                <span>{node.label}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
)}
