---
// An event's map on its page (board C6), the main column's full width: the
// kit's own, drawn in the browser by MapLibre GL over OpenFreeMap's tiles
// (src/lib/event-map-draw.ts: the venue's pin in the brand's accent, page
// scrolling never caught, the OpenStreetMap credit folding to ⓘ). MapLibre
// loads only when the map comes near the screen, so the page above it costs
// nothing. Until it draws (with scripts off, without WebGL, before it loads)
// the frame shows the place and a link to it on OpenStreetMap.
interface Props {
  lat: number
  lng: number
  /** The place as the page names it: the venue, else the location. */
  place: string | null
  /** The venue's street address, or null. */
  address: string | null
  /** What the event is, for the map's name when it has no place. */
  title: string
}

const { lat, lng, place, address, title } = Astro.props
const label = `Map: ${place ?? title}`
const at = `${lat.toFixed(5)}/${lng.toFixed(5)}`
const osm = `https://www.openstreetmap.org/?mlat=${lat.toFixed(5)}&mlon=${lng.toFixed(5)}#map=17/${at}`
---
<div class="event-map" role="region" aria-label={label} data-event-map data-lat={lat} data-lng={lng} data-label={label}>
  <div class="event-map-canvas" data-event-map-canvas></div>
  <div class="event-map-fallback" data-event-map-fallback>
    <svg viewBox="0 0 32 42" aria-hidden="true"><path d="M16 41s14-13.2 14-24.5A14 14 0 0 0 2 16.5C2 27.8 16 41 16 41z" /><circle cx="16" cy="16.5" r="5.5" /></svg>
    {(place || address) && <p>{[place, address].filter(Boolean).join(', ')}</p>}
    <a class="text-link" href={osm} rel="noopener">Open in OpenStreetMap</a>
  </div>
</div>

<script>
  // Load the map's code when it is within a screen of view; once per map.
  const maps = document.querySelectorAll<HTMLElement>('[data-event-map]')
  const draw = (figure: HTMLElement) =>
    import('../lib/event-map-draw')
      .then((m) => m.drawEventMap(figure))
      .catch(() => {})
  if (maps.length > 0 && 'IntersectionObserver' in window) {
    const near = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          near.unobserve(entry.target)
          draw(entry.target as HTMLElement)
        }
      },
      { rootMargin: '100% 0px' },
    )
    maps.forEach((figure) => near.observe(figure))
  } else {
    maps.forEach(draw)
  }
</script>

<style>
  .event-map {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    margin-top: 1.625rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    /* C6's ground under the map: the band's tint, ruled in a faint grid. */
    background:
      repeating-linear-gradient(0deg, transparent 0 38px, var(--line) 38px 39px),
      repeating-linear-gradient(90deg, transparent 0 38px, var(--line) 38px 39px),
      var(--band-tint);
  }
  .event-map-canvas {
    position: absolute;
    inset: 0;
  }
  .event-map-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.375rem;
    padding: 1rem;
    text-align: center;
  }
  .event-map-fallback[hidden] {
    display: none;
  }
  .event-map-fallback svg,
  .event-map :global(.event-map-pin svg) {
    display: block;
    width: 2rem;
    height: 2.625rem;
    fill: var(--bg-brand-accent, var(--accent));
    stroke: color-mix(in srgb, var(--bg-brand-accent, var(--accent)) 55%, #000);
    stroke-width: 1.25;
  }
  .event-map :global(.event-map-pin circle) {
    fill: #fff;
    stroke: none;
  }
  .event-map-fallback circle {
    fill: #fff;
    stroke: none;
  }
  .event-map-fallback p {
    margin: 0;
    font-weight: 700;
  }
  .event-map-fallback a {
    font-size: var(--text-sm);
  }
  @media (min-width: 40rem) {
    .event-map {
      aspect-ratio: 2 / 1;
    }
  }
</style>
