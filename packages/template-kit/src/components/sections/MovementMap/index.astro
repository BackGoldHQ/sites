---
// MovementMap: a kicker, a heading, and the live map BackGold frames when the
// section names a data source — the map a visitor zooms and explores, with its
// own legend, count badge, stat tiles and source line. A section with no data
// source sends no frame: then the figures the organization wrote and where
// the data comes from draw alone, as before. A figure BackGold fills in live
// is left out of that list (see literalStat).
import type { Section } from '@backgold/content'
import Band from '../Band.astro'
import ModuleFrame from '../modules/ModuleFrame.astro'
import { links, rows } from '../../../lib/section'
import { literalStat, text } from '../../../lib/format'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
const framed = !!section.embed
const stats = framed
  ? []
  : rows(section)
      .map((row) => ({ value: literalStat(row.value), label: text(row.label), note: text(row.note) }))
      .filter((stat) => stat.value !== null)
const [source] = links(section)
---
{(framed || heading || stats.length > 0) && (
  <Band section={section} class="stats">
    {kicker && <p class="kicker">{kicker}</p>}
    {heading && <h2>{heading}</h2>}
    {framed && (
      <ModuleFrame embed={section.embed} band={section.band} type={section.type} layout="full" title={heading || 'Map'} height="44rem" />
    )}
    {stats.length > 0 && (
      <ul class="grid grid-3 stat-list" role="list">
        {stats.map((stat) => (
          <li class="stat">
            <p class="stat-value">{stat.value}</p>
            {stat.label && <p class="stat-label">{stat.label}</p>}
            {stat.note && <p class="stat-note">{stat.note}</p>}
          </li>
        ))}
      </ul>
    )}
    {!framed && source && <p class="fine">Source: <a href={source.href} rel={source.rel}>{source.label}</a></p>}
  </Band>
)}
