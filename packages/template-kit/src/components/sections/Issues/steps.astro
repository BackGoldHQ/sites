---
// Issues, 'steps' layout (boards A10 and C8, "What happens next"): the
// section head (the kicker and the heading), the lead, then the issues as
// numbered steps, each under a rule in the quieter button's colour (the
// primary): "Step 1" small in the display face and the accent, the step's
// title and its line. Up to four steps run across a wide screen and one to a
// row on a phone; more wrap. The section's links follow as buttons.
import type { ComponentProps } from 'astro/types'
import Band from '../Band.astro'
import Prose from '../../Prose.astro'
import SectionHead from '../SectionHead.astro'
import type Default from './index.astro'
import { links, rows } from '../../../lib/section'
import { text } from '../../../lib/format'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const steps = rows(section).filter((row) => text(row.title) || text(row.body))
const ctas = links(section)
---
<Band section={section} class="issues">
  <SectionHead kicker={text(section.copy.kicker)} heading={text(section.copy.heading)} more={[]} />
  <Prose value={section.copy.lead} class="lede" />
  {steps.length > 0 && (
    <ol class="steps" role="list">
      {steps.map((step, i) => (
        <li class="step">
          <p class="step-label">Step {i + 1}</p>
          {text(step.title) && <h3 class="step-title">{text(step.title)}</h3>}
          <Prose value={step.body} class="step-body" />
        </li>
      ))}
    </ol>
  )}
  {ctas.length > 0 && (
    <p class="actions">
      {ctas.map((link, i) => <a class:list={['button', i > 0 && 'button-quiet']} href={link.href} rel={link.rel}>{link.label}</a>)}
    </p>
  )}
</Band>

<style>
  .steps {
    display: grid;
    gap: 1.75rem 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .step {
    padding-top: 1rem;
    border-top: 3px solid var(--button-2);
  }
  .step > * {
    margin: 0;
  }
  .step-label {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .step-title {
    margin-top: 0.25rem;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .step :global(.step-body) {
    margin-top: 0.375rem;
    color: var(--muted);
    font-size: 0.96875rem;
  }
  .step :global(.step-body) > :global(:last-child) {
    margin-bottom: 0;
  }
</style>
