---
// Issues, 'numbered' layout (board A1, section 3): the section head (the
// kicker and the heading, with the section's links beside them as text
// links), the lead paragraph, then the issues as a numbered list: each a
// large two-digit numeral in the accent under a heavy rule, its title and
// its line. Three to a row on a wide screen, one to a row on a phone.
import type { ComponentProps } from 'astro/types'
import Band from '../Band.astro'
import Prose from '../../Prose.astro'
import SectionHead from '../SectionHead.astro'
import type Default from './index.astro'
import { links, rows } from '../../../lib/section'
import { text } from '../../../lib/format'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const issues = rows(section).filter((row) => text(row.title) || text(row.body))
const numeral = (i: number) => String(i + 1).padStart(2, '0')
---
<Band section={section} class="issues">
  <SectionHead kicker={text(section.copy.kicker)} heading={text(section.copy.heading)} more={links(section)} />
  <Prose value={section.copy.lead} class="lede" />
  {issues.length > 0 && (
    <ol class="numbered" role="list">
      {issues.map((issue, i) => (
        <li class="numbered-item">
          <p class="numbered-numeral" aria-hidden="true">{numeral(i)}</p>
          {text(issue.title) && <h3>{text(issue.title)}</h3>}
          <Prose value={issue.body} class="numbered-body" />
        </li>
      ))}
    </ol>
  )}
</Band>

<style>
  .numbered {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .numbered-item {
    border-top: 3px solid var(--ink);
    padding-top: 1.125rem;
  }
  .numbered-numeral {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.375rem, 2rem + 1.2vw, 3rem);
    font-weight: 800;
    line-height: 1;
    color: var(--accent);
  }
  .numbered-item h3 {
    margin: 0.75rem 0 0.5rem;
  }
  .numbered-item :global(.numbered-body) {
    color: var(--muted);
    font-size: 0.96875rem;
  }
  .numbered-item :global(.numbered-body) > :global(:last-child) {
    margin-bottom: 0;
  }
  @media (min-width: 40rem) {
    .numbered {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem 2.25rem;
    }
  }
  @media (min-width: 60rem) {
    .numbered {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
