---
// Issues (Cards, the default): the section head (the kicker and the heading,
// with the section's links beside them as text links: C1's "Read the whole
// plan", as Numbered draws its head for A1), a lead paragraph, then one card
// per issue. `variant` is the card style chosen in BackGold, kept as
// `data-variant` on the section for your CSS.
import type { Section } from '@backgold/content'
import Band from '../Band.astro'
import Prose from '../../Prose.astro'
import SectionHead from '../SectionHead.astro'
import { links, rows } from '../../../lib/section'
import { text } from '../../../lib/format'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const issues = rows(section).filter((row) => text(row.title) || text(row.body))
---
<Band section={section} class="issues">
  <SectionHead kicker={text(section.copy.kicker)} heading={text(section.copy.heading)} more={links(section)} />
  <Prose value={section.copy.lead} class="lede" />
  {issues.length > 0 && (
    <ul class="grid grid-3" role="list">
      {issues.map((issue) => (
        <li class="tile">
          {text(issue.title) && <h3>{text(issue.title)}</h3>}
          <Prose value={issue.body} />
        </li>
      ))}
    </ul>
  )}
</Band>
