---
// Portfolio · Grid, the default (mock 13, A, with C as its open state): the
// kicker and heading, the body, then the work as picture cards, three
// across on a wide screen, two on a tablet and one on a phone. Each card
// opens with its picture at 16:10 (or, with none, the title large on a
// panel of the band's surface) with the kind laid over its corner as a
// small tag, then the title and "Client: … · 2024" in the muted ink.
//
// When the work names more than one kind, a chip per kind ("All" first,
// then each kind in row order) narrows the cards to that kind, with
// "Showing N of M." for a screen reader. Clicking a card opens the
// section's one lightbox, a native <dialog> filled with that piece: its
// pictures as a gallery (Prev, Next and a dot per picture, the arrow keys
// too), the kind and year in small capitals, the title, the summary, the
// "Role:" and "Result:" lines and, when the piece has a page, a button to
// it. Escape, the close button and a click outside close it, and focus
// returns to the card. The chips and the lightbox are the section's
// script: without it the chips stay hidden and each card is a plain link
// to the piece's page, or to its picture when it has none. Nothing is
// drawn with no work and no heading.
import type { Section } from '@backgold/content'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import Prose from '../../Prose.astro'
import { text } from '../../../lib/format'
import { creditOf, idFor, kindAndYear, kindsOf, targetOf, workOf } from './work'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
const clientLabel = text(section.copy.clientLabel)?.trim() ?? null
const work = workOf(section)
const kinds = kindsOf(work)
const filter = kinds.length > 1
const gridId = idFor(section, 'work')
const boxId = idFor(section, 'lightbox')
---
{(heading || work.length > 0) && (
  <Band section={section} class="portfolio portfolio-grid">
    <SectionHead kicker={kicker} heading={heading} more={[]} />
    <Prose value={section.copy.body} class="lede" />
    {work.length > 0 && (
      <div class="work" data-portfolio>
        {filter && (
          <div class="work-kinds" role="group" aria-label="Filter by kind" data-work-kinds hidden>
            <button type="button" aria-pressed="true" aria-controls={gridId} data-work-kind="">All</button>
            {kinds.map((kind) => (
              <button type="button" aria-pressed="false" aria-controls={gridId} data-work-kind={kind}>{kind}</button>
            ))}
          </div>
        )}
        <ul class="work-grid" id={gridId} role="list">
          {work.map((piece) => {
            const target = targetOf(piece)
            const credit = creditOf(piece, clientLabel)
            return (
              <li class="work-card" data-work-card data-kind={piece.kind ?? ''}>
                <div class:list={['work-frame', !piece.pictures[0] && 'work-frame-words']}>
                  {piece.pictures[0] ? (
                    <img class="work-photo" src={piece.pictures[0]} alt="" loading="lazy" decoding="async" />
                  ) : (
                    <p class="work-frame-title" aria-hidden="true">{piece.title}</p>
                  )}
                  {piece.kind && <p class="work-tag">{piece.kind}</p>}
                </div>
                <h3 class="work-title">
                  {target ? <a href={target.href} rel={target.rel} data-work-open>{piece.title}</a> : <span data-work-open>{piece.title}</span>}
                </h3>
                {credit && <p class="work-credit">{credit}</p>}
              </li>
            )
          })}
        </ul>
        {filter && <p class="visually-hidden" role="status" data-work-showing></p>}
        <dialog class="work-box bg-band-contrast" id={boxId} data-work-box>
          <div class="work-box-inner">
            <button type="button" class="work-box-close" data-work-close>
              <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
              <span class="visually-hidden">Close</span>
            </button>
            {work.map((piece, i) => {
              const titleId = `${boxId}-title-${i}`
              const line = kindAndYear(piece)
              const count = piece.pictures.length
              return (
                <div class:list={['work-panel', count > 0 && 'work-panel-pictured']} data-work-panel data-title-id={titleId} hidden>
                  {count > 0 && (
                    <div class="work-gallery" data-work-gallery>
                      <div class="work-gallery-frame">
                        {piece.pictures.map((src, p) => (
                          <img
                            class="work-gallery-photo"
                            src={src}
                            alt={count > 1 ? `${piece.title}, picture ${p + 1} of ${count}` : piece.title}
                            loading="lazy"
                            decoding="async"
                            data-work-picture
                            hidden={p > 0}
                          />
                        ))}
                      </div>
                      {count > 1 && (
                        <div class="work-gallery-nav">
                          <button type="button" class="work-step" data-work-step="-1" aria-label="Previous picture">
                            <span aria-hidden="true">&larr;</span> Prev
                          </button>
                          <div class="work-dots" role="group" aria-label="Pictures">
                            {piece.pictures.map((_, p) => (
                              <button type="button" class="work-dot" data-work-dot={p} aria-label={`Picture ${p + 1} of ${count}`} aria-current={p === 0 ? 'true' : undefined}></button>
                            ))}
                          </div>
                          <button type="button" class="work-step" data-work-step="1" aria-label="Next picture">
                            Next <span aria-hidden="true">&rarr;</span>
                          </button>
                        </div>
                      )}
                    </div>
                  )}
                  <div class="work-panel-words">
                    {line && <p class="work-panel-kind">{line}</p>}
                    <h2 class="work-panel-title" id={titleId}>{piece.title}</h2>
                    {piece.summary && <p class="work-panel-summary">{piece.summary}</p>}
                    {piece.role && <p class="work-panel-fact"><strong>Role:</strong> {piece.role}</p>}
                    {piece.result && <p class="work-panel-fact"><strong>Result:</strong> {piece.result}</p>}
                    {piece.link && (
                      <p class="actions work-panel-actions">
                        <a class="button" href={piece.link.href} rel={piece.link.rel}>See the project</a>
                      </p>
                    )}
                  </div>
                </div>
              )
            })}
          </div>
        </dialog>
        <script is:inline>
          ;(function (root) {
            if (!root || typeof HTMLDialogElement !== 'function') return
            var box = root.querySelector('[data-work-box]')
            var panels = box.querySelectorAll('[data-work-panel]')
            var cards = root.querySelectorAll('[data-work-card]')
            var current = null
            var opener = null

            // The kind chips: narrow the cards, say how many show.
            var group = root.querySelector('[data-work-kinds]')
            if (group) {
              var chips = group.querySelectorAll('[data-work-kind]')
              var showing = root.querySelector('[data-work-showing]')
              var choose = function (chip) {
                var kind = chip.getAttribute('data-work-kind')
                var shown = 0
                for (var c = 0; c < chips.length; c++) chips[c].setAttribute('aria-pressed', chips[c] === chip ? 'true' : 'false')
                for (var i = 0; i < cards.length; i++) {
                  var match = !kind || cards[i].getAttribute('data-kind') === kind
                  cards[i].hidden = !match
                  if (match) shown++
                }
                showing.textContent = kind ? 'Showing ' + shown + ' of ' + cards.length + ': ' + kind + '.' : 'Showing all ' + cards.length + '.'
              }
              for (var c = 0; c < chips.length; c++) {
                chips[c].addEventListener('click', function (event) {
                  choose(event.currentTarget)
                })
              }
              group.hidden = false
            }

            // The gallery: one picture at a time, its dot marked.
            var pick = function (panel, at) {
              var pictures = panel.querySelectorAll('[data-work-picture]')
              if (pictures.length === 0) return
              var n = pictures.length
              var index = ((at % n) + n) % n
              var dots = panel.querySelectorAll('[data-work-dot]')
              for (var p = 0; p < n; p++) pictures[p].hidden = p !== index
              for (var d = 0; d < dots.length; d++) {
                if (d === index) dots[d].setAttribute('aria-current', 'true')
                else dots[d].removeAttribute('aria-current')
              }
              panel.setAttribute('data-at', String(index))
            }
            var step = function (by) {
              if (current) pick(current, Number(current.getAttribute('data-at') || 0) + by)
            }

            var open = function (index, from) {
              opener = from
              for (var i = 0; i < panels.length; i++) panels[i].hidden = i !== index
              current = panels[index]
              box.setAttribute('aria-labelledby', current.getAttribute('data-title-id'))
              pick(current, 0)
              box.showModal()
            }

            // Each card's title opens the lightbox; a card with nowhere to go gets a button for it.
            for (var i = 0; i < cards.length; i++) {
              ;(function (index) {
                var el = cards[index].querySelector('[data-work-open]')
                if (el.tagName === 'SPAN') {
                  var button = document.createElement('button')
                  button.type = 'button'
                  button.className = 'work-open'
                  button.textContent = el.textContent
                  el.replaceWith(button)
                  el = button
                } else {
                  el.setAttribute('role', 'button')
                  el.addEventListener('keydown', function (event) {
                    if (event.key === ' ') {
                      event.preventDefault()
                      open(index, el)
                    }
                  })
                }
                el.setAttribute('aria-haspopup', 'dialog')
                el.setAttribute('aria-controls', box.id)
                el.addEventListener('click', function (event) {
                  if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
                  event.preventDefault()
                  open(index, el)
                })
              })(i)
            }

            box.addEventListener('click', function (event) {
              var t = event.target
              if (t === box || t.closest('[data-work-close]')) box.close()
              var by = t.closest('[data-work-step]')
              if (by) step(Number(by.getAttribute('data-work-step')))
              var dot = t.closest('[data-work-dot]')
              if (dot && current) pick(current, Number(dot.getAttribute('data-work-dot')))
            })
            box.addEventListener('keydown', function (event) {
              if (event.key === 'ArrowLeft') step(-1)
              if (event.key === 'ArrowRight') step(1)
            })
            box.addEventListener('close', function () {
              if (opener) opener.focus()
            })
          })(document.currentScript.closest('[data-portfolio]'))
        </script>
      </div>
    )}
  </Band>
)}

<style>
  .work-kinds {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.25rem;
  }
  .work-kinds[hidden],
  .work-card[hidden] {
    display: none;
  }
  .work-kinds button {
    min-height: 2.75rem;
    padding: 0.375rem 1rem;
    border: 1.5px solid color-mix(in srgb, var(--ink) 25%, transparent);
    border-radius: var(--pill);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }
  .work-kinds button:hover {
    border-color: var(--ink);
  }
  .work-kinds button[aria-pressed='true'] {
    border-color: var(--button);
    background: var(--button);
    color: var(--button-ink);
  }

  .work-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .work-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-radius: var(--radius-card);
  }
  .work-card > p,
  .work-card > h3 {
    margin: 0;
  }
  .work-frame {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }
  .work-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* No picture: the title large on the band's surface. */
  .work-frame-words {
    display: grid;
    place-items: center;
    padding: 1.5rem 1.5rem 3rem;
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: inset 0 -3px 0 var(--accent);
  }
  .work-frame-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-align: center;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .work-tag {
    position: absolute;
    left: 0.875rem;
    bottom: 0.875rem;
    max-width: calc(100% - 1.75rem);
    margin: 0;
    padding: 0.25rem 0.625rem;
    border-radius: var(--pill);
    background: var(--surface);
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }
  .work-frame-words .work-tag {
    background: color-mix(in srgb, var(--ink) 9%, transparent);
  }
  .work-card .work-title {
    margin-top: 0.875rem;
    font-size: calc(var(--h3) * 0.9);
    font-weight: 700;
    line-height: 1.2;
  }
  .work-title a,
  .work-title :global(.work-open) {
    color: var(--ink);
    text-decoration: none;
  }
  /* With script a card with nowhere to go opens the lightbox from a button that reads as its title. */
  .work-title :global(.work-open) {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  /* The title's link (or button) covers the card. */
  .work-title a::after,
  .work-title :global(.work-open)::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
  }
  .work-card:hover .work-title a,
  .work-card:hover .work-title :global(.work-open) {
    text-decoration: underline;
  }
  .work-card:focus-within {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
  }
  .work-title a:focus-visible,
  .work-title :global(.work-open:focus-visible) {
    outline: none;
  }
  .work-card .work-credit {
    margin-top: 0.3125rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  /* The lightbox (mock C): the contrast band's ground, the pictures at the left, the words at the right. */
  .work-box {
    width: min(100% - 2rem, 66rem);
    max-width: none;
    max-height: calc(100% - 2rem);
    padding: 0;
    border: 0;
    border-radius: var(--radius-card);
    background: var(--bg-band-background);
    color: var(--bg-band-color);
    box-shadow: var(--shadow);
  }
  .work-box::backdrop {
    background: color-mix(in srgb, var(--band-photo, CanvasText) 72%, transparent);
  }
  .work-box-inner {
    position: relative;
    padding: 3.25rem 1.25rem 1.5rem;
  }
  .work-box-close {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .work-box-close:hover {
    background: color-mix(in srgb, var(--ink) 12%, transparent);
  }
  .work-panel[hidden] {
    display: none;
  }
  .work-panel {
    display: grid;
    gap: 1.5rem;
  }
  .work-gallery-frame {
    display: grid;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }
  .work-gallery-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .work-gallery-photo[hidden] {
    display: none;
  }
  /* Prev at the left, Next at the right, the dots between them (wrapping there, past a dozen pictures). */
  .work-gallery-nav {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.5rem;
  }
  .work-step {
    min-height: 2.75rem;
    padding: 0 0.5rem;
    border: 0;
    border-radius: var(--pill);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
  }
  .work-step:hover {
    text-decoration: underline;
  }
  .work-dots {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    min-width: 0;
  }
  /* A dot: a 24px-wide, 44px-tall target around a 10px ring, filled for the picture showing. */
  .work-dot {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .work-dot::before {
    content: '';
    width: 0.625rem;
    height: 0.625rem;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
  }
  .work-dot[aria-current='true']::before {
    background: var(--ink);
  }
  .work-panel-words > * {
    margin: 0;
  }
  .work-panel-kind {
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .work-panel-words .work-panel-title {
    margin-top: 0.5rem;
    padding-right: 2rem;
    font-size: clamp(1.625rem, 1.25rem + 1.2vw, 2.25rem);
    font-weight: 800;
    line-height: 1.08;
  }
  .work-panel-words .work-panel-summary {
    margin-top: 0.875rem;
    color: var(--muted);
  }
  .work-panel-words .work-panel-fact {
    margin-top: 0.625rem;
    font-size: 0.9375rem;
  }
  .work-panel-words .work-panel-actions {
    margin-top: 1.5rem;
  }

  @media (min-width: 40rem) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 56rem) {
    .work-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem 1.5rem;
    }
    .work-box-inner {
      padding: 1.75rem;
    }
    .work-panel-pictured {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: 1.75rem;
      align-items: start;
    }
    .work-panel-pictured .work-panel-words {
      padding-top: 0.5rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .work-photo {
      transition: transform 0.3s ease;
    }
    .work-card:hover .work-photo {
      transform: scale(1.03);
    }
  }
</style>
