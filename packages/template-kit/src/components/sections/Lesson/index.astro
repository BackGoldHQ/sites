---
// Lesson · Player (board D3): the lesson at this address (lesson.ts) as
// LessonBody draws it, the course's rail at the right on a wide screen and
// after the lesson on a phone. Nothing is drawn without a lesson. The
// default layout; it draws `player` and any layout the kit has no file for.
import type { Section } from '@backgold/content'
import Band from '../Band.astro'
import LessonBody from './LessonBody.astro'
import { lessonOf, type LessonView } from './lesson'

interface Props {
  section: Section
  variant?: string
  /** Drawn as the lesson's own page: its title is the <h1>. */
  lead?: boolean
  /** The lesson, already read (the lesson route); left out, the section reads it. */
  view?: LessonView | null
}

const { section, lead = false } = Astro.props
const view = Astro.props.view !== undefined ? Astro.props.view : await lessonOf(section, Astro)
---
{view && (
  <Band section={section} class="lesson lesson-player">
    <LessonBody view={view} section={section} layout="player" lead={lead} />
  </Band>
)}
