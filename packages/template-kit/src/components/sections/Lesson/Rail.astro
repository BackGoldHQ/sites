---
// The course's lessons beside a lesson (board D3's rail): the kicker
// "Course" over the course's title, then for a visitor the course's bar with
// "4 of 12" and "38 min left", signed out "12 lessons · 1 h 1 min" and
// "Lesson 1 is free". Each row is the lesson's mark (number, check or lock),
// its title (a link, but for this lesson's) and its word (Done, Now,
// Members, Free, Sign in) or its length. On a phone (and up to 56rem) only
// the lessons either side of this one show, with "All 12 lessons" to the
// course under them, as on every width.
import Bar from '../Course/Bar.astro'
import Icon from '../Course/Icon.astro'
import type { LessonView } from './lesson'
import { clockOf, leftOf, lessonsOf } from '../../../lib/academy'
import { idFor } from '../SampleBallot/ballot'
import type { Section } from '@backgold/content'

interface Props {
  view: LessonView
  section: Section
  level: 2 | 3
}

const { view, section, level } = Astro.props
const Title = level === 2 ? 'h2' : 'h3'
const id = idFor(section, 'lesson-rail')
const { rail } = view
const left = rail.progress ? leftOf(rail.progress) : null
---
<aside class="ls-rail" aria-labelledby={id}>
  <p class="kicker">Course</p>
  <Title id={id} class="ls-rail-title">{view.courseHref ? <a href={view.courseHref}>{view.courseTitle}</a> : view.courseTitle}</Title>
  {rail.progress ? (
    <div class="ls-rail-progress">
      <Bar completed={rail.progress.completed} total={rail.progress.total} label={`${view.courseTitle}: ${rail.progress.completed} of ${rail.progress.total} lessons`} />
      <p class="ls-rail-figures">
        <strong>{rail.progress.completed} of {rail.progress.total}</strong>
        {left && <span>{left}</span>}
      </p>
    </div>
  ) : (
    <p class="ls-rail-figures ls-rail-out">
      <span>{rail.count}</span>
      {rail.free && <span>{rail.free}</span>}
    </p>
  )}
  <ol class="ls-rail-rows" role="list">
    {rail.rows.map((row) => (
      <li class:list={['ls-rail-row', row.now && 'ls-rail-now', row.done && 'ls-rail-done', row.locked && 'ls-rail-locked', Math.abs(row.n - view.n) > 2 && 'ls-rail-far']}>
        <span class="ls-rail-mark" aria-hidden="true">{row.done ? <Icon name="check" /> : row.locked ? <Icon name="lock" /> : row.n}</span>
        <span class="ls-rail-name">
          {row.now || !row.href ? <span aria-current={row.now ? 'page' : undefined}>{row.name}</span> : <a href={row.href}>{row.name}</a>}
        </span>
        <span class="ls-rail-word">{row.word ?? clockOf(row.seconds)}</span>
      </li>
    ))}
  </ol>
  {view.courseHref && <a class="text-link ls-rail-all" href={view.courseHref}>All {lessonsOf(view.total)}</a>}
</aside>

<style>
  .ls-rail {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    min-width: 0;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
  }
  .ls-rail > * {
    margin: 0;
  }
  .ls-rail .kicker {
    margin-bottom: -0.25rem;
  }
  .ls-rail .ls-rail-title {
    font-family: var(--font);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.3;
  }
  .ls-rail-title a {
    color: var(--ink);
  }
  .ls-rail-progress {
    display: grid;
    gap: 0.5rem;
  }
  .ls-rail-progress > * {
    margin: 0;
  }
  .ls-rail-figures {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    color: var(--muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }
  .ls-rail-figures strong {
    color: var(--ink);
  }
  .ls-rail-out {
    flex-direction: column;
  }
  .ls-rail-rows {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ls-rail-row {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr) auto;
    gap: 0.625rem;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.375rem 0.5rem;
    border-radius: var(--radius);
    font-size: var(--text-sm);
    line-height: 1.35;
  }
  .ls-rail-now {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    font-weight: 700;
  }
  .ls-rail-mark {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1.5px solid var(--line-strong);
    border-radius: 50%;
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .ls-rail-done .ls-rail-mark {
    border-color: var(--button);
    background: var(--button);
    color: var(--button-ink);
  }
  .ls-rail-now .ls-rail-mark {
    border-color: var(--accent);
    color: var(--ink);
  }
  .ls-rail-name {
    min-width: 0;
  }
  .ls-rail-name a {
    color: var(--ink);
    text-decoration: none;
  }
  .ls-rail-name a:hover {
    text-decoration: underline;
  }
  .ls-rail-name a:focus-visible {
    outline: 3px solid var(--link);
    outline-offset: 2px;
  }
  .ls-rail-word {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ls-rail-now .ls-rail-word,
  .ls-rail-done .ls-rail-word {
    color: var(--ink);
  }
  @media (max-width: 55.99rem) {
    .ls-rail-far {
      display: none;
    }
  }
</style>
