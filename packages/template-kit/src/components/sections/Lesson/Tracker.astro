---
// A lesson's script (board D3), for any layout that draws a lesson: placed
// inside the lesson's root (the element with class `ls`), it reads that
// root's `data-lesson`, `data-course-slug`, `data-lesson-slug`,
// `data-progress` and `data-resume`, its <video> or YouTube frame and the two
// Mark complete forms under `.ls-complete` (the first marks it, the second
// marks it as not done; each is shown while the other is hidden). It picks
// the file up at the saved place, trades the 1080p copy for the 720p one
// (`data-src-720`) on a viewport 768px wide or narrower, sends both forms
// through fetch and swaps them in place (each form posts on its own when
// fetch fails), saves the place on pause and every 15 seconds of play, and
// marks the lesson at the video's end: the file through the <video>
// events, YouTube through its player API, loaded only when the root carries
// `data-lesson` and the lesson is on YouTube. Without `data-lesson` only the
// resume and the 720p swap run. Put it in for a visitor, or for a file
// with copies.
---
<script is:inline>
  ;(function (root) {
    if (!root) return
    var video = root.querySelector('video')
    var tube = root.querySelector('iframe[data-provider="youtube"]')
    var resume = Number(root.getAttribute('data-resume')) || 0
    // The resume listener is on before the copy below loads, so the saved place applies to it.
    if (video && resume > 0) {
      video.addEventListener('loadedmetadata', function () {
        if (!video.duration || resume < video.duration - 3) video.currentTime = resume
      })
    }
    // The 720p copy on a narrow viewport, picked once at load; a resize mid-play keeps what is playing.
    var narrow = video && video.getAttribute('data-src-720')
    if (narrow && window.matchMedia && window.matchMedia('(max-width: 768px)').matches && video.currentSrc !== narrow && video.getAttribute('src') !== narrow) {
      video.src = narrow
      video.load()
    }
    if (!root.hasAttribute('data-lesson') || !window.fetch) return
    var path = root.getAttribute('data-progress')
    var course = root.getAttribute('data-course-slug')
    var lesson = root.getAttribute('data-lesson-slug')
    var forms = root.querySelectorAll('.ls-complete form')
    var send = function (body, keep) {
      body.course = course
      body.lesson = lesson
      return fetch(path, {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(body),
        keepalive: !!keep,
      })
    }
    var show = function (done) {
      forms[0].hidden = done
      forms[1].hidden = !done
    }
    for (var f = 0; f < forms.length; f++) {
      forms[f].addEventListener('submit', function (event) {
        var form = event.currentTarget
        var done = form.getAttribute('data-complete') === 'true'
        event.preventDefault()
        send({ completed: done })
          .then(function (res) {
            if (!res.ok) throw new Error(String(res.status))
            show(done)
            forms[done ? 1 : 0].querySelector('button').focus()
          })
          .catch(function () {
            form.submit()
          })
      })
    }
    var finish = function () {
      send({ completed: true })
        .then(function (res) {
          if (res.ok) show(true)
        })
        .catch(function () {})
    }
    if (video) {
      var last = 0
      var save = function (keep) {
        var at = Math.floor(video.currentTime)
        last = Date.now()
        if (at > 0 && !video.ended) send({ position_seconds: at }, keep).catch(function () {})
      }
      video.addEventListener('play', function () {
        last = Date.now()
      })
      video.addEventListener('timeupdate', function () {
        if (!video.paused && Date.now() - last >= 15000) save(false)
      })
      video.addEventListener('pause', function () {
        if (!video.ended) save(true)
      })
      video.addEventListener('ended', finish)
      return
    }
    if (!tube) return
    // YouTube's player API (enablejsapi=1 on the frame): the place on pause and every 15 seconds of play, the lesson at the end.
    var player = null
    var timer = null
    var saveTube = function (keep) {
      if (!player || typeof player.getCurrentTime !== 'function') return
      var at = Math.floor(player.getCurrentTime())
      if (at > 0) send({ position_seconds: at }, keep).catch(function () {})
    }
    var onState = function (event) {
      var YT = window.YT
      if (!YT) return
      if (timer) {
        clearInterval(timer)
        timer = null
      }
      if (event.data === YT.PlayerState.PLAYING) timer = setInterval(function () { saveTube(false) }, 15000)
      else if (event.data === YT.PlayerState.PAUSED) saveTube(true)
      else if (event.data === YT.PlayerState.ENDED) finish()
    }
    var start = function () {
      player = new window.YT.Player(tube, { events: { onStateChange: onState } })
    }
    if (window.YT && window.YT.Player) {
      start()
    } else {
      var queue = (window.__bgYouTubeReady = window.__bgYouTubeReady || [])
      queue.push(start)
      if (queue.length === 1) {
        window.onYouTubeIframeAPIReady = function () {
          for (var q = 0; q < queue.length; q++) queue[q]()
        }
        var tag = document.createElement('script')
        tag.src = 'https://www.youtube.com/iframe_api'
        tag.async = true
        document.head.appendChild(tag)
      }
    }
  })(document.currentScript.closest('.ls'))
</script>
