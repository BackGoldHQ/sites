---
// StatCards, 'feature' layout (board 09, C "Big-number spotlight"): the
// heading, then the first figure as the spotlight, a filled card in the
// contrast band's colours (on a section that is already on the contrast
// band, a tint of its ink) with its label small in capitals, the figure huge
// in the display face and its note as the line under it; the other figures
// sit beside it as plain cards on the band's surface, two across (one when
// there is only one), each a large figure with its label and its note muted,
// and the spotlight runs as tall as they do. Everything stacks in one column
// on a phone. A card marked `accent` in BackGold shows its figure in the
// accent, else in the ink. Nothing is drawn without a figure.
import type { ComponentProps } from 'astro/types'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import type Default from './index.astro'
import { rows } from '../../../lib/section'
import { literalStat, text } from '../../../lib/format'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const heading = text(section.copy.heading)
const stats = rows(section)
  .map((row) => ({ value: literalStat(row.value), label: text(row.label), note: text(row.note), accent: row.accent === true }))
  .filter((stat) => stat.value !== null)
const [lead, ...rest] = stats
const across = Math.min(rest.length, 2)
const tall = Math.max(1, Math.ceil(rest.length / 2))
---
{lead && (
  <Band section={section} class="stats stats-feature">
    <SectionHead kicker={null} heading={heading} more={[]} />
    <ul class:list={['feature', `feature-${across}`]} style={`--feature-rows:${tall}`} role="list">
      <li class="feature-lead bg-band-contrast">
        {lead.label && <p class="feature-label">{lead.label}</p>}
        <p class:list={['feature-value', lead.accent && 'feature-accent']}>{lead.value}</p>
        {lead.note && <p class="feature-note">{lead.note}</p>}
      </li>
      {rest.map((stat) => (
        <li class="feature-card">
          <p class:list={['feature-card-value', stat.accent && 'feature-accent']}>{stat.value}</p>
          {stat.label && <p class="feature-card-label">{stat.label}</p>}
          {stat.note && <p class="feature-card-note">{stat.note}</p>}
        </li>
      ))}
    </ul>
  </Band>
)}

<style>
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .feature p {
    margin: 0;
  }
  .feature-lead,
  .feature-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-radius: var(--radius-card);
  }
  .feature-lead {
    justify-content: center;
    gap: 0.625rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    background: var(--bg-band-background);
    color: var(--bg-band-color);
  }
  :global(.bg-band-contrast) .feature-lead {
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }
  .feature-label {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .feature-value {
    font-family: var(--font-display);
    font-size: clamp(3rem, 2rem + 4.2vw, 5rem);
    font-weight: 800;
    font-variant-numeric: lining-nums;
    line-height: 0.95;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }
  .feature-note {
    font-size: var(--text-lg);
    line-height: 1.4;
  }
  .feature-card {
    gap: 0.375rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .feature-card-value {
    font-family: var(--font-display);
    font-size: clamp(2.125rem, 1.7rem + 1.6vw, 3rem);
    font-weight: 800;
    font-variant-numeric: lining-nums;
    line-height: 1;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .feature-card .feature-card-label {
    margin-top: 0.25rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .feature-card-note {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.4;
  }
  .feature-accent {
    color: var(--accent);
  }
  @media (min-width: 48rem) {
    .feature-1 {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    }
    .feature-2 {
      grid-template-columns: minmax(0, 1.3fr) repeat(2, minmax(0, 1fr));
    }
    .feature-lead {
      grid-row: 1 / span var(--feature-rows);
    }
    .feature-0 .feature-lead {
      max-width: 36rem;
    }
  }
</style>
