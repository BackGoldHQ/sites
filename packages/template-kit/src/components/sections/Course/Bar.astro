---
// A course's bar (boards D1, D2, D3): a real <progress> at the visitor's
// lessons finished of the course's lessons, drawn at its value (it never
// fills up on load). `label` names it for a screen reader ("Foundational
// Leadership: 4 of 12 lessons"); the words beside it are the layout's.
interface Props {
  completed: number
  total: number
  label: string
}

const { completed, total, label } = Astro.props
const max = Math.max(total, 1)
---
<progress class="ac-bar" max={max} value={Math.min(completed, max)} aria-label={label}>{completed} of {total}</progress>

<style>
  .ac-bar {
    display: block;
    width: 100%;
    height: 0.5rem;
    border: 0;
    border-radius: var(--pill);
    background: color-mix(in srgb, var(--ink) 14%, transparent);
    color: var(--button);
    overflow: hidden;
    appearance: none;
  }
  .ac-bar::-webkit-progress-bar {
    border-radius: var(--pill);
    background: color-mix(in srgb, var(--ink) 14%, transparent);
  }
  .ac-bar::-webkit-progress-value {
    border-radius: var(--pill);
    background: var(--button);
  }
  .ac-bar::-moz-progress-bar {
    border-radius: var(--pill);
    background: var(--button);
  }
  @media (forced-colors: active) {
    .ac-bar {
      border: 1px solid CanvasText;
    }
  }
</style>
