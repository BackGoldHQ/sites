---
// Course · Syllabus (board D2): one course as a visitor sees it. The
// breadcrumb, the head (CourseHead: the cover, the summary, this visitor's
// bar and "Continue · Lesson 5"), then the syllabus (Syllabus: every lesson
// in order with Done, Up next, the locks and the lengths) beside "About this
// course" (Lessons, Length, Who can watch, and the lessons whose rule is not
// the course's) and, for a visitor, "Your place" with Sign out. On a phone
// the cover moves above the title and the panels follow the syllabus.
//
// The course is the one at this address, or the section's pinned course
// (course.ts); with neither, or one the api does not have, nothing is drawn.
// The default layout; it draws `syllabus` and any layout the kit has no
// file for.
import type { Section } from '@backgold/content'
import Band from '../Band.astro'
import Crumbs from './Crumbs.astro'
import CourseHead from './CourseHead.astro'
import Syllabus from './Syllabus.astro'
import { courseOf, type CourseView } from './course'
import { lengthOf, lessonsOf } from '../../../lib/academy'

interface Props {
  section: Section
  variant?: string
  /** Drawn as the course's own page: the title is the <h1>. */
  lead?: boolean
  /** The course, already read (the course entry layout); left out, the section reads it. */
  view?: CourseView | null
}

const { section, lead = false } = Astro.props
const view = Astro.props.view !== undefined ? Astro.props.view : await courseOf(section, Astro)
const Sub = lead ? 'h2' : 'h3'
const name = view?.visitor ? (view.visitor.first_name ?? view.visitor.email) : null
---
{view && (
  <Band section={section} class="course course-syllabus">
    <Crumbs steps={[{ label: 'Courses', href: view.coursesHref }, { label: view.title, href: null }]} />
    <CourseHead view={view} lead={lead} cover />
    <div class="cs-columns">
      <div class="cs-syllabus">
        <div class="cs-list-head">
          <p class="kicker">Syllabus</p>
          <Sub>{lessonsOf(view.lessons)}</Sub>
        </div>
        <Syllabus rows={view.rows} />
      </div>
      <aside class="cs-aside" aria-label="About this course">
        <section class="cs-panel">
          <Sub class="cs-panel-title">About this course</Sub>
          <dl class="cs-facts">
            <div><dt>Lessons</dt><dd>{view.lessons}</dd></div>
            {lengthOf(view.seconds) && <div><dt>Length</dt><dd>{lengthOf(view.seconds)}</dd></div>}
            <div><dt>Who can watch</dt><dd>{view.whoCanWatch}</dd></div>
            {view.exceptions.map((e) => <div><dt>Lesson {e.n}</dt><dd>{e.who}</dd></div>)}
          </dl>
        </section>
        {view.visitor && (
          <section class="cs-panel">
            <Sub class="cs-panel-title">Your place</Sub>
            <p>You are signed in as {name}. The Academy keeps your place in each course on this site.</p>
            <a class="button button-quiet button-small" href={view.signOut}>Sign out</a>
          </section>
        )}
      </aside>
    </div>
  </Band>
)}

<style>
  .cs-columns {
    display: grid;
    gap: 2rem;
  }
  .cs-syllabus {
    min-width: 0;
  }
  .cs-list-head {
    margin-bottom: 1rem;
  }
  .cs-list-head > * {
    margin: 0;
  }
  .cs-list-head .kicker {
    margin-bottom: 0.375rem;
  }
  .cs-list-head :is(h2, h3) {
    font-size: var(--h3);
  }
  .cs-aside {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .cs-panel {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    padding: 1.25rem 1.375rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
  }
  .cs-panel > * {
    margin: 0;
  }
  .cs-panel .cs-panel-title {
    font-family: var(--font);
    font-size: var(--text);
    font-weight: 700;
    letter-spacing: 0;
  }
  .cs-panel p {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .cs-facts {
    display: grid;
    gap: 0.625rem;
    width: 100%;
    margin: 0;
    font-size: var(--text-sm);
  }
  .cs-facts > div {
    display: grid;
    grid-template-columns: minmax(6rem, auto) minmax(0, 1fr);
    gap: 0.75rem;
  }
  .cs-facts dt {
    color: var(--muted);
  }
  .cs-facts dd {
    margin: 0;
    color: var(--ink);
    font-weight: 600;
  }
  @media (min-width: 56rem) {
    .cs-columns {
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 20rem);
      gap: 3rem;
    }
  }
</style>
