---
// EventsList · Calendar (ruling 32: beside the Agenda, never in its place; the
// events page's default): one month at a time. On a desktop (48rem and wider)
// a month grid, Sunday to Saturday, each event a chip in its day — its type
// and time over its title, both in the event's own time zone, and an empty
// live-counts slot (LiveCounts fills it) — linking to the event's page on this
// site (/events/<slug>). Today is ringed and marked aria-current="date"; days
// before it are muted, their events still there; the days of the months
// either side are faint and empty. On a phone the same month's events are
// the Agenda's rows (AgendaMonths), with the event's button when
// `options.actions` is 'buttons'.
//
// The month is `?month=YYYY-MM`, else the month it is today in the events'
// time zone. The arrows are addresses (`?month=` on this page's own path), so
// they work with scripts off; they reach a year back and two years ahead, and
// "This month" returns to the bare address. The rows are the month's own,
// past days included, from the Content API's `GET /events?from=&to=`
// (src/lib/events.ts monthEvents); if that cannot be read the section's own
// rows that fall in the month are drawn. A month with no event says so with
// the section's empty-events line.
//
// On the events page the type tabs come first, as the Agenda draws them
// (TypeTabs), each keeping the month in view; on /events/<type> the month is
// that type's events. src/pages/[...path].astro never lets the edge store a
// page with a calendar on it: the month in view and today move with the
// clock and `?month=`, neither of which is in the edge cache's key.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import AgendaMonths from './AgendaMonths.astro'
import LiveCounts from './LiveCounts.astro'
import TypeTabs from './TypeTabs.astro'
import { actionsOf, eventsOf, monthName, type EventRow } from './events'
import { text } from '../../../lib/format'
import { rows as rowsOf } from '../../../lib/section'
import {
  MONTH_PARAM,
  monthEvents,
  monthInReach,
  monthOf,
  monthParam,
  shiftMonth,
  tabsFor,
  todayIn,
  type CalendarMonth,
} from '../../../lib/events'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const heading = text(section.copy.heading)
const invitation = text(section.copy.eventsEmptyCta)
const buttons = actionsOf(section) === 'buttons'
const bg = Astro.locals.backgold
const pathname = Astro.url.pathname

// Today, in the time zone of the section's own events (UTC without one).
const baked = rowsOf(section)
const zone = baked.map((row) => text(row.timezone)).find((z): z is string => !!z) ?? null
const today = todayIn(zone)
const current: CalendarMonth = { year: today.year, monthIndex: today.monthIndex }
const month = monthOf(Astro.url.searchParams.get(MONTH_PARAM), current) ?? current
const isCurrent = month.year === current.year && month.monthIndex === current.monthIndex

const tabs = bg.setup === null ? await tabsFor(bg.client, Astro.request, section, pathname) : null
let read: Record<string, unknown>[] | null = null
if (bg.setup === null) {
  try {
    read = await monthEvents(bg.client, Astro.request, month, tabs?.active ?? null)
  } catch {
    read = null
  }
}
// Every row of the month, whatever the section's `max`.
const { max: _max, ...options } = section.options ?? {}
const all = eventsOf({ ...section, options, data: { source: section.data?.source ?? 'events', items: read ?? baked } })
const events = all.filter((e) => e.when && e.when.year === month.year && e.when.monthIndex === month.monthIndex)

const byDay = new Map<number, EventRow[]>()
for (const e of events) {
  const day = Number(e.when!.day)
  byDay.set(day, [...(byDay.get(day) ?? []), e])
}

// The grid: the weeks that hold the month, Sunday first, with the days of
// the months either side filling the first and last week.
const WEEKDAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']
const firstWeekday = new Date(Date.UTC(month.year, month.monthIndex, 1)).getUTCDay()
const length = new Date(Date.UTC(month.year, month.monthIndex + 1, 0)).getUTCDate()
const previousLength = new Date(Date.UTC(month.year, month.monthIndex, 0)).getUTCDate()
interface Cell {
  day: number
  /** In the month shown; the others are the months either side. */
  inMonth: boolean
}
const cells: Cell[] = []
for (let i = firstWeekday - 1; i >= 0; i--) cells.push({ day: previousLength - i, inMonth: false })
for (let d = 1; d <= length; d++) cells.push({ day: d, inMonth: true })
for (let d = 1; cells.length % 7 !== 0; d++) cells.push({ day: d, inMonth: false })
const weeks = Array.from({ length: cells.length / 7 }, (_, w) => cells.slice(w * 7, w * 7 + 7))

const monthOrder = month.year * 12 + month.monthIndex
const currentOrder = current.year * 12 + current.monthIndex
const isPast = (day: number) => monthOrder < currentOrder || (monthOrder === currentOrder && day < today.day)
const isToday = (day: number) => isCurrent && day === today.day
const label = (m: CalendarMonth) => `${monthName(m.monthIndex)} ${m.year}`
const title = label(month)
const dayLabel = (day: number, n: number) =>
  `${WEEKDAYS[new Date(Date.UTC(month.year, month.monthIndex, day)).getUTCDay()]}, ${monthName(month.monthIndex)} ${day}${isToday(day) ? ', today' : ''}, ${n === 0 ? 'no events' : n === 1 ? '1 event' : `${n} events`}`

// The arrows and the tabs: `?month=` on this page's own path.
const href = (m: CalendarMonth) => `${pathname}?${MONTH_PARAM}=${monthParam(m)}`
const previous = shiftMonth(month, -1)
const next = shiftMonth(month, 1)
const query = isCurrent ? '' : `?${MONTH_PARAM}=${monthParam(month)}`
const count = (n: number) => (n === 1 ? '1 event' : `${n} events`)
---
<Band section={section} class="events events-calendar">
  {heading && <h2>{heading}</h2>}
  {tabs && <TypeTabs tabs={tabs} query={query} />}
  <div class="cal">
    <div class="cal-bar">
      <h3 class="cal-label" id={`${section.id}-month`}>
        {title} <span class="cal-count">{events.length > 0 ? count(events.length) : 'nothing yet'}</span>
      </h3>
      <nav class="cal-nav" aria-label="Months">
        {monthInReach(previous, current) && (
          <a class="cal-arrow" href={href(previous)} rel="nofollow"><span aria-hidden="true">‹</span> {monthName(previous.monthIndex)}</a>
        )}
        {!isCurrent && <a class="cal-arrow cal-now" href={pathname}>This month</a>}
        {monthInReach(next, current) && (
          <a class="cal-arrow" href={href(next)} rel="nofollow">{monthName(next.monthIndex)} <span aria-hidden="true">›</span></a>
        )}
      </nav>
    </div>

    <div class="cal-grid-wrap">
      <table class="cal-grid" aria-labelledby={`${section.id}-month`}>
        <thead>
          <tr>{WEEKDAYS.map((d) => <th scope="col" abbr={d}>{d.slice(0, 3)}</th>)}</tr>
        </thead>
        <tbody>
          {weeks.map((week) => (
            <tr>
              {week.map((cell) =>
                cell.inMonth ? (
                  <td
                    class:list={['cal-day', isPast(cell.day) && 'cal-past', isToday(cell.day) && 'cal-today']}
                    aria-current={isToday(cell.day) ? 'date' : undefined}
                  >
                    <span class="cal-dn" aria-hidden="true">{cell.day}</span>
                    <span class="visually-hidden">{dayLabel(cell.day, byDay.get(cell.day)?.length ?? 0)}</span>
                    {(byDay.get(cell.day) ?? []).length > 0 && (
                      <ul class="cal-chips" role="list">
                        {(byDay.get(cell.day) ?? []).map((event) => (
                          <li>
                            {event.link ? (
                              <a class="cal-chip" href={event.link.href} rel={event.link.rel}>
                                {(event.type || event.when?.time) && (
                                  <span class="cal-kind">{[event.type, event.when?.time].filter(Boolean).join(' · ')}</span>
                                )}
                                <span class="cal-title">{event.title}</span>
                                {event.id && <span class="cal-live" data-bg-live={event.id}></span>}
                              </a>
                            ) : (
                              <span class="cal-chip">
                                {(event.type || event.when?.time) && (
                                  <span class="cal-kind">{[event.type, event.when?.time].filter(Boolean).join(' · ')}</span>
                                )}
                                <span class="cal-title">{event.title}</span>
                              </span>
                            )}
                          </li>
                        ))}
                      </ul>
                    )}
                  </td>
                ) : (
                  <td class="cal-out" aria-hidden="true"><span class="cal-dn">{cell.day}</span></td>
                ),
              )}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="cal-phone">
      <AgendaMonths events={events} buttons={buttons} invitation={invitation} />
    </div>

    {events.length === 0 && (
      <p class="cal-empty">
        <strong>Nothing on the calendar in {monthName(month.monthIndex)}.</strong>
        {invitation && <span> {invitation}</span>}
      </p>
    )}
  </div>
  <LiveCounts />
</Band>

<style>
  .cal {
    margin-top: 1.5rem;
  }
  .cal-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    margin-bottom: 1rem;
  }
  .cal-label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin: 0;
    font-size: calc(var(--h3) * 1.15);
    font-weight: 800;
  }
  .cal-count {
    color: var(--muted);
    font-family: var(--font);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0;
  }
  .cal-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cal-arrow {
    display: inline-block;
    padding: 0.4375rem 0.875rem;
    border: 1.5px solid color-mix(in srgb, var(--ink) 25%, transparent);
    border-radius: var(--pill);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }
  .cal-arrow:hover {
    border-color: var(--ink);
  }
  /* A phone draws the month as the agenda's rows; the grid is the desktop's. */
  .cal-grid-wrap {
    display: none;
  }
  .cal-phone :global(.agenda) {
    margin-top: 0;
  }
  .cal-phone :global(.agenda-heading) {
    display: none;
  }
  .cal-grid {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .cal-grid th {
    padding: 0.5625rem 0.625rem 0.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: left;
    text-transform: uppercase;
  }
  .cal-grid td {
    height: 6.625rem;
    padding: 0.375rem 0.375rem 0.4375rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .cal-grid td:last-child {
    border-right: 0;
  }
  .cal-grid tr:last-child td {
    border-bottom: 0;
  }
  .cal-dn {
    display: inline-block;
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.375rem;
    border-radius: var(--pill);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 800;
    line-height: 1.5rem;
    text-align: center;
  }
  .cal-chips {
    display: grid;
    /* One column no wider than the day: a long title is cut with an ellipsis, never spilt into the next day. */
    grid-template-columns: minmax(0, 1fr);
    gap: 0.1875rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .cal-chip {
    display: block;
    min-width: 0;
    padding: 0.1875rem 0.375rem 0.25rem;
    border-radius: min(var(--radius), 6px);
    background: color-mix(in srgb, var(--link) 12%, transparent);
    color: var(--ink);
    line-height: 1.25;
    text-decoration: none;
  }
  a.cal-chip:hover {
    box-shadow: inset 0 0 0 1px var(--link);
  }
  .cal-kind,
  .cal-title,
  .cal-live {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cal-kind {
    color: var(--link);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .cal-title {
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .cal-live {
    color: var(--muted);
    font-size: 0.625rem;
    font-weight: 700;
  }
  .cal-live:empty {
    display: none;
  }
  .cal-past {
    background: color-mix(in srgb, var(--ink) 4%, transparent);
  }
  .cal-past .cal-dn {
    color: var(--muted);
  }
  .cal-past .cal-chip {
    opacity: 0.62;
  }
  .cal-out {
    background: color-mix(in srgb, var(--ink) 4%, transparent);
  }
  .cal-out .cal-dn {
    color: var(--muted);
    font-weight: 600;
    opacity: 0.55;
  }
  .cal-today .cal-dn {
    box-shadow: inset 0 0 0 2px var(--button);
    color: var(--ink);
  }
  .cal-empty {
    margin: 1rem 0 0;
    padding: 1.125rem 1.25rem;
    border: 2px dashed color-mix(in srgb, var(--ink) 22%, transparent);
    border-radius: var(--radius);
    color: var(--muted);
  }
  .cal-empty strong {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }
  @media (min-width: 48rem) {
    .cal-grid-wrap {
      display: block;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: var(--radius-card);
      background: var(--surface);
    }
    .cal-phone {
      display: none;
    }
  }
</style>
