---
// EventsList (List, the default; board C1's "Upcoming events · List", A12
// shows it beside Cards and Agenda): the section head (the kicker when one
// is set, the heading, and the section's links at the right, C1's "All
// events"), then the events as rows (EventRows: a card per event with its
// day, its type, its title, its time and place and its live counts). Each
// event links to its page on this site (/events/<slug>), which frames
// BackGold's RSVP and tickets (never build an RSVP form here):
// `options.actions` 'buttons' puts the event's button on each row, 'link'
// (or none) makes the title the link; either way the whole row opens it. On
// the events page (/events, /events/<type>) a line under the rows names their
// one zone and offers every event as one calendar file (CalendarLine, as the
// Agenda draws it). With no events listed, the section places BackGold's own
// events-list frame instead, when it has one, else says so.
import type { Section } from '@backgold/content'
import { Embed } from '@backgold/astro/components'
import Band from '../Band.astro'
import EventRows from './EventRows.astro'
import LiveCounts from './LiveCounts.astro'
import CalendarLine from './CalendarLine.astro'
import SectionHead from '../SectionHead.astro'
import { actionsOf, eventsOf, sharedZone } from './events'
import { onEventsPage } from '../../../lib/events'
import { links } from '../../../lib/section'
import { text } from '../../../lib/format'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const heading = text(section.copy.heading)
const buttons = actionsOf(section) === 'buttons'
const events = eventsOf(section)
const calendarLine = events.length > 0 && onEventsPage(Astro.url.pathname)
const zone = calendarLine ? sharedZone(events) : null
---
<Band section={section} class="events events-list">
  <SectionHead kicker={text(section.copy.kicker)} heading={heading} more={links(section)} />
  {events.length > 0 && <EventRows events={events} buttons={buttons} level={3} zoneless={zone !== null} />}
  {calendarLine && <CalendarLine zone={zone} />}
  {events.length > 0 && <LiveCounts />}
  {events.length === 0 && section.embed && <Embed embed={section.embed} title={heading ?? 'Upcoming events'} />}
  {events.length === 0 && !section.embed && <p class="empty">No upcoming events right now.</p>}
</Band>
