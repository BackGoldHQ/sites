---
// Services, 'compare' layout (board S04, C, the compare table; the board's
// process strip is the Issues section's steps layout): the section head and
// the body, then a table on the band's surface with a column per service in
// the operator's order (its name, the copy's featured label as a chip on the
// featured service when the operator wrote one, its price as typed and its
// term in the header) and a row per line any service includes, in the order
// the lines first appear. A cell where the service lists the line holds a
// check and says "Included" to a screen reader; any other holds a muted dash
// and says "Not included". The services' buttons sit along the foot of the
// table, each under its own column: the featured service's solid, the others
// outlined. On a phone the table scrolls sideways inside its own bordered
// box, the lines' column held at the left edge.
//
// With one service there is nothing to compare: it is drawn as a card, its
// name, price and term over what it includes as a plain checked list, and
// its button. Several services that include nothing draw as the list layout.
// The note sits small under either. Nothing is drawn with neither a heading
// nor a service.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import Prose from '../../Prose.astro'
import Button from './Button.astro'
import Check from './Check.astro'
import Includes from './Includes.astro'
import List from './list.astro'
import { everyInclude, servicesOf } from './services'
import { text } from '../../../lib/format'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
const s = servicesOf(section)
const lines = everyInclude(s.items)
const many = s.items.length > 1
const asList = many && lines.length === 0
const buttons = s.items.some((service) => service.link)
const regionId = `${section.id}-services-compare`.replace(/[^A-Za-z0-9_-]/g, '-')
const [only] = s.items
---
{asList ? (
  <List {...Astro.props} />
) : (heading || only) && (
  <Band section={section} class="services services-compare">
    <SectionHead kicker={kicker} heading={heading} more={[]} />
    <Prose value={section.copy.body} class="lede" />
    {many ? (
      <div class="sv-frame" role="region" aria-labelledby={regionId} tabindex="0">
        <table class="sv-table" style={`--sv-services: ${s.items.length}`}>
          <caption class="visually-hidden" id={regionId}>{heading ?? 'Services compared'}</caption>
          <thead>
            <tr>
              <th scope="col" class="sv-line-col">Included</th>
              {s.items.map((service) => (
                <th scope="col" class:list={[service.featured && 'sv-col-featured']}>
                  <span class="sv-service-name">{service.name}</span>
                  {service.featured && s.featuredLabel && <span class="chip sv-featured">{s.featuredLabel}</span>}
                  {service.price && <span class="sv-service-price">{service.price}</span>}
                  {service.term && <span class="sv-service-term">{service.term}</span>}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {lines.map((line) => (
              <tr>
                <th scope="row" class="sv-line-col">{line}</th>
                {s.items.map((service) => (
                  <td class:list={[service.featured && 'sv-col-featured']}>
                    {service.includes.includes(line) ? (
                      <>
                        <Check />
                        <span class="visually-hidden">Included</span>
                      </>
                    ) : (
                      <>
                        <span class="sv-dash" aria-hidden="true">–</span>
                        <span class="visually-hidden">Not included</span>
                      </>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
          {buttons && (
            <tfoot>
              <tr>
                <td class="sv-line-col"></td>
                {s.items.map((service) => (
                  <td class:list={[service.featured && 'sv-col-featured']}>
                    <Button service={service} solid={service.featured} many={many} class="sv-table-button" />
                  </td>
                ))}
              </tr>
            </tfoot>
          )}
        </table>
      </div>
    ) : only && (
      <div class="sv-single">
        <div class="sv-single-head">
          <div class="sv-single-name">
            <h3>{only.name}</h3>
            {only.featured && s.featuredLabel && <span class="chip">{s.featuredLabel}</span>}
          </div>
          {(only.price || only.term) && (
            <p class="sv-single-price">
              {only.price && <span class="sv-single-amount">{only.price}</span>}
              {only.term && <span class="sv-single-term">{only.term}</span>}
            </p>
          )}
        </div>
        {only.summary && <p class="sv-single-summary">{only.summary}</p>}
        <Includes items={only.includes} class="sv-single-includes" />
        <Button service={only} solid={true} many={false} class="sv-single-button" />
      </div>
    )}
    {s.note && <p class="fine sv-compare-note">{s.note}</p>}
  </Band>
)}

<style>
  /* Positioned, so a cell's visually hidden words stay inside the scroll box instead of widening the page. */
  .sv-frame {
    position: relative;
    overflow-x: auto;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--ink);
    overscroll-behavior-x: contain;
  }
  :global(.lede) + .sv-frame,
  :global(.lede) + .sv-single {
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
  }
  .sv-table {
    width: 100%;
    min-width: calc(9rem + var(--sv-services) * 11rem);
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.9375rem;
  }
  .sv-table th,
  .sv-table td {
    padding: 0.9375rem 1.125rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: middle;
  }
  .sv-table tbody tr:last-child > *,
  .sv-table tfoot td {
    border-bottom: 0;
  }
  .sv-table thead th {
    padding-block: 1.125rem 1.25rem;
    border-bottom: 1px solid var(--button-2);
    background: var(--button-2);
    color: var(--button-2-ink);
    vertical-align: bottom;
  }
  .sv-table thead .sv-line-col {
    color: color-mix(in srgb, var(--button-2-ink) 78%, transparent);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .sv-line-col {
    position: sticky;
    left: 0;
    z-index: 1;
    width: 30%;
    background: var(--surface);
    font-weight: 500;
  }
  tbody .sv-line-col,
  tfoot .sv-line-col {
    box-shadow: inset -1px 0 0 var(--line);
  }
  .sv-service-name {
    display: block;
    font-weight: 700;
    line-height: 1.3;
  }
  .sv-featured {
    margin-top: 0.375rem;
    background: color-mix(in srgb, var(--button-2-ink) 16%, transparent);
    color: var(--button-2-ink);
    white-space: normal;
  }
  .sv-service-price {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    font-variant-numeric: lining-nums;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .sv-service-term {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--text-sm);
    font-weight: 500;
    opacity: 0.85;
  }
  tbody .sv-col-featured,
  tfoot .sv-col-featured {
    background: color-mix(in srgb, var(--button-2) 7%, transparent);
  }
  .sv-table td {
    --sv-check: var(--accent);
  }
  .sv-table td :global(.sv-check) {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
  }
  .sv-dash {
    color: var(--muted);
    font-weight: 600;
  }
  .sv-table tfoot td {
    padding: 1.125rem 0.75rem;
    border-top: 1px solid var(--line);
    vertical-align: top;
  }
  .sv-table :global(.sv-table-button) {
    width: 100%;
    padding-inline: 0.75rem;
  }
  .sv-table thead :focus-visible,
  .sv-frame:focus-visible {
    outline-offset: 2px;
  }
  .sv-single {
    display: grid;
    gap: 1.25rem;
    max-width: 40rem;
    padding: clamp(1.375rem, 1rem + 1.2vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--ink);
  }
  .sv-single > * {
    margin: 0;
  }
  .sv-single-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }
  .sv-single-name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }
  .sv-single-name h3 {
    margin: 0;
    font-family: var(--font);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: 0;
  }
  /* The featured label's chip, outlined so it reads on a surface as dark as the tint (a dark scheme). */
  .sv-single-name .chip {
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .sv-single-price {
    margin: 0;
  }
  .sv-single-amount {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.5rem + 0.8vw, 2.25rem);
    font-variant-numeric: lining-nums;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .sv-single-term {
    display: block;
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .sv-single-summary {
    color: var(--muted);
  }
  .sv-single :global(.sv-single-includes) {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .sv-single :global(.sv-single-button) {
    justify-self: start;
  }
  .sv-compare-note {
    margin: 1.25rem 0 0;
  }
  /* On a phone the held column is narrower, so more of the scrolled services shows beside it. */
  @media (max-width: 39.99rem) {
    .sv-line-col {
      width: 9rem;
    }
  }
  /* Wider, the single service's price sits at the right of its name. */
  @media (min-width: 40rem) {
    .sv-single-price {
      text-align: right;
    }
  }
  :global(.bg-band-contrast) .sv-frame,
  :global(.bg-band-contrast) .sv-single {
    border-color: var(--line);
  }
</style>
