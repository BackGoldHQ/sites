---
// Classroom · Grid (board D1): the organization's courses as cards, three
// across on a wide screen, two on a tablet, one on a phone, each with this
// visitor's place in it (classroom.ts). The default layout; it draws `grid`
// and any layout the kit has no file for.
import type { Section } from '@backgold/content'
import Courses from './Courses.astro'
import { classroomOf } from './classroom'

interface Props {
  section: Section
  variant?: string
  /** Where the courses come from: the section's rows (a page), or `GET /courses` (the courses list page). */
  from?: 'rows' | 'read'
}

const { section, from } = Astro.props
const classroom = await classroomOf(section, Astro, from)
---
<Courses section={section} classroom={classroom} layout="grid" />
