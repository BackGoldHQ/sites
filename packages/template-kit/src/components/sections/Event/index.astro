---
// One event · Full (board A12, the default): the heading, then BackGold's RSVP
// and tickets on a raised card.
import type { Section } from '@backgold/content'
import Headed from '../modules/Headed.astro'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
---
<Headed section={section} layout="detail" card height="44rem" narrow />
