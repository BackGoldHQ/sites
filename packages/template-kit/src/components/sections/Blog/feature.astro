---
// Blog · Lead story (board A1, "Blog · Lead story"; A12 shows it beside Cards
// and List): the section head (the kicker, the heading and its "All news"
// link: the section's own link, else "All news" to the news list at the
// organization's blog base), then the newest
// post large, with its cover, its category as an accent chip, its title,
// summary and byline (the author's picture or initials, "Corinne Pell ·
// Oct 2"), and the next ones as a short list beside it, each with its
// category, title, date and a small square cover. Four posts, or the
// section's `maxItems`. With nothing published it draws nothing.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import { links } from '../../../lib/section'
import { text } from '../../../lib/format'
import { latestNews, shownOf, storyOf } from './latest'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const heading = text(section.copy.heading) ?? 'Latest'
const own = links(section)
const { entries, listPath } = await latestNews(Astro.locals, shownOf(section, 4))
const more = own.length > 0 ? own : listPath ? [{ label: 'All news', href: listPath, rel: undefined }] : []
const stories = entries.map(storyOf)
const [lead, ...rest] = stories
---
{lead && (
  <Band section={section} class="entries blog-feature">
    <SectionHead kicker={text(section.copy.kicker)} heading={heading} more={more} />
    <div class:list={['lead', { 'lead-alone': rest.length === 0 }]}>
      <article class="lead-story">
        {lead.image && <img class="lead-cover" src={lead.image} alt="" loading="lazy" decoding="async" />}
        {lead.category && <p class="lead-chips"><span class="chip chip-accent">{lead.category}</span></p>}
        <h3 class="lead-title">{lead.href ? <a href={lead.href}>{lead.title}</a> : lead.title}</h3>
        {lead.summary && <p class="lead-summary">{lead.summary}</p>}
        {(lead.byline || lead.shortDay) && (
          <p class="lead-byline">
            {lead.avatar && (lead.avatar.url ? <img class="lead-avatar" src={lead.avatar.url} alt="" loading="lazy" decoding="async" /> : <span class="lead-avatar" aria-hidden="true">{lead.avatar.initials}</span>)}
            <span>
              {lead.byline}
              {lead.byline && lead.shortDay && ' · '}
              {lead.shortDay && lead.date && <time datetime={lead.date}>{lead.shortDay}</time>}
            </span>
          </p>
        )}
      </article>
      {rest.length > 0 && (
        <ul class="lead-rest" role="list">
          {rest.map((story) => (
            <li class:list={['lead-item', { 'lead-item-pictured': story.image }]}>
              <div>
                {story.category && <p class="lead-chips"><span class="chip">{story.category}</span></p>}
                <h3 class="lead-item-title">{story.href ? <a href={story.href}>{story.title}</a> : story.title}</h3>
                {story.shortDay && story.date && <p class="lead-byline"><time datetime={story.date}>{story.shortDay}</time></p>}
              </div>
              {story.image && <img class="lead-thumb" src={story.image} alt="" loading="lazy" decoding="async" />}
            </li>
          ))}
        </ul>
      )}
    </div>
  </Band>
)}

<style>
  .lead {
    display: grid;
    gap: 2rem;
  }
  .lead-story > *,
  .lead-item p,
  .lead-item h3 {
    margin: 0;
  }
  .lead-story .lead-cover {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-card);
    margin-bottom: 1.125rem;
  }
  .lead-story .lead-title {
    margin: 0.75rem 0 0.625rem;
    font-size: clamp(1.625rem, 1.2rem + 1.3vw, 2.125rem);
    font-weight: 800;
    line-height: 1.1;
  }
  .lead-title a,
  .lead-item-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .lead-title a:hover,
  .lead-item-title a:hover {
    text-decoration: underline;
  }
  .lead-story .lead-summary {
    color: var(--muted);
    font-size: 1.0625rem;
    max-width: var(--measure);
  }
  .lead-byline {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .lead-story .lead-byline {
    margin-top: 0.875rem;
  }
  .lead-avatar {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.875rem;
    height: 1.875rem;
    border-radius: 50%;
    object-fit: cover;
    background: linear-gradient(150deg, var(--bg-brand-primary), var(--bg-brand-accent));
    color: var(--band-photo-ink);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .lead-rest {
    display: grid;
    align-content: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lead-item {
    display: grid;
    gap: 1rem;
    padding: 1.125rem 0;
    border-top: 1px solid var(--line);
  }
  .lead-item-pictured {
    grid-template-columns: minmax(0, 1fr) 5.5rem;
  }
  .lead-item:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .lead-item .lead-item-title {
    margin-top: 0.375rem;
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .lead-thumb {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
  }
  @media (min-width: 52rem) {
    .lead {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 2.25rem;
    }
    .lead-alone {
      grid-template-columns: minmax(0, 1fr);
      max-width: 48rem;
    }
    .lead-item-pictured {
      grid-template-columns: minmax(0, 1fr) 6.875rem;
    }
  }
</style>
