---
// Blog · List (board A4, "Blog · List"; A12 shows it beside Cards and Lead
// story): one post per row, newest first, with its cover, category, title,
// summary and byline (authors · date). Four posts, or the section's
// `maxItems`; "All news" goes to the full list at the organization's blog
// base. The board's category tabs, search and pager belong to that list, not
// to the section, and are not drawn here. With nothing published it draws
// nothing.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import { text } from '../../../lib/format'
import { latestNews, shownOf, storyOf } from './latest'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const heading = text(section.copy.heading) ?? 'Latest'
const { entries, listPath } = await latestNews(Astro.locals.backgold, shownOf(section, 4))
const stories = entries.map(storyOf)
---
{stories.length > 0 && (
  <Band section={section} class="entries blog-list">
    <h2>{heading}</h2>
    <ul class="post-list" role="list">
      {stories.map((story) => (
        <li class:list={['post-row', { 'post-row-pictured': story.image }]}>
          {story.image && <span class="post-frame"><img class="post-cover" src={story.image} alt="" loading="lazy" decoding="async" /></span>}
          <div class="post-body">
            {story.category && <p class="post-chip">{story.category}</p>}
            <h3 class="post-title">{story.href ? <a href={story.href}>{story.title}</a> : story.title}</h3>
            {story.summary && <p class="post-summary">{story.summary}</p>}
            {(story.byline || story.day) && (
              <p class="post-byline">
                {story.byline}
                {story.byline && story.day && ' · '}
                {story.day && story.date && <time datetime={story.date}>{story.day}</time>}
              </p>
            )}
          </div>
        </li>
      ))}
    </ul>
    {listPath && <p class="more"><a href={listPath}>All news</a></p>}
  </Band>
)}

<style>
  .post-list {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .post-row {
    display: grid;
    gap: 0.875rem;
    padding: 1.5rem 0;
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
  }
  .post-row:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .post-frame {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
  }
  .post-cover {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .post-body > * {
    margin: 0;
  }
  .post-chip {
    display: inline-block;
    padding: 0.125rem 0.625rem;
    border-radius: var(--pill);
    background: color-mix(in srgb, var(--link) 12%, transparent);
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .post-body .post-title {
    margin-top: 0.5rem;
    font-size: var(--h3);
    font-weight: 700;
    line-height: 1.2;
  }
  .post-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .post-title a:hover {
    text-decoration: underline;
  }
  .post-body .post-summary {
    margin-top: 0.5rem;
    color: var(--muted);
    max-width: var(--measure);
  }
  .post-body .post-byline {
    margin-top: 0.625rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  @media (min-width: 40rem) {
    .post-row-pictured {
      grid-template-columns: minmax(10rem, 13.75rem) minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .post-cover {
      transition: transform 0.3s ease;
    }
    .post-row:hover .post-cover {
      transform: scale(1.02);
    }
  }
</style>
