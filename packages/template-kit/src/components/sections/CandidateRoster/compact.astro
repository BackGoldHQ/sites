---
// CandidateRoster · Compact (board A1, "Candidate roster · Compact"; A12
// shows it beside Cards and Ballot): the section head (the kicker, the
// heading and its "All N candidates" link), then one row of four candidates
// from the top of the ballot (by level, BackGold's order within a level),
// each with a square headshot (their initials on the brand's gradient when
// there is none), the name, the office and the place as a chip, with an
// "Endorsed" chip under the office when the candidate is endorsed. The name
// links to the candidate's own site when the record has one. Two across on
// a phone. With no candidates it draws nothing.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import { links } from '../../../lib/section'
import { text } from '../../../lib/format'
import { candidatesOf, initials, levelRank } from './candidates'

type Props = ComponentProps<typeof Default>

/** A1 draws one row; the section's link goes to the rest. */
const SHOWN = 4

const { section } = Astro.props
const candidates = candidatesOf(section)
  .map((c, i) => ({ c, i }))
  .sort((a, b) => levelRank(a.c.level) - levelRank(b.c.level) || a.i - b.i)
  .slice(0, SHOWN)
  .map(({ c }) => c)
---
{candidates.length > 0 && (
  <Band section={section} class="roster roster-compact">
    <SectionHead kicker={text(section.copy.kicker)} heading={text(section.copy.heading)} more={links(section)} />
    <ul class="compact" role="list">
      {candidates.map((c) => (
        <li class="compact-item">
          {c.photo ? (
            <img class="compact-photo" src={c.photo} alt="" loading="lazy" decoding="async" />
          ) : (
            <span class="compact-photo compact-initials" aria-hidden="true">{initials(c.name)}</span>
          )}
          <h3 class="compact-name">{c.site ? <a href={c.site.href} rel={c.site.rel}>{c.name}</a> : c.name}</h3>
          {c.office && <p class="compact-office">{c.office}</p>}
          {c.endorsed && <p class="compact-endorsed"><span class="chip chip-accent">Endorsed</span></p>}
          {c.region && <p class="compact-region"><span class="chip chip-wash">{c.region}</span></p>}
        </li>
      ))}
    </ul>
  </Band>
)}

<style>
  .compact {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .compact-item {
    min-width: 0;
  }
  .compact-item > * {
    margin: 0;
  }
  .compact-photo {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 1rem;
  }
  .compact-initials {
    display: grid;
    place-items: center;
    background: linear-gradient(150deg, var(--bg-brand-primary), var(--bg-brand-accent));
    color: var(--band-photo-ink);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
    font-weight: 600;
  }
  .compact-item .compact-name {
    margin-top: 0.75rem;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .compact-name a {
    color: var(--ink);
    text-decoration: none;
  }
  .compact-name a:hover {
    text-decoration: underline;
  }
  .compact-item .compact-office {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .compact-item .compact-endorsed,
  .compact-item .compact-region {
    margin-top: 0.5rem;
  }
  /* A1 draws the place as a chip as wide as the card. */
  .compact-region .chip {
    display: flex;
    white-space: normal;
  }
  @media (min-width: 48rem) {
    .compact {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.125rem;
    }
  }
</style>
