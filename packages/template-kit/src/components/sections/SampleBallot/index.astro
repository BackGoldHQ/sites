---
// SampleBallot · Slate (mock 03, "Printable slate"; the default): the slate
// as one card to take to the polls. The kicker over the heading is the
// slate's title, the body under it, and a key to the mark ("● Endorsed")
// when a race carries one. The races follow in the organization's order,
// grouped by office as the candidate roster's Ballot groups them: the office
// in small capitals, each name with the party in parentheses, and at the
// right a filled circle for an endorsed race (the endorsed label is its
// text for a screen reader) or an empty ring. Under a rule the ballot
// measures (`measuresHeading`), each its title over "Vote YES" or "Vote NO"
// (or "No position"), then the closing note, small.
//
// "Print this slate", at the title's right (under the body on a phone),
// prints the card through the browser. It is drawn
// hidden and shown by the section's script, so with scripts off nothing is
// offered that cannot work. The page's print style holds whenever a slate
// is on the page, however printing starts: `body:has(.slate-sheet)` hides
// every element that neither holds a slate nor sits inside one, keeping the
// footer's legal line ("Paid for by …") under the card, and the card prints
// in black ink on white. With no races, no measures and no heading it draws
// nothing.
import type { Section } from '@backgold/content'
import Band from '../Band.astro'
import Prose from '../../Prose.astro'
import Position from './Position.astro'
import { text } from '../../../lib/format'
import { ballotOf, idFor, nameWithParty, officesOf } from './ballot'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
const note = text(section.copy.note)
const printLabel = text(section.copy.printLabel) ?? 'Print this slate'
const endorsedLabel = text(section.copy.endorsedLabel) ?? 'Endorsed'
const measuresHeading = text(section.copy.measuresHeading) ?? 'Ballot measures'
const { races, measures } = ballotOf(section)
const offices = officesOf(races)
const titleId = idFor(section, 'slate-title')
const hasRows = races.length > 0 || measures.length > 0
---
{(hasRows || heading) && (
  <Band section={section} class="sample-ballot sample-ballot-slate">
    <article class="slate-sheet" aria-labelledby={heading ? titleId : undefined} data-slate>
      <header class="slate-head">
        <div class="slate-title">
          {kicker && <p class="kicker">{kicker}</p>}
          {heading && <h2 id={titleId}>{heading}</h2>}
        </div>
        {hasRows && (
          <button type="button" class="button button-quiet button-small slate-print" data-slate-print hidden>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path d="M7 9V3h10v6M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2M7 14h10v7H7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
            </svg>
            {printLabel}
          </button>
        )}
        <Prose value={section.copy.body} class="slate-body" />
      </header>
      {races.some((race) => race.endorsed) && (
        <p class="slate-key" aria-hidden="true"><span class="slate-mark slate-mark-on"></span>{endorsedLabel}</p>
      )}
      {races.length > 0 && (
        <ol class="slate-races" role="list">
          {offices.map((group) => (
            <li class="slate-office">
              {group.office && <h3 class="slate-label">{group.office}</h3>}
              <ul class="slate-names" role="list">
                {group.races.map((race) => (
                  <li class="slate-race">
                    <span class="slate-name">{nameWithParty(race)}</span>
                    <span class:list={['slate-mark', race.endorsed && 'slate-mark-on']}>
                      {race.endorsed && <span class="visually-hidden">{endorsedLabel}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      )}
      {measures.length > 0 && (
        <div class="slate-measures">
          <h3 class="slate-measures-heading">{measuresHeading}</h3>
          <ul class="slate-measure-list" role="list">
            {measures.map((measure) => (
              <li class="slate-measure">
                <h4 class="slate-label">{measure.title}</h4>
                {measure.position && (
                  <p class="slate-vote">
                    {measure.position !== 'neutral' && <span>Vote</span>}
                    <Position position={measure.position} />
                  </p>
                )}
              </li>
            ))}
          </ul>
        </div>
      )}
      {note && <p class="slate-note">{note}</p>}
      {hasRows && (
        <script is:inline>
          ;(function (sheet) {
            var button = sheet && sheet.querySelector('[data-slate-print]')
            if (!button || typeof window.print !== 'function') return
            button.addEventListener('click', function () {
              window.print()
            })
            button.hidden = false
          })(document.currentScript.closest('[data-slate]'))
        </script>
      )}
    </article>
  </Band>
)}

<style>
  .slate-sheet {
    max-width: 46rem;
    margin-inline: auto;
    padding: clamp(1.25rem, 0.75rem + 2vw, 2.25rem);
    border: 2px solid var(--line-strong);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--ink);
  }
  /* The title, the print button at its right (under the body on a phone), the body. */
  .slate-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'title' 'body' 'print';
    column-gap: 1.5rem;
  }
  .slate-title {
    grid-area: title;
  }
  .slate-title h2 {
    margin: 0;
    font-size: clamp(1.625rem, 1.25rem + 1.2vw, 2.125rem);
  }
  .slate-print {
    grid-area: print;
    justify-self: start;
    margin-top: 1rem;
  }
  .slate-print[hidden] {
    display: none;
  }
  .slate-head :global(.slate-body) {
    grid-area: body;
    margin-top: 0.75rem;
    color: var(--muted);
  }
  .slate-head :global(.slate-body p) {
    margin: 0 0 0.5rem;
  }
  .slate-head :global(.slate-body p:last-child) {
    margin-bottom: 0;
  }
  @media (min-width: 40rem) {
    .slate-head {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'title print' 'body body';
    }
    .slate-print {
      align-self: start;
      margin-top: 0;
    }
  }
  .slate-key {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    margin: 1rem 0 0.5rem;
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .slate-key .slate-mark {
    width: 0.875rem;
    height: 0.875rem;
    border-width: 0.4375rem;
  }
  .slate-races,
  .slate-names,
  .slate-measure-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .slate-races {
    margin-top: 1rem;
  }
  .slate-key + .slate-races {
    margin-top: 0;
  }
  .slate-office,
  .slate-measure {
    padding: 0.875rem 0;
    border-top: 1px solid var(--line);
  }
  .slate-label {
    margin: 0 0 0.25rem;
    color: var(--muted);
    font-family: var(--font);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .slate-names {
    display: grid;
    gap: 0.5rem;
  }
  .slate-race {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .slate-name {
    min-width: 0;
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.3;
  }
  /* The mark is drawn with its border, so it prints without the browser's background graphics. */
  .slate-mark {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    border: 2px solid var(--line-strong);
    border-radius: 50%;
  }
  .slate-mark-on {
    border-width: 0.75rem;
    border-color: var(--ink);
  }
  .slate-measures {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 2px solid var(--ink);
  }
  .slate-races + .slate-measures {
    margin-top: 0.25rem;
  }
  .slate-measures-heading {
    margin: 0 0 0.25rem;
    font-size: var(--text-lg);
    font-weight: 700;
  }
  .slate-measure:first-child {
    border-top: 0;
  }
  .slate-vote {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 700;
  }
  .slate-note {
    margin: 0.25rem 0 0;
    padding-top: 0.875rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .slate-races + .slate-note {
    margin-top: 0;
  }

  @media print {
    /* Only the slate and the legal line: every element that holds neither, and is in neither, is left off the page. */
    :global(body:has(.slate-sheet) :not(:has(.slate-sheet, .disclaimer)):not(.slate-sheet, .slate-sheet *, .disclaimer, .disclaimer *)) {
      display: none !important;
    }
    :global(html:has(.slate-sheet)) {
      background: white;
    }
    :global(body:has(.slate-sheet)) {
      display: block;
      min-height: 0;
      padding: 0;
      background: none;
    }
    :global(body:has(.slate-sheet) .bg-section:has(.slate-sheet)),
    :global(body:has(.slate-sheet) .site-footer),
    :global(body:has(.slate-sheet) .site-footer-inner) {
      margin: 0;
      padding: 0;
      background: none;
    }
    :global(body:has(.slate-sheet) .disclaimer) {
      margin: 1rem 0 0;
    }
    :global(body:has(.slate-sheet) .disclaimer p) {
      border-color: black;
      color: black;
    }
    .slate-sheet {
      --ink: black;
      --muted: black;
      --accent: black;
      --line: black;
      --line-strong: black;
      max-width: none;
      border-color: black;
      background: white;
      color: black;
      break-inside: avoid;
    }
    .slate-print {
      display: none;
    }
  }
</style>
