---
// Pathways · Tabs (mock 11, B, "Tabs + program list"): the kicker, heading
// and body, then a tab per pathway and the picked pathway under them. A
// pathway is a filled panel in the contrast band's colours (on a section
// that is already on the contrast band, a tint of its ink) with its title,
// the line about who it is for and the one button, `programsLabel`, to its
// programs; beside it, its programs as a list of rows, each program string
// drawn as the row's words, the part before a " · " as the program's name
// and the rest small under it ("Deciding to run" over "45 min"). A pathway
// with no programs is its panel alone, the width of the row; under 48rem
// the list goes under the panel.
//
// The tabs are a tablist of buttons, drawn hidden and shown by the
// section's script, which then shows one pathway at a time: the first,
// until another tab is clicked or reached with the arrow keys (Home and End
// go to the first and last). With scripts off every pathway shows, one
// under another, each under its own heading. Under 48rem the tabs are a
// wrapped row of chips. With one pathway there are no tabs. With no
// pathways and no heading it draws nothing.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import Prose from '../../Prose.astro'
import { idFor, pathwaysOf } from './pathways'
import { text } from '../../../lib/format'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
const programsLabel = text(section.copy.programsLabel)
const pathways = pathwaysOf(section)
const tabbed = pathways.length > 1
---
{(pathways.length > 0 || heading) && (
  <Band section={section} class="pathways pathways-tabs">
    <div class="paths-intro">
      <SectionHead kicker={kicker} heading={heading} more={[]} />
      <Prose value={section.copy.body} class="lede" />
    </div>
    {pathways.length > 0 && (
      <div class="paths" data-paths>
        {tabbed && (
          <div class="paths-tabs" role="tablist" aria-label={heading ?? 'Pathways'} data-paths-tabs hidden>
            {pathways.map((p, i) => (
              <button
                type="button"
                role="tab"
                id={idFor(section, `tab-${p.key}`)}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={idFor(section, `path-${p.key}`)}
                tabindex={i === 0 ? 0 : -1}
              >{p.title}</button>
            ))}
          </div>
        )}
        <div class="paths-list">
          {pathways.map((p) => (
            <div class:list={['path', p.programs.length === 0 && 'path-solo']} id={idFor(section, `path-${p.key}`)} data-paths-panel>
              <div class="path-card bg-band-contrast">
                <h3 class="path-title">{p.title}</h3>
                {p.summary && <p class="path-summary">{p.summary}</p>}
                {p.link && programsLabel && <a class="button" href={p.link.href} rel={p.link.rel}>{programsLabel}</a>}
              </div>
              {p.programs.length > 0 && (
                <ul class="path-programs" role="list">
                  {p.programs.map((program) => (
                    <li class="program">
                      <span class="program-name">{program.name}</span>
                      {program.detail && <span class="program-detail">{program.detail}</span>}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
        {tabbed && (
          <script is:inline>
            ;(function (root) {
              if (!root) return
              var list = root.querySelector('[data-paths-tabs]')
              var tabs = list.querySelectorAll('[role="tab"]')
              var panels = root.querySelectorAll('[data-paths-panel]')
              var select = function (index, focus) {
                for (var t = 0; t < tabs.length; t++) {
                  var on = t === index
                  tabs[t].setAttribute('aria-selected', on ? 'true' : 'false')
                  tabs[t].tabIndex = on ? 0 : -1
                  panels[t].hidden = !on
                }
                if (focus) tabs[index].focus()
              }
              var keys = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }
              for (var t = 0; t < tabs.length; t++) {
                tabs[t].addEventListener('click', function (event) {
                  select(Array.prototype.indexOf.call(tabs, event.currentTarget), false)
                })
                tabs[t].addEventListener('keydown', function (event) {
                  var at = Array.prototype.indexOf.call(tabs, event.currentTarget)
                  var next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : event.key in keys ? (at + keys[event.key] + tabs.length) % tabs.length : -1
                  if (next === -1) return
                  event.preventDefault()
                  select(next, true)
                })
                panels[t].setAttribute('role', 'tabpanel')
                panels[t].setAttribute('aria-labelledby', tabs[t].id)
                panels[t].tabIndex = 0
              }
              select(0, false)
              list.hidden = false
              root.setAttribute('data-paths-live', '')
            })(document.currentScript.closest('[data-paths]'))
          </script>
        )}
      </div>
    )}
  </Band>
)}

<style>
  .paths-intro > :global(.lede) {
    margin: -0.5rem 0 1.75rem;
  }
  .paths-intro > :global(.lede > :last-child) {
    margin-bottom: 0;
  }
  .paths-tabs[hidden],
  .path[hidden] {
    display: none;
  }
  .paths-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .paths-tabs button {
    min-height: 2.75rem;
    padding: 0.375rem 1rem;
    border: 1.5px solid color-mix(in srgb, var(--ink) 25%, transparent);
    border-radius: var(--pill);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }
  .paths-tabs button:hover {
    border-color: var(--ink);
  }
  .paths-tabs button[aria-selected='true'] {
    border-color: var(--button-2);
    background: var(--button-2);
    color: var(--button-2-ink);
  }
  .paths-list {
    display: grid;
    gap: 2rem;
  }
  .path {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
  }
  .path:focus-visible {
    outline-offset: 6px;
    border-radius: var(--radius-card);
  }
  .path-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    min-width: 0;
    padding: clamp(1.375rem, 1rem + 1.5vw, 2rem);
    border-radius: var(--radius-card);
    background: var(--bg-band-background);
    color: var(--bg-band-color);
  }
  .path-card > * {
    margin: 0;
  }
  :global(.bg-band-contrast) .path-card {
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }
  .path-title {
    font-size: var(--h3);
    font-weight: 700;
  }
  .path-summary {
    font-size: var(--text-lg);
    line-height: 1.5;
    max-width: 34rem;
  }
  .path-card .button {
    margin-top: 0.5rem;
  }
  .path-programs {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .program {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
    padding: 0.875rem 1.125rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .program-name {
    font-weight: 700;
    line-height: 1.35;
  }
  .program-detail {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  @media (min-width: 48rem) {
    .paths-tabs {
      flex-wrap: nowrap;
      gap: 0.25rem;
      margin-bottom: 1.5rem;
      overflow-x: auto;
      box-shadow: inset 0 -2px 0 var(--line);
    }
    .paths-tabs button {
      flex: 0 0 auto;
      padding: 0.625rem 1rem;
      border: 0;
      border-bottom: 3px solid transparent;
      border-radius: 0;
      color: var(--muted);
      font-size: var(--text);
      white-space: nowrap;
    }
    .paths-tabs button:hover {
      color: var(--ink);
    }
    .paths-tabs button[aria-selected='true'] {
      border-color: var(--accent);
      background: transparent;
      color: var(--ink);
      font-weight: 700;
    }
    .paths-tabs button:focus-visible {
      outline-offset: -3px;
    }
    .path {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: 1.25rem;
      align-items: start;
    }
    .path-solo {
      grid-template-columns: minmax(0, 1fr);
    }
    .path-card {
      min-height: 100%;
    }
  }
</style>
