---
// Contact your legislators · Compact: the lookup alone, narrow, on a raised
// card.
import type { Section } from '@backgold/content'
import Headed from '../modules/Headed.astro'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
---
<Headed section={section} layout="compact" card height="24rem" narrow />
