---
// Resources, 'library' layout, the default (board 09, B, "Resource
// library"): the kicker and heading, the line of copy, then a card per guide
// or download on the band's surface, four across on a wide screen, three on
// a tablet and two on a phone. Each card opens with the resource's kind in
// small capitals, then its title, the detail ("PDF · 18 pp") in the muted
// ink and, at the foot, a chip: `openLabel` ("Free") on an open resource,
// `gatedLabel` ("Email to unlock") in the accent on a gated one. The whole
// card is the resource's link: an open one goes to its own address, a gated
// one to the section's `buttonHref`, where BackGold's sign-up is, and to its
// own address when the section has none. No email field is drawn here.
//
// When the resources name more than one kind, a chip per kind ("All" first,
// then each kind in row order) narrows the cards to that kind, with
// "Showing N of M." for a screen reader. The chips are drawn hidden and shown
// by the section's script, so with scripts off every card shows and nothing
// is offered that cannot work. With no resource and no heading it draws
// nothing.
import type { Section } from '@backgold/content'
import Band from '../Band.astro'
import SectionHead from '../SectionHead.astro'
import Prose from '../../Prose.astro'
import { idFor } from '../SampleBallot/ballot'
import { kindsOf, resourcesOf } from './resources'

interface Props {
  section: Section
  variant?: string
}

const { section } = Astro.props
const found = resourcesOf(section)
const { resources } = found
const kinds = kindsOf(resources)
const filter = kinds.length > 1
const cardsId = idFor(section, 'resources')
---
{(resources.length > 0 || found.heading) && (
  <Band section={section} class="resources resources-library">
    <div class="res-intro">
      <SectionHead kicker={found.kicker} heading={found.heading} more={[]} />
      <Prose value={section.copy.body} class="lede" />
    </div>
    {resources.length > 0 && (
      <div class="res-library" data-resources>
        {filter && (
          <div class="res-kinds" role="group" aria-label="Filter by kind" data-resource-kinds hidden>
            <button type="button" aria-pressed="true" aria-controls={cardsId} data-kind="">All</button>
            {kinds.map((kind) => (
              <button type="button" aria-pressed="false" aria-controls={cardsId} data-kind={kind}>{kind}</button>
            ))}
          </div>
        )}
        <ul class="res-cards" id={cardsId} role="list">
          {resources.map((r) => (
            <li class:list={['res-card', r.link && 'res-card-linked']} data-kind={r.kind ?? ''}>
              {r.kind && <p class="res-card-kind">{r.kind}</p>}
              <h3 class="res-card-title">{r.link ? <a href={r.link.href} rel={r.link.rel}>{r.title}</a> : r.title}</h3>
              {r.detail && <p class="res-card-detail">{r.detail}</p>}
              <p class="res-card-chip">
                <span class:list={['chip', r.gated && 'chip-accent']}>{r.gated ? found.gatedLabel : found.openLabel}</span>
              </p>
            </li>
          ))}
        </ul>
        {filter && <p class="visually-hidden" role="status" data-resource-showing></p>}
        {filter && (
          <script is:inline>
            ;(function (root) {
              if (!root) return
              var group = root.querySelector('[data-resource-kinds]')
              var chips = group.querySelectorAll('[data-kind]')
              var cards = root.querySelectorAll('.res-cards > [data-kind]')
              var showing = root.querySelector('[data-resource-showing]')
              var choose = function (chip) {
                var kind = chip.getAttribute('data-kind')
                var shown = 0
                for (var c = 0; c < chips.length; c++) chips[c].setAttribute('aria-pressed', chips[c] === chip ? 'true' : 'false')
                for (var i = 0; i < cards.length; i++) {
                  var match = !kind || cards[i].getAttribute('data-kind') === kind
                  cards[i].hidden = !match
                  if (match) shown++
                }
                showing.textContent = shown === cards.length ? 'Showing all ' + cards.length + '.' : 'Showing ' + shown + ' of ' + cards.length + '.'
              }
              for (var c = 0; c < chips.length; c++) {
                chips[c].addEventListener('click', function (event) {
                  choose(event.currentTarget)
                })
              }
              group.hidden = false
            })(document.currentScript.closest('[data-resources]'))
          </script>
        )}
      </div>
    )}
  </Band>
)}

<style>
  .res-intro > :global(.lede) {
    margin: -0.5rem 0 1.75rem;
  }
  .res-intro:last-child > :global(.lede) {
    margin-bottom: 0;
  }
  .res-kinds {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .res-kinds[hidden],
  .res-card[hidden] {
    display: none;
  }
  .res-kinds button {
    min-height: 2.75rem;
    padding: 0.375rem 0.875rem;
    border: 1.5px solid color-mix(in srgb, var(--ink) 25%, transparent);
    border-radius: var(--pill);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }
  .res-kinds button:hover {
    border-color: var(--ink);
  }
  .res-kinds button[aria-pressed='true'] {
    border-color: var(--button);
    background: var(--button);
    color: var(--button-ink);
  }
  .res-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .res-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.375rem;
    min-width: 0;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .res-card > * {
    margin: 0;
  }
  .res-card-kind {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .res-card .res-card-title {
    font-size: var(--text);
    font-weight: 700;
    line-height: 1.3;
  }
  .res-card-title a {
    color: var(--ink);
    text-decoration: none;
  }
  /* The title's link covers the card. */
  .res-card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  .res-card-title a:focus-visible {
    outline: none;
  }
  .res-card-linked:hover .res-card-title a {
    text-decoration: underline;
  }
  .res-card-linked:focus-within {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
  .res-card-detail {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.4;
  }
  .res-card > .res-card-chip {
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .res-card-chip .chip {
    white-space: normal;
  }
  @media (min-width: 40rem) {
    .res-cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
    .res-card {
      padding: 1.25rem;
    }
    .res-card .res-card-title {
      font-size: 1.0625rem;
    }
  }
  @media (min-width: 60rem) {
    .res-cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
</style>
