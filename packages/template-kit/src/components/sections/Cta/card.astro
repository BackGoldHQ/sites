---
// Cta, 'card' layout (board C8's Join; A4's, A6's and C5's sidebar): the
// eyebrow, the heading, the line of copy and up to two buttons (the donate
// link first, the rest outlines) on one card. In the page's column it is one
// raised card centred on the band, on the band's card colour, its words and
// buttons centred; a page that opens with it draws no title band over it
// (PageSections: the card's heading is what the page says first). In a
// sidebar the section itself is the card, on the brand's ground (site.css),
// and the words sit at the left. A donate link goes to the organization's
// own donate page in BackGold, exactly as given: never rebuild it on this
// site.
import type { ComponentProps } from 'astro/types'
import Band from '../Band.astro'
import Prose from '../../Prose.astro'
import type Default from './index.astro'
import { links } from '../../../lib/section'
import { text } from '../../../lib/format'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const eyebrow = text(section.copy.eyebrow)
const heading = text(section.copy.heading)
const buttons = links(section)
---
<Band section={section} class="cta cta-card">
  <div class="cta-card-box">
    {eyebrow && <p class="kicker">{eyebrow}</p>}
    {heading && <h2>{heading}</h2>}
    <Prose value={section.copy.body} class="lede" />
    {buttons.length > 0 && (
      <p class="actions">
        {buttons.map((link, i) => <a class:list={['button', i > 0 && 'button-quiet']} href={link.href} rel={link.rel}>{link.label}</a>)}
      </p>
    )}
  </div>
</Band>

<style>
  .cta-card-box {
    max-width: 47.5rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem) clamp(1.375rem, 0.9rem + 2vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow);
    text-align: center;
  }
  .cta-card-box > * {
    margin: 0;
  }
  .cta-card-box h2 {
    font-size: clamp(2.25rem, 1.5rem + 2.6vw, 4rem);
    line-height: 0.98;
  }
  .cta-card-box .kicker + h2 {
    margin-top: 0.75rem;
  }
  .cta-card-box > :global(.lede) {
    margin: 1rem auto 0;
  }
  .cta-card-box .actions {
    justify-content: center;
    margin-top: 1.625rem;
  }
  :global(.rail) .cta-card-box {
    max-width: none;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    text-align: left;
  }
  :global(.rail) .cta-card-box h2 {
    font-size: var(--h3);
    line-height: 1.15;
  }
  :global(.rail) .cta-card-box > :global(.lede) {
    margin: 0.5rem 0 0;
    font-size: var(--text);
  }
  :global(.rail) .cta-card-box .actions {
    justify-content: flex-start;
    margin-top: 1rem;
  }
</style>
