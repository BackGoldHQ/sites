---
// Progress, 'match' layout (board 09, B "Match deadline"): one raised card on
// the band's surface. At the left, the kicker as an accent chip (else, when
// the section sets a multiplier, "2× match"), the heading, the bar at the
// share of the goal raised and the figures under it, as BackGold last counted
// them when the page was published. At the right (under it, below 56rem), the
// time left until the match ends as four tiles, days, hours, minutes and
// seconds, and the one button, the section's donate link under its own label.
// Pages are cached until content changes, so the server writes the end of
// the match and a few lines of script count it down each second in the
// visitor's browser; once it has passed the tiles give way to "The match has
// ended" and the chip ("2× match active") goes. Without script the end reads plainly ("Ends Sunday, October 18,
// 2026 at 11:59 PM"). The clock (MatchClock.astro) is drawn only for an end
// that is a date.
// Nothing is drawn without a raised figure.
import type { ComponentProps } from 'astro/types'
import Band from '../Band.astro'
import type Default from './index.astro'
import { links, rows } from '../../../lib/section'
import { formatCents, formatWhen, text } from '../../../lib/format'
import MatchClock from './MatchClock.astro'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const [row] = rows(section)
const raised = typeof row?.raised_cents === 'number' ? row.raised_cents : null
const goal = typeof row?.goal_cents === 'number' && row.goal_cents > 0 ? row.goal_cents : null
const percent = raised !== null && goal !== null ? Math.min(100, Math.round((raised / goal) * 100)) : null
const multiplier = section.options?.matchMultiplier
const times = typeof multiplier === 'number' && Number.isInteger(multiplier) && multiplier >= 2 && multiplier <= 10 ? multiplier : null
const chip = text(section.copy.kicker) ?? (times !== null ? `${times}× match` : null)
const heading = text(section.copy.heading)
const [give] = links(section)
const until = text(section.options?.matchUntil)?.trim() ?? null
const ends = until !== null && !Number.isNaN(Date.parse(until)) ? formatWhen(until) : null
---
{raised !== null && (
  <Band section={section} class="progress progress-match">
    <div class:list={['match', (ends || give) && 'match-split']}>
      <div class="match-main">
        {chip && <p class="chip chip-accent match-chip" data-match-chip>{chip}</p>}
        {heading && <h2 class="match-heading">{heading}</h2>}
        {percent !== null && (
          <div class="meter match-meter" role="img" aria-label={`${percent}% of the goal`}>
            <span class="meter-fill" style={`width:${percent}%`}></span>
          </div>
        )}
        <p class="match-figures">
          <strong class="match-raised">{formatCents(raised)}</strong> raised
          {goal !== null && <span> of a {formatCents(goal)} goal</span>}
        </p>
      </div>
      {(ends || give) && (
        <div class="match-side">
          {ends && until && <MatchClock until={until} ends={ends} />}
          {give && <a class="button match-give" href={give.href} rel={give.rel}>{give.label}</a>}
        </div>
      )}
    </div>
  </Band>
)}

<style>
  .match {
    display: grid;
    gap: 1.75rem;
    padding: clamp(1.375rem, 1rem + 1.5vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .match-main {
    min-width: 0;
  }
  .match-main > :last-child {
    margin-bottom: 0;
  }
  .match-chip[hidden] {
    display: none;
  }
  .match-chip {
    margin: 0 0 0.875rem;
    text-transform: uppercase;
  }
  .match-heading {
    margin: 0;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.125rem);
  }
  .match-meter {
    height: 1.125rem;
    margin: 1.25rem 0 0.875rem;
  }
  .match-figures {
    margin: 0;
    font-size: var(--text-lg);
  }
  .match-heading + .match-figures {
    margin-top: 1rem;
  }
  .match-raised {
    font-family: var(--font-display);
    font-size: 1.25em;
    font-weight: 800;
    font-variant-numeric: lining-nums;
    letter-spacing: -0.01em;
  }
  .match-side {
    display: grid;
    gap: 0.875rem;
    min-width: 0;
  }
  .match-give {
    display: flex;
    width: 100%;
    font-size: var(--text);
  }
  @media (min-width: 56rem) {
    .match-split {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 2.5rem;
      align-items: center;
    }
  }
</style>
