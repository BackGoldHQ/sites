---
// BackGold's own module (donate, a form, a sign-up, a petition, an event's
// RSVP and tickets, the store, the calendar, a poll, contacting legislators)
// as the boards draw it "first-party, in the site's tokens" (A7–A12): the
// module's frame, asked to wear this site (BackGold's embed look: the section's
// layout, the colours where it sits, light and dark, the radius and the type)
// so it draws no ground, card, heading or platform footer of its own. The
// face is the template's `frameFont` when it is one the embed look accepts
// (FRAME_FONTS), read from `Astro.locals.template` (the routes set it);
// where that is unset, Public Sans, as it is for a template that names none.
// An unknown value is never sent:
// the api drops a look with a malformed `font` as a whole. The corners are
// the template's `frameRadius` (a whole number of pixels, 0 to 40, the embed look's bounds), else 12,
// read the same way. The colours are the band's through the template's
// `frameColors` when it has one, and a template with `frameSkin` asks the
// frame to load its stylesheet (`skin`, the site's own https origin, where the
// template serves /_backgold/frame.css), read the same way. The
// site credits BackGold once, as "Powered by BackGold" in the footer's bottom
// row, never per module.
//
// The fields, limits, receipts, consent and every write stay BackGold's, in
// its frame: nothing here builds, covers or imitates a field. `card` sets the
// module on a raised card (its frame then sits on the card colour, the panel
// band's); without it the module sits straight on the section's band. The
// default slot is drawn inside the card above the module (a form's title).
// Advocacy has no frame, only a container its script fills: it is placed as
// BackGold sends it.
//
// `params` adds the frame's own options to its address beside the look, the
// allowlisted keys only (FRAME_PARAMS: `text`, `full` or `collapsed`, a
// petition sheet's text drawn whole or as a closed disclosure); any other key
// or value is never sent.
//
// A Donate frame also carries the page address's donate names (an ask
// amount, a donate place, `utm_*`, lib/donate-frame.ts) that its address from
// BackGold does not already name; a form frame carries the page's `pick`,
// the choice it opens on (lib/donate-frame.ts withPickQuery).
//
// A section BackGold sends with no embed has nothing to frame (no donation
// form for the organization, no petition picked, an event no longer public):
// it draws one line saying the module is not available, where the module
// would be, never nothing, in the words a hosted BackGold page uses for a
// donate module with no form.
import type { SectionEmbed } from '@backgold/content'
import { Embed } from '@backgold/astro/components'
import { SECTION_BANDS, appearanceOf, moduleLook, type SectionBand } from '../../../lib/brand'
import { isDonateFrame, isFormFrame, withDonateQuery, withPickQuery } from '../../../lib/donate-frame'

interface Props {
  /** The section's (or the event page's) embed, as BackGold sends it. */
  embed: SectionEmbed | null | undefined
  /** The ground the module sits on when it has no card: the section's band. */
  band: string
  /** The module's type, kept as `data-module`. */
  type: string
  /** The layout the frame arranges itself for (the section's, else the type's default). */
  layout: string
  card?: boolean
  /** The frame's accessible name. */
  title: string
  /** How tall the frame starts before it reports its own height. */
  height?: string
  class?: string
  /** The frame's own options, appended to its address (FRAME_PARAMS keys and values only). */
  params?: Record<string, string>
}

const { embed: sent, band: sectionBand, type, layout, card = false, title, height = '32rem', class: className, params = {} } = Astro.props
/** The frame options a template may send, each with the values the frame takes. */
const FRAME_PARAMS: Record<string, readonly string[]> = { text: ['full', 'collapsed'] }
const bg = Astro.locals.backgold
const brand = bg.setup === null ? bg.site.brand : null
const theme = bg.setup === null ? bg.site.theme : null
const appearance = bg.setup === null ? appearanceOf(bg.site.style) : 'auto'
/** The faces BackGold's embed look accepts (the api's EMBED_LOOK_FONTS). */
const FRAME_FONTS = ['public-sans', 'inter', 'system-sans', 'system-serif', 'ubuntu-sans-mono', 'jetbrains-mono']
const frameFont = Astro.locals.template?.frameFont
const font = frameFont && FRAME_FONTS.includes(frameFont) ? frameFont : 'public-sans'
const frameRadius = Astro.locals.template?.frameRadius
const radius = typeof frameRadius === 'number' && Number.isInteger(frameRadius) && frameRadius >= 0 && frameRadius <= 40 ? frameRadius : 12
/** The site's own https origin for a template that serves the frames its stylesheet; null otherwise (an http dev server cannot be one). */
function skinOrigin(): string | null {
  if (!Astro.locals.template?.frameSkin) return null
  const site = bg.setup === null && bg.siteUrl ? bg.siteUrl : Astro.url.origin
  try {
    const url = new URL(site)
    return url.protocol === 'https:' ? url.origin : null
  } catch {
    return null
  }
}
const skin = skinOrigin()
const band: SectionBand = card ? 'panel' : SECTION_BANDS.includes(sectionBand as SectionBand) ? (sectionBand as SectionBand) : 'plain'

/** The module's address with the look query (and a Donate frame's donate names), or as sent when it is not one we can read. */
function framed(iframe: string | null): string | null {
  if (!iframe) return iframe
  let url: URL
  try {
    url = new URL(iframe)
  } catch {
    return iframe
  }
  if (isDonateFrame(type)) withDonateQuery(url, Astro.url.searchParams)
  if (isFormFrame(type)) withPickQuery(url, Astro.url.searchParams)
  url.searchParams.set('layout', layout)
  for (const [key, value] of Object.entries(moduleLook(brand, band, appearance, theme, Astro.locals.template?.frameColors ?? null))) url.searchParams.set(key, value)
  url.searchParams.set('radius', String(radius))
  url.searchParams.set('font', font)
  if (skin) url.searchParams.set('skin', skin)
  for (const [key, value] of Object.entries(params)) if (Object.hasOwn(FRAME_PARAMS, key) && FRAME_PARAMS[key]!.includes(value)) url.searchParams.set(key, value)
  return url.toString()
}

const embed = sent ? { ...sent, iframe: framed(sent.iframe) } : null
/** The frame's name as words: a heading's starred word (`*helps*`, a template's marked word) without its stars. */
const name = title.replace(/\*([^*\n]+)\*/g, '$1')
const hasHead = Astro.slots.has('default')

/** What a visitor reads where a module with nothing to frame would be. */
const UNAVAILABLE: Record<string, string> = {
  Donate: 'Online donations are not available right now.',
  FormBlock: 'This form is not available right now.',
  PollBlock: 'This poll is not available right now.',
  SignupCapture: 'Signing up is not available right now.',
  Petition: 'This petition is not available right now.',
  Store: 'The store is not available right now.',
  Event: 'This event is not available right now.',
  Calendar: 'The calendar is not available right now.',
  Advocacy: 'Contacting your legislators is not available right now.',
}
const unavailable = UNAVAILABLE[type] ?? 'This is not available right now.'
---
{embed ? (
  <div class:list={['module', card && 'module-card', className]} data-module={type} style={`--bg-embed-height:${height}`}>
    {hasHead && <div class="module-head"><slot /></div>}
    <Embed embed={embed} title={name} />
  </div>
) : (
  <div class:list={['module', 'module-unavailable', card && 'module-card', className]} data-module={type} data-module-unavailable>
    {hasHead && <div class="module-head"><slot /></div>}
    <p class="module-unavailable-line">{unavailable}</p>
  </div>
)}

<style>
  .module {
    min-width: 0;
  }
  .module-card {
    padding: clamp(1.25rem, 1rem + 0.8vw, 1.75rem);
    border: 1px solid var(--band-panel-line);
    border-radius: var(--radius-card);
    background: var(--band-panel);
    color: var(--band-panel-ink);
    box-shadow: var(--shadow);
  }
  .module-head :global(h3) {
    margin: 0 0 0.875rem;
    font-size: var(--h3);
    font-weight: 600;
  }
  .module-unavailable-line {
    margin: 0;
    padding: 1rem 1.125rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-card);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .module-card .module-unavailable-line {
    padding: 0;
    border: 0;
  }
  .module :global(.bg-embed) {
    display: block;
    width: 100%;
    background: transparent;
    color-scheme: light dark;
  }
</style>
