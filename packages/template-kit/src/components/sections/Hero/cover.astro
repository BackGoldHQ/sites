---
// Hero, 'cover' layout (Full photo; board A1-home, section 1, and A13): the
// photo fills the band edge to edge and the kicker, the headline, the line
// under it and the buttons sit over its lower edge on a fixed scrim (A1 note
// 2: legibility is not a taste, there is no overlay option), in the photo
// band's inks so they read on any photo. The headline's last word is set in
// the accent, in italic (A1's "Fewer *excuses.*"): the contract carries no
// mark for it, so the template takes the last word. The photo's alt text is
// `copy.imageAlt`, and its caption, when the section carries one
// (`copy.caption`), sits at the photo's lower left. The first button is the
// main call, the rest outlines. Without a photo it draws the same words on
// the section's own band, with no caption. The page-opening
// Hero's headline is the page's <h1> (`level={1}`); any other Hero's is an
// <h2>. A Hero with its signup form on carries an `embed`: BackGold's own
// form, framed under the buttons.
import type { ComponentProps } from 'astro/types'
import { Embed } from '@backgold/astro/components'
import Band from '../Band.astro'
import type Default from './index.astro'
import { heroPhoto, links } from '../../../lib/section'
import { text } from '../../../lib/format'

type Props = ComponentProps<typeof Default>

const { section, level = 2 } = Astro.props
const Heading = level === 1 ? 'h1' : 'h2'
const kicker = text(section.copy.kicker)
const headline = text(section.copy.headline)?.trim() ?? null
const subheadline = text(section.copy.subheadline)
const caption = text(section.copy.caption)
const picture = heroPhoto(section, 'imageUrl', 'photoUrl', 'videoPosterUrl')
const buttons = links(section)
// "More freedom. Fewer " and "excuses.": the last word apart, for the accent.
const split = headline ? /^(.*\s)(\S+)$/su.exec(headline) : null
const [lead, last] = split ? [split[1]!, split[2]!] : [headline ?? '', null]
---
<Band section={section} class:list={['hero-cover', picture && 'hero-cover-photo']}>
  {picture && (
    <>
      <img
        class="cover-image"
        src={picture.url}
        alt={picture.alt}
        loading={level === 1 ? 'eager' : 'lazy'}
        fetchpriority={level === 1 ? 'high' : undefined}
        decoding="async"
      />
      <div class="cover-scrim" aria-hidden="true"></div>
      {caption && <p class="cover-caption">{caption}</p>}
    </>
  )}
  <div class:list={['cover-words', picture && 'on-photo']}>
    {kicker && <p class="kicker">{kicker}</p>}
    {headline && <Heading class="cover-headline">{lead}{last && <em>{last}</em>}</Heading>}
    {subheadline && <p class="cover-lede">{subheadline}</p>}
    {buttons.length > 0 && (
      <p class="actions">
        {buttons.map((link, i) => <a class:list={['button', i > 0 && 'button-quiet']} href={link.href} rel={link.rel}>{link.label}</a>)}
      </p>
    )}
    {section.embed && <Embed embed={section.embed} title="Sign up" />}
  </div>
</Band>

<style>
  /* The band itself: the photo's frame. Band.astro renders it, so it is reached through its class. */
  :global(.bg-section.hero-cover-photo) {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    min-height: 32.5rem;
    --bg-section-padding: var(--space) var(--gutter) clamp(2.25rem, 1.5rem + 2.5vw, 4rem);
  }
  :global(.bg-section.hero-cover-photo) > :global(.bg-section-inner) {
    width: 100%;
  }
  /* The photo is not the band's ground: the band after it keeps its own top padding. */
  :global(.bg-section.bg-bleed-full.hero-cover-photo + .bg-section.bg-bleed-full) {
    padding-top: var(--space);
  }

  .cover-image {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
  /* A1's scrim: light at the top, deep where the words are, so they read on any photo. */
  .cover-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--band-photo) 10%, transparent) 0%,
      color-mix(in srgb, var(--band-photo) 35%, transparent) 30%,
      color-mix(in srgb, var(--band-photo) 80%, transparent) 62%,
      color-mix(in srgb, var(--band-photo) 92%, transparent) 100%
    );
  }
  .cover-caption {
    position: absolute;
    left: 0.75rem;
    bottom: 0.625rem;
    z-index: 1;
    max-width: calc(100% - 1.5rem);
    margin: 0;
    padding: 0.1875rem 0.5rem;
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--band-photo) 70%, transparent);
    color: var(--band-photo-ink);
    font-size: 0.6875rem;
    line-height: 1.4;
  }

  .cover-words .kicker {
    margin-bottom: 0.875rem;
  }
  .cover-headline {
    font-size: clamp(2.75rem, 1.4rem + 4.9vw, 5.25rem);
    font-weight: 800;
    line-height: 0.96;
    letter-spacing: -0.03em;
    max-width: 11em;
    margin: 0;
  }
  .cover-headline em {
    font-style: italic;
    font-weight: 500;
    color: var(--accent);
  }
  .cover-lede {
    font-size: var(--text-lg);
    color: var(--muted);
    max-width: 34em;
    margin: 1.375rem 0 0;
  }
  .on-photo .cover-lede {
    color: color-mix(in srgb, var(--ink) 92%, transparent);
  }
  .cover-words .actions {
    margin-top: 1.875rem;
  }
  .cover-words > :global(.bg-embed) {
    margin-top: 1.5rem;
  }
  @media (min-width: 48rem) {
    :global(.bg-section.hero-cover-photo) {
      min-height: 37.5rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .cover-headline,
    .cover-lede {
      animation: cover-rise 0.4s ease-out both;
    }
  }
  /* A1's motion note: the headline and lede rise 12px and fade in once on load. */
  @keyframes cover-rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
  /* The kicker reads in the photo band's full ink, not the accent: over a bright
     sky the accent (a light blue in both modes) fades where the scrim is still
     thin (A1 note 2: legibility is not a taste). */
  .cover-words.on-photo .kicker {
    color: var(--band-photo-ink);
  }
</style>
