---
// Hero, 'video' layout (REPORT §3 Hero, "Video background"): the cover with
// one thing moving. Here it is a muted loop (`media.videoUrl`) filling the
// band edge to edge, with the photo as its poster and the cover's scrim, kicker,
// headline (its last word in the accent), line, buttons and signup frame over
// it in the photo band's inks. The video is decoration: hidden from assistive
// technology, no sound, no native controls, playing by the browser's own
// autoplay with no script. Its poster is also drawn as an image under it, so
// `prefers-reduced-motion: reduce` hides the video (its source is not even
// fetched then) and leaves the photo. With script a small Pause button sits
// in the band's top right corner (WCAG 2.2.2: motion that runs on gets a
// way to stop it).
//
// The rotating layout draws through this file too (rotating.astro passes the
// Hero's `words`): the headline's last word gives way to each word in turn,
// on the cover's photo, never over a video, so one thing moves at a time.
// The first word is in the HTML and the <h1>'s text; the turning word is
// hidden from assistive technology and the heading's `aria-label` holds the
// headline with the first word, so its name never changes under a reader.
// An inline island turns the words every 3 s with a short fade (the word is
// held at the widest one's width, so the headline never reflows), and the
// same corner button pauses them; under reduced motion they never turn.
//
// The photo's alt text is `copy.imageAlt`; the caption (`copy.caption`) sits
// at the frame's lower left, and with no photo or video there is none.
// Without a video (and without words) this is exactly the cover. The
// page-opening Hero's headline is the page's <h1> (`level={1}`); any other
// Hero's is an <h2>. A Hero with its signup form on carries an `embed`:
// BackGold's own form, framed under the buttons.
import type { ComponentProps } from 'astro/types'
import ModuleFrame from '../modules/ModuleFrame.astro'
import Band from '../Band.astro'
import Cover from './cover.astro'
import type Default from './index.astro'
import { heroPhoto, links, media } from '../../../lib/section'
import { text } from '../../../lib/format'

type Props = ComponentProps<typeof Default> & {
  /** The rotating layout's words, the first shown without script; none for the video layout. */
  words?: string[]
}

const { section, level = 2, words = [] } = Astro.props
const turning = words.length > 0
const video = turning ? null : media(section, 'videoUrl')
// The video's own poster frame first, so nothing jumps when the loop starts.
const picture = video ? heroPhoto(section, 'videoPosterUrl', 'imageUrl', 'photoUrl') : heroPhoto(section, 'imageUrl', 'photoUrl', 'videoPosterUrl')
const framed = video !== null || picture !== null
const Heading = level === 1 ? 'h1' : 'h2'
const kicker = text(section.copy.kicker)
const headline = text(section.copy.headline)?.trim() ?? null
const subheadline = text(section.copy.subheadline)
const caption = text(section.copy.caption)
const buttons = links(section)
// "More freedom. Fewer " and "excuses.": the last word apart, for the accent
// (or, rotating, for the words that take its place; a one-word headline is
// replaced whole).
const split = headline ? /^(.*\s)(\S+)$/su.exec(headline) : null
const [lead, last] = split ? [split[1]!, split[2]!] : turning ? ['', null] : [headline ?? '', null]
const moving = video !== null || words.length > 1
const what = video ? 'background video' : 'changing words'
---
{!video && !turning ? (
  <Cover {...Astro.props} />
) : (
  <Band section={section} class:list={['hero-motion', framed && 'hero-motion-frame']}>
    {picture && (
      <img
        class="motion-image"
        src={picture.url}
        alt={picture.alt}
        loading={level === 1 ? 'eager' : 'lazy'}
        fetchpriority={level === 1 ? 'high' : undefined}
        decoding="async"
      />
    )}
    {video && (
      <video
        class="motion-video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={picture?.url}
        aria-hidden="true"
        tabindex="-1"
        disablepictureinpicture
      >
        <source src={video.url} media="(prefers-reduced-motion: no-preference)" />
      </video>
    )}
    {framed && <div class="motion-scrim" aria-hidden="true"></div>}
    {framed && caption && <p class="motion-caption">{caption}</p>}
    <div class:list={['motion-words', framed && 'on-photo', moving && !framed && 'motion-words-clear']}>
      {kicker && <p class="kicker">{kicker}</p>}
      {headline && (
        turning ? (
          <Heading class="motion-headline" aria-label={`${lead}${words[0]}`}>
            {lead}<em class="motion-turn" aria-hidden="true" data-words={words.length > 1 ? JSON.stringify(words) : undefined}><span class="motion-turn-word">{words[0]}</span></em>
          </Heading>
        ) : (
          <Heading class="motion-headline">{lead}{last && <em>{last}</em>}</Heading>
        )
      )}
      {subheadline && <p class="motion-lede">{subheadline}</p>}
      {buttons.length > 0 && (
        <p class="actions">
          {buttons.map((link, i) => <a class:list={['button', i > 0 && 'button-quiet']} href={link.href} rel={link.rel}>{link.label}</a>)}
        </p>
      )}
      {section.embed && <ModuleFrame embed={section.embed} band={section.band} type="SignupCapture" layout="card" title="Sign up" height="24rem" class="hero-signup" />}
    </div>
    {moving && (
      <>
        <button type="button" class:list={['motion-toggle', framed && 'motion-toggle-framed']} data-motion-toggle data-what={what} hidden>
          <svg class="motion-icon motion-icon-pause" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 3h3v10H4zM9 3h3v10H9z" /></svg>
          <svg class="motion-icon motion-icon-play" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M5 3l8 5-8 5z" /></svg>
          <span class="visually-hidden" data-motion-label>Pause the {what}</span>
        </button>
        <script is:inline>
          ;(function () {
            var toggle = document.currentScript && document.currentScript.previousElementSibling
            if (!toggle || !toggle.hasAttribute('data-motion-toggle')) return
            var band = toggle.closest('.bg-section')
            var video = band && band.querySelector('video')
            var turn = band && band.querySelector('[data-words]')
            var label = toggle.querySelector('[data-motion-label]')
            var what = toggle.getAttribute('data-what')
            var reduce = window.matchMedia('(prefers-reduced-motion: reduce)')
            var words = []
            var word = turn && turn.firstElementChild
            var at = 0
            var timer = null
            var paused = false
            var inView = true

            // The words: one span whose text changes, so the heading's text
            // is only ever the headline as shown. It is held at the widest
            // word's width (measured again once the faces load and when the
            // window changes size), so the headline never reflows as they turn.
            if (turn) {
              try {
                words = JSON.parse(turn.getAttribute('data-words') || '[]')
              } catch (e) {}
              if (!word || words.length < 2) return
              var hold = function () {
                var widest = 0
                turn.style.minWidth = ''
                for (var i = 0; i < words.length; i++) {
                  word.textContent = words[i]
                  widest = Math.max(widest, word.getBoundingClientRect().width)
                }
                word.textContent = words[at]
                turn.style.minWidth = Math.ceil(widest) + 'px'
              }
              hold()
              if (document.fonts && document.fonts.ready) document.fonts.ready.then(hold)
              window.addEventListener('resize', hold)
            }
            if (!video && words.length < 2) return

            function step() {
              turn.classList.add('is-turning')
              setTimeout(function () {
                at = (at + 1) % words.length
                word.textContent = words[at]
                turn.classList.remove('is-turning')
              }, 250)
            }
            function moving() {
              return !paused && !reduce.matches && inView && !document.hidden
            }
            function run() {
              var go = moving()
              if (turn) {
                if (go && !timer) timer = setInterval(step, 3000)
                if (!go && timer) {
                  clearInterval(timer)
                  timer = null
                }
              }
              if (video) {
                if (go && video.paused && video.currentSrc) video.play().catch(function () {})
                if (!go && !video.paused) video.pause()
              }
              toggle.hidden = reduce.matches || (video ? !video.currentSrc : false)
              toggle.setAttribute('data-paused', paused ? 'true' : 'false')
              label.textContent = (paused ? 'Play the ' : 'Pause the ') + what
            }

            toggle.addEventListener('click', function () {
              paused = !paused
              run()
            })
            if (reduce.addEventListener) reduce.addEventListener('change', run)
            document.addEventListener('visibilitychange', run)
            if (video) {
              video.addEventListener('loadedmetadata', run)
              // The browser's autoplay may start after the hero was found off screen or paused.
              video.addEventListener('play', function () {
                if (!moving()) video.pause()
              })
            }
            if ('IntersectionObserver' in window) {
              new IntersectionObserver(function (entries) {
                inView = entries[0].isIntersecting
                run()
              }).observe(band)
            }
            run()
          })()
        </script>
      </>
    )}
  </Band>
)}

<style>
  /* The band: placed for the corner button; with a photo or a video, their frame, on the photo band's ground. */
  :global(.bg-section.hero-motion) {
    position: relative;
  }
  :global(.bg-section.hero-motion-frame) {
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    min-height: 32.5rem;
    background: var(--band-photo);
    --bg-section-padding: var(--space) var(--gutter) clamp(2.25rem, 1.5rem + 2.5vw, 4rem);
  }
  :global(.bg-section.hero-motion-frame) > :global(.bg-section-inner) {
    width: 100%;
  }
  /* A frame is not the band's ground: the band after it keeps its own top padding. */
  :global(.bg-section.bg-bleed-full.hero-motion-frame + .bg-section.bg-bleed-full) {
    padding-top: var(--space);
  }

  .motion-image,
  .motion-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
  .motion-image {
    z-index: -3;
  }
  .motion-video {
    z-index: -2;
  }
  /* The cover's scrim: light at the top, deep where the words are, so they read on any frame. */
  .motion-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--band-photo) 10%, transparent) 0%,
      color-mix(in srgb, var(--band-photo) 35%, transparent) 30%,
      color-mix(in srgb, var(--band-photo) 80%, transparent) 62%,
      color-mix(in srgb, var(--band-photo) 92%, transparent) 100%
    );
  }
  .motion-caption {
    position: absolute;
    left: 0.75rem;
    bottom: 0.625rem;
    z-index: 1;
    max-width: calc(100% - 1.5rem);
    margin: 0;
    padding: 0.1875rem 0.5rem;
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--band-photo) 70%, transparent);
    color: var(--band-photo-ink);
    font-size: 0.6875rem;
    line-height: 1.4;
  }

  /* Pause / play: in the band's top padding, clear of the words on any width. */
  .motion-toggle {
    position: absolute;
    top: 0.375rem;
    right: 0.375rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--bg-band-background);
    color: var(--ink);
    cursor: pointer;
  }
  .motion-toggle[hidden] {
    display: none;
  }
  .motion-toggle-framed {
    border-color: var(--band-photo-line-strong);
    background: color-mix(in srgb, var(--band-photo) 70%, transparent);
    color: var(--band-photo-ink);
  }
  .motion-icon {
    width: 0.875rem;
    height: 0.875rem;
    fill: currentColor;
  }
  .motion-toggle[data-paused='true'] .motion-icon-pause,
  .motion-toggle:not([data-paused='true']) .motion-icon-play {
    display: none;
  }

  /* On the band the corner button may meet the first line when the band above shares its ground (no top padding). */
  .motion-words-clear > :first-child {
    padding-right: 2.75rem;
  }
  .motion-words .kicker {
    margin-bottom: 0.875rem;
  }
  .motion-headline {
    font-size: clamp(2.75rem, 1.4rem + 4.9vw, 5.25rem);
    font-weight: 800;
    line-height: 0.96;
    letter-spacing: -0.03em;
    max-width: 11em;
    margin: 0;
  }
  .motion-headline em {
    font-style: italic;
    font-weight: 500;
    color: var(--accent);
  }
  /* The turning word: held at the widest word's width (the island sets it), fading out and in as it changes. */
  .motion-turn {
    display: inline-block;
    max-width: 100%;
  }
  .motion-turn-word {
    display: inline-block;
  }
  .is-turning .motion-turn-word {
    opacity: 0;
    transform: translateY(0.15em);
  }
  .motion-lede {
    font-size: var(--text-lg);
    color: var(--muted);
    max-width: 34em;
    margin: 1.375rem 0 0;
  }
  .on-photo .motion-lede {
    color: color-mix(in srgb, var(--ink) 92%, transparent);
  }
  .motion-words .actions {
    margin-top: 1.875rem;
  }
  .motion-words > :global(.hero-signup) {
    margin-top: 1.5rem;
  }
  @media (min-width: 48rem) {
    :global(.bg-section.hero-motion-frame) {
      min-height: 37.5rem;
    }
    .motion-toggle {
      top: 0.75rem;
      right: 0.75rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .motion-video {
      display: none;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .motion-headline,
    .motion-lede {
      animation: motion-rise 0.4s ease-out both;
    }
    .motion-turn-word {
      transition:
        opacity 0.25s ease,
        transform 0.25s ease;
    }
  }
  /* A1's motion note, as the cover has it: the headline and lede rise 12px and fade in once on load. */
  @keyframes motion-rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
</style>
