---
// Hero, 'field' layout ("Kindling"): the words centered over a field of dim,
// cool motes drawn on a canvas, through which fire moves the way an idea
// does: one mote catches, a pale wisp blooms, and it leaps to its nearest
// neighbours, which glow warm afterwards instead of burning out. The pointer
// kindles where it passes; left alone, the field kindles itself. The colours
// are the band's: the motes rest in a cool tint of the band's muted ink and
// warm to its accent, the wisps are its accent paled; so the field reads on
// whatever the organization's theme gives the band (it is drawn for a dark
// band, the contrast or brand band of a dark theme). It respects
// prefers-reduced-motion (one still frame, a few motes lit) and pauses when
// scrolled off-screen or the tab is hidden; with no JavaScript the words
// stand on the band alone.
//
// The words are the cover layout's: the kicker, the headline with its accent
// in italic (the part after a colon when the headline has one, else the last
// word), the line under it, the buttons (the first the main call, the rest
// outlines), under them whatever a template's own Hero · field passes in the
// default slot (the academy's proof line, its counts from the Content API),
// and `copy.note` as a small line ("Move through the field. Something
// catches."). The page-opening Hero's headline is the page's
// <h1> (`level={1}`); any other Hero's is an <h2>. A Hero with its signup
// form on carries an `embed`: BackGold's own form, framed under the buttons.
import type { ComponentProps } from 'astro/types'
import { Embed } from '@backgold/astro/components'
import Band from '../Band.astro'
import type Default from './index.astro'
import { links } from '../../../lib/section'
import { text } from '../../../lib/format'

type Props = ComponentProps<typeof Default>

const { section, level = 2 } = Astro.props
const Heading = level === 1 ? 'h1' : 'h2'
const kicker = text(section.copy.kicker)
const headline = text(section.copy.headline)?.trim() ?? null
const subheadline = text(section.copy.subheadline)
const note = text(section.copy.note)
const buttons = links(section)
// "Liberty spreads the way fire does: one mind at a time." → the clause after the colon in the accent; else the last word.
const colon = headline ? /^(.*?:\s+)(\S.*)$/su.exec(headline) : null
const split = colon ?? (headline ? /^(.*\s)(\S+)$/su.exec(headline) : null)
const [lead, last] = split ? [split[1]!, split[2]!] : [headline ?? '', null]
---
<Band section={section} class="hero-field">
  <canvas class="field-canvas" aria-hidden="true"></canvas>
  <div class="field-words">
    {kicker && <p class="kicker">{kicker}</p>}
    {headline && <Heading class="field-headline">{lead}{last && <em>{last}</em>}</Heading>}
    {subheadline && <p class="field-lede">{subheadline}</p>}
    {buttons.length > 0 && (
      <p class="actions">
        {buttons.map((link, i) => <a class:list={['button', i > 0 && 'button-quiet']} href={link.href} rel={link.rel}>{link.label}</a>)}
      </p>
    )}
    <slot />
    {note && <p class="field-note">{note}</p>}
    {section.embed && <Embed embed={section.embed} title="Sign up" />}
  </div>
  <script is:inline>
    ;(function (root) {
      var canvas = root && root.querySelector('canvas.field-canvas')
      if (!canvas || !canvas.getContext) return
      var ctx = canvas.getContext('2d', { alpha: true })
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      var DPR = Math.min(window.devicePixelRatio || 1, 1.5)
      // The band's colours: the motes rest cool (the muted ink toward blue) and warm to the accent; the wisps are the accent paled.
      var style = getComputedStyle(root)
      var parse = function (value, fallback) {
        var probe = document.createElement('span')
        probe.style.color = value
        root.appendChild(probe)
        var m = /rgba?\((\d+),\s*(\d+),\s*(\d+)/.exec(getComputedStyle(probe).color)
        root.removeChild(probe)
        return m ? [+m[1], +m[2], +m[3]] : fallback
      }
      var ACCENT = parse(style.getPropertyValue('--accent') || '', [255, 179, 92])
      var MUTED = parse(style.getPropertyValue('--muted') || '', [140, 140, 160])
      var mix = function (a, b, t) {
        return [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t]
      }
      var COOL = mix(MUTED, [122, 140, 255], 0.55)
      var WARM = mix(ACCENT, [255, 190, 110], 0.35)
      var PALE = mix(ACCENT, [255, 255, 255], 0.72)
      var rgba = function (c, a) {
        return 'rgba(' + (c[0] | 0) + ',' + (c[1] | 0) + ',' + (c[2] | 0) + ',' + a + ')'
      }
      var W = 0, H = 0, motes = [], sparks = [], wisps = []
      var pointer = { x: -1e4, y: -1e4, t: 0 }
      var running = false, lastAuto = 0, lastPointer = 0
      function resize() {
        var r = root.getBoundingClientRect()
        W = Math.max(1, Math.floor(r.width))
        H = Math.max(1, Math.floor(r.height))
        canvas.width = Math.floor(W * DPR)
        canvas.height = Math.floor(H * DPR)
        canvas.style.width = W + 'px'
        canvas.style.height = H + 'px'
        ctx.setTransform(DPR, 0, 0, DPR, 0, 0)
        seed()
      }
      // A resize seeds a new field: the sparks and wisps of the old one name motes it no longer has, so they go with it.
      function seed() {
        var n = Math.round(Math.min(220, Math.max(70, (W * H) / 4200)))
        motes = []
        sparks = []
        wisps = []
        for (var i = 0; i < n; i++) {
          motes.push({ x: Math.random() * W, y: Math.random() * H, r: 1.1 + Math.random() * 1.9, base: 0.2 + Math.random() * 0.3, heat: 0, warm: 0, ph: Math.random() * Math.PI * 2, sp: 0.15 + Math.random() * 0.35, lastLit: -1e9 })
        }
      }
      function kindle(i, now, strength) {
        var m = motes[i]
        if (!m || now - m.lastLit < 1400) return
        m.heat = Math.max(m.heat, strength || 1)
        m.lastLit = now
        wisps.push({ x: m.x, y: m.y, t0: now, life: 1400 + Math.random() * 900, size: 16 + Math.random() * 18 })
        var R = 120, leaps = 0
        for (var j = 0; j < motes.length && leaps < 4; j++) {
          if (j === i) continue
          var n = motes[j], dx = n.x - m.x, dy = n.y - m.y, d2 = dx * dx + dy * dy
          if (d2 < R * R && now - n.lastLit > 1400 && Math.random() < 0.55) {
            sparks.push({ from: i, to: j, t0: now, dur: 260 + Math.sqrt(d2) * 3 })
            leaps++
          }
        }
      }
      function nearest(x, y) {
        var best = -1, bd = 1e12
        for (var i = 0; i < motes.length; i++) {
          var dx = motes[i].x - x, dy = motes[i].y - y, d = dx * dx + dy * dy
          if (d < bd) { bd = d; best = i }
        }
        return bd < 70 * 70 ? best : -1
      }
      function drawWisp(w, now) {
        var t = (now - w.t0) / w.life
        if (t >= 1) return false
        var a = t < 0.2 ? t / 0.2 : 1 - (t - 0.2) / 0.8
        var s = w.size * (0.6 + 0.6 * Math.sin(t * Math.PI))
        var x = w.x + Math.sin(now / 300 + w.t0) * 2, y = w.y - t * 26
        var g = ctx.createRadialGradient(x, y + s * 0.15, 0, x, y, s)
        g.addColorStop(0, rgba(PALE, 0.75 * a))
        g.addColorStop(0.35, rgba(WARM, 0.45 * a))
        g.addColorStop(0.7, rgba(COOL, 0.12 * a))
        g.addColorStop(1, 'rgba(0,0,0,0)')
        ctx.fillStyle = g
        ctx.beginPath()
        ctx.ellipse(x, y, s * 0.55, s, 0, 0, Math.PI * 2)
        ctx.fill()
        return true
      }
      // One frame of the field. A draw that throws costs that frame only: the next is asked for whatever happens, while the field runs.
      function frame(now) {
        if (!running) return
        try {
          draw(now)
        } finally {
          requestAnimationFrame(frame)
        }
      }
      function draw(now) {
        ctx.clearRect(0, 0, W, H)
        if (now - pointer.t < 1200 && now - lastPointer > 140) {
          var p = nearest(pointer.x, pointer.y)
          if (p >= 0) { kindle(p, now, 1); lastPointer = now }
        }
        if (now - pointer.t > 2500 && now - lastAuto > 900 + Math.random() * 900) {
          kindle(Math.floor(Math.random() * motes.length), now, 0.9)
          lastAuto = now
        }
        ctx.lineWidth = 1
        for (var k = sparks.length - 1; k >= 0; k--) {
          var s = sparks[k], a = motes[s.from], b = motes[s.to], t = (now - s.t0) / s.dur
          if (!a || !b) { sparks.splice(k, 1); continue }
          if (t >= 1) { sparks.splice(k, 1); kindle(s.to, now, 0.85); continue }
          var x = a.x + (b.x - a.x) * t, y = a.y + (b.y - a.y) * t - Math.sin(t * Math.PI) * 6
          var lg = ctx.createLinearGradient(a.x, a.y, x, y)
          lg.addColorStop(0, rgba(WARM, 0))
          lg.addColorStop(1, rgba(PALE, 0.55))
          ctx.strokeStyle = lg
          ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(x, y); ctx.stroke()
          ctx.fillStyle = rgba(PALE, 0.9)
          ctx.beginPath(); ctx.arc(x, y, 1.4, 0, Math.PI * 2); ctx.fill()
        }
        for (var i = 0; i < motes.length; i++) {
          var m = motes[i]
          m.x += Math.sin(now / 4000 + m.ph) * 0.06 * m.sp
          m.y -= 0.02 * m.sp
          if (m.y < -4) { m.y = H + 4; m.x = Math.random() * W }
          if (m.heat > 0) { m.heat *= 0.975; m.warm = Math.min(1, m.warm + 0.02); if (m.heat < 0.01) m.heat = 0 }
          else if (m.warm > 0) m.warm *= 0.9992
          var tw = 0.5 + 0.5 * Math.sin(now / 900 + m.ph)
          var lit = Math.max(m.heat, m.warm * 0.6)
          var col = mix(COOL, WARM, lit)
          var alpha = m.base * (0.7 + 0.3 * tw) + lit * 0.7
          var r = m.r + lit * 1.6
          if (lit > 0.05) {
            var rg = ctx.createRadialGradient(m.x, m.y, 0, m.x, m.y, r * 6)
            rg.addColorStop(0, rgba(col, 0.35 * lit))
            rg.addColorStop(1, 'rgba(0,0,0,0)')
            ctx.fillStyle = rg
            ctx.beginPath(); ctx.arc(m.x, m.y, r * 6, 0, Math.PI * 2); ctx.fill()
          }
          ctx.fillStyle = rgba(lit > 0.5 ? mix(col, PALE, (lit - 0.5) * 2) : col, Math.min(1, alpha))
          ctx.beginPath(); ctx.arc(m.x, m.y, r, 0, Math.PI * 2); ctx.fill()
        }
        ctx.globalCompositeOperation = 'lighter'
        try {
          for (var q = wisps.length - 1; q >= 0; q--) if (!drawWisp(wisps[q], now)) wisps.splice(q, 1)
        } finally {
          ctx.globalCompositeOperation = 'source-over'
        }
      }
      function still() {
        ctx.clearRect(0, 0, W, H)
        for (var i = 0; i < motes.length; i++) {
          var m = motes[i], lit = Math.random() < 0.12 ? 0.8 : 0, col = mix(COOL, WARM, lit)
          if (lit) {
            var g = ctx.createRadialGradient(m.x, m.y, 0, m.x, m.y, 14)
            g.addColorStop(0, rgba(col, 0.35)); g.addColorStop(1, 'rgba(0,0,0,0)')
            ctx.fillStyle = g
            ctx.beginPath(); ctx.arc(m.x, m.y, 14, 0, Math.PI * 2); ctx.fill()
          }
          ctx.fillStyle = rgba(col, m.base + lit * 0.6)
          ctx.beginPath(); ctx.arc(m.x, m.y, m.r + lit, 0, Math.PI * 2); ctx.fill()
        }
      }
      function start() { if (!running) { running = true; requestAnimationFrame(frame) } }
      function stop() { running = false }
      resize()
      window.addEventListener('resize', function () { resize(); if (reduce) still() })
      if (reduce) { still(); return }
      root.addEventListener('pointermove', function (e) {
        var r = canvas.getBoundingClientRect()
        pointer = { x: e.clientX - r.left, y: e.clientY - r.top, t: performance.now() }
      })
      root.addEventListener('pointerdown', function (e) {
        var r = canvas.getBoundingClientRect()
        var i = nearest(e.clientX - r.left, e.clientY - r.top)
        if (i >= 0) kindle(i, performance.now(), 1)
      })
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          entries.forEach(function (en) { en.isIntersecting ? start() : stop() })
        }).observe(canvas)
      } else start()
      document.addEventListener('visibilitychange', function () { document.hidden ? stop() : start() })
      ;[500, 900, 1400].forEach(function (d) {
        setTimeout(function () { kindle(Math.floor(Math.random() * motes.length), performance.now(), 1) }, d)
      })
    })(document.currentScript.closest('.bg-section'))
  </script>
</Band>

<style>
  /* The band itself: the field's frame. Band.astro renders it, so it is reached through its class. */
  :global(.bg-section.hero-field) {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 34rem;
    --bg-section-padding: clamp(4rem, 2rem + 6vw, 7rem) var(--gutter);
  }
  :global(.bg-section.hero-field) > :global(.bg-section-inner) {
    width: 100%;
  }
  .field-canvas {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .field-words {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 46rem;
    margin: 0 auto;
    text-align: center;
  }
  .field-words .kicker {
    margin-bottom: 1rem;
  }
  .field-headline {
    font-size: clamp(2.6rem, 1.6rem + 4.2vw, 5rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }
  .field-headline em {
    font-style: italic;
    font-weight: 500;
    color: var(--accent);
  }
  .field-lede {
    font-size: var(--text-lg);
    color: var(--muted);
    max-width: 34em;
    margin: 1.375rem 0 0;
    text-wrap: pretty;
  }
  .field-words .actions {
    justify-content: center;
    margin-top: 1.875rem;
  }
  .field-note {
    margin: 1.75rem 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
    letter-spacing: 0.01em;
  }
  .field-words > :global(.bg-embed) {
    margin-top: 1.5rem;
  }
  @media (min-width: 48rem) {
    :global(.bg-section.hero-field) {
      min-height: 40rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .field-headline,
    .field-lede {
      animation: field-rise 0.5s ease-out both;
    }
    .field-lede {
      animation-delay: 0.1s;
    }
  }
  @keyframes field-rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
</style>
