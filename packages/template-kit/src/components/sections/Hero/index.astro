---
// Hero: the headline, a line under it, one call to action and a picture.
// When the page opens with a Hero, its headline is the page's <h1> (the
// page's LeadingHero passes `level={1}`); any other Hero uses an <h2>.
// `variant` is the layout chosen in BackGold ('split' puts the picture beside
// the words; anything else stacks them). The picture's alt text is
// `copy.imageAlt`, and its caption (`copy.caption`) a chip at its lower left;
// with no picture there is no caption.
// A Hero with its signup form on carries an `embed`: BackGold's own form,
// framed below the words (never rebuild it here; consent stays with BackGold).
import type { Section } from '@backgold/content'
import ModuleFrame from '../modules/ModuleFrame.astro'
import Band from '../Band.astro'
import { heroPhoto, links } from '../../../lib/section'
import { text } from '../../../lib/format'

interface Props {
  section: Section
  variant?: string
  level?: 1 | 2
}

const { section, level = 2 } = Astro.props
const Heading = level === 1 ? 'h1' : 'h2'
const headline = text(section.copy.headline)
const subheadline = text(section.copy.subheadline)
const caption = text(section.copy.caption)
const picture = heroPhoto(section, 'imageUrl', 'photoUrl', 'videoPosterUrl')
const [cta] = links(section)
const split = section.variant === 'split' && picture !== null
---
<Band section={section} class:list={['hero', split && 'hero-split']}>
  <div class="hero-words">
    {headline && <Heading class="hero-headline">{headline}</Heading>}
    {subheadline && <p class="hero-lede">{subheadline}</p>}
    {cta && <p class="actions"><a class="button" href={cta.href} rel={cta.rel}>{cta.label}</a></p>}
    {section.embed && <ModuleFrame embed={section.embed} band={section.band} type="SignupCapture" layout="card" title="Sign up" height="24rem" class="hero-signup" />}
  </div>
  {picture && (
    <div class="hero-photo">
      <img
        class="hero-image"
        src={picture.url}
        alt={picture.alt}
        loading={level === 1 ? 'eager' : 'lazy'}
        fetchpriority={level === 1 ? 'high' : undefined}
        decoding="async"
      />
      {caption && <p class="photo-caption">{caption}</p>}
    </div>
  )}
</Band>
