---
// Hero, 'statement' layout (boards A3-leadership and A11-contact, section 1):
// the kicker, one wide headline and the line under it, with no photo, for a
// page that opens on words. A button or a signup form the Hero carries follows the
// line. The page-opening Hero's headline is the page's <h1> (`level={1}`);
// any other Hero's is an <h2>. The signup form is BackGold's own (`embed`).
import type { ComponentProps } from 'astro/types'
import ModuleFrame from '../modules/ModuleFrame.astro'
import Band from '../Band.astro'
import type Default from './index.astro'
import { links } from '../../../lib/section'
import { text } from '../../../lib/format'

type Props = ComponentProps<typeof Default>

const { section, level = 2 } = Astro.props
const Heading = level === 1 ? 'h1' : 'h2'
const kicker = text(section.copy.kicker)
const headline = text(section.copy.headline)
const subheadline = text(section.copy.subheadline)
const buttons = links(section)
---
<Band section={section} class="hero-statement">
  <div class="statement">
    {kicker && <p class="kicker">{kicker}</p>}
    {headline && <Heading class="statement-headline">{headline}</Heading>}
    {subheadline && <p class="statement-lede">{subheadline}</p>}
    {buttons.length > 0 && (
      <p class="actions">
        {buttons.map((link, i) => <a class:list={['button', i > 0 && 'button-quiet']} href={link.href} rel={link.rel}>{link.label}</a>)}
      </p>
    )}
    {section.embed && <ModuleFrame embed={section.embed} band={section.band} type="SignupCapture" layout="card" title="Sign up" height="24rem" class="hero-signup" />}
  </div>
</Band>

<style>
  .statement-headline {
    font-size: clamp(2.5rem, 1.6rem + 3vw, 4rem);
    font-weight: 800;
    line-height: 1;
    max-width: 14em;
    margin: 0;
  }
  .statement-lede {
    font-size: var(--text-lg);
    color: var(--muted);
    max-width: 40em;
    margin: 1.25rem 0 0;
  }
  .statement > :global(.hero-signup) {
    margin-top: 1.5rem;
    max-width: 40rem;
  }
</style>
