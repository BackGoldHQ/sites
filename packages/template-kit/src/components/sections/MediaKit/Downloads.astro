---
// The Press kit's downloads (board 15, A): each an outline button with a
// download mark, the asset's title and its detail ("JPG · 2 MB") small,
// wrapping onto as many rows as they need. A download with no address is
// its words alone, not a button.
import type { KitRow } from './kit'

interface Props {
  assets: KitRow[]
}

const { assets } = Astro.props
---
{assets.length > 0 && (
  <ul class="kit-assets" role="list">
    {assets.map((asset) => (
      <li>
        {asset.link ? (
          <a class="button button-quiet kit-asset" href={asset.link.href} rel={asset.link.rel}>
            <svg class="kit-asset-mark" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="kit-asset-words">
              <span class="kit-asset-title">{asset.title}</span>
              {asset.detail && <span class="kit-asset-detail">{asset.detail}</span>}
            </span>
          </a>
        ) : (
          <p class="kit-asset-plain">
            <span class="kit-asset-title">{asset.title}</span>
            {asset.detail && <span class="kit-asset-detail">{asset.detail}</span>}
          </p>
        )}
      </li>
    ))}
  </ul>
)}

<style>
  .kit-assets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .kit-assets > li {
    min-width: 0;
    max-width: 100%;
  }
  .kit-asset {
    justify-content: flex-start;
    gap: 0.625rem;
    max-width: 100%;
    padding: 0.5rem 1.125rem 0.5rem 0.875rem;
    border-width: 1.5px;
    text-align: left;
  }
  .kit-asset-mark {
    flex: 0 0 auto;
  }
  .kit-asset-words {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5rem;
    min-width: 0;
  }
  .kit-asset-title {
    overflow-wrap: anywhere;
  }
  .kit-asset-detail {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .kit-asset-plain {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5rem;
    margin: 0;
    padding: 0.5rem 0;
    font-size: 0.9375rem;
    font-weight: 700;
  }
</style>
