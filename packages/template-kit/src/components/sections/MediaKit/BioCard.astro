---
// One of the Press kit's cards (board 15, A): on the band's surface, its
// label ("Short bio") with the word count beside it, muted, and the Copy
// button at the right; the words under it, a bio as its paragraphs. The
// button is drawn hidden; the Press kit's script shows it where the
// browser can copy, and copies the words under it (`data-kit-text`).
import Prose from '../../Prose.astro'
import { wordCount } from './kit'

interface Props {
  label: string
  value: string
  level: 'h2' | 'h3'
  /** Whether to show the word count (a bio's; not the fact sheet's line). */
  count?: boolean
}

const { label, value, level: Label, count = true } = Astro.props
const words = count ? wordCount(value) : 0
---
<li class="bio-card" data-kit-card>
  <div class="bio-card-head">
    <Label class="bio-card-label">{label}</Label>
    {words > 0 && <span class="bio-card-count">{words === 1 ? '1 word' : `${words} words`}</span>}
    <button type="button" class="bio-card-copy" data-kit-copy data-kit-copied={`${label} copied.`} hidden>
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
        <path d="M9 9h10v11H9zM5 15V4h10" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
      </svg>
      <span data-kit-copy-label>Copy</span><span class="visually-hidden"> {label.toLowerCase()}</span>
    </button>
  </div>
  <div class="bio-card-text" data-kit-text>
    {count ? <Prose value={value} /> : <p>{value}</p>}
  </div>
</li>

<style>
  .bio-card {
    min-width: 0;
    padding: 1rem 1.125rem 1.125rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .bio-card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    margin-bottom: 0.375rem;
  }
  .bio-card-head .bio-card-label {
    margin: 0;
    font-family: var(--font);
    font-size: var(--text);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.3;
  }
  .bio-card-count {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .bio-card-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    margin: -0.625rem -0.625rem -0.625rem auto;
    padding: 0 0.75rem;
    border: 0;
    border-radius: var(--pill);
    background: transparent;
    color: var(--link);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
  }
  .bio-card-copy[hidden] {
    display: none;
  }
  .bio-card-copy:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .bio-card-text {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .bio-card-text :global(.prose) {
    max-width: none;
    line-height: inherit;
  }
  .bio-card-text :global(p) {
    margin: 0;
  }
  .bio-card-text :global(p + p) {
    margin-top: 0.625rem;
  }
  @media (min-width: 40rem) {
    .bio-card {
      padding: 1.125rem 1.375rem 1.25rem;
    }
  }
</style>
