---
// Financials, 'donut' layout (REPORT §2 G15, "where the money goes"): the
// head (the kicker, the heading with the year as a chip, the body), then a
// donut beside its legend, then `sourceNote` as a fine line and the report
// link as the one button. On a phone the legend follows under the donut.
//
// The donut is a CSS conic-gradient drawn from the shares in row order: a
// figure's slice runs from the sum of the shares drawn before it to that sum
// plus its own share, each slice in the next colour of the sequence below,
// with a hairline of the band's ground after it so neighbours read apart.
// The shares are drawn as the organization published them, never scaled to
// fill the ring: when they come to less than 100 the rest of the ring is
// left open in the track colour, and when they come to more the ring draws
// what fits and stops, with nothing said about it. The hole is the band's
// ground. The donut is a picture (aria-hidden); the legend carries every
// number: a swatch in the slice's colour, the category, the share ("62%"),
// the amount and the note. A figure with no share, or whose slice did not
// fit, has no swatch. Nothing is drawn with neither a heading nor a figure.
import type { ComponentProps } from 'astro/types'
import type Default from './index.astro'
import Band from '../Band.astro'
import { text } from '../../../lib/format'
import Head from './Head.astro'
import Foot from './Foot.astro'
import { rowsOf, shareLabel } from './financials'

type Props = ComponentProps<typeof Default>

/** The colours in the sequence (--financials-1 … --financials-8 below), reused in order past the eighth slice. */
const COLOURS = 8
/** The hairline after each slice, in points of the ring, taken from slices wide enough to spare it. */
const GAP = 0.4

const { section } = Astro.props
const heading = text(section.copy.heading)
const figures = rowsOf(section)

const stop = (at: number) => `${Number(at.toFixed(3))}%`
let drawn = 0
let colour = 0
const stops: string[] = []
const legend = figures.map((figure) => {
  if (figure.share === null || figure.share <= 0 || drawn >= 100) return { figure, swatch: null }
  const from = drawn
  const to = Math.min(drawn + figure.share, 100)
  const fill = `var(--financials-${(colour % COLOURS) + 1})`
  const gap = to - from > GAP * 3 ? GAP : 0
  stops.push(`${fill} ${stop(from)} ${stop(to - gap)}`)
  if (gap > 0) stops.push(`var(--bg-band-background) ${stop(to - gap)} ${stop(to)}`)
  drawn = to
  colour += 1
  return { figure, swatch: fill }
})
if (stops.length > 0 && drawn < 100) stops.push(`var(--financials-open) ${stop(drawn)} 100%`)
const ring = stops.length > 0 ? `--ring: conic-gradient(${stops.join(', ')})` : null
---
{(heading || figures.length > 0) && (
  <Band section={section} class="financials financials-donut">
    <Head section={section} />
    {figures.length > 0 && (
      <div class:list={['donut-figures', ring && 'donut-figures-ring']}>
        {ring && <div class="donut" style={ring} aria-hidden="true"></div>}
        <ul class="legend" role="list">
          {legend.map(({ figure, swatch }) => (
            <li class="legend-item">
              <span class="legend-swatch" style={swatch ? `background: ${swatch}` : undefined} aria-hidden="true"></span>
              <div class="legend-words">
                {figure.category && <p class="legend-category">{figure.category}</p>}
                {figure.note && <p class="legend-note">{figure.note}</p>}
              </div>
              {(figure.share !== null || figure.amount) && (
                <p class="legend-numbers">
                  {figure.share !== null && <strong class="legend-share">{shareLabel(figure.share)}</strong>}
                  {figure.amount && <span class="legend-amount">{figure.amount}</span>}
                </p>
              )}
            </li>
          ))}
        </ul>
      </div>
    )}
    <Foot section={section} />
  </Band>
)}

<style>
  /*
    The slice colours, from the band's own. Each is the button colour or the
    accent at its own depth: full, or mixed toward the ink (deeper in light
    mode, paler in dark) or toward the surface (paler in light mode, deeper in
    dark), and neighbours sit far apart in depth, so the slices read apart
    even where the brand's accent and button are the same colour. No mix
    keeps less than a third of its colour, so none fades into a dark band's
    ground. The open part of the ring is the ink at a tenth, the track the
    bars layout draws.
  */
  .donut-figures {
    --financials-1: var(--button);
    --financials-2: color-mix(in srgb, var(--button) 55%, var(--ink));
    --financials-3: color-mix(in srgb, var(--button) 55%, var(--surface));
    --financials-4: color-mix(in srgb, var(--accent) 34%, var(--ink));
    --financials-5: color-mix(in srgb, var(--button) 36%, var(--surface));
    --financials-6: color-mix(in srgb, var(--accent) 78%, var(--ink));
    --financials-7: color-mix(in srgb, var(--accent) 78%, var(--surface));
    --financials-8: color-mix(in srgb, var(--button) 42%, var(--ink));
    --financials-open: color-mix(in srgb, var(--ink) 10%, transparent);
  }
  .donut-figures-ring {
    display: grid;
    grid-template-columns: clamp(13rem, 26vw, 19rem) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 1rem + 3vw, 4rem);
  }
  .donut {
    position: relative;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--ring);
  }
  .donut::after {
    content: '';
    position: absolute;
    inset: 21%;
    border-radius: 50%;
    background: var(--bg-band-background);
  }
  .legend {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .legend-item {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.25rem 0.875rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--line);
  }
  .legend-item:first-child {
    padding-top: 0;
  }
  .legend-item:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }
  .legend-swatch {
    width: 1rem;
    height: 1rem;
    margin-top: 0.1875rem;
    border-radius: 0.25rem;
  }
  .legend-swatch[style] {
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .legend-category {
    margin: 0;
    font-weight: 700;
    line-height: 1.3;
  }
  .legend-note {
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.4;
  }
  .legend-numbers {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.125rem;
    margin: 0;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .legend-share {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.15;
  }
  .legend-amount {
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  /* A phone: the donut centred, the legend under it. */
  @media (max-width: 39.99rem) {
    .donut-figures-ring {
      grid-template-columns: minmax(0, 1fr);
    }
    .donut {
      width: min(100%, 15rem);
      justify-self: center;
    }
  }
</style>
