---
// QuickDonate, 'ladder' layout (REPORT §2 G4, the impact ladder): the kicker
// as a chip, the heading and the body at the left as the grid layout draws
// them, and at the right a card holding the ladder, one rung per row: the
// amount large in the display face and what it does beside it ("$25 — 50
// doors knocked"), in the order the section lists its `ladder` rows. Under the
// rungs a small Other amount link, the monthly switch when the section offers
// it, the one button and the note under it, as DonateCard draws them.
// Every rung is a plain link to the organization's own donate page in
// BackGold with its `?amount=`, and Other links there with none, so without
// script a rung is the gift. Picker.astro, right after the card, makes the
// rungs a choice instead: picking one marks it and the button's address and
// words ("Donate $100") follow. The section's default amount starts
// selected when it is a rung. Nothing is collected here and no raised
// figures or donor counts are shown. On a phone the card follows the
// words; without words the card stands alone, centred. Without rungs the
// grid layout is drawn; nothing is drawn when the section has no donate link.
import type { ComponentProps } from 'astro/types'
import Band from '../Band.astro'
import Prose from '../../Prose.astro'
import Picker from './Picker.astro'
import Default from './index.astro'
import { amountHref, dollars, giveLabel, ladderOf, presetOf, quickDonate } from './donate'
import { prose, text } from '../../../lib/format'

type Props = ComponentProps<typeof Default>

const { section } = Astro.props
const found = quickDonate(section)
const rungs = ladderOf(section)
// The rungs are this layout's amounts: the default amount starts selected when it is one of them.
const preset = presetOf(section)
const qd = found && { ...found, selected: rungs.some((rung) => rung.amount === preset) ? preset : null }
const kicker = text(section.copy.kicker)
const heading = text(section.copy.heading)
const words = kicker || heading || prose(section.copy.body)
---
{qd && rungs.length === 0 && <Default {...Astro.props} />}
{qd && rungs.length > 0 && (
  <Band section={section} class="quick-donate qd-ladder">
    <div class:list={['qd-ladder-grid', words && 'qd-ladder-words']}>
      {words && (
        <div class="qd-words">
          {kicker && <p class="chip qd-kicker">{kicker}</p>}
          {heading && <h2>{heading}</h2>}
          <Prose value={section.copy.body} class="lede" />
        </div>
      )}
      <div class="qd-ladder-card" data-quick-donate data-href={qd.donate.href} data-label={qd.donate.label}>
        <ul class="qd-rungs" role="list" aria-label="Choose an amount">
          {rungs.map((rung) => (
            <li>
              <a class="qd-rung" href={amountHref(qd.donate.href, rung.amount)} rel={qd.donate.rel} data-amount={rung.amount} data-selected={rung.amount === qd.selected ? '' : undefined}>
                <span class="qd-rung-amount">{dollars(rung.amount)}</span>
                <span class="visually-hidden"> — </span>
                <span class="qd-rung-impact">{rung.impact}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="qd-other-line">
          <a class="qd-other" href={amountHref(qd.donate.href, null)} rel={qd.donate.rel} data-other>Other amount</a>
        </p>
        {qd.monthly && (
          <button type="button" class="qd-switch" role="switch" aria-checked="false" data-monthly hidden>
            <span class="qd-switch-track" aria-hidden="true"><span class="qd-switch-thumb"></span></span>
            <span>{qd.monthly}</span>
          </button>
        )}
        <a class="button qd-give" href={amountHref(qd.donate.href, qd.selected)} rel={qd.donate.rel} data-give>{giveLabel(qd)}</a>
        {qd.note && <p class="fine qd-note">{qd.note}</p>}
      </div>
      <Picker />
    </div>
  </Band>
)}

<style>
  .qd-ladder-grid {
    display: grid;
    gap: 1.75rem;
    max-width: 32rem;
    margin-inline: auto;
  }
  .qd-ladder-words {
    max-width: none;
  }
  .qd-kicker {
    margin: 0 0 1rem;
  }
  .qd-words h2 {
    margin: 0;
    max-width: 16em;
  }
  .qd-words > :global(.lede) {
    margin: 1rem 0 0;
  }
  .qd-words > :global(.lede) > :last-child {
    margin-bottom: 0;
  }

  .qd-ladder-card {
    padding: clamp(1.25rem, 0.9rem + 1.2vw, 1.75rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow);
    color: var(--ink);
  }
  /* The amounts share one column, as wide as the widest, so the impacts line up (each rung its own two columns where subgrid is missing). */
  .qd-rungs {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .qd-rungs > li {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: max-content minmax(0, 1fr);
    grid-template-columns: subgrid;
  }
  .qd-rung {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: max-content minmax(0, 1fr);
    grid-template-columns: subgrid;
    column-gap: 1rem;
    align-items: center;
    min-height: 3.5rem;
    padding: 0.625rem 1rem;
    border: 2px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
  }
  .qd-rung:hover {
    border-color: var(--ink);
  }
  .qd-rung[data-selected] {
    background: var(--button-2);
    border-color: var(--button-2);
    color: var(--button-2-ink);
  }
  .qd-rung-amount {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    font-weight: 700;
    font-variant-numeric: lining-nums tabular-nums;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }
  .qd-rung-impact {
    font-size: var(--text);
    font-weight: 600;
    line-height: 1.3;
  }
  .qd-other-line {
    margin: 0.25rem 0 0;
    font-size: var(--text-sm);
  }
  /* A small link with a full-size tap target. */
  .qd-other {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--link);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.25em;
  }

  .qd-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    margin: 0.25rem 0 0;
    padding: 0 0.25rem 0 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
  }
  .qd-switch[hidden] {
    display: none;
  }
  .qd-switch-track {
    position: relative;
    flex: 0 0 auto;
    width: 2.75rem;
    height: 1.5rem;
    border: 2px solid var(--line-strong);
    border-radius: var(--pill);
  }
  .qd-switch-thumb {
    position: absolute;
    top: 0.1875rem;
    left: 0.1875rem;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    background: var(--muted);
  }
  .qd-switch[aria-checked='true'] .qd-switch-track {
    background: var(--button-2);
    border-color: var(--button-2);
  }
  .qd-switch[aria-checked='true'] .qd-switch-thumb {
    background: var(--button-2-ink);
    transform: translateX(1.25rem);
  }
  .qd-give {
    display: flex;
    width: 100%;
    margin-top: 0.875rem;
    font-size: var(--text);
  }
  .qd-note {
    margin: 0.75rem 0 0;
    text-align: center;
  }

  @media (min-width: 48rem) {
    .qd-ladder-words {
      grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
      gap: clamp(2rem, 4vw, 3.5rem);
      align-items: center;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .qd-rung,
    .qd-switch-track,
    .qd-switch-thumb {
      transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease,
        transform 0.15s ease;
    }
  }
</style>
