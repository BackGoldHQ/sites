{
  "name": "@backgold/template-kit",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "What every BackGold Astro template draws the same way: the section, entry and chrome components, the Site layout, the routes, lib and the stylesheets, consumed as source.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./template": "./src/template.ts",
    "./routes/*": "./src/routes/*",
    "./layouts/*": "./src/layouts/*",
    "./components/*": "./src/components/*",
    "./lib/*": "./src/lib/*.ts",
    "./styles/*": "./src/styles/*"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "astro check && tsc --noEmit"
  },
  "peerDependencies": {
    "@backgold/astro": "workspace:^",
    "@backgold/content": "workspace:^",
    "astro": "^7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@backgold/astro": "workspace:^",
    "@backgold/content": "workspace:^",
    "@backgold/contract": "workspace:*",
    "astro": "^7.3.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.12"
  }
}
