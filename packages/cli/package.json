{
  "name": "@backgold/cli",
  "version": "0.1.0",
  "description": "Deploy an Astro site built on @backgold/astro to BackGold hosting",
  "license": "MIT",
  "type": "module",
  "bin": {
    "backgold": "bin/backgold.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\"",
    "prepublishOnly": "pnpm lint && pnpm build && pnpm test"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">= 22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BackGoldHQ/sites.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "backgold",
    "astro",
    "cloudflare-workers",
    "deploy"
  ]
}
