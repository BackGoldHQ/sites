// The template's Worker. A "//" inside a string stays.
{
  "name": "backgold-fixture",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-04",
  "vars": { "SITE_URL": "", "BACKGOLD_API_ORIGIN": "https://api.backgold.com" },
  /* No id: Cloudflare creates it. */
  "kv_namespaces": [{ "binding": "BACKGOLD_CACHE" }],
  "env": {
    "staging": {
      "name": "template-fixture",
      "kv_namespaces": [{ "binding": "BACKGOLD_CACHE", "id": "__FIXTURE_STAGING_KV_ID__" }],
    },
  },
}
