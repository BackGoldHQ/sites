  },
  "devDependencies": {
    "@backgold/cli": "workspace:^",
    "wrangler": "^4.149.0"
  },
  "cloudflare": {
    "bindings": {
      "BACKGOLD_SITE_KEY": { "description": "The site's publishable key." }
    }
  }
